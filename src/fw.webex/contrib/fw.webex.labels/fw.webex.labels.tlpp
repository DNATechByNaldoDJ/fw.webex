            baselineY=textBaselineY(box,contentBox,style,size,lineHeight,lines.length);
        return {lines:lines,size:size,padding:padding,lineHeight:lineHeight,
            contentBox:contentBox,
            overflowed:!measured.fits,metrics:{contentBox:{
                x:box.x+padding.left,y:box.y+padding.top,width:width,height:height},
                fontSize:maximum,minFontSize:minimum,finalFontSize:size,
                lineCount:lines.length,maxLines:maxLines,overflowed:!measured.fits,
                overflowPolicy:fit.overflow||"error",lineHeight:lineHeight,
