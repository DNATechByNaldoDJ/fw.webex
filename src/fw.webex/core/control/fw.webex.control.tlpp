method New(cType) class WebExControl
    paramtype 1 var cType as character optional default "div"
    ::jAttrs:=JSONObject():New()
    ::jChildren:=JSONObject():New()
    ::jContents:=JSONObject():New()
    ::jObjectsContainer:=JSONObject():New()
    ::lVisible:=.T.
    ::lChartEnabled:=__jFeatures["lChartEnabled"]
    ::lIconsEnabled:=__jFeatures["lIconsEnabled"]
    ::lJQueryEnabled:=__jFeatures["lJQueryEnabled"]
    ::lMarkDownEnabled:=__jFeatures["lMarkDownEnabled"]
    ::lApexChartEnabled:=__jFeatures["lApexChartEnabled"]
    ::lDataTableEnabled:=__jFeatures["lDataTableEnabled"]
    ::lASCIILoaderEnabled:=__jFeatures["lASCIILoaderEnabled"]
    ::lMaterialDesignEnabled:=__jFeatures["lMaterialDesignEnabled"]
    ::lWebExBackURLButtonEnabled:=__jFeatures["lWebExBackURLButtonEnabled"]
    ::lRenderChildren:=.T.
    ::lExternalAssets:=.F.
    _Super:New()
    ::SetID(::NewID())
    ::SetType(cType)
    ::SetContent(FWWEBEX_WEB_NULL_CONTENT)
    ::SetFWWebExTmpPath()
return(self)

