    endif
return(self)

method AddScript(oScript) class WebExControl
    local cType as character
    paramtype 1 var oScript as object class WebExScript
    if (!::FindInHeader(oScript:GetID()))
        cType:=if(oScript:GetScriptInPage(),"page","head")
        if (!__jScripts:HasProperty(cType))
            __jScripts[cType]:=JSONObject():New()
        endif
        __jScripts[cType][oScript:GetID()]:=oScript
    endif
return(oScript)

method RenderHTML() class WebExControl

    local aAttrs as array
    local aChildren as array

    local cKey as character
    local cHTML as character
    local cContent as character
    local cLowerType as character

    local lHTMLAssetsToFile:=.F. as logical

    local nAttr as numeric
    local nAttrs as numeric

    local nChild as numeric
    local nChilds as numeric

    local oChild as object

    local xVal as variant

    if ((::lRenderChildren).or.(Empty(::cHTML)))

        if ((.T.).or.(!::HasFeaturesEnabled()))
            ::EnableFeatures()
        endif

        // Garante que tenha um ID unico
        if (!::jAttrs:HasProperty("id"))
            ::jAttrs["id"]:=::GetFixedID()
        endif

        cLowerType:=::cType
        cContent:=::GetContent(::cID)

        if (;
                (::ExternalAssetsIsEnabled());
                .and.;
                (::lExternalAssets);
                .and.;
                (cLowerType$"script|style");
                .and.;
                (!::ContentIsNull(cContent));
            )
            lHTMLAssetsToFile:=WebFileTools():HTMLAssetsToFile(;
                ::GetID();
                ,cLowerType;
                ,cContent;
                ,::cFWWebExTmpPath;
                ,@::cExternalAssetsFilePath;
                ,@::cLocalAssetsFilePath;
            )
            if (lHTMLAssetsToFile)
                cContent:=FWWEBEX_WEB_NULL_CONTENT
                ::AddAssets(::GetID(),cLowerType,::cLocalAssetsFilePath,::cExternalAssetsFilePath)
            endif
        endif

        if (lHTMLAssetsToFile)

            cHTML:=""

        else

            cHTML:="<"+::cType

                if (cLowerType!="!--")
                    aAttrs:=::jAttrs:GetNames()
                    nAttrs:=Len(aAttrs)
                    for nAttr:=1 to nAttrs
                        cKey:=aAttrs[nAttr]
                        if (::jAttrs:HasProperty(cKey))
                            xVal:=::jAttrs[cKey]
                            if (valType(xVal)!="C")
                                xVal:=cValToChar(xVal)
                            endif
                            if (cKey==xVal)
                                cHTML+=" "+cKey
                            else
                                cHTML+=" "+cKey+'="'+xVal+'"'
                            endif
                        endif
                    next nAttr
                endif

            if (aScan(__aVoidTags,{|cType as character|(cType==cLowerType)})>0)

                cHTML+="/>"

            else

                if (cLowerType!="!--")
                    cHTML+=">"
                endif

                if (!::ContentIsNull(cContent))
                    cHTML+=cContent
                endif

                aChildren:=::jChildren:GetNames()
                nChilds:=Len(aChildren)
                if (nChilds>0)
                    for nChild:=1 to nChilds
                        cKey:=aChildren[nChild]
                        if (::jChildren:HasProperty(cKey))
                            oChild:=::jChildren[cKey]
                            if (valType(oChild)=="O")
                                ::SetRenderChildren(::lRenderChildren)
                                cHTML+=oChild:RenderHTML()
                                if (::jContents:HasProperty(oChild:GetID()))
                                    cContent:=::GetContent(oChild:GetID())
                                    if (!::ContentIsNull(cContent))
                                        cHTML+=cContent
                                    endif
                                endif
                            endif
                        endif
                    next nChild
                endif

                if (cLowerType!="!--")
                    cHTML+="</"+::cType+">"
                else
                    cHTML+="-->"
                endif

            endif

        endif

        ::cHTML:=cHTML

    else

        cHTML:=::cHTML

    endif

return(cHTML)

method SetRenderChildren(lRenderChildren)  class WebExControl
    paramtype 1 var lRenderChildren as logical optional default .T.
    ::lRenderChildren:=lRenderChildren
return(self)

method GetExternalAssets() class WebExControl
return(::lExternalAssets)

method SetExternalAssets(lExternalAssets) class WebExControl
    paramtype 1 var lExternalAssets as logical optional default .F.
    ::lExternalAssets:=(::ExternalAssetsIsEnabled()).and.((lExternalAssets).and.(::cType$"script|style"))
    ::cLocalAssetsFilePath:=""
    ::cExternalAssetsFilePath:=""
return(self)

method ExternalAssetsIsEnabled() class WebExControl
return(FWWEBEX_EXTERNAL_ASSETS_IS_ENABLED)

method AddAssets(cID,cType,cLocal,cRemote) class WebExControl

    paramtype 1 var cID as character
    paramtype 2 var cType as character
    paramtype 3 var cLocal as character
    paramtype 4 var cRemote as character

    __jAssets[cID]:=JSONObject():New()
    __jAssets[cID]["id"]:=cID
    __jAssets[cID]["type"]:=cType
    __jAssets[cID]["local"]:=cLocal
    __jAssets[cID]["remote"]:=cRemote

return(__jAssets)

method GetAssets() class WebExControl
return(__jAssets)

method DelAssets() class WebExControl
    aEval(__jAssets:GetNames(),{|cName as character|__jAssets:DelName(cName)})
return(__jAssets)

method AddClass(cNewClass) class WebExControl
    local aNewClass as array
    local cClass as character
    local cClassItem as character
    local cChrSpace2 as character
    local i as numeric
    paramtype 1 var cNewClass as character
    cNewClass:=Lower(AllTrim(cNewClass))
    if (!::HasAttr("class"))
        if (!Empty(cNewClass))
            cChrSpace2:=Space(2)
            while (cChrSpace2$cNewClass)
                cNewClass:=StrTran(cNewClass,cChrSpace2," ")
            end while
            ::SetAttr("class",cNewClass)
        endif
    else
        cClass:=Lower(AllTrim(::GetAttr("class")))
        cChrSpace2:=Space(2)
        while (cChrSpace2$cNewClass)
            cNewClass:=StrTran(cNewClass,cChrSpace2," ")
        end while
        aNewClass:=StrTokArr2(Lower(AllTrim(cNewClass))," ",.T.)
        for i:=1 to Len(aNewClass)
            cClassItem:=AllTrim(aNewClass[i])
            if (Empty(cClassItem))
                loop
            endif
            if (!::HasAttrValue("class",cClassItem))
                cClass+=if(!Empty(cClass)," ","")+cClassItem
            endif
        next i
        FWFreeArray(@aNewClass)
        ::DelAttr("class")
        if (!Empty(cClass))
            ::SetAttr("class",cClass)
        endif
    endif
return(self)

method HasClass(cClass,aClasses) class WebExControl
    local lHasClass as logical
    lHasClass:=::HasAttrValue("class",cClass,@aClasses)
return(lHasClass)

method DelClass(cClass,lDelClass) class WebExControl
    local aClasses as array
    paramtype 1 var cClass as character
    paramtype 2 var lDelClass as logical optional default .F.
    lDelClass:=::HasAttrValue("class",cClass,@aClasses)
    if (lDelClass)
        ::DelAttrValue("class",cClass,@aClasses,@lDelClass)
    endif
    FWFreeArray(@aClasses)
return(self)

method DelClassRegex(cClassRegex,lDelClass) class WebExControl
return(::DelAttrValueRegex("class",cClassRegex,@lDelClass))

method IsVisible() class WebExControl
return(::lVisible)

method SetVisible(lVisible) class WebExControl
    paramtype 1 var lVisible as logical optional default .T.
    ::lVisible:=lVisible
    if (::lVisible)
        ::DelClass("d-none")
    else
        ::AddClass("d-none")
    endif
return(self)

static function GetWebExBackURLButtonScript()

    local cBackURLButtonScript as character

    beginContent var cBackURLButtonScript

        /**
         * FWWebEx Custom History Stack
         * ----------------------------------------
         * Sistema de navegacao reversa baseado em sessionStorage.
         * Evita usar o historico nativo do browser (que o Protheus detona).
         * Released to Public Domain, por NaldoDJ(TM) vibes.
         */

        (function(global) {
            const STORAGE_KEY = "FWWebExHistoryStack";

            const HistoryStack = {
                push: function(url) {
                    if (!url) return;
                    let stack = HistoryStack._getStack();
                    let current = window.location.href;
                    if (stack.length === 0 || stack[stack.length - 1] !== current) {
                        stack.push(current);
                    }
                    sessionStorage.setItem(STORAGE_KEY, JSON.stringify(stack));
                    if (url !== current) {
                        window.location.href = url;
                    }
                },

                pop: function() {
                    let stack = HistoryStack._getStack();
                    let current = stack.pop(); // tira o atual
                    let back = stack.pop();    // pega o anterior
                    sessionStorage.setItem(STORAGE_KEY, JSON.stringify(stack));
                    return back || "#"; // fallback
                },

                clear: function() {
                    sessionStorage.removeItem(STORAGE_KEY);
                },

                _getStack: function() {
                    try {
                        return JSON.parse(sessionStorage.getItem(STORAGE_KEY)) || [];
                    } catch (e) {
                        return [];
                    }
                }
            };

            // Expoe globalmente
            global.FWWebExHistory = HistoryStack;

            // Atalho para uso direto no botao back
            global.popFromCustomHistory = function() {
                return HistoryStack.pop();
            };

            // Atalho de navegacao com empilhamento
            global.navigateTo = function(url) {
                HistoryStack.push(url);
            };

        })(window);

    endContent

return(cBackURLButtonScript)

method Clean() class WebExControl
    ::ResetID()
    ::DelAssets()
    ::RemoveScripts()
    ::DisableFeatures()
    ::CleanObjectsContainer()
    ::CleanHeader()
    ::CleanChildren()
    aEval(;
         ::GetJSONChildren():GetNames();
        ,{|cName as character|;
            if(;
                (ValType(::GetJSONChildren()[cName])=="O");
                ,FreeObj(::GetJSONChildren()[cName]);
                ,nil;
            );
            ,::GetJSONChildren():DelName(cName);
        };
    )
return(nil)

method CleanHeader() class WebExControl

    local aHeader:=__jHeader:GetNames() as array

    local cKey as character

    local nHeader as numeric
    local nHeaders as numeric

    local oHeader as object

    nHeaders:=Len(aHeader)
    if (nHeaders>0)
        for nHeader:=1 to nHeaders
            cKey:=aHeader[nHeader]
            if (__jHeader:HasProperty(cKey))
                oHeader:=__jHeader[cKey]
                if (valType(oHeader)=="O")
                    oHeader:CleanObjectsContainer()
                    oHeader:CleanChildren()
                    FreeObj(@oHeader)
                endif
                __jHeader:DelName(cKey)
            endif
        next nHeader
    endif
return(nil)

method CleanChildren() class WebExControl

    local aChildren:=::jChildren:GetNames() as array

    local cKey as character

    local nChild as numeric
    local nChilds as numeric

    local oChild as object

    nChilds:=Len(aChildren)
    if (nChilds>0)
        for nChild:=1 to nChilds
            cKey:=aChildren[nChild]
            if (::jChildren:HasProperty(cKey))
                oChild:=::jChildren[cKey]
                if (valType(oChild)=="O")
                    oChild:CleanObjectsContainer()
                    oChild:CleanChildren()
                    FreeObj(@oChild)
                endif
                ::jChildren:DelName(cKey)
            endif
        next nChild
    endif

return(nil)

method CleanObjectsContainer() class WebExControl

    local aObjects:=::jObjectsContainer:GetNames() as array

    local cKey as character

    local nObject as numeric
    local nObjects as numeric

    local oObject as object

    nObjects:=Len(aObjects)
    if (nObjects>0)
        for nObject:=1 to nObjects
            cKey:=aObjects[nObject]
            if (::jObjectsContainer:HasProperty(cKey))
                oObject:=::jObjectsContainer[cKey]
                if (valType(oObject)=="O")
                    oObject:CleanObjectsContainer()
                    FreeObj(@oObject)
                endif
                ::jObjectsContainer:DelName(cKey)
            endif
        next nObject
    endif

return(nil)

method RemoveScripts() class WebExControl
    local jHeadScripts:=::GetHeadScripts() as json
    local jPageScripts:=::GetPageScripts() as json
    aEval(;
         jHeadScripts:GetNames();
        ,{|cName as character|;
            if(;
                (ValType(jHeadScripts[cName])=="O");
                ,(;
                    jHeadScripts[cName]:CleanChildren();
                    ,FreeObj(jHeadScripts[cName]);
                );
                ,nil;
            );
            ,jHeadScripts:DelName(cName);
        };
    )
    aEval(;
         jPageScripts:GetNames();
        ,{|cName as character|;
            if(;
                (ValType(jPageScripts[cName])=="O");
                ,(;
                    jPageScripts[cName]:CleanChildren();
                    ,FreeObj(jPageScripts[cName]);
                );
                ,nil;
            );
            ,jPageScripts:DelName(cName);
        };
    )
return(nil)

method AddFeature(oFeature,bLoadFeature,nPriority) class WebExControl

    local cWebExFeature as character

    local oWebExFeature as object

    paramtype 1 var oFeature as object
    paramtype 2 var bLoadFeature as block
    paramtype 3 var nPriority as numeric optional default 1

    cClassName:=GetClassName(oFeature)
    if (!Left(cClassName,8)=="FWWEBEX.")
        CLASSPARAMEXCEPTION PARAM 1 VAR oFeature TEXT cClassName MESSAGE "Object must belong to the FWWEBEX namespace. Got '"+cClassName+"' instead. Check your class declaration."
    elseif ((!MethIsMemberOf(oFeature,"ISKINDOF",.T.)).or.(!oFeature:IsKindOf("WEBEXCONTROL",.T.)))
        CLASSPARAMEXCEPTION PARAM 1 VAR oFeature TEXT cClassName MESSAGE "Object must inherit from FWWEBEX.WebExControl. Received: "+cClassName+"."
    endif

    if (!::ExistFeature(oFeature))
        oWebExFeature:=WebExFeatures():New(oFeature,bLoadFeature)
        oWebExFeature:SetMemberData("nPriority",nPriority)
        cWebExFeature:=oWebExFeature:GetMemberData("cFeatureID")
        __jWebExFeatures[cWebExFeature]:=oWebExFeature
    endif

return(self)

method ExistFeature(vFeature) class WebExControl
    local cFeature as character
    local cClassName as character
    local lExistFeature as logical
    paramtype 1 var vFeature as character,object
    if (ValType(vFeature)=="O")
        cClassName:=GetClassName(vFeature)
        if (!Left(cClassName,8)=="FWWEBEX.")
            CLASSPARAMEXCEPTION PARAM 1 VAR vFeature TEXT cClassName MESSAGE "Object must belong to the FWWEBEX namespace. Got '"+cClassName+"' instead. Check your class declaration."
        elseif ((!MethIsMemberOf(vFeature,"ISKINDOF",.T.)).or.(!vFeature:IsKindOf("WEBEXCONTROL",.T.)))
            CLASSPARAMEXCEPTION PARAM 1 VAR vFeature TEXT cClassName MESSAGE "Object must inherit from FWWEBEX.WebExControl. Received: "+cClassName+"."
        endif
        cFeature:=cClassName
    else
        cFeature:=vFeature
    endif
    lExistFeature:=__jWebExFeatures:HasProperty(cFeature)
    lExistFeature:=((lExistFeature).and.(__jWebExFeatures[cFeature]:GetMemberData("lLoaded")))
return(lExistFeature)

method EnableFeatures() class WebExControl
    if (!__lHasFeaturesEnabled)
        __lHasFeaturesEnabled:=.T.
        WebExFeatures():LoadAll(self)
    endif
return(__lHasFeaturesEnabled)

method DisableFeatures() class WebExControl
    local aWebExFeatures as array
    local oWebExFeature as object
    if (__lHasFeaturesEnabled)
        __lHasFeaturesEnabled:=.F.
        WebExFeatures():UnLoadAll()
        aWebExFeatures:=__jWebExFeatures:GetNames()
        aEval(;
            aWebExFeatures;
            ,{|cWebExFeature as character|;
                 oWebExFeature:=__jWebExFeatures[cWebExFeature];
                ,oWebExFeature:Unload();
                ,FreeObj(oWebExFeature);
                ,__jWebExFeatures:DelName(cWebExFeature);
            };
        )
        aSize(aWebExFeatures,0)
    endif
return(__lHasFeaturesEnabled)

method HasFeaturesEnabled() class WebExControl
return(__lHasFeaturesEnabled)

method DumpDOM(nLevel) class WebExControl

    local aAttr as array
    local aChildren as array

    local cDOM as character

    local cID as character
    local cKey as character
    local cAttr as character
    local cType as character
    local cPrefix as character
    local cContent as character

    local i as numeric
    local nAttr as numeric

    local oChild as object

    paramtype 1 var nLevel as numeric optional default 0

    // Prefixo de identacao
    cPrefix:=Replicate("   ",nLevel)+"+---> "
    // Tipo do componente
    cType:=::cType
    // Monta linha do componente atual
    cDOM:=cPrefix+cType

    // ID, se existir
    if (::jAttrs:HasProperty("id"))
        cID:=::jAttrs["id"]
    else
        cID:=::GetFixedID()
    endif

    // Atributos
    aAttr:=::jAttrs:GetNames()
    nAttr:=Len(aAttr)
    cAttr:=""
    for i:=1 to nAttr
        cKey:=aAttr[i]
        cAttr+="("+cKey+"="+::jAttrs[cKey]+")"
        if (i<nAttr)
            cAttr+=","
        endif
    next i
    FWFreeArray(@aAttr)
    if (Right(cAttr,1)=",")
        cAttr:=SubStr(cAttr,1,(Len(cAttr)-1))
    endif
    if (!Empty(cAttr))
        cDOM+=" [attr="+cAttr+"]"
    endif

    // Content
    cContent:=::GetContent()
    if (::ContentIsNull(cContent))
        cDOM+=" [content="+cContent+"]"
    endif

    cDOM+=__cCRLF

    // Varre os filhos
    aChildren:=::jChildren:GetNames()
    for i:=1 to Len(aChildren)
        cKey:=aChildren[i]
        if (::jChildren:HasProperty(cKey))
            oChild:=::jChildren[cKey]
            if (;
                    (valType(oChild)=="O");
                    .and.;
                    MethIsMemberOf(oChild,"ISKINDOF",.T.);
                    .and.;
                    oChild:IsKindOf("WEBEXCONTROL",.T.);
            )
               cDOM+=oChild:DumpDOM(nLevel+1)
            endif
        endif
    next i
    FWFreeArray(@aChildren)

return(cDOM)

method StrReplace(cTemplate,vSubstitutions) class WebExControl
return(WebExHelper():StrReplace(cTemplate,vSubstitutions))

function ___WebExControl____StrReplaceEx(cString as character,vSubstitutions as variadic) as character
return(WebExHelper():StrReplaceEx(cString,vSubstitutions))
