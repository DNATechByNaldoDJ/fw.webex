      <button type="button" data-action="redo" aria-label="Refazer">Refazer</button>
      <select data-role="zoom" aria-label="Zoom">
        <option value="fit">Ajustar</option><option value="1">100%</option>
        <option value="1.25">125%</option><option value="1.5">150%</option>
        <option value=".75">75%</option><option value=".5">50%</option>
