#include "fw.webex.th"

namespace FWWebEx

class WebExFeatureJsPDF from WebExControl
    protected data oFeature as object
    public method Enable(nPriority as numeric) as object
    public method Load(oControl as object,nPriority as numeric) as object
end class

class WebExFeatureJsPDFHTML from WebExControl
    protected data oFeature as object
    public method Enable(nPriority as numeric) as object
    public method Load(oControl as object,nPriority as numeric) as object
end class

method Enable(nPriority) class WebExFeatureJsPDF
    local oFeature as object
    paramtype 1 var nPriority as numeric optional default 30
    _Super:New()
    ::oFeature:=self
    oFeature:=::oFeature
    ::AddFeature(oFeature,{|oControl as object|oFeature:Load(oControl,nPriority)},nPriority)
return(self)

method Load(oControl,nPriority) class WebExFeatureJsPDF
    local cRuntime as character
    paramtype 1 var oControl as object
    paramtype 2 var nPriority as numeric optional default 30

    beginContent var cRuntime
(function(root){
    "use strict";
    const VERSION="4.2.1";
    function dependencyError(message,code){
        const error=new Error(message);
        error.name="FWWebExPDFDependencyError";
        error.code=code||"FWPDF_DEPENDENCY_MISSING";
        return error;
    }
    function constructor(){
        return root.jspdf&&root.jspdf.jsPDF;
    }
    const namespace=root.FWWebEx=root.FWWebEx||{};
    const api=namespace.PDF=namespace.PDF||{};
    if(api.__fwwebexJsPDFVersion&&api.__fwwebexJsPDFVersion!==VERSION)
        throw dependencyError(
            "FWWebEx.PDF ja foi inicializado com jsPDF "+
                api.__fwwebexJsPDFVersion+"; a feature solicitou "+VERSION+".",
            "FWPDF_VERSION_CONFLICT"
        );
    api.__fwwebexJsPDFVersion=VERSION;
    api.version=VERSION;
    api.isReady=function(){return typeof constructor()==="function";};
    api.getConstructor=function(){
        const PDF=constructor();
        if(!PDF)throw dependencyError("jsPDF "+VERSION+" nao esta disponivel.");
        return PDF;
    };
    api.whenReady=function(timeout){
        timeout=Number.isFinite(Number(timeout))?Math.max(0,Number(timeout)):10000;
        return new Promise(function(resolve,reject){
            const started=Date.now();
            (function check(){
                if(api.isReady()){resolve(api);return;}
                if(Date.now()-started>=timeout){
                    reject(dependencyError("jsPDF "+VERSION+" nao foi carregado no prazo esperado."));
                    return;
                }
                root.setTimeout(check,25);
            })();
        });
    };
    api.create=function(options){
        return new (api.getConstructor())(options||{});
    };
})(window);
    endContent

    WITH WEBEXOBJECT oControl
        WITH WEBEXOBJECT ::jObjectsContainer["script-jspdf"] CLASS WebExScript ARGS .F.
            .:SetAttr("src","https://cdn.jsdelivr.net/npm/jspdf@4.2.1/dist/jspdf.umd.min.js")
            .:AddInHeader(.this)
            .:SetPriority(nPriority)
        END WEBEXOBJECT NOADDCHILD
        WITH WEBEXOBJECT ::jObjectsContainer["script-jspdf-runtime"] CLASS WebExScript
            .:SetContent(cRuntime,.F.)
            .:AddInHeader(.this)
            .:SetPriority(nPriority+1)
        END WEBEXOBJECT NOADDCHILD
    END WEBEXOBJECT NOADDCHILD
return(self)

method Enable(nPriority) class WebExFeatureJsPDFHTML
    local oFeature as object
    paramtype 1 var nPriority as numeric optional default 32
    _Super:New()
    WebExFeatureJsPDF():Enable(nPriority-2)
    ::oFeature:=self
    oFeature:=::oFeature
    ::AddFeature(oFeature,{|oControl as object|oFeature:Load(oControl,nPriority)},nPriority)
return(self)

method Load(oControl,nPriority) class WebExFeatureJsPDFHTML
    local cRuntime as character
    paramtype 1 var oControl as object
    paramtype 2 var nPriority as numeric optional default 32

    beginContent var cRuntime
(function(root){
    "use strict";
    const namespace=root.FWWebEx=root.FWWebEx||{};
    const api=namespace.PDF=namespace.PDF||{};
    function dependencyError(message){
        const error=new Error(message);
        error.name="FWWebExPDFDependencyError";
        error.code="FWPDF_HTML_DEPENDENCY_MISSING";
        return error;
    }
    function renderError(cause){
        const message=cause&&cause.message?
            cause.message:"Falha desconhecida durante a renderizacao HTML.";
        const error=new Error("Nao foi possivel renderizar o HTML no PDF: "+message);
        error.name="FWWebExPDFRenderError";
        error.code="FWPDF_HTML_RENDER_FAILED";
        error.cause=cause;
        return error;
    }
    api.hasHTMLSupport=function(){
        return typeof api.create==="function"&&typeof root.html2canvas==="function"&&
            !!root.DOMPurify&&typeof root.DOMPurify.sanitize==="function";
    };
    api.whenHTMLReady=function(timeout){
        timeout=Number.isFinite(Number(timeout))?Math.max(0,Number(timeout)):10000;
        return new Promise(function(resolve,reject){
            const started=Date.now();
            (function check(){
                if(api.hasHTMLSupport()){resolve(api);return;}
                if(Date.now()-started>=timeout){
                    reject(dependencyError(
                        "html2canvas e DOMPurify nao foram carregados no prazo esperado."));
                    return;
                }
                root.setTimeout(check,25);
            })();
        });
    };
    api.renderElement=async function(source,options){
        options=options||{};
        if(source==null)throw renderError(new Error(
            "Informe um elemento DOM ou uma string HTML."));
        if(typeof api.whenReady==="function")
            await api.whenReady(options.timeout);
        await api.whenHTMLReady(options.timeout);
        if(options.sanitize!==false){
            if(typeof source==="string"){
                source=root.DOMPurify.sanitize(source,options.sanitizeOptions||{});
            }else if(source&&source.nodeType===1&&source.ownerDocument&&source.outerHTML){
                const host=source.ownerDocument.createElement("div");
                host.innerHTML=root.DOMPurify.sanitize(
                    source.outerHTML,options.sanitizeOptions||{});
                source=host.firstElementChild||host;
            }
        }
        let pdf;
        try{pdf=options.pdf||api.create(options.documentOptions);}
        catch(error){throw error;}
        const htmlOptions=Object.assign({},options.htmlOptions||{});
        const userCallback=htmlOptions.callback;
        return new Promise(function(resolve,reject){
            htmlOptions.callback=function(document){
                try{
                    if(typeof userCallback==="function")userCallback(document);
                    resolve(document);
                }catch(error){reject(renderError(error));}
            };
            try{
                const worker=pdf.html(source,htmlOptions);
                if(worker&&typeof worker.catch==="function")
                    worker.catch(function(error){reject(renderError(error));});
            }catch(error){reject(renderError(error));}
        });
    };
})(window);
    endContent

    WITH WEBEXOBJECT oControl
        WITH WEBEXOBJECT ::jObjectsContainer["script-dompurify"] CLASS WebExScript ARGS .F.
            .:SetAttr("src","https://cdn.jsdelivr.net/npm/dompurify@3.4.7/dist/purify.min.js")
            .:AddInHeader(.this)
            .:SetPriority(nPriority)
        END WEBEXOBJECT NOADDCHILD
        WITH WEBEXOBJECT ::jObjectsContainer["script-html2canvas"] CLASS WebExScript ARGS .F.
            .:SetAttr("src","https://cdn.jsdelivr.net/npm/html2canvas@1.4.1/dist/html2canvas.min.js")
            .:AddInHeader(.this)
            .:SetPriority(nPriority+1)
        END WEBEXOBJECT NOADDCHILD
        WITH WEBEXOBJECT ::jObjectsContainer["script-jspdf-html-runtime"] CLASS WebExScript
            .:SetContent(cRuntime,.F.)
            .:AddInHeader(.this)
            .:SetPriority(nPriority+2)
        END WEBEXOBJECT NOADDCHILD
    END WEBEXOBJECT NOADDCHILD
return(self)
