        }else if(command.indexOf("position-")===0){
            const direction=command.slice(9),vertical=direction==="above"||
                    direction==="below",positive=direction==="below"||direction==="right",
                cross=String(options.crossAlign||"start").toLowerCase(),
                gap=Math.max(0,finite(options.gap,0)),axis=vertical?"y":"x",
                ordered=geometric(targets(),axis,!positive);
            if(["start","center","end","stretch"].indexOf(cross)<0)
                throw new Error("FWWebEx Labels: alinhamento transversal invalido: "+cross+".");
            let cursor=vertical?(positive?reference.box.y+reference.box.height:
                reference.box.y):(positive?reference.box.x+reference.box.width:reference.box.x);
            ordered.forEach(function(item){
                const width=vertical&&cross==="stretch"?reference.box.width:item.box.width,
                    height=!vertical&&cross==="stretch"?reference.box.height:item.box.height,
                    mainSize=vertical?height:width;
                if(!movable(item)){
                    cursor+=positive?gap+mainSize:-(gap+mainSize);return;
                }
                resize(item,width,height);
                let x=item.box.x,y=item.box.y;
                if(vertical){
                    y=positive?cursor+gap:cursor-gap-item.box.height;
                    if(cross==="start"||cross==="stretch")x=reference.box.x;
                    if(cross==="center")x=reference.box.x+
                        (reference.box.width-item.box.width)/2;
                    if(cross==="end")x=reference.box.x+reference.box.width-item.box.width;
                    cursor=positive?y+item.box.height:y;
                }else{
                    x=positive?cursor+gap:cursor-gap-item.box.width;
                    if(cross==="start"||cross==="stretch")y=reference.box.y;
                    if(cross==="center")y=reference.box.y+
                        (reference.box.height-item.box.height)/2;
                    if(cross==="end")y=reference.box.y+reference.box.height-item.box.height;
                    cursor=positive?x+item.box.width:x;
                }
                translate(item,x,y);
            });
        }else{
            const horizontal=command==="distribute-horizontal",axis=horizontal?"x":"y",
                size=horizontal?"width":"height",participants=requested.slice();
            if(participants.indexOf(referenceId)<0)participants.push(referenceId);
            const ordered=geometric(participants.map(function(id){return graph.byId.get(id);})
                .filter(Boolean),axis,false);
            if(ordered.length<3)
                throw new Error("FWWebEx Labels: distribuicao requer ao menos tres elementos.");
            const start=ordered[0].box[axis],last=ordered[ordered.length-1],
                end=last.box[axis]+last.box[size],span=end-start,
                used=ordered.reduce(function(total,item){return total+item.box[size];},0),
                gap=(span-used)/(ordered.length-1),positions=new Map();
            let cursor=start;
            ordered.forEach(function(item){
                positions.set(item.id,cursor);cursor+=item.box[size]+gap;
            });
            const offset=reference.box[axis]-positions.get(referenceId);
            ordered.forEach(function(item){
                if(item.id===referenceId||!movable(item))return;
                translate(item,horizontal?positions.get(item.id)+offset:item.box.x,
                    horizontal?item.box.y:positions.get(item.id)+offset);
            });
        }
        const overflowIds=[];
        changed.forEach(function(id){
            const item=graph.byId.get(id);
            if(!item)return;
            const parent=item.containerId&&graph.byId.get(item.containerId),
                padding=parent&&parent.type==="container"?
                    normalizeInsets(parent.layout&&parent.layout.padding,0):
                    {top:0,right:0,bottom:0,left:0},
                bounds=parent&&parent.type==="container"?{
                    x:parent.box.x+padding.left,y:parent.box.y+padding.top,
                    width:Math.max(0,parent.box.width-padding.left-padding.right),
                    height:Math.max(0,parent.box.height-padding.top-padding.bottom)
                }:{x:0,y:0,width:finite(layout.page&&layout.page.width,0),
                    height:finite(layout.page&&layout.page.height,0)};
            if(item.box.x<bounds.x-epsilon||item.box.y<bounds.y-epsilon||
                item.box.x+item.box.width>bounds.x+bounds.width+epsilon||
                item.box.y+item.box.height>bounds.y+bounds.height+epsilon)
                overflowIds.push(id);
        });
        return {layout:layout,changedIds:Array.from(changed),skippedIds:skipped,
            overflowIds:overflowIds,referenceId:referenceId,command:command};
    }
    const SNAP_PRIORITIES={
        reference:1,container:2,"manual-guide":3,element:4,grid:5,page:6
    };
    function snapBaselineOffset(element,metric){
        if(!element||element.type!=="text"||finite(element.rotation,0)!==0)return null;
        if(metric&&metric.baselineOffset!==undefined&&metric.baselineOffset!==null&&
            Number.isFinite(Number(metric.baselineOffset)))
            return Number(metric.baselineOffset);
        if(String(element.template||"")==="")return null;
        const style=element.style||{},padding=normalizeInsets(style.padding,0),
            size=Math.max(.1,finite(metric&&metric.finalFontSize,
                finite(style.fontSize,10))),
            factor=Math.max(.5,finite(style.lineHeightFactor,1.15)),
            lineHeight=Math.max(.0001,finite(metric&&metric.lineHeight,
                size*.352778*factor)),
            lineCount=Math.max(1,Math.floor(finite(metric&&metric.lineCount,1))),
            contentHeight=lineCount*lineHeight,
            contentHeightAvailable=Math.max(0,finite(element.box&&element.box.height,0)-
                padding.top-padding.bottom);
        let offset=padding.top+size*.352778;
        if(style.verticalAlign==="middle")
            offset+=(contentHeightAvailable-contentHeight)/2;
        if(style.verticalAlign==="bottom")
            offset+=contentHeightAvailable-contentHeight;
        return offset;
    }
    function resolveSnap(layout,request){
        layout=layout&&typeof layout==="object"?layout:{};request=request||{};
        const page=layout.page||{},editor=layout.editor||{},snap=editor.snap||{},
            grid=editor.grid||{},elements=Array.isArray(layout.elements)?layout.elements:[],
            byId=new Map(elements.map(function(element){return [element.id,element];})),
            item=byId.get(String(request.elementId||"")),
            raw={x:finite(request.position&&request.position.x,0),
                y:finite(request.position&&request.position.y,0)},
            empty={x:raw.x,y:raw.y,position:{x:raw.x,y:raw.y},
                winners:{x:null,y:null},latch:{x:null,y:null}};
        if(!item||request.disabled===true)return empty;
        const pixelsPerMm=Math.max(.0001,finite(request.pixelsPerMm,1)),
            tolerancePx=Math.max(0,finite(request.tolerancePx,
                finite(snap.tolerancePx,8))),
            hysteresisFactor=Math.max(1,finite(request.hysteresisFactor,1.5)),
            exclude=new Set((Array.isArray(request.excludeIds)?request.excludeIds:[])
                .map(String).concat([String(item.id)])),
            metrics=request.metricsById&&typeof request.metricsById==="object"?
                request.metricsById:{},
            candidates={x:[],y:[]},sequence={value:0};
        function anchors(element,box,metric){
            box=box||element.box||{x:0,y:0,width:0,height:0};
            const width=Math.max(0,finite(box.width,0)),height=Math.max(0,finite(box.height,0)),
                result={
                    x:[{name:"left",offset:0,value:finite(box.x,0)},
                        {name:"center",offset:width/2,value:finite(box.x,0)+width/2},
                        {name:"right",offset:width,value:finite(box.x,0)+width}],
                    y:[{name:"top",offset:0,value:finite(box.y,0)},
                        {name:"middle",offset:height/2,value:finite(box.y,0)+height/2},
                        {name:"bottom",offset:height,value:finite(box.y,0)+height}]
                },baseline=snapBaselineOffset(element,metric);
            if(baseline!==null)result.y.push({name:"baseline",offset:baseline,
                value:finite(box.y,0)+baseline});
            return result;
        }
        const moving=anchors(item,{x:raw.x,y:raw.y,
            width:item.box.width,height:item.box.height},metrics[item.id]);
        function add(axis,origin,sourceId,movingAnchor,targetAnchor,targetMm,
            coordinateMm,label,always){
            const deltaMm=coordinateMm-raw[axis],distancePx=Math.abs(deltaMm)*pixelsPerMm;
            candidates[axis].push({
                key:[origin,sourceId||"",axis,movingAnchor,targetAnchor,
                    Number(targetMm).toFixed(6)].join(":"),
                axis:axis,source:origin,origin:origin,sourceId:sourceId||null,
                priority:SNAP_PRIORITIES[origin],movingAnchor:movingAnchor,
                targetAnchor:targetAnchor,targetMm:targetMm,coordinateMm:coordinateMm,
                deltaMm:deltaMm,distanceMm:Math.abs(deltaMm),distancePx:distancePx,
                label:label||sourceId||origin,always:always===true,sequence:sequence.value++
            });
        }
        function addSameAnchors(source,box,origin,label){
            if(!source)return;
            const target=anchors(source,box,metrics[source.id]);
            ["x","y"].forEach(function(axis){
                target[axis].forEach(function(targetAnchor){
                    const movingAnchor=moving[axis].find(function(anchor){
                        return anchor.name===targetAnchor.name;
                    });
                    if(!movingAnchor)return;
                    add(axis,origin,source.id,movingAnchor.name,targetAnchor.name,
                        targetAnchor.value,targetAnchor.value-movingAnchor.offset,label,false);
                });
            });
        }
        if(snap.enabled===true){
            const reference=byId.get(String(snap.referenceElementId||""));
            if(reference&&!exclude.has(String(reference.id))&&reference.hidden!==true)
                addSameAnchors(reference,reference.box,"reference",
                    reference.name||reference.id);
            const parent=byId.get(String(item.containerId||""));
            if(parent&&parent.type==="container"&&!exclude.has(String(parent.id))){
                const padding=normalizeInsets(parent.layout&&parent.layout.padding,0),
                    box={x:parent.box.x+padding.left,y:parent.box.y+padding.top,
                        width:Math.max(0,parent.box.width-padding.left-padding.right),
                        height:Math.max(0,parent.box.height-padding.top-padding.bottom)};
                addSameAnchors(parent,box,"container",parent.name||parent.id);
            }
            (Array.isArray(editor.guides)?editor.guides:[]).forEach(function(guide,index){
                if(!guide||!Number.isFinite(Number(guide.position)))return;
                const axis=guide.axis==="x"||guide.axis==="vertical"?"x":
                    guide.axis==="y"||guide.axis==="horizontal"?"y":null;
                if(!axis)return;
                const position=Number(guide.position),id=String(guide.id||index),
                    label=guide.name||guide.label||("Guia "+(index+1));
                moving[axis].forEach(function(anchor){
                    add(axis,"manual-guide",id,anchor.name,"guide",position,
                        position-anchor.offset,label,false);
                });
            });
            const referenceId=String(snap.referenceElementId||""),
                parentId=String(item.containerId||"");
            elements.forEach(function(source){
                if(source.hidden===true||exclude.has(String(source.id))||
                    String(source.id)===referenceId||String(source.id)===parentId)return;
                addSameAnchors(source,source.box,"element",source.name||source.id);
            });
        }
        if(grid.enabled===true){
            const step=Math.max(.01,finite(grid.step,1)),gridX=Math.round(raw.x/step)*step,
                gridY=Math.round(raw.y/step)*step;
            add("x","grid","grid","left","grid",gridX,gridX,"Grid",true);
            add("y","grid","grid","top","grid",gridY,gridY,"Grid",true);
        }
        if(snap.enabled===true){
            const width=Math.max(0,finite(page.width,0)),height=Math.max(0,finite(page.height,0)),
                margins=normalizeInsets(page.margins,0),safe=Math.max(0,finite(page.safeArea,0));
            [
                ["x",0,"left","page-left"],["x",width/2,"center","page-center"],
                ["x",width,"right","page-right"],
                ["x",margins.left,"left","margin-left"],
                ["x",width-margins.right,"right","margin-right"],
                ["x",margins.left+safe,"left","safe-left"],
                ["x",width-margins.right-safe,"right","safe-right"],
                ["y",0,"top","page-top"],["y",height/2,"middle","page-middle"],
                ["y",height,"bottom","page-bottom"],
                ["y",margins.top,"top","margin-top"],
                ["y",height-margins.bottom,"bottom","margin-bottom"],
                ["y",margins.top+safe,"top","safe-top"],
                ["y",height-margins.bottom-safe,"bottom","safe-bottom"]
            ].forEach(function(entry){
                const axis=entry[0],target=entry[1],anchorName=entry[2],
                    movingAnchor=moving[axis].find(function(anchor){
                        return anchor.name===anchorName;
                    });
                if(movingAnchor)add(axis,"page","page",anchorName,entry[3],target,
                    target-movingAnchor.offset,"Pagina",false);
            });
        }
        function rank(list){
            return list.slice().sort(function(a,b){
                return a.priority-b.priority||a.distancePx-b.distancePx||
                    a.sequence-b.sequence;
            })[0]||null;
        }
        function select(axis){
            const list=candidates[axis],previous=request.latch&&request.latch[axis],
                previousKey=typeof previous==="string"?previous:previous&&previous.key;
            let latched=previousKey&&list.find(function(candidate){
                return candidate.key===previousKey;
            });
            if(!latched&&previous&&typeof previous==="object"&&
                Number.isFinite(Number(previous.targetMm))){
                const movingAnchor=moving[axis].find(function(anchor){
                    return anchor.name===previous.movingAnchor;
                });
                if(movingAnchor){
                    const coordinate=Number(previous.targetMm)-movingAnchor.offset;
                    latched=Object.assign({},previous,{coordinateMm:coordinate,
                        deltaMm:coordinate-raw[axis],distanceMm:Math.abs(coordinate-raw[axis]),
                        distancePx:Math.abs(coordinate-raw[axis])*pixelsPerMm});
                }
            }
            const eligible=list.filter(function(candidate){
                return candidate.always||candidate.distancePx<=tolerancePx+1e-9;
            });
            if(latched&&(latched.always||
                latched.distancePx<=tolerancePx*hysteresisFactor+1e-9)){
                const higher=rank(eligible.filter(function(candidate){
                    return candidate.priority<latched.priority;
                }));
                return higher||latched;
            }
            return rank(eligible);
        }
        const winnerX=select("x"),winnerY=select("y"),result={
            x:winnerX?winnerX.coordinateMm:raw.x,
            y:winnerY?winnerY.coordinateMm:raw.y,
            winners:{x:winnerX,y:winnerY},latch:{x:winnerX,y:winnerY}
        };
        result.position={x:result.x,y:result.y};
        return result;
    }
    function pageRotationGeometry(rotation,width,height){
        rotation=finite(rotation,0);
        rotation=((rotation%360)+360)%360;
        if([0,90,180,270].indexOf(rotation)<0)rotation=0;
        width=Math.max(0,finite(width,0));height=Math.max(0,finite(height,0));
        let matrix,pageWidth=width,pageHeight=height;
        if(rotation===90){
            matrix=[0,1,-1,0,height,0];pageWidth=height;pageHeight=width;
        }else if(rotation===180){
            matrix=[-1,0,0,-1,width,height];
        }else if(rotation===270){
            matrix=[0,-1,1,0,0,width];pageWidth=height;pageHeight=width;
        }else matrix=[1,0,0,1,0,0];
        return {
            rotation:rotation,sourceWidth:width,sourceHeight:height,
            width:pageWidth,height:pageHeight,pageWidth:pageWidth,pageHeight:pageHeight,
            matrix:matrix
        };
    }
    function pageTransform(page,rotation){
        page=page&&typeof page==="object"?page:{};
        return pageRotationGeometry(defined(rotation,page.rotation),page.width,page.height);
    }
    function transformPoint(matrix,point){
        matrix=matrix||[1,0,0,1,0,0];point=point||{};
        const x=finite(point.x,0),y=finite(point.y,0);
        return {
            x:matrix[0]*x+matrix[2]*y+matrix[4],
            y:matrix[1]*x+matrix[3]*y+matrix[5]
        };
    }
    function invertMatrix(matrix){
        matrix=matrix||[1,0,0,1,0,0];
        const determinant=matrix[0]*matrix[3]-matrix[1]*matrix[2];
        if(Math.abs(determinant)<1e-12)
            throw new Error("A matriz de transformacao da pagina nao e inversivel.");
        return [
            matrix[3]/determinant,-matrix[1]/determinant,
            -matrix[2]/determinant,matrix[0]/determinant,
            (matrix[2]*matrix[5]-matrix[3]*matrix[4])/determinant,
            (matrix[1]*matrix[4]-matrix[0]*matrix[5])/determinant
        ];
    }
    function pageRotationMatrix(pdf,rotation,width,height){
        const matrix=pageRotationGeometry(rotation,width,height).matrix;
        return new pdf.Matrix(matrix[0],matrix[1],matrix[2],matrix[3],matrix[4],matrix[5]);
    }
    function elementRotationMatrix(pdf,angle,box){
        const radians=angle*Math.PI/180,c=Math.cos(radians),s=Math.sin(radians);
        const cx=box.x+box.width/2,cy=box.y+box.height/2;
        return new pdf.Matrix(c,s,-s,c,cx-c*cx+s*cy,cy-s*cx-c*cy);
    }
    function prepareBackground(pdf,layout){
        const background=layout.background;
        if(!background||!background.dataUrl)return null;
        const sourceW=layout.page.width,sourceH=layout.page.height;
        const mime=/^data:image\/(png|jpe?g|webp);/i.exec(background.dataUrl);
        if(!mime)throw engineError(issue("BACKGROUND_DATA_URI_INVALID","error","/background/dataUrl",
            "O background deve ser uma imagem PNG, JPEG ou WEBP em Data URI.",
            "Reimporte a imagem de fundo.","",null,"background"));
        const format=mime[1].toLowerCase()==="png"?"PNG":
            mime[1].toLowerCase()==="webp"?"WEBP":"JPEG";
        let properties;
        try{properties=pdf.getImageProperties(background.dataUrl);}
        catch(error){
            throw engineError(issue("BACKGROUND_IMAGE_INVALID","error","/background/dataUrl",
                "Nao foi possivel ler a imagem de fundo.",
                "Reimporte uma imagem valida.","",null,"background",
                {cause:error&&error.message?error.message:String(error)}));
        }
        const imageW=finite(properties.width,sourceW),imageH=finite(properties.height,sourceH);
        let x=0,y=0,width=sourceW,height=sourceH,clip=false;
        if(background.fit==="contain"||background.fit==="cover"){
            const scale=background.fit==="contain"?Math.min(sourceW/imageW,sourceH/imageH):
                Math.max(sourceW/imageW,sourceH/imageH);
            width=imageW*scale;height=imageH*scale;x=(sourceW-width)/2;y=(sourceH-height)/2;
            clip=background.fit==="cover";
        }
        return {dataUrl:background.dataUrl,format:format,x:x,y:y,width:width,height:height,
            clip:clip,opacity:Math.min(1,Math.max(0,finite(background.opacity,1)))};
    }
    function prepareRenderPlan(pdf,layout,records){
        const issues=[],pages=[],metrics={records:[]},indexes=new Map();
        layout.elements.forEach(function(element,index){indexes.set(element,index);});
        const elementsById=new Map(layout.elements.map(function(element){
            return [element.id,element];
        }));
        function clipBoxes(element){
            const boxes=[],visited=new Set();let parent=elementsById.get(element.containerId);
            while(parent&&parent.type==="container"&&!visited.has(parent.id)){
                visited.add(parent.id);
                if(parent.layout.clipChildren===true||parent.layout.overflow==="clip")
                    boxes.unshift(clone(parent.box));
                parent=elementsById.get(parent.containerId);
            }
            return boxes;
        }
        const ordered=layout.elements.slice().sort(function(a,b){
            return a.zIndex===b.zIndex?indexes.get(a)-indexes.get(b):a.zIndex-b.zIndex;
        });
        let background=null;
        try{background=prepareBackground(pdf,layout);}
        catch(error){
            if(error.issue)issues.push(error.issue);
            else issues.push(issue("BACKGROUND_PREPARE_FAILED","error","/background",
                error.message||"Falha ao preparar background.","Revise a imagem de fundo.",
                null,null,"background"));
        }
        records.forEach(function(record,recordIndex){
            let data;
            try{data=prepareData(layout,record);}
            catch(error){
                const failures=error.issues||[issue(error.code||"DATA_PREPARE_FAILED","error","",
                    error.message||"Falha ao preparar dados.","Revise os dados e defaults.",
                    null,recordIndex,"data")];
                Array.prototype.push.apply(issues,failures);return;
            }
            const page={recordIndex:recordIndex,data:data,elements:[],background:background};
            const recordMetrics={elements:{}};
            ordered.forEach(function(element){
                if(element.type==="container"||element.hidden)return;
                const index=indexes.get(element),path=pointer("elements",index);
                const text=value(element.template,data),box=element.box;
                try{
                    if(element.type==="text"){
                        pdf.setTextColor("#000000");pdf.setFont("helvetica","normal");pdf.setFontSize(10);
                        if(typeof pdf.setCharSpace==="function")pdf.setCharSpace(0);
                        const font=resolvePDFFont(pdf,element.style.fontFamily,
                            element.style.fontStyle);
                        pdf.setFont(font.family,font.style);
                        if(typeof pdf.setCharSpace==="function")
                            pdf.setCharSpace(finite(element.style.letterSpacing,0));
                        const fitted=fitText(pdf,text,element,path,recordIndex);
                        page.elements.push({element:element,text:text,fitted:fitted,font:font,
                            clipBoxes:clipBoxes(element)});
                        recordMetrics.elements[element.id]=clone(fitted.metrics);
                        recordMetrics.elements[element.id].font={
                            requestedFamily:font.requestedFamily,requestedStyle:font.requestedStyle,
                            family:font.family,style:font.style,fallback:font.fallback};
                        if(font.fallback)issues.push(issue("FONT_FALLBACK_USED","warning",
                            path+"/style/fontFamily",
                            "A fonte solicitada nao esta disponivel no jsPDF e recebeu fallback.",
                            "Registre a fonte no jsPDF ou escolha uma fonte disponivel.",
                            element.id,recordIndex,"text",clone(recordMetrics.elements[element.id].font)));
                        if(fitted.overflowed)issues.push(issue("TEXT_OVERFLOW_APPLIED","warning",
                            path+"/fit/overflow",
                            "O texto excedeu a area e recebeu a politica "+element.fit.overflow+".",
                            "Confira o preview de impressao.",element.id,recordIndex,"text",
                            clone(fitted.metrics)));
                    }else if(element.type==="barcode"){
                        const quiet=Math.max(0,finite(element.quietZone,0));
                        const available=box.width-quiet*2;
                        if(!(available>0))throw engineError(issue("BARCODE_CONTENT_BOX_INVALID","error",
                            path+"/quietZone","A zona silenciosa eliminou a largura util do barcode.",
                            "Aumente a caixa ou reduza quietZone.",element.id,recordIndex,"barcode",
                            {boxWidth:box.width,quietZone:quiet,availableWidth:available}));
                        let rendered=barcode(text,element,available,box.height,layout,path,recordIndex);
                        rendered=fitBarcodeText(pdf,rendered,element,available,box.height,path,recordIndex);
                        page.elements.push({element:element,text:text,barcode:rendered,
                            quietZone:quiet,availableWidth:available,
                            clipBoxes:clipBoxes(element)});
                        recordMetrics.elements[element.id]={format:rendered.format,
                            moduleCount:rendered.moduleCount,moduleWidth:rendered.moduleWidth,
                            minModuleWidth:element.minModuleWidth,barsHeight:rendered.barsHeight,
                            humanReadableFontSize:rendered.textSize,textMargin:rendered.textMargin,
                            inputValue:rendered.inputValue,encodedDisplayText:rendered.value};
                        if(rendered.moduleBelowMinimum)
                            issues.push(issue("BARCODE_MODULE_TOO_NARROW_ALLOWED","warning",
                                path+"/overflow",
                                "A largura do modulo ficou abaixo do minimo configurado.",
                                "Aumente a caixa, reduza minModuleWidth ou use overflow error para bloquear.",
                                element.id,recordIndex,"barcode",
                                {format:rendered.format,value:rendered.inputValue,
                                    moduleCount:rendered.moduleCount,
                                    moduleWidth:rendered.moduleWidth,
                                    minModuleWidth:element.minModuleWidth,
                                    requiredWidth:rendered.requiredWidth,
                                    availableWidth:available}));
                        if(rendered.fontFallback)
                            issues.push(issue("FONT_FALLBACK_USED","warning",
                                path+"/humanReadableFontFamily",
                                "A fonte do texto legivel do barcode recebeu fallback.",
                                "Registre a fonte no jsPDF ou escolha uma fonte disponivel.",
                                element.id,recordIndex,"barcode",clone(rendered.fontFallback)));
                        if(rendered.textWidth>available+0.0001)
                            issues.push(issue("BARCODE_TEXT_OVERFLOW_APPLIED","warning",
                                path+"/textOverflow",
                                "O texto legivel excedeu a largura e recebeu a politica "+
                                    element.textOverflow+".","Confira o preview de impressao.",
                                element.id,recordIndex,"barcode",clone(recordMetrics.elements[element.id])));
                    }
                }catch(error){
                    if(error.issue)issues.push(error.issue);
                    else issues.push(issue("ELEMENT_PREPARE_FAILED","error",path,
                        error.message||"Falha ao preparar elemento.",
                        "Revise as propriedades do elemento.",element.id,recordIndex,"renderer",
                        {cause:error&&error.stack?error.stack:String(error)}));
                }
            });
            metrics.records[recordIndex]=recordMetrics;pages.push(page);
        });
        return {pages:pages,issues:issues,metrics:metrics};
    }
    function resetGraphicsState(pdf){
        pdf.setTextColor("#000000");pdf.setDrawColor("#000000");pdf.setFillColor("#ffffff");
        pdf.setFont("helvetica","normal");pdf.setFontSize(10);
        if(typeof pdf.setCharSpace==="function")pdf.setCharSpace(0);
        if(typeof pdf.setLineWidth==="function")pdf.setLineWidth(0.2);
    }
    function applyClip(pdf,box){
        if(typeof pdf.clip!=="function")return;
        pdf.rect(box.x,box.y,box.width,box.height);
        pdf.clip();
        if(typeof pdf.discardPath==="function")pdf.discardPath();
    }
    function setPDFColor(pdf,method,color,fallback){
        try{pdf[method](color||fallback);}
        catch(error){pdf[method](fallback);}
    }
    function renderBarcodeBars(pdf,rendered,x,y,width,height){
        const encodings=rendered.encodings||[];
        const maximumHeight=Math.max.apply(Math,encodings.map(function(encoding){
            return encoding.height;
        }).concat([1]));
        let moduleOffset=0;
        encodings.forEach(function(encoding){
            const data=encoding.data,segmentHeight=height*(encoding.height/maximumHeight);
            setPDFColor(pdf,"setFillColor",encoding.lineColor||rendered.lineColor,"#000000");
            let index=0;
            while(index<data.length){
                const value=Number(data.charAt(index));
                if(!(value>0)){index++;continue;}
                let end=index+1;
                while(end<data.length&&data.charAt(end)===data.charAt(index))end++;
                pdf.rect(x+(moduleOffset+index)*rendered.moduleWidth,y,
                    (end-index)*rendered.moduleWidth,segmentHeight*value,"F");
                index=end;
            }
            moduleOffset+=data.length;
        });
    }
    function renderPreparedPage(pdf,layout,page){
        const background=page.background;
        if(background){
            pdf.saveGraphicsState();
            try{
                if(background.opacity<1&&pdf.GState&&typeof pdf.setGState==="function")
                    pdf.setGState(new pdf.GState({opacity:background.opacity}));
                if(background.clip)applyClip(pdf,{x:0,y:0,width:layout.page.width,height:layout.page.height});
                pdf.addImage(background.dataUrl,background.format,background.x,background.y,
                    background.width,background.height,undefined,"FAST");
            }finally{pdf.restoreGraphicsState();}
        }
        page.elements.forEach(function(entry){
            const element=entry.element,box=element.box,angle=finite(element.rotation,0);
            pdf.saveGraphicsState();
            try{
                resetGraphicsState(pdf);
                (entry.clipBoxes||[]).forEach(function(clipBox){applyClip(pdf,clipBox);});
                if(angle%360!==0)pdf.setCurrentTransformationMatrix(
                    elementRotationMatrix(pdf,angle,box));
                if(entry.barcode){
                    const rendered=entry.barcode;
                    const contentX=box.x+entry.quietZone;
                    if(rendered.background&&rendered.background!=="transparent"&&
                        rendered.background!=="none"){
                        setPDFColor(pdf,"setFillColor",rendered.background,"#ffffff");
                        pdf.rect(box.x,box.y,box.width,box.height,"F");
                    }
                    const textOnTop=rendered.textPosition==="top";
                    const barsY=box.y+(textOnTop?rendered.textHeight+rendered.textMargin:0);
                    renderBarcodeBars(pdf,rendered,contentX,barsY,
                        entry.availableWidth,rendered.barsHeight);
                    if(element.displayValue!==false&&rendered.displayText){
                        pdf.setFont(rendered.textFontFamily,rendered.textFontStyle);
                        pdf.setFontSize(rendered.textSize);
                        setPDFColor(pdf,"setTextColor",rendered.textColor,"#000000");
                        if(element.textOverflow==="clip"&&rendered.textWidth>entry.availableWidth)
                            applyClip(pdf,{x:contentX,y:textOnTop?box.y:
                                box.y+rendered.barsHeight,width:entry.availableWidth,
                                height:rendered.textHeight+rendered.textMargin});
                        let textX=contentX;
                        if(rendered.textAlign==="center")textX+=entry.availableWidth/2;
                        if(rendered.textAlign==="right")textX+=entry.availableWidth;
                        const textY=textOnTop?box.y+rendered.textHeight*0.82:
                            box.y+rendered.barsHeight+rendered.textMargin+
                                rendered.textHeight*0.82;
                        pdf.text(rendered.displayText,textX,textY,{align:rendered.textAlign});
                    }
                    return;
                }
                const style=element.style,fitted=entry.fitted,content=fitted.contentBox;
                pdf.setFont(entry.font.family,entry.font.style);
                pdf.setTextColor(style.color||"#000000");pdf.setFontSize(fitted.size);
                if(typeof pdf.setCharSpace==="function")
                    pdf.setCharSpace(finite(style.letterSpacing,0));
                if(!fitted.lines.length)return;
                if(fitted.overflowed&&element.fit.overflow==="clip")applyClip(pdf,content);
                let y=fitted.metrics&&Number.isFinite(fitted.metrics.baselineY)?
                    fitted.metrics.baselineY:content.y+fitted.size*0.352778;
                let x=content.x;
                if(style.align==="center")x=content.x+content.width/2;
                if(style.align==="right")x=content.x+content.width;
                const textOptions=Object.assign({},element.textOptions||{},{
                    align:style.align,lineHeightFactor:style.lineHeightFactor});
                delete textOptions.angle;
                if(style.align==="justify")textOptions.maxWidth=content.width;
                pdf.text(fitted.lines,x,y,textOptions);
            }finally{pdf.restoreGraphicsState();}
        });
    }
    function combinedReport(layout,records,baseIssues,plan){
        const issues=[],seen=new Set();
        [baseIssues,plan?plan.issues:[]].forEach(function(group){
            (group||[]).forEach(function(item){
                const key=[item.code,item.severity,item.path,item.elementId,
                    item.recordIndex,item.phase,item.message].join("|");
                if(!seen.has(key)){seen.add(key);issues.push(item);}
            });
        });
        const errors=issues.filter(function(item){return item.severity==="error";});
        return {valid:!errors.length,issues:issues,errors:errors,
            warnings:issues.filter(function(item){return item.severity==="warning";}),
            layout:layout,records:records,metrics:plan?plan.metrics:{}};
    }
    async function generate(layout,records,options){
        options=options||{};
        const resolved=resolveLayout(layout,records,{requireRecord:true});
        layout=resolved.layout;records=resolved.records;
        let report=resolved.report;
        const requestedRotation=options.rotation!=null?Number(options.rotation):layout.page.rotation;
        const rotation=((requestedRotation%360)+360)%360;
        if(!Number.isFinite(requestedRotation)||[0,90,180,270].indexOf(rotation)<0){
            const problem=issue("PAGE_ROTATION_INVALID","error","/page/rotation",
                "Rotacao deve ser 0, 90, 180 ou 270.","Escolha uma rotacao ortogonal.");
            throw validationError(combinedReport(layout,records,[problem],null));
        }
        const swap=rotation===90||rotation===270,sourceW=layout.page.width,sourceH=layout.page.height;
        const pageW=swap?sourceH:sourceW,pageH=swap?sourceW:sourceH;
        const PDFService=window.FWWebEx&&window.FWWebEx.PDF;
        if(!PDFService){
            const dependencyError=new Error("WebExFeatureJsPDF nao foi carregada.");
            dependencyError.name="FWWebExPDFDependencyError";
            dependencyError.code="FWPDF_DEPENDENCY_MISSING";
            throw dependencyError;
        }
        if(typeof PDFService.whenReady==="function")
            await PDFService.whenReady(options.dependencyTimeout);
        else if(typeof PDFService.isReady!=="function"||!PDFService.isReady()){
            const dependencyError=new Error("jsPDF ainda nao esta disponivel.");
            dependencyError.name="FWWebExPDFDependencyError";
            dependencyError.code="FWPDF_DEPENDENCY_MISSING";
            throw dependencyError;
        }
        const pdf=PDFService.create({unit:"mm",format:[pageW,pageH],
            orientation:pageW>pageH?"landscape":"portrait",
            compress:true,putOnlyUsedFonts:true});
        const plan=prepareRenderPlan(pdf,layout,records);
        report=combinedReport(layout,records,report.issues,plan);
        if(!report.valid)throw validationError(report);
        for(let pageIndex=0;pageIndex<plan.pages.length;pageIndex++){
            if(pageIndex)pdf.addPage([pageW,pageH],pageW>pageH?"landscape":"portrait");
            let renderFailure=null;
            pdf.advancedAPI(function(document){
                document.saveGraphicsState();
                try{
                    if(rotation!==0)document.setCurrentTransformationMatrix(
                        pageRotationMatrix(document,rotation,sourceW,sourceH));
                    renderPreparedPage(document,layout,plan.pages[pageIndex]);
                }catch(error){renderFailure=error;}
                finally{document.restoreGraphicsState();}
            });
            if(renderFailure){
                const failures=renderFailure.issues||[issue(renderFailure.code||"RENDER_FAILED",
                    "error","",renderFailure.message||"Falha ao renderizar PDF.",
                    "Revise o contrato e os dados.",null,pageIndex,"renderer")];
                throw validationError(combinedReport(layout,records,report.issues.concat(failures),null));
            }
        }
        pdf.__fwwebexLabelReport=report;
        if(options.autoPrint===true)pdf.autoPrint();
        let output=pdf;
        if(options.output==="blob")output=pdf.output("blob");
        else if(options.output==="datauristring")output=pdf.output("datauristring");
        else if(options.output==="arraybuffer")output=pdf.output("arraybuffer");
        else if(options.output==="none")output=null;
        else if(options.output!=="pdf")pdf.save(options.fileName||((layout.name||"rotulos")+".pdf"));
        if(options.returnResult===true||options.output==="none")
            return {pdf:pdf,output:output,report:report,layout:layout};
        return output;
    }
    window.FWWebExLabels=window.FWWebExLabels||{};
    window.FWWebExLabels.contract=window.FWWebExLabels.contract||{};
    window.FWWebExLabels.renderer=window.FWWebExLabels.renderer||{};
    window.FWWebExLabels.layout=window.FWWebExLabels.layout||{};
    window.FWWebExLabels.geometry=window.FWWebExLabels.geometry||{};
    window.FWWebExLabels.snap=window.FWWebExLabels.snap||{};
    window.FWWebExLabels.contract.normalize=normalizeLayout;
    window.FWWebExLabels.contract.serialize=serializeLayout;
    window.FWWebExLabels.contract.validate=validateContract;
    window.FWWebExLabels.contract.createSampleRecords=createSampleRecords;
    window.FWWebExLabels.renderer.generate=generate;
    window.FWWebExLabels.layout.resolve=resolveLayout;
    window.FWWebExLabels.layout.reflow=resolveLayout;
    window.FWWebExLabels.layout.assign=graphAssign;
    window.FWWebExLabels.layout.duplicate=graphDuplicate;
    window.FWWebExLabels.layout.remove=graphRemove;
    window.FWWebExLabels.layout.translate=graphTranslate;
    window.FWWebExLabels.layout.arrange=graphArrange;
    window.FWWebExLabels.layout.align=function(layout,ids,options){
        return graphArrange(layout,ids,Object.assign({operation:"align"},options||{}));
    };
    window.FWWebExLabels.layout.position=function(layout,ids,options){
        return graphArrange(layout,ids,Object.assign({operation:"position"},options||{}));
    };
    window.FWWebExLabels.layout.distribute=function(layout,ids,options){
        return graphArrange(layout,ids,Object.assign({operation:"distribute"},options||{}));
    };
    window.FWWebExLabels.layout.matchSize=function(layout,ids,options){
        return graphArrange(layout,ids,Object.assign({operation:"match-size"},options||{}));
    };
    window.FWWebExLabels.geometry.pageRotationGeometry=pageRotationGeometry;
    window.FWWebExLabels.geometry.pageTransform=pageTransform;
    window.FWWebExLabels.geometry.transformPoint=transformPoint;
    window.FWWebExLabels.geometry.invertMatrix=invertMatrix;
    window.FWWebExLabels.snap.resolve=resolveSnap;
    window.FWWebExLabels.snap.priorities=clone(SNAP_PRIORITIES);
    window.FWWebExLabels.snap.textBaselineOffset=snapBaselineOffset;
    window.FWWebExLabels.layoutEngine=window.FWWebExLabels.layout;
    window.FWWebExLabels.generate=generate;
})();
    endContent
    WITH WEBEXOBJECT oControl
        WITH WEBEXOBJECT ::jObjectsContainer["script-jsbarcode"] CLASS WebExScript ARGS .F.
            .:SetContent("https://cdn.jsdelivr.net/npm/jsbarcode@3.11.6/dist/JsBarcode.all.min.js")
            .:AddInHeader(.this)
            .:SetPriority(35)
        END WEBEXOBJECT NOADDCHILD
        WITH WEBEXOBJECT ::jObjectsContainer["style-fwwebex-labels"] CLASS WebExStyle
            .:SetContent(cStyle)
            .:AddInHeader(.this)
            .:SetPriority(36)
        END WEBEXOBJECT NOADDCHILD
        WITH WEBEXOBJECT ::jObjectsContainer["script-fwwebex-labels-runtime"] CLASS WebExScript
            .:SetContent(cRuntime,.F.)
            .:AddInHeader(.this)
            .:SetPriority(37)
        END WEBEXOBJECT NOADDCHILD
    END WEBEXOBJECT NOADDCHILD
return(self)

method New(nLabelWidth,nLabelHeight) class WebExLabelDesigner
    paramtype 1 var nLabelWidth as numeric optional default 100
    paramtype 2 var nLabelHeight as numeric optional default 60
    WebExFeatureLabels():Enable()
    WebExFeaturePDFJS():Enable(38)
    _Super:New()
    ::nLabelWidth:=nLabelWidth
    ::nLabelHeight:=nLabelHeight
    ::cInitialLayout:=""
    ::cInitialRecords:="[]"
    ::cDesignerOptions:="{}"
    ::oDesignerScript:=WebExScript():New()
    ::AddClass("fwwebex-label-designer")
return(self)

method SetLayout(xLayout) class WebExLabelDesigner
    paramtype 1 var xLayout as character,json
    if (ValType(xLayout)=="J")
        ::cInitialLayout:=xLayout:ToJSON()
    else
        ::cInitialLayout:=xLayout
    endif
return(self)

method SetRecords(xRecords) class WebExLabelDesigner
    paramtype 1 var xRecords as array,character,json
    do case
    case ValType(xRecords)=="C"
        ::cInitialRecords:=xRecords
    case ValType(xRecords)=="J"
        ::cInitialRecords:=xRecords:ToJSON()
    otherwise
        ::cInitialRecords:=FWJsonSerialize(xRecords)
    endcase
return(self)

method SetOptions(xOptions) class WebExLabelDesigner
    paramtype 1 var xOptions as character,json
    if (ValType(xOptions)=="J")
        ::cDesignerOptions:=xOptions:ToJSON()
    else
        ::cDesignerOptions:=xOptions
    endif
return(self)

method RenderHTML() class WebExLabelDesigner
    local cHTML as character
    local cScript as character
    local cWidth:=tlpp.ToStr(::nLabelWidth) as character
    local cHeight:=tlpp.ToStr(::nLabelHeight) as character
    local cLayoutJSON:=WebExHelper():EscapeHTMLScript(::cInitialLayout) as character
    local cRecordsJSON:=WebExHelper():EscapeHTMLScript(::cInitialRecords) as character
    local cOptionsJSON:=WebExHelper():EscapeHTMLScript(::cDesignerOptions) as character

    beginContent var cScript
(function(){
    const root=document.getElementById("__ID__");
    if(!root || root.__labelDesigner){ return; }
    function buildShell(){
        if(typeof root.insertAdjacentHTML!=="function")
            throw new Error("FWWebEx Labels: o host nao permite criar a estrutura do designer.");
        root.insertAdjacentHTML("afterbegin",`
<div class="fwwebex-label-toolbar" data-role="toolbar" aria-label="Ferramentas do designer">
  <div class="fwwebex-label-quickbar">
