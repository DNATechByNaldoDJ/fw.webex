namespace FWWebEx

#include "fw.webex.th"

class WebExDataTableFilterPanelEx from WebExDiv

    protected data cTitle as character
    protected data cTargetTableID as character
    protected data jTargetTableFields as json

    protected data jInternalFilter as character
    protected data jInternalFieldsTypes as json

    protected data oPanel as object

    protected data oPanelContainer as object
    protected data oPanelContent as object

    protected data oPanelHeader as object
    protected data oPanelHeaderIcon as object
    protected data oPanelHeaderTitle as object
    protected data oPanelHeaderButtonClose as object

    protected data oPanelBody as object
    protected data oPanelBodyContainer as object
    protected data oPanelBodyControls as object

    protected data oPanelBodyButtonAddCondition as object

    protected data oPanelBodyButtonAddGroup as object
    protected data oPanelBodyPreview as object
    protected data oPanelBodyPreviewLabel as object
    protected data oPanelBodyPreviewTextArea as object

    protected data oPanelFooter as object
    protected data oPanelFooterButtonClose as object
    protected data oPanelFooterButtonApply as object

    public method New(cTitle as character,cTargetTableID as character,jTargetTableFields as json,jInternalFilter as json,jInternalFieldsTypes as json) as object

endclass

method New(cTitle,cTargetTableID,jTargetTableFields,jInternalFilter,jInternalFieldsTypes) class WebExDataTableFilterPanelEx

    local cScript as character
    local cIDPanel as character
    local cIDContainer as character

    paramtype 1 var cTitle as character optional default "Advanced Filter"
    paramtype 2 var cTargetTableID as character
    paramtype 3 var jTargetTableFields as json
    paramtype 4 var jInternalFilter as json optional default JSONObject():New()
    paramtype 5 var jInternalFieldsTypes as json optional default JSONObject():New()

    ::cTitle:=cTitle
    ::cTargetTableID:=cTargetTableID
    ::jTargetTableFields:=jTargetTableFields
    ::jInternalFilter:=jInternalFilter
    ::jInternalFieldsTypes:=jInternalFieldsTypes

    _Super:New()

    ::oPanel:=self

    WITH WEBEXOBJECT ::oPanel
        cIDPanel:=.:GetID()
        .:SetAttr("tabindex","-1")
        .:AddClass("modal fade")
        WITH WEBEXOBJECT ::oPanelContainer CLASS WebExDiv
            .:AddClass("modal-dialog modal-lg")
            WITH WEBEXOBJECT ::oPanelContent CLASS WebExDiv
                .:AddClass("modal-content")
                WITH WEBEXOBJECT ::oPanelHeader CLASS WebExDiv
                    .:AddClass("modal-header")
                    WITH WEBEXOBJECT ::oPanelHeaderIcon CLASS WebExIcon ARGS "fa-filter","fontawesome"
                        .:AddClass("modal-title me-1")
                    END WEBEXOBJECT
                    WITH WEBEXOBJECT ::oPanelHeaderTitle CLASS WebExH5
                        .:AddClass("modal-title")
                        .:SetContent(::cTitle)
                    END WEBEXOBJECT
                    WITH WEBEXOBJECT ::oPanelHeaderButtonClose CLASS WebExButton ARGS "","button"
                        .:SetAttr("data-bs-dismiss","modal")
                        .:AddClass("btn-close")
                    END WEBEXOBJECT
                END WEBEXOBJECT
                WITH WEBEXOBJECT ::oPanelBody CLASS WebExDiv
                    .:AddClass("modal-body")
                    WITH WEBEXOBJECT ::oPanelBodyContainer CLASS WebExDiv
                        cIDContainer:=.:GetID()
                        .:SetFixedID(cIDContainer+"_rows")
                        .:AddClass("conditions")
                        beginContent var cScript
                            // Create a private context for this instance using an IIFE
                            const FWWebExDataTableFilterPanelExContext___ID_CONTAINER__ = (function() {
                                // Initialize fields and types for this instance
                                const fields = __FIELDS__;
                                const fieldsTypes = {};
                                fields.fields.forEach(field => {
                                    fieldsTypes[field.name] = field.type;
                                });
                                const operatorsByType = {
                                    'C': ['=','!=','>','<','>=','<=','LIKE','NOT LIKE','IN','NOT IN'],
                                    'N': ['=','!=','>','<','>=','<=','IN','NOT IN'],
                                    'D': ['=','!=','>','<','>=','<=','IN','NOT IN'],
                                    'L': ['=','!=']
                                };

                                // Return context accessor
                                return function() {
                                    return { fields,fieldsTypes,operatorsByType };
                                };
                            })();

                            // Update field options based on selected field type
                            function FWWebExDataTableFilterPanelExUpdateField___ID_CONTAINER__(row) {
                                const context = FWWebExDataTableFilterPanelExContext___ID_CONTAINER__();
                                const field = row.querySelector('.field').value;
                                const type = context.fieldsTypes[field];
                                const selectOp = row.querySelector('.operator');
                                selectOp.innerHTML = '';
                                context.operatorsByType[type].forEach(op => {
                                    const opt = document.createElement('option');
                                    opt.value = op;
                                    opt.textContent = op;
                                    selectOp.appendChild(opt);
                                });
                                let valueInput = row.querySelector('.value');
                                let newValue;
                                if (type === 'L') {
                                    const select = document.createElement('select');
                                    select.className = 'form-select value';
                                    select.innerHTML = `
                                        <option value="T">True</option>
                                        <option value="F">False</option>
                                    `;
                                    valueInput.replaceWith(select);
                                    newValue = select;
                                    newValue.addEventListener('change',FWWebExDataTableFilterPanelExUpdatePreview___ID_CONTAINER__);
                                } else {
                                    const input = document.createElement('input');
                                    input.className = 'form-control value';
                                    input.placeholder = '...';
                                    if (type === 'D') input.type = 'date';
                                    else if (type === 'N') input.type = 'number';
                                    else input.type = 'text';
                                    valueInput.replaceWith(input);
                                    newValue = input;
                                    newValue.addEventListener('input',FWWebExDataTableFilterPanelExUpdatePreview___ID_CONTAINER__);
                                }
                                FWWebExDataTableFilterPanelExUpdatePreview___ID_CONTAINER__();
                            }

                            // Handle connector change
                            function FWWebExDataTableFilterPanelExHandleConnectorChange___ID_CONTAINER__(e) {
                                const select = e.target;
                                const newVal = select.value;
                                if (newVal === '') {
                                    const item = select.closest('.filter-condition, .filter-group-wrapper');
                                    if (item && item.nextElementSibling) {
                                        FWWebExAlert("Cannot delete/clear AND/OR unless the subsequent expression has been deleted.", 'Alert', 'warning', { dismissible: true });
                                        select.value = select.dataset.oldValue || 'AND';
                                        return;
                                    }
                                }
                                select.dataset.oldValue = newVal;
                                FWWebExDataTableFilterPanelExUpdatePreview___ID_CONTAINER__();
                            }

                            // Add a new condition row
                            function FWWebExDataTableFilterPanelExAddCondition___ID_CONTAINER__(container) {
                                const context = FWWebExDataTableFilterPanelExContext___ID_CONTAINER__();
                                const children = Array.from(container.children);
                                const preview = FWWebExAllTrim(FWWebExDataTableFilterPanelExGetPreview___ID_CONTAINER__());
                                if (children.length > 0) {
                                    const lastChild = children[children.length - 1];
                                    if (lastChild.classList.contains('filter-condition')) {
                                        const field = lastChild.querySelector('.field').value;
                                        const op = lastChild.querySelector('.operator').value;
                                        const value = lastChild.querySelector('.value').value.trim();
                                        if (!field || !op || !value) {
                                            FWWebExAlert("Complete the previous condition before adding a new one.", 'Alert','warning', { dismissible: true });
                                            return;
                                        }
                                    } else if (lastChild.classList.contains('filter-group-wrapper')) {
                                        const innerConditions = lastChild.querySelector('.conditions');
                                        if (innerConditions.children.length === 0) {
                                            FWWebExAlert("Add at least one condition to the previous group before adding a new one.", 'Alert','warning', { dismissible: true });
                                            return;
                                        }
                                    }
                                }
                                if ((preview && children.length > 0) || (!preview && children.length - 2 > 0)) {
                                    const lastChild = children[children.length - 1];
                                    let lastConnector;
                                    if (lastChild.classList.contains('filter-condition')) {
                                        lastConnector = lastChild.querySelector(':scope > .connector');
                                    } else if (lastChild.classList.contains('filter-group-wrapper')) {
                                        lastConnector = lastChild.querySelector('.mt-2 .connector');
                                    }
                                    if (!lastConnector || lastConnector.value === '') {
                                        FWWebExAlert("Inconsistency: there must be an AND or OR operator before adding a new condition or Group.", 'Alert','warning', { dismissible: true });
                                        return;
                                    }
                                }
                                const row = document.createElement('div');
                                row.className = 'filter-condition input-group input-group-sm mb-2';
                                row.setAttribute("style", "display:flex; gap:1px; align-items:center;");
                                let html = `
                                    <select class="form-select field" style="max-width: 20ch;"></select>
                                    <select class="form-select operator" style="max-width: 15ch;"></select>
                                    <input type="text" class="form-control value" placeholder="..." style="flex:1;">
                                    <select class="form-select connector" style="max-width: 95px;">
                                        <option value=""></option>
                                        <option>AND</option>
                                        <option>OR</option>
                                    </select>
                                    <button class="btn btn-outline-danger remove-btn" type="button">x</button>
                                `;
                                row.innerHTML = html;
                                container.appendChild(row);
                                const selectField = row.querySelector('.field');
                                context.fields.fields.forEach(field => {
                                    const opt = document.createElement('option');
                                    opt.value = field.name.trim();
                                    opt.textContent = field.label.trim();
                                    selectField.appendChild(opt);
                                });
                                selectField.addEventListener('change',() => { FWWebExDataTableFilterPanelExUpdateField___ID_CONTAINER__(row); });
                                const operatorSelect = row.querySelector('.operator');
                                operatorSelect.addEventListener('change',FWWebExDataTableFilterPanelExUpdatePreview___ID_CONTAINER__);
                                const valueEl = row.querySelector('.value');
                                valueEl.addEventListener('input',FWWebExDataTableFilterPanelExUpdatePreview___ID_CONTAINER__);
                                const connectorEl = row.querySelector(':scope > .connector');
                                if (connectorEl) connectorEl.addEventListener('change',FWWebExDataTableFilterPanelExHandleConnectorChange___ID_CONTAINER__);
                                row.querySelector('.remove-btn').addEventListener('click',() => { row.remove(); FWWebExDataTableFilterPanelExUpdatePreview___ID_CONTAINER__(); });
                                if (selectField.value) FWWebExDataTableFilterPanelExUpdateField___ID_CONTAINER__(row);
                                FWWebExDataTableFilterPanelExUpdatePreview___ID_CONTAINER__();
                            }

                            // Add a new group
                            function FWWebExDataTableFilterPanelExAddGroup___ID_CONTAINER__(container) {
                                const children = Array.from(container.children);
                                const preview = FWWebExAllTrim(FWWebExDataTableFilterPanelExGetPreview___ID_CONTAINER__());
                                if (children.length > 0) {
                                    const lastChild = children[children.length - 1];
                                    if (lastChild.classList.contains('filter-condition')) {
                                        const field = lastChild.querySelector('.field').value;
                                        const op = lastChild.querySelector('.operator').value;
                                        const value = lastChild.querySelector('.value').value.trim();
                                        if (!field || !op || !value) {
                                            FWWebExAlert("Complete the previous condition before adding a new one.", 'Alert' ,'warning', { dismissible: true });
                                            return;
                                        }
                                    } else if (lastChild.classList.contains('filter-group-wrapper')) {
                                        const innerConditions = lastChild.querySelector('.conditions');
                                        if (innerConditions.children.length === 0) {
                                            FWWebExAlert("Add at least one condition to the previous group before adding a new one.", 'Alert' ,'warning', { dismissible: true });
                                            return;
                                        }
                                    }
                                }
                                if ((preview && children.length > 0) || (!preview && children.length - 3 > 0)) {
                                    const lastChild = children[children.length - 1];
                                    let lastConnector;
                                    if (lastChild.classList.contains('filter-condition')) {
                                        lastConnector = lastChild.querySelector(':scope > .connector');
                                    } else if (lastChild.classList.contains('filter-group-wrapper')) {
                                        lastConnector = lastChild.querySelector('.mt-2 .connector');
                                    }
                                    if (!lastConnector || lastConnector.value === '') {
                                        FWWebExAlert("Inconsistency: there must be an AND or OR operator before adding a new condition or Group.", 'Alert' , 'warning', { dismissible: true });
                                        return;
                                    }
                                }
                                const wrapper = document.createElement('div');
                                wrapper.className = 'filter-group-wrapper mb-2';
                                wrapper.setAttribute("style", "display:flex; gap:1px; align-items:center;");
                                const group = document.createElement('div');
                                group.className = 'filter-group border p-2';
                                group.setAttribute("style", "flex:1;");
                                group.innerHTML = `
                                    <div class="conditions"></div>
                                    <div class="mt-2 d-flex">
                                        <button class="btn btn-sm btn-outline-primary add-condition">(+)Expr.</button>
                                        <button class="btn btn-sm btn-outline-primary add-group ms-1">(+)(Expr.)</button>
                                        <select class="form-select connector ms-1" style="max-width: 95px;">
                                            <option value=""></option>
                                            <option>AND</option>
                                            <option>OR</option>
                                        </select>
                                        <button class="btn btn-sm btn-outline-danger remove-btn ms-1">x</button>
                                    </div>
                                `;
                                wrapper.appendChild(group);
                                container.appendChild(wrapper);
                                group.querySelector('.add-condition').addEventListener('click',() => { FWWebExDataTableFilterPanelExAddCondition___ID_CONTAINER__(group.querySelector('.conditions')); });
                                group.querySelector('.add-group').addEventListener('click',() => { FWWebExDataTableFilterPanelExAddGroup___ID_CONTAINER__(group.querySelector('.conditions')); });
                                group.querySelector('.remove-btn').addEventListener('click',() => { wrapper.remove(); FWWebExDataTableFilterPanelExUpdatePreview___ID_CONTAINER__(); });
                                const connectorEl = group.querySelector('.mt-2 .connector');
                                if (connectorEl) connectorEl.addEventListener('change',FWWebExDataTableFilterPanelExHandleConnectorChange___ID_CONTAINER__);
                                FWWebExDataTableFilterPanelExUpdatePreview___ID_CONTAINER__();
                            }

                            // Build SQL-like expression from conditions
                            function FWWebExDataTableFilterPanelExBuildExpression___ID_CONTAINER__(container) {
                                const context = FWWebExDataTableFilterPanelExContext___ID_CONTAINER__();
                                const parts = [];
                                const children = Array.from(container.children);
                                children.forEach((child,index) => {
                                    if (child.classList.contains('filter-condition')) {
                                        const connectorEl = child.querySelector(':scope > .connector');
                                        const connector = connectorEl ? connectorEl.value : '';
                                        const field = child.querySelector('.field').value;
                                        const op = child.querySelector('.operator').value;
                                        const valueEl = child.querySelector('.value');
                                        let value = valueEl.value.trim();
                                        const type = context.fieldsTypes[field];

                                        // Basic validation: skip incomplete conditions
                                        if (!field || !op || !value) {
                                            console.warn(`Incomplete condition ignored: field=${field},op=${op},value=${value}`);
                                            return; // Skip to avoid invalid SQL
                                        }

                                        if (type === 'D' && value) {
                                            value = value.replace(/-/g,'');
                                        }
                                        let cond;
                                        if (op === 'LIKE' || op === 'NOT LIKE') {
                                            value = `'%${value.replace(/'/g,"''")}%'`;
                                            cond = `${field} ${op} ${value}`;
                                        } else if (op === 'IN' || op === 'NOT IN') {
                                            const values = value.split(',').map(v => v.trim()).filter(v => v);
                                            if (values.length === 0) {
                                                console.warn(`Empty list in IN/NOT IN ignored for field=${field}`);
                                                return; // Skip empty lists
                                            }
                                            const formatted = values.map(v => {
                                                if (type === 'N') return v;
                                                return `'${v.replace(/'/g,"''")}'`;
                                            });
                                            cond = `${field} ${op} (${formatted.join(',')})`;
                                        } else {
                                            if (type !== 'N') {
                                                value = `'${value.replace(/'/g,"''")}'`;
                                            } else if (type === 'N' && isNaN(parseFloat(value))) {
                                                console.warn(`Non-numeric value ignored for field=${field}`);
                                                return; // Skip non-numeric values for numeric fields
                                            }
                                            cond = `${field} ${op} ${value}`;
                                        }
                                        // Append connector only if not the last child and connector is valid
                                        if (index < children.length - 1 && connector) {
                                            parts.push(cond+' '+connector);
                                        } else {
                                            parts.push(cond);
                                        }
                                    } else if (child.classList.contains('filter-group-wrapper')) {
                                        const connectorEl = child.querySelector('.mt-2 .connector');
                                        const connector = connectorEl ? connectorEl.value : '';
                                        const innerExpr = FWWebExDataTableFilterPanelExBuildExpression___ID_CONTAINER__(child.querySelector('.conditions'));
                                        if (innerExpr) {
                                            // Append connector only if not the last child and connector is valid
                                            if (index < children.length - 1 && connector) {
                                                parts.push(`(${innerExpr}) ${connector}`);
                                            } else {
                                                parts.push(`(${innerExpr})`);
                                            }
                                        }
                                    }
                                });
                                return parts.join(' ');
                            }

                            // Update preview textarea with current expression
                            function FWWebExDataTableFilterPanelExUpdatePreview___ID_CONTAINER__() {
                                const container = document.getElementById("__ID_CONTAINER___rows");
                                const expression = FWWebExDataTableFilterPanelExBuildExpression___ID_CONTAINER__(container);
                                document.getElementById("__ID_CONTAINER___preview").value = expression;
                            }

                            // Get preview textarea with current expression
                            function FWWebExDataTableFilterPanelExGetPreview___ID_CONTAINER__() {
                                return(document.getElementById("__ID_CONTAINER___preview").value);
                            }

                        endContent
                        cScript:=WebExHelper():StrReplaceEx(;
                            cScript;
                            ,{"__ID_CONTAINER__",cIDContainer};
                            ,{"__FIELDS__",jTargetTableFields:ToJSON()};
                        )
                        WITH WEBEXOBJECT CLASS WebExScript
                            .:SetContent(cScript)
                        END WEBEXOBJECT
                        WITH WEBEXOBJECT ::oPanelBodyControls CLASS WebExDiv
                            .:AddClass("mt-2")
                            WITH WEBEXOBJECT ::oPanelBodyButtonAddCondition CLASS WebExButton ARGS "(+)Expr.","button"
                                .:AddClass("btn btn-sm btn-outline-primary")
                                .:SetAttr("onclick","FWWebExDataTableFilterPanelExAddCondition_"+cIDContainer+"(document.getElementById('"+cIDContainer+"_rows'))")
                            END WEBEXOBJECT
                            WITH WEBEXOBJECT ::oPanelBodyButtonAddGroup CLASS WebExButton ARGS "(+)(Expr.)","button"
                                .:AddClass("btn btn-sm btn-outline-primary ms-2")
                                .:SetAttr("onclick","FWWebExDataTableFilterPanelExAddGroup_"+cIDContainer+"(document.getElementById('"+cIDContainer+"_rows'))")
                            END WEBEXOBJECT
                        END WEBEXOBJECT
                        WITH WEBEXOBJECT ::oPanelBodyPreview CLASS WebExDiv
                            .:AddClass("mt-3")
                            WITH WEBEXOBJECT ::oPanelBodyPreviewLabel CLASS WebExLabel ARGS "Filter Expression Preview:","Filter Expression Preview:"
                            END WEBEXOBJECT
                            WITH WEBEXOBJECT ::oPanelBodyPreviewTextArea CLASS WebExTextarea
                                .:SetFixedID(cIDContainer+"_preview")
                                .:AddClass("form-control")
                                .:SetAttr("rows","4")
                                .:SetAttr("readonly","true")
                                .:SetAttr("style","margin-bottom: 8px;")
                            END WEBEXOBJECT
                        END WEBEXOBJECT
                    END WEBEXOBJECT
                END WEBEXOBJECT
                WITH WEBEXOBJECT ::oPanelFooter CLASS WebExDiv
                    .:AddClass("modal-footer")
                    WITH WEBEXOBJECT ::oPanelFooterButtonClose CLASS WebExButton ARGS "Close","button"
                        .:SetAttr("data-bs-dismiss","modal")
                        .:AddClass("btn btn-secondary")
                    END WEBEXOBJECT
                    WITH WEBEXOBJECT ::oPanelFooterButtonApply CLASS WebExButton ARGS "Apply","button"
                        .:AddClass("btn btn-primary")
                        .:SetAttr("onclick","FWWebExDataTableFilterPanelExApplyFilters_"+cIDContainer+"()")
                    END WEBEXOBJECT
                    beginContent var cScript
                        // Apply filters to the DataTable
                        function FWWebExDataTableFilterPanelExApplyFilters___ID_CONTAINER__() {
                            const container = document.getElementById("__ID_CONTAINER___rows");
                            const expression = FWWebExDataTableFilterPanelExBuildExpression___ID_CONTAINER__(container);

                            // Validate for missing connectors between conditions
                            const invalidConnectorPattern = /\)\s*\w+\s*(?:=|\!=|>|<|>=|<=|LIKE|NOT LIKE|IN|NOT IN)\s*[^()]+(?=\s*(?:\(|$))/i;
                            if (invalidConnectorPattern.test(expression)) {
                                FWWebExAlert("Invalid filter expression: missing logical connector (AND/OR) between conditions.", 'Alert' , 'warning', { dismissible: true });
                                return; // Prevent application if missing connectors
                            }

                            // Validate for starting with AND/OR
                            if (FWWebExAllTrim(expression).startsWith('AND ') || FWWebExAllTrim(expression).startsWith('OR ')) {
                                FWWebExAlert("Invalid filter expression: cannot start with AND or OR.", 'Alert' ,'warning', { dismissible: true });
                                return; // Prevent application if invalid
                            }

                            // Validate for ending with AND/OR
                            if (FWWebExAllTrim(expression).endsWith(' AND') || FWWebExAllTrim(expression).endsWith(' OR')) {
                                FWWebExAlert("Invalid filter expression: cannot end with AND or OR.", 'Alert' ,'warning', { dismissible: true });
                                return;
                            }

                            // Helper function to convert internal filter to SQL expression
                            function buildInternalExpression(filter,fieldsTypes) {
                                if (!fieldsTypes) {
                                    console.warn("Field types not provided for internal filter. Skipping internal filter processing.");
                                    return '';
                                }
                                const parts = [];
                                for (const [field,value] of Object.entries(filter)) {
                                    if (!fieldsTypes[field]) {
                                        console.warn(`Field type for ${field} not found. Skipping this condition.`);
                                        continue;
                                    }
                                    const type = fieldsTypes[field];
                                    let formattedValue;

                                    if (type === 'C') { // Character
                                        formattedValue = `'${value.replace(/'/g,"''")}'`;
                                    } else if (type === 'N') { // Numeric
                                        formattedValue = value;
                                    } else if (type === 'D') { // Date
                                        formattedValue = `'${value.replace(/-/g,'')}'`;
                                    } else if (type === 'L') { // Logical
                                        formattedValue = value === 'T' || value === true ? 'T' : 'F';
                                    } else {
                                        console.warn(`Unsupported field type ${type} for field ${field}. Skipping.`);
                                        continue;
                                    }

                                    parts.push(`${field} = ${formattedValue}`);
                                }
                                return parts.join(' AND ');
                            }

                            // Parse and process internal filter if provided
                            let internalExpression = '';
                            const jInternalFilter = '__JSON_INTERNAL_FILTER__';
                            const jInternalFieldsAndTypes = '__JSON_INTERNAL_FIELDS_AND_TYPES__';

                            if (jInternalFilter && jInternalFilter.trim() !== '') {
                                try {
                                    const internalFilter = JSON.parse(jInternalFilter);
                                    if (Object.keys(internalFilter).length > 0) {
                                        if (!jInternalFieldsAndTypes) {
                                            console.error("jInternalFieldsAndTypes is required when jInternalFilter is provided.");
                                            internalExpression = '';
                                        } else {
                                            const fieldsTypes = JSON.parse(jInternalFieldsAndTypes);
                                            internalExpression = buildInternalExpression(internalFilter,fieldsTypes);
                                        }
                                    }
                                } catch (err) {
                                    console.error("Error parsing jInternalFilter:",err.message);
                                    internalExpression = '';
                                }
                            }

                            // Combine internal and user expressions
                            let hasFilter = false;
                            let finalExpression = '';
                            if (internalExpression && expression) {
                                hasFilter = true;
                                finalExpression = `(${internalExpression}) AND (${expression})`;
                            } else if (internalExpression) {
                                finalExpression = internalExpression;
                            } else if (expression) {
                                hasFilter = true;
                                finalExpression = expression;
                            }

                            // Encode the final expression
                            const encodedExpression = btoa(finalExpression || '');

                            // Apply to DataTable
                            if (FWWebExHasDataTables()) {
                                if ($.fn.DataTable.isDataTable("#__ID_TARGET_TABLE__")) {
                                    let table = $("#__ID_TARGET_TABLE__").DataTable();
                                    table.settings()[0].oInit.FWWebExPanelFilterEx = { expression: encodedExpression };
                                    table.settings()[0].oInit.FWWebExPanelFilterExHasFilter = hasFilter;
                                    table.ajax.reload();
                                } else {
                                    console.warn("Target table #__ID_TARGET_TABLE__ not found to apply filters.");
                                }
                            } else {
                                console.error("DataTables plugin is not available. Please check if the JS file has been imported.");
                            }
                            bootstrap.Modal.getInstance(document.getElementById("__ID_PANEL__")).hide();
                        }
                    endContent
                    cScript:=WebExHelper():StrReplaceEx(;
                        cScript;
                        ,{"__ID_PANEL__",cIDPanel};
                        ,{"__ID_CONTAINER__",cIDContainer};
                        ,{"__ID_TARGET_TABLE__",::cTargetTableID};
                        ,{"__JSON_INTERNAL_FILTER__",::jInternalFilter:ToJSON()};
                        ,{"__JSON_INTERNAL_FIELDS_AND_TYPES__",::jInternalFieldsTypes:ToJSON()};
                    )
                    WITH WEBEXOBJECT CLASS WebExScript
                        .:SetContent(cScript)
                    END WEBEXOBJECT
                END WEBEXOBJECT
            END WEBEXOBJECT
        END WEBEXOBJECT
    END WEBEXOBJECT NOADDCHILD

return(self)
