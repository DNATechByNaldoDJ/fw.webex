                    (reference.box.width-item.box.width)/2;
                if(command==="align-right")x=reference.box.x+reference.box.width-
                    item.box.width;
                if(command==="align-top")y=reference.box.y;
                if(command==="align-middle")y=reference.box.y+
                    (reference.box.height-item.box.height)/2;
