        });
        let offset=cleaned.indexOf("{{");
        if(offset<0)offset=cleaned.indexOf("}}");
        if(offset>=0)problems.push({offset:offset,token:cleaned.slice(offset,offset+20),
            reason:"Delimitadores de template nao balanceados."});
        return {paths:tokens.filter(function(path,index){
            return tokens.indexOf(path)===index;
        }),problems:problems};
    }
    function templatePaths(template){
        return templateTokens(template).paths;
    }
    function emptyValue(value){return value===undefined||value===null||value==="";}
    function barcodeSampleValue(format,fallback){
        format=String(format||"AUTO").toUpperCase();
        if(format==="AUTO")format=String(fallback||"CODE128").toUpperCase();
        const samples={
            EAN13:"789123456789",EAN8:"1234567",EAN5:"12345",EAN2:"12",
            UPC:"12345678901",UPCE:"123456",ITF14:"1234567890123",
            ITF:"1234567890",CODE39:"EXEMPLO",CODABAR:"A1234B",
            PHARMACODE:"1234",MSI:"123456",MSI10:"123456",MSI11:"123456",
            MSI1010:"123456",MSI1110:"123456",CODE128:"1234567890",
            CODE128A:"EXEMPLO",CODE128B:"EXEMPLO",CODE128C:"1234567890"
