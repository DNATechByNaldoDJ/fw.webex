#include "fw.webex.th"

using namespace FWWebEx

static __lAsciiToWebAccentuation:=.F. as logical

function u_TestaMD(lSave as logical,lAsciiToWebAccentuation as logical)

    local cFS:=FORWARD_SLASH as character
    local cCRLF:=CRLF as character
    local cLink1 as character
    local cLink2 as character
    local cOutPut as character

    local lSetCentury:=__SetCentury("ON") as logical
    local lEnableUTF8:=.T. as logical
    local lEnableEmoji:=.T. as logical
    local lEnableEscapeHTMLAttribute as logical

    local oMD as object
    local oMDComment as object

    DEFAULT lSave:=.T.
    DEFAULT lAsciiToWebAccentuation:=.F.

    __lAsciiToWebAccentuation:=lAsciiToWebAccentuation
    lEnableEscapeHTMLAttribute:=(!lSave)

    oMD:=FWMarkDown():New()
    oMD:EnableUTF8(lEnableUTF8)
    oMD:EnableEmoji(lEnableEmoji)
    oMD:EnableEscapeHTMLAttribute(lEnableEscapeHTMLAttribute)

    // FrontMatter no topo
    oMD:FrontMatter(;
        {;
             "title" : __Accentuation("Relat#1rio Teste","oacute");
            ,"author" : "DNATech";
            ,"date" : DToC(Date());
        };
    )

    //TODO: Fix PageHeader and PageFooter
    oMD:PageHeader(__Accentuation("Relat#1rio Gerado em ","oacute")+DToC(Date()))
    oMD:PageFooter(__Accentuation("DNATech. #1 Todos os direitos reservados","copy"))

    oMD:Header(__Accentuation(":rocket: Relat#1rio Markdown","oacute"),1)
    oMD:Paragraph("Gerado em ADVPL com suporte a **Markdown**.")

    oMD:Header(__Accentuation(":small_orange_diamond: Lista hier#1rquica","aacute"),2)
    oMD:ListItem("Item 1",1)
    oMD:ListItem("Subitem 1.1",2)
    oMD:ListItem("Subitem 1.1.1",3)
    oMD:ListItem("Item 2",1)

    oMD:Rule()

    oMD:Header("Lista Ordenada Aninhada",2)
    oMD:ListItem("Top 1",1,.T.)
    oMD:ListItem("Sub 1",2,.T.)
    oMD:ListItem("Sub 2",2,.T.)
    oMD:ListItem("Top 2",1,.T.)

    oMD:PageBreak()

    oMD:Header(":check_mark_button: Lista de Tarefas",2)
    oMD:ListItemTask("Tarefa pendente",.F.,1)
    oMD:ListItemTask(__Accentuation("Tarefa conclu#1da","iacute"),.T.,1)

    oMD:Rule()

    oMD:Header(__Accentuation("Texto Avan#1ado","ccedil"),2)
    oMD:Paragraph(oMD:Highlight("Destaque")+" com "+oMD:Subscript("sub")+" e "+oMD:SuperScript("super"))

    oMD:PageBreak()

    oMD:Header("Links",2)
    oMD:Paragraph("Veja o "+oMD:Link("GitHub :: FWMarkDown Report","https://github.com/DNATechByNaldoDJ/fw.webex/blob/main/src/fw.webex/tests/md/fw.webex.example_024.pdf"))

    oMD:PageBreak()

    oMD:Header("Imagens",2)
    oMD:Paragraph(oMD:Image("Logo","https://github.com/DNATechByNaldoDJ/fw.webex/blob/main/src/resource/fwwebex_banner_linkedin.png?raw=true"))

    oMD:PageBreak()

    // Add resized image
    oMD:Header("Imagem Redimensionada",2)
    oMD:Paragraph(oMD:Image("Logo","https://github.com/DNATechByNaldoDJ/fw.webex/blob/main/src/resource/fwwebex_banner_linkedin.png?raw=true",300,300,"custom-size"))

    oMD:PageBreak()

    oMD:Header("Imagem Tag",2)
    //cFS :: Renderizar xBase OK no GitHub
    cLink1:='<img class="custom-size" src="https:'+cFS+cFS+'github.com'+cFS+'DNATechByNaldoDJ'+cFS+'fw.webex'+cFS+'blob'+cFS+'main'+cFS+'src'+cFS+'resource'+cFS+'dna_tech_logo.png?raw=true" alt="Sample Image" width="300">'
    cLink2:='<img class="custom-size" src="https:'+cFS+cFS+'github.com'+cFS+'DNATechByNaldoDJ'+cFS+'fw.webex'+cFS+'blob'+cFS+'main'+cFS+'src'+cFS+'resource'+cFS+'dna_tech_logo_menu_background.png?raw=true" alt="Sample Image" width="300">'
    if (lSave)
        oMD:Paragraph(cLink1)
        oMD:Paragraph(cLink2)
    else
        oMD:Paragraph(WebExHelper():EscapeHTMLAttribute(cLink1))
        oMD:Paragraph(WebExHelper():EscapeHTMLAttribute(cLink2))
    endif

    oMD:PageBreak()

    oMD:Header(__Accentuation("C#1digo","oacute"),2)
    oMD:CodeBlock("User Function Hello()"+cCRLF+"   ConOut('Hello Markdown')"+cCRLF+"Return","advpl")

    oMd:Rule()

    oMD:Header(__Accentuation("Cita#1#2o","ccedil","atilde"),2)
    oMD:Quote(__Accentuation("Markdown deixa a leitura mais agrad#1vel."+cCRLF+"E agora com multi-linha.","aacute"),1)
    oMD:Quote(__Accentuation("Cita#1#2o aninhada.","ccedil","atilde"),2)

    oMd:Rule()

    oMD:Header("Tabela",2)
    oMD:Table({"Produto","Qtde","Valor","Tabela"},{{"A","10","10.25","A-1"},{"B","25","15.75","B-2"}},{"left","right","right","left"})

    oMD:Rule()

    oMD:Header(__Accentuation("Defini#1#2o","ccedil","atilde"),2)
    oMD:DefinitionList("Termo",__Accentuation("Defini#1#2o aqui.","ccedil","atilde"))

    oMD:PageBreak()

    oMD:Header(__Accentuation("Rodap#1","eacute"),2)
    oMD:Paragraph(__Accentuation("Texto com rodap#1","eacute")+oMD:FootNoteRef("1"))
    oMD:FootNoteDef("1",__Accentuation("Nota de rodap#1.","eacute"))

    oMD:PageBreak()

    oMD:Header(__Accentuation("Relat#1rio com V#2deo","oacute","iacute"),1)
    if (lSave)
        oMD:Paragraph(__Accentuation("Para ver,desabilite o coment#1rio abaixo:","aacute"))
        oMDComment:=FWMarkDown():New()
        oMDComment:EnableUTF8(lEnableUTF8)
        oMDComment:EnableEmoji(lEnableEmoji)
        oMDComment:VideoEmbed("https://www.youtube.com/watch?v=vZaldeUg6D0",640,360)
        oMD:Comment(oMDComment:BuildOutPut(),.T./*lHTML*/)
        oMDComment:Clean()
        FreeObj(@oMDComment)
    else
        oMD:VideoEmbed("https://www.youtube.com/watch?v=vZaldeUg6D0",640,360)
    endif

    if (lSave)
        oMD:Save("C:\GitHub\fw.webex\src\fw.webex\tests\resources\md\relatorio.md")
    else
        cOutPut:=oMD:BuildOutPut()
    endif

    oMD:Clean()
    FreeObj(@oMD)

    if (!lSetCentury)
        __SetCentury("OFF")
    endif

return(cOutPut)

static function __Accentuation(cString as character,vAccentuation as variadic)

    local aAccentuation as array

    local cNewString:=cString as character

    local nVArg as numeric
    local nAccentuation as numeric

    if ((ValType(vAccentuation)=="J").and.(vAccentuation:HasProperty("VARGS")))
        vAccentuation:GetJSONValue("VARGS",@aAccentuation)
        nAccentuation:=Len(aAccentuation)
        for nVArg:=1 to nAccentuation
            cNewString:=WebExHelper():Accentuation(cNewString,aAccentuation[nVArg])
        next nVArg
    endif
    if (__lAsciiToWebAccentuation)
        cNewString:=WebExHelper():AsciiToWebAccentuation(cNewString)
        if (("&cr;"$cNewString).or.("&NewLine;"$cNewString))
            cNewString:=WebExHelper():StrReplaceEx(;
                cNewString;
                ,{"&cr;",""};
                ,{"&NewLine;",CRLF};
            )
        endif
    endif
return(cNewString)
