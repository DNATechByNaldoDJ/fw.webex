        if(type==="text"){
            const style=source.style||{},fit=source.fit||{};
            element.style={
                fontFamily:String(defined(style.fontFamily,defined(source.fontFamily,"helvetica"))),
                fontSize:finite(defined(style.fontSize,source.fontSize),10),
                minFontSize:finite(defined(style.minFontSize,source.minFontSize),3),
                fontStyle:String(defined(style.fontStyle,source.bold===true?"bold":"normal")),
                color:String(defined(style.color,defined(source.color,"#000000"))),
                lineHeightFactor:finite(defined(style.lineHeightFactor,source.lineHeightFactor),1.15),
                letterSpacing:finite(defined(style.letterSpacing,source.letterSpacing),0),
                align:String(defined(style.align,defined(source.align,"left"))),
                verticalAlign:String(defined(style.verticalAlign,defined(source.verticalAlign,"top"))),
                padding:normalizeInsets(defined(style.padding,source.padding),0),
                margin:normalizeInsets(defined(style.margin,source.margin),0)
            };
            const legacyShrink=source.overflow==="shrink";
            element.fit={
                mode:String(defined(fit.mode,legacyShrink||source.autoFit!==false?"shrink":"none")),
                maxLines:Math.max(1,finite(defined(fit.maxLines,source.maxLines),999)),
                overflow:String(defined(fit.overflow,source.overflow==="shrink"?"error":defined(source.overflow,"error")))
            };
            element.textOptions=clone(source.textOptions||{});
        }else if(type==="barcode"){
            const legacyOptions=source.barcodeOptions||{};
            const legacyFontSize=sourceVersion===1&&source.humanReadableFontSize==null&&
                legacyOptions.fontSize!=null?finite(legacyOptions.fontSize,16)*0.75:
                defined(source.humanReadableFontSize,legacyOptions.fontSize);
            const legacyTextMargin=sourceVersion===1&&source.textMargin==null&&
                legacyOptions.textMargin!=null?finite(legacyOptions.textMargin,2)*
                    0.2645833333:defined(source.textMargin,legacyOptions.textMargin);
            element.format=String(defined(source.format,"CODE128")).toUpperCase();
            element.fallbackFormat=String(defined(source.fallbackFormat,"CODE128")).toUpperCase();
            element.displayValue=defined(source.displayValue,
                source.barcodeOptions&&source.barcodeOptions.displayValue)!==false;
            element.quietZone=finite(source.quietZone,0);
            element.minModuleWidth=finite(source.minModuleWidth,0);
            element.overflow=String(defined(source.overflow,"error"));
            element.humanReadableFontSize=finite(legacyFontSize,16);
            element.humanReadableMinFontSize=finite(source.humanReadableMinFontSize,
                Math.min(element.humanReadableFontSize,6));
            element.humanReadableFontFamily=String(defined(source.humanReadableFontFamily,
                source.barcodeOptions&&source.barcodeOptions.font||"courier"));
            element.humanReadableFontStyle=String(defined(source.humanReadableFontStyle,
                source.barcodeOptions&&source.barcodeOptions.fontOptions||"normal"));
            element.humanReadableColor=String(defined(source.humanReadableColor,
                source.barcodeOptions&&source.barcodeOptions.lineColor||"#000000"));
            element.humanReadablePosition=String(defined(source.humanReadablePosition,
                source.barcodeOptions&&source.barcodeOptions.textPosition||"bottom"));
            element.humanReadableAlign=String(defined(source.humanReadableAlign,
                source.barcodeOptions&&source.barcodeOptions.textAlign||"center"));
            element.textMargin=finite(legacyTextMargin,2);
            element.autoFit=source.autoFit!==false;
            element.textOverflow=String(defined(source.textOverflow,"error"));
            element.barcodeOptions=clone(source.barcodeOptions||{});
        }else if(type==="container"){
            const layout=source.layout||{};
            element.layout={
                direction:String(defined(layout.direction,defined(source.direction,"vertical"))),
                padding:normalizeInsets(defined(layout.padding,source.padding),0),
                gap:finite(defined(layout.gap,source.gap),0),
                crossAlign:String(defined(layout.crossAlign,defined(source.crossAlign,"stretch"))),
                mainAlign:String(defined(layout.mainAlign,defined(source.mainAlign,"start"))),
                sizing:String(defined(layout.sizing,defined(source.sizing,"none"))),
                overflow:String(defined(layout.overflow,defined(source.overflow,"error"))),
                clipChildren:defined(layout.clipChildren,source.clipChildren)===true,
                children:Array.isArray(layout.children)?layout.children.map(String):[]
            };
        }
        if(source.basisBox||source.basisWidth!=null||source.basisHeight!=null){
            const basis=source.basisBox||{};
            element.basisBox={width:finite(defined(basis.width,source.basisWidth),element.box.width),
                height:finite(defined(basis.height,source.basisHeight),element.box.height)};
        }
        return element;
    }
    function normalizeLayout(input){
        if(typeof input==="string")input=JSON.parse(input);
        if(!input||typeof input!=="object")throw new Error("Contrato de rotulo invalido.");
        const sourceVersion=input.version==null?1:Number(input.version);
        if(!Number.isInteger(sourceVersion)||sourceVersion<1||sourceVersion>CONTRACT_VERSION)
            throw contractError("CONTRACT_VERSION_UNSUPPORTED",
                "Versao de contrato nao suportada: "+String(input.version)+".","/version");
        if(input.schema!=null&&String(input.schema)!==SCHEMA)
            throw contractError("CONTRACT_SCHEMA_INVALID",
                "Schema de contrato nao suportado: "+String(input.schema)+".","/schema");
        const page=input.page||{},background=input.background;
        const normalized={
            schema:SCHEMA,version:CONTRACT_VERSION,name:String(defined(input.name,"rotulo")),unit:"mm",
            page:{
                width:finite(page.width,100),height:finite(page.height,60),
                rotation:finite(page.rotation,0),margins:normalizeInsets(page.margins,0),
                safeArea:finite(page.safeArea,0),bleed:finite(page.bleed,0)
            },
            editor:normalizeEditor(input.editor),
            variables:clone(Array.isArray(input.variables)?input.variables:[]),
            barcodeAutoRules:clone(Array.isArray(input.barcodeAutoRules)?input.barcodeAutoRules:[]),
            barcodeFallbackFormat:String(defined(input.barcodeFallbackFormat,"CODE128")).toUpperCase(),
            elements:(Array.isArray(input.elements)?input.elements:[]).map(function(element,index){
                return normalizeElement(element,index,sourceVersion);
            }),
            background:typeof background==="string"?{
                dataUrl:background,fit:"fill",opacity:1,locked:true
            }:(background&&typeof background==="object"?{
                dataUrl:String(defined(background.dataUrl,"")),
                fit:String(defined(background.fit,"fill")),
                opacity:finite(background.opacity,1),locked:background.locked!==false
            }:null)
        };
        if(sourceVersion===1){
            normalized.elements.filter(function(element){return element.type==="container";})
                .forEach(function(container){
                    if(!container.layout.children.length)container.layout.children=normalized.elements
                        .filter(function(element){return element.containerId===container.id;})
                        .map(function(element){return element.id;});
                });
