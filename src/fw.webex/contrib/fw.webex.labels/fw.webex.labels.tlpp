      <button type="button" role="tab" data-tab-group="toolbar" data-tab-target="selection"
        aria-selected="false" tabindex="-1">Sele&ccedil;&atilde;o</button>
      <button type="button" role="tab" data-tab-group="toolbar" data-tab-target="view"
        aria-selected="false" tabindex="-1">Visualiza&ccedil;&atilde;o</button>
