            variable.label||leaf||"EXEMPLO").trim();
        return {value:(label||"EXEMPLO").replace(/([a-z0-9])([A-Z])/g,"$1 $2")
            .toUpperCase(),source:"name"};
    }
    function setMissingSamplePath(record,path,value){
        const keys=pathParts(path);
        if(!keys)return {status:"unsafe",at:path};
        let current=record;
        for(let index=0;index<keys.length;index++){
            const key=keys[index],last=index===keys.length-1,
                at=keys.slice(0,index+1).join(".");
            if(last){
                if(Object.prototype.hasOwnProperty.call(current,key))
                    return {status:"preserved",at:at};
                current[key]=clone(value);return {status:"added",at:at};
            }
            if(!Object.prototype.hasOwnProperty.call(current,key))current[key]={};
            else if(!current[key]||typeof current[key]!=="object"||
                Array.isArray(current[key]))return {status:"conflict",at:at};
            current=current[key];
        }
        return {status:"conflict",at:path};
    }
    function createSampleRecords(inputLayout,inputRecords,options){
        options=options||{};
        if(typeof inputLayout==="string")inputLayout=JSON.parse(inputLayout);
        const layout=inputLayout&&typeof inputLayout==="object"&&!Array.isArray(inputLayout)?
            inputLayout:{};
        if(typeof inputRecords==="string")inputRecords=JSON.parse(inputRecords||"[]");
        let records=inputRecords==null?[]:(Array.isArray(inputRecords)?inputRecords:[inputRecords]);
        if(records.some(function(record){
            return !record||typeof record!=="object"||Array.isArray(record);
        }))throw new Error("Os dados de exemplo devem ser um objeto JSON ou uma lista de objetos.");
        records=clone(records);let createdRecord=false;
        if(!records.length){records=[{}];createdRecord=true;}
        const descriptors=[],byPath=new Map(),warnings=[];
        function descriptor(path){
            if(!isSafePath(path)){
                if(!warnings.some(function(item){return item.path===path;}))warnings.push({
                    code:"SAMPLE_PATH_UNSAFE",path:path,
                    message:"Mnemonico ignorado por usar um caminho inseguro."
                });
                return null;
            }
            if(!byPath.has(path)){
                const entry={path:path,variable:null,elementIds:[],barcodeFormats:[]};
                byPath.set(path,entry);descriptors.push(entry);
            }
            return byPath.get(path);
        }
        if(options.includeDeclaredVariables!==false)
            (Array.isArray(layout.variables)?layout.variables:[])
            .forEach(function(variable){
                if(!variable||!variable.name)return;
                const entry=descriptor(String(variable.name));
                if(entry&&!entry.variable)entry.variable=variable;
            });
        (Array.isArray(layout.elements)?layout.elements:[]).forEach(function(element){
            if(!element||typeof element!=="object")return;
            const paths=templatePaths(element.template),exact=
                /^\s*\{\{\s*([A-Za-z_][A-Za-z0-9_.]*)\s*\}\}\s*$/.exec(
                    String(element.template||""));
            paths.forEach(function(path){
                const entry=descriptor(path);if(!entry)return;
                if(entry.elementIds.indexOf(element.id)<0)entry.elementIds.push(element.id);
                if(element.type==="barcode"&&exact&&exact[1]===path){
                    let format=String(element.format||"AUTO").toUpperCase();
                    if(format==="AUTO")format=String(element.fallbackFormat||
                        layout.barcodeFallbackFormat||"CODE128").toUpperCase();
                    if(entry.barcodeFormats.indexOf(format)<0)
                        entry.barcodeFormats.push(format);
                }
            });
        });
        descriptors.forEach(function(entry){
            if(entry.barcodeFormats.length>1)warnings.push({
                code:"SAMPLE_BARCODE_FORMAT_CONFLICT",path:entry.path,
                message:"O mnemonico alimenta codigos de barras com formatos diferentes.",
                formats:entry.barcodeFormats.slice()
            });
        });
        const added=[],preserved=[],conflicts=[];
        records.forEach(function(record,recordIndex){
            descriptors.forEach(function(entry){
                const sample=sampleDescriptorValue(entry,layout),result=
                    setMissingSamplePath(record,entry.path,sample.value),detail={
                        recordIndex:recordIndex,path:entry.path,value:clone(sample.value),
                        source:sample.source,at:result.at
                    };
                if(result.status==="added")added.push(detail);
                else if(result.status==="preserved")preserved.push(detail);
                else if(result.status==="conflict")conflicts.push(detail);
            });
        });
        return {
            records:records,paths:descriptors.map(function(entry){return entry.path;}),
            added:added,preserved:preserved,conflicts:conflicts,warnings:warnings,
            createdRecord:createdRecord,changed:createdRecord||added.length>0
        };
    }
    function insetsHaveValue(value){
        return value.top!==0||value.right!==0||value.bottom!==0||value.left!==0;
    }
    function rotatedBounds(element){
        const box=element.box,angle=((finite(element.rotation,0)%360)+360)%360;
        if(angle===0)return {x:box.x,y:box.y,width:box.width,height:box.height};
        const radians=angle*Math.PI/180,c=Math.cos(radians),s=Math.sin(radians);
        const cx=box.x+box.width/2,cy=box.y+box.height/2;
        const points=[[box.x,box.y],[box.x+box.width,box.y],
            [box.x+box.width,box.y+box.height],[box.x,box.y+box.height]].map(function(point){
            const dx=point[0]-cx,dy=point[1]-cy;
            return {x:cx+dx*c-dy*s,y:cy+dx*s+dy*c};
        });
        const xs=points.map(function(point){return point.x;}),ys=points.map(function(point){return point.y;});
        const left=Math.min.apply(Math,xs),top=Math.min.apply(Math,ys);
        return {x:left,y:top,width:Math.max.apply(Math,xs)-left,height:Math.max.apply(Math,ys)-top};
    }
    function variableTypeMatches(value,type){
        type=String(type||"").toLowerCase();
        if(!type)return true;
        if(type==="array")return Array.isArray(value);
        if(type==="integer")return typeof value==="number"&&Number.isInteger(value);
        if(type==="number")return typeof value==="number"&&Number.isFinite(value);
        if(type==="object")return value!==null&&typeof value==="object"&&!Array.isArray(value);
        return typeof value===type;
    }
    function validateRawNumber(issues,value,path,options){
        options=options||{};
        if(value===undefined){
            if(options.required)issues.push(issue("NUMBER_REQUIRED","error",path,
                "O valor numerico e obrigatorio.","Informe um numero JSON valido."));
            return;
        }
        if(typeof value!=="number"||!Number.isFinite(value)||
            (options.positive&&!(value>0))||(options.nonNegative&&value<0)||
            (options.integer&&!Number.isInteger(value))||
            (options.min!=null&&value<options.min)||(options.max!=null&&value>options.max))
            issues.push(issue("NUMBER_INVALID","error",path,
                "O valor deve ser um numero "+(options.positive?"positivo":
                    options.nonNegative?"nao negativo":options.integer?"inteiro":"finito")+".",
                "Informe um numero JSON valido."));
    }
    function validateRawInsets(issues,value,path){
        if(value===undefined)return;
        if(typeof value==="number"){
            validateRawNumber(issues,value,path,{nonNegative:true});return;
        }
        if(!value||typeof value!=="object"||Array.isArray(value)){
            issues.push(issue("INSETS_INVALID","error",path,
                "O valor deve ser um numero ou objeto de lados.",
                "Use numero, {x,y} ou {top,right,bottom,left}."));return;
        }
        ["x","y","top","right","bottom","left"].forEach(function(side){
            validateRawNumber(issues,value[side],path+"/"+side,{nonNegative:true});
        });
    }
    function validateRawContract(source){
        const issues=[];
        if(!source||typeof source!=="object"||Array.isArray(source)){
            issues.push(issue("CONTRACT_INVALID","error","",
                "Contrato de rotulo deve ser um objeto JSON.","Informe um objeto de layout."));
            return issues;
        }
        const version=source.version==null?1:source.version;
        if(typeof version!=="number"||!Number.isInteger(version))
            issues.push(issue("CONTRACT_VERSION_INVALID","error","/version",
                "Version deve ser um numero inteiro.","Use version 1 ou 2."));
        if(version===2&&source.schema==null)
            issues.push(issue("CONTRACT_SCHEMA_REQUIRED","error","/schema",
                "Contratos version 2 devem informar schema.",
                "Use schema fwwebex.labels."));
        if(source.unit!==undefined&&source.unit!=="mm")
            issues.push(issue("CONTRACT_UNIT_INVALID","error","/unit",
                "A unidade canonica do contrato deve ser mm.","Use unit: mm."));
        if(!source.page||typeof source.page!=="object"||Array.isArray(source.page))
            issues.push(issue("PAGE_REQUIRED","error","/page",
                "O contrato precisa de um objeto page.","Informe tamanho e rotacao da pagina."));
        else{
            validateRawNumber(issues,source.page.width,"/page/width",
                {positive:true,required:version===2});
            validateRawNumber(issues,source.page.height,"/page/height",
                {positive:true,required:version===2});
            validateRawNumber(issues,source.page.rotation,"/page/rotation");
            validateRawNumber(issues,source.page.safeArea,"/page/safeArea",{nonNegative:true});
            validateRawNumber(issues,source.page.bleed,"/page/bleed",{nonNegative:true});
            validateRawInsets(issues,source.page.margins,"/page/margins");
        }
        if(source.background!==undefined&&source.background!==null&&
            typeof source.background!=="string"&&
            (typeof source.background!=="object"||Array.isArray(source.background)))
            issues.push(issue("BACKGROUND_INVALID","error","/background",
                "Background deve ser Data URI no v1 ou objeto no v2.",
                "Reimporte a imagem de fundo."));
        if(version===2&&typeof source.background==="string")
            issues.push(issue("BACKGROUND_LEGACY_SHAPE","warning","/background",
                "Background string foi aceito por compatibilidade.",
                "Ao salvar, use background.dataUrl."));
        if(source.background&&typeof source.background==="object"&&!Array.isArray(source.background)){
            if(source.background.dataUrl!==undefined&&typeof source.background.dataUrl!=="string")
                issues.push(issue("BACKGROUND_DATA_URI_TYPE_INVALID","error","/background/dataUrl",
                    "background.dataUrl deve ser texto.","Informe uma Data URI de imagem."));
            if(source.background.fit!==undefined&&
                ["fill","contain","cover","none"].indexOf(source.background.fit)<0)
                issues.push(issue("BACKGROUND_FIT_INVALID","error","/background/fit",
                    "Modo de ajuste do background invalido.","Use fill, contain, cover ou none."));
            validateRawNumber(issues,source.background.opacity,"/background/opacity",
                {min:0,max:1});
            if(source.background.locked!==undefined&&typeof source.background.locked!=="boolean")
                issues.push(issue("BACKGROUND_LOCK_INVALID","error","/background/locked",
                    "background.locked deve ser booleano.","Use true ou false."));
        }
        if(source.variables!==undefined&&!Array.isArray(source.variables))
            issues.push(issue("VARIABLES_INVALID","error","/variables",
                "Variables deve ser um array.","Informe uma lista de variaveis."));
        if(Array.isArray(source.variables))source.variables.forEach(function(variable,index){
            const path=pointer("variables",index);
            if(!variable||typeof variable!=="object"||Array.isArray(variable)){
                issues.push(issue("VARIABLE_INVALID","error",path,
                    "Cada variavel deve ser um objeto.","Corrija ou remova a declaracao."));return;
            }
            if(typeof variable.name!=="string"||!variable.name.trim())
                issues.push(issue("VARIABLE_NAME_REQUIRED","error",path+"/name",
                    "A variavel precisa de um nome.","Informe o caminho do mnemonico."));
            if(variable.type!==undefined&&
                ["string","number","integer","boolean","object","array"].indexOf(
                    String(variable.type).toLowerCase())<0)
                issues.push(issue("VARIABLE_TYPE_UNSUPPORTED","error",path+"/type",
                    "Tipo de variavel nao suportado: "+variable.type+".",
                    "Use string, number, integer, boolean, object ou array."));
            if(variable.required!==undefined&&typeof variable.required!=="boolean")
                issues.push(issue("VARIABLE_REQUIRED_TYPE_INVALID","error",path+"/required",
                    "required deve ser booleano.","Use true ou false."));
        });
        if(source.barcodeAutoRules!==undefined&&!Array.isArray(source.barcodeAutoRules))
            issues.push(issue("BARCODE_AUTO_RULES_INVALID","error","/barcodeAutoRules",
                "barcodeAutoRules deve ser um array.","Informe uma lista de regras."));
        if(Array.isArray(source.barcodeAutoRules))
            source.barcodeAutoRules.forEach(function(rule,index){
                const path=pointer("barcodeAutoRules",index);
                if(!rule||typeof rule!=="object"||Array.isArray(rule)){
                    issues.push(issue("BARCODE_AUTO_RULE_INVALID","error",path,
                        "Cada regra AUTO deve ser um objeto.","Corrija ou remova a regra."));
                    return;
                }
                validateRawNumber(issues,rule.length,path+"/length",
                    {positive:true,integer:true});
                if(rule.pattern!==undefined&&typeof rule.pattern!=="string")
                    issues.push(issue("BARCODE_AUTO_PATTERN_TYPE_INVALID","error",
                        path+"/pattern","pattern deve ser uma string.",
                        "Informe uma expressao regular em texto."));
                if(typeof rule.pattern==="string"){
                    try{new RegExp(rule.pattern);}
                    catch(error){
                        issues.push(issue("BARCODE_AUTO_PATTERN_INVALID","error",
                            path+"/pattern","Expressao regular invalida: "+error.message,
                            "Corrija o pattern da regra AUTO."));
                    }
                }
                if(typeof rule.format!=="string"||!rule.format.trim())
                    issues.push(issue("BARCODE_AUTO_FORMAT_REQUIRED","error",path+"/format",
                        "A regra AUTO precisa de um formato.",
                        "Informe uma simbologia suportada pelo JsBarcode."));
            });
        if(!Array.isArray(source.elements)){
            issues.push(issue("ELEMENTS_INVALID","error","/elements",
                "Elements deve ser um array.","Informe uma lista, mesmo que vazia."));
            return issues;
        }
        source.elements.forEach(function(element,index){
            const path=pointer("elements",index);
            if(!element||typeof element!=="object"||Array.isArray(element)){
                issues.push(issue("ELEMENT_INVALID","error",path,
                    "Elemento deve ser um objeto.","Corrija ou remova o item."));return;
            }
            if(version===2&&(typeof element.id!=="string"||!element.id.trim()))
                issues.push(issue("ELEMENT_ID_REQUIRED","error",path+"/id",
                    "O elemento precisa de um ID.","Informe um identificador unico."));
            if(version===2&&(typeof element.type!=="string"||!element.type.trim()))
                issues.push(issue("ELEMENT_TYPE_REQUIRED","error",path+"/type",
                    "O elemento precisa de um tipo.","Use text, barcode ou container."));
            if(version===2&&(!element.box||typeof element.box!=="object"||
                Array.isArray(element.box)))
                issues.push(issue("ELEMENT_BOX_REQUIRED","error",path+"/box",
                    "Contratos v2 devem informar box.","Use box com x, y, width e height."));
            const box=element.box&&typeof element.box==="object"?element.box:element;
            ["x","y"].forEach(function(name){
                validateRawNumber(issues,box[name],path+(element.box?"/box/":"/")+name,
                    {required:version===2});
            });
            ["width","height"].forEach(function(name){
                validateRawNumber(issues,box[name],path+(element.box?"/box/":"/")+name,
                    {positive:true,required:version===2});
            });
            validateRawNumber(issues,element.rotation,path+"/rotation");
            validateRawNumber(issues,element.zIndex,path+"/zIndex");
            if(String(element.type||"text").toLowerCase()==="text"){
                const style=element.style||{},fit=element.fit||{};
                validateRawNumber(issues,defined(style.fontSize,element.fontSize),
                    path+(element.style?"/style/fontSize":"/fontSize"),{positive:true});
                validateRawNumber(issues,defined(style.minFontSize,element.minFontSize),
                    path+(element.style?"/style/minFontSize":"/minFontSize"),{positive:true});
                validateRawNumber(issues,defined(style.lineHeightFactor,element.lineHeightFactor),
                    path+(element.style?"/style/lineHeightFactor":"/lineHeightFactor"),{positive:true});
                validateRawNumber(issues,defined(style.letterSpacing,element.letterSpacing),
                    path+(element.style?"/style/letterSpacing":"/letterSpacing"));
                validateRawNumber(issues,defined(fit.maxLines,element.maxLines),
                    path+(element.fit?"/fit/maxLines":"/maxLines"),
                    {positive:true,integer:true});
                validateRawInsets(issues,defined(style.padding,element.padding),
                    path+(element.style?"/style/padding":"/padding"));
                validateRawInsets(issues,defined(style.margin,element.margin),
                    path+(element.style?"/style/margin":"/margin"));
            }else if(String(element.type).toLowerCase()==="barcode"){
                ["quietZone","minModuleWidth","humanReadableFontSize",
                    "humanReadableMinFontSize","textMargin"].forEach(function(name){
                    validateRawNumber(issues,element[name],path+"/"+name,
                        {nonNegative:name==="quietZone"||name==="minModuleWidth"||name==="textMargin",
                            positive:name==="humanReadableFontSize"||
                                name==="humanReadableMinFontSize"});
                });
                if(element.barcodeOptions)
                    validateRawNumber(issues,element.barcodeOptions.width,
                        path+"/barcodeOptions/width",{positive:true});
                if(element.overflow!==undefined&&
                    ["error","allow"].indexOf(element.overflow)<0)
                    issues.push(issue("BARCODE_OVERFLOW_POLICY_INVALID","error",
                        path+"/overflow","Politica de modulo minimo invalida.",
                        "Use error ou allow."));
            }else if(String(element.type).toLowerCase()==="container"){
                const config=element.layout||element;
                validateRawNumber(issues,config.gap,path+(element.layout?"/layout/gap":"/gap"),
                    {nonNegative:true});
                validateRawInsets(issues,config.padding,
                    path+(element.layout?"/layout/padding":"/padding"));
            }
        });
        return issues;
    }
    function validateContract(input,records,options){
        options=options||{};
        let source=input;
        if(typeof source==="string"){
            try{source=JSON.parse(source);}
            catch(error){
                const problem=issue("CONTRACT_JSON_INVALID","error","",
                    "JSON do contrato invalido: "+error.message,
                    "Corrija a sintaxe do JSON.");
                return {valid:false,issues:[problem],errors:[problem],warnings:[],
                    layout:null,records:[],metrics:{}};
            }
        }
        const issues=validateRawContract(source);let layout;
        try{layout=normalizeLayout(source);}
        catch(error){
            const failures=Array.isArray(error.issues)?error.issues:[
                issue(error.code||"CONTRACT_INVALID","error","",error.message||"Contrato de rotulo invalido.")
            ];
            const combined=issues.concat(failures);
            return {valid:false,issues:combined,
                errors:combined.filter(function(item){return item.severity==="error";}),
                warnings:combined.filter(function(item){return item.severity==="warning";}),layout:null,
                records:[],metrics:{}};
        }
        if(typeof records==="string"){
            try{records=JSON.parse(records);}
            catch(error){
                issues.push(issue("DATA_JSON_INVALID","error","",
                    "JSON dos dados invalido: "+error.message,
                    "Corrija a sintaxe do JSON.",null,null,"data"));
                records=[];
            }
        }
        records=records==null?[]:(Array.isArray(records)?records:[records]);
        if(options.requireRecord===true&&!records.length)records=[{}];
        records.forEach(function(record,index){
            if(!record||typeof record!=="object"||Array.isArray(record))
                issues.push(issue("DATA_RECORD_INVALID","error",pointer(index),
                    "Cada registro deve ser um objeto JSON.",
                    "Informe um objeto ou um array de objetos.",null,index,"data"));
        });
        const preparedRecords=records.map(function(record){return clone(record||{});});
        const ids=new Map(),elementIndexes=new Map(),elements=layout.elements,page=layout.page;
        if([0,90,180,270].indexOf(page.rotation)<0)
            issues.push(issue("PAGE_ROTATION_INVALID","error","/page/rotation",
                "Rotacao da pagina deve ser 0, 90, 180 ou 270.","Escolha uma rotacao ortogonal."));
        if(!(page.width>0&&page.height>0))
            issues.push(issue("PAGE_SIZE_INVALID","error","/page",
                "Dimensoes da pagina devem ser positivas.","Informe largura e altura maiores que zero."));
        ["margins"].forEach(function(name){
            const value=page[name];
            if(Object.keys(value).some(function(side){return !Number.isFinite(value[side])||value[side]<0;}))
                issues.push(issue("PAGE_INSETS_INVALID","error",pointer("page",name),
                    "Margens da pagina devem conter numeros nao negativos.",
                    "Corrija os quatro lados da margem."));
        });
        if(page.safeArea<0||page.bleed<0)
            issues.push(issue("PAGE_AREA_INVALID","error","/page",
                "Area segura e sangria nao podem ser negativas.","Use valores maiores ou iguais a zero."));
        if(page.margins.left+page.margins.right>=page.width||
            page.margins.top+page.margins.bottom>=page.height)
            issues.push(issue("PAGE_USABLE_AREA_INVALID","error","/page/margins",
                "As margens eliminaram a area util da pagina.",
                "Reduza as margens ou aumente a pagina.",null,null,"geometry",
                {page:{width:page.width,height:page.height},margins:clone(page.margins)}));
        if(page.margins.left+page.margins.right+page.safeArea*2>=page.width||
            page.margins.top+page.margins.bottom+page.safeArea*2>=page.height)
            issues.push(issue("PAGE_SAFE_AREA_INVALID","error","/page/safeArea",
                "Margens e area segura eliminaram a regiao recomendada para conteudo.",
                "Reduza safeArea/margens ou aumente a pagina.",null,null,"geometry"));
        if(layout.background){
            if(["fill","contain","cover","none"].indexOf(layout.background.fit)<0)
                issues.push(issue("BACKGROUND_FIT_INVALID","error","/background/fit",
                    "Modo de ajuste do background invalido.","Use fill, contain, cover ou none."));
            if(!Number.isFinite(layout.background.opacity)||layout.background.opacity<0||
                layout.background.opacity>1)
                issues.push(issue("BACKGROUND_OPACITY_INVALID","error","/background/opacity",
                    "A opacidade do background deve estar entre 0 e 1.",
                    "Informe um valor decimal entre 0 e 1."));
        }
        elements.forEach(function(element,index){
            const path=pointer("elements",index),box=element.box;
            elementIndexes.set(element,index);
            if(ids.has(element.id))issues.push(issue("ELEMENT_ID_DUPLICATE","error",path+"/id",
                "ID duplicado: "+element.id+".","Defina um ID unico.",element.id));
            else ids.set(element.id,element);
            if(!element.id)issues.push(issue("ELEMENT_ID_REQUIRED","error",path+"/id",
                "O elemento precisa de um ID.","Informe um identificador unico.",element.id));
            if(!(box.width>0&&box.height>0)||![box.x,box.y,box.width,box.height].every(Number.isFinite))
                issues.push(issue("ELEMENT_BOX_INVALID","error",path+"/box",
                    "Caixa possui coordenadas ou dimensoes invalidas.",
                    "Use numeros finitos e dimensoes positivas.",element.id));
            if(!Number.isFinite(element.rotation))
                issues.push(issue("ELEMENT_ROTATION_INVALID","error",path+"/rotation",
                    "Rotacao do elemento deve ser um numero finito.","Informe o angulo em graus.",element.id));
            const bounds=rotatedBounds(element);
            if(!(options.deferContainerBounds&&element.containerId)&&
                (bounds.x<0||bounds.y<0||bounds.x+bounds.width>page.width||
                    bounds.y+bounds.height>page.height))
                issues.push(issue("ELEMENT_OUTSIDE_PAGE","error",path+"/box",
                    "Elemento ultrapassa os limites da pagina, considerando sua rotacao.",
                    "Reposicione, reduza ou ajuste a rotacao do elemento.",element.id,null,"geometry",
                    {bounds:bounds,page:{width:page.width,height:page.height}}));
            if(!(options.deferContainerBounds&&element.containerId)){
                const safeBounds={
                    x:page.margins.left+page.safeArea,
                    y:page.margins.top+page.safeArea,
                    width:page.width-page.margins.left-page.margins.right-page.safeArea*2,
                    height:page.height-page.margins.top-page.margins.bottom-page.safeArea*2
                };
                if(safeBounds.width>0&&safeBounds.height>0&&
                    (bounds.x<safeBounds.x||bounds.y<safeBounds.y||
                    bounds.x+bounds.width>safeBounds.x+safeBounds.width||
                    bounds.y+bounds.height>safeBounds.y+safeBounds.height))
                    issues.push(issue("ELEMENT_OUTSIDE_SAFE_AREA","warning",path+"/box",
                        "Elemento ultrapassa a area reservada/segura da pagina.",
                        "Confira margens e safeArea; a impressao nao sera recortada por este aviso.",
                        element.id,null,"geometry",
                        {bounds:bounds,safeBounds:safeBounds}));
            }
            if(["text","barcode","container"].indexOf(element.type)<0)
                issues.push(issue("ELEMENT_TYPE_UNSUPPORTED","error",path+"/type",
                    "Tipo de elemento nao suportado: "+element.type+".",
                    "Use text, barcode ou container.",element.id));
            templateTokens(element.template).problems.forEach(function(problem){
                issues.push(issue("TEMPLATE_SYNTAX_INVALID","error",path+"/template",
                    problem.reason+" Trecho: "+problem.token,
                    "Use placeholders no formato {{produto.codigo}}.",element.id,null,
                    "contract",problem));
            });
            if(element.type==="text"){
                const style=element.style,fit=element.fit,padding=style.padding;
                if(!(style.fontSize>0&&style.minFontSize>0&&style.minFontSize<=style.fontSize))
                    issues.push(issue("TEXT_FONT_RANGE_INVALID","error",path+"/style",
                        "Tamanhos de fonte devem ser positivos e minFontSize nao pode superar fontSize.",
                        "Ajuste os limites de fonte.",element.id));
                if(["left","center","right","justify"].indexOf(style.align)<0)
                    issues.push(issue("TEXT_ALIGN_INVALID","error",path+"/style/align",
                        "Alinhamento horizontal invalido.","Use left, center, right ou justify.",element.id));
                if(["top","middle","bottom"].indexOf(style.verticalAlign)<0)
                    issues.push(issue("TEXT_VERTICAL_ALIGN_INVALID","error",path+"/style/verticalAlign",
                        "Alinhamento vertical invalido.","Use top, middle ou bottom.",element.id));
                if(["none","shrink"].indexOf(fit.mode)<0)
                    issues.push(issue("TEXT_FIT_MODE_INVALID","error",path+"/fit/mode",
                        "Modo de autoajuste invalido.","Use none ou shrink.",element.id));
                if(["error","clip","ellipsis"].indexOf(fit.overflow)<0)
                    issues.push(issue("TEXT_OVERFLOW_POLICY_INVALID","error",path+"/fit/overflow",
                        "Politica de excesso invalida.","Use error, clip ou ellipsis.",element.id));
                if(["normal","bold","italic","bolditalic"].indexOf(
                    String(style.fontStyle).toLowerCase().replace(/\s+/g,""))<0)
                    issues.push(issue("TEXT_FONT_STYLE_INVALID","error",path+"/style/fontStyle",
                        "Estilo de fonte invalido.",
                        "Use normal, bold, italic ou bolditalic.",element.id));
                if(Object.keys(padding).some(function(side){return !Number.isFinite(padding[side])||padding[side]<0;}))
                    issues.push(issue("TEXT_PADDING_INVALID","error",path+"/style/padding",
                        "Padding deve conter numeros nao negativos.","Corrija os quatro lados.",element.id));
                const contentBox={x:box.x+padding.left,y:box.y+padding.top,
                    width:box.width-padding.left-padding.right,
                    height:box.height-padding.top-padding.bottom};
                if(!(contentBox.width>0&&contentBox.height>0))
                    issues.push(issue("TEXT_CONTENT_BOX_INVALID","error",path+"/style/padding",
                        "O padding eliminou a area util do texto.",
                        "Aumente a caixa ou reduza o padding.",element.id,null,"layout",
                        {contentBox:contentBox,padding:padding}));
                if(!element.containerId&&insetsHaveValue(style.margin))
                    issues.push(issue("TEXT_ABSOLUTE_MARGIN_IGNORED","warning",path+"/style/margin",
                        "Margin nao altera o posicionamento absoluto deste texto.",
                        "Associe o elemento a um container ou use x/y.",element.id));
            }
            if(element.type==="barcode"){
                const width=finite(element.barcodeOptions.width,2);
                if(width<=0)issues.push(issue("BARCODE_RENDER_WIDTH_INVALID","error",
                    path+"/barcodeOptions/width","A largura de modulo do JsBarcode deve ser positiva.",
                    "Use barcodeOptions.width maior que zero.",element.id));
                if(element.quietZone<0||element.minModuleWidth<0||element.textMargin<0||
                    element.humanReadableFontSize<=0||element.humanReadableMinFontSize<=0||
                    element.humanReadableMinFontSize>element.humanReadableFontSize)
                    issues.push(issue("BARCODE_DIMENSION_INVALID","error",path,
                        "Medidas do codigo de barras devem ser positivas; quietZone e textMargin aceitam zero.",
                        "Revise quietZone, minModuleWidth, textMargin e os limites de fonte.",element.id));
                if(["error","clip","ellipsis"].indexOf(element.textOverflow)<0)
                    issues.push(issue("BARCODE_TEXT_OVERFLOW_POLICY_INVALID","error",
                        path+"/textOverflow","Politica do texto legivel invalida.",
                        "Use error, clip ou ellipsis.",element.id));
                if(["top","bottom"].indexOf(element.humanReadablePosition)<0)
                    issues.push(issue("BARCODE_TEXT_POSITION_INVALID","error",
                        path+"/humanReadablePosition","Posicao do texto legivel invalida.",
                        "Use top ou bottom.",element.id));
                if(["left","center","right"].indexOf(element.humanReadableAlign)<0)
                    issues.push(issue("BARCODE_TEXT_ALIGN_INVALID","error",
                        path+"/humanReadableAlign","Alinhamento do texto legivel invalido.",
                        "Use left, center ou right.",element.id));
                if(["error","allow"].indexOf(element.overflow)<0)
                    issues.push(issue("BARCODE_OVERFLOW_POLICY_INVALID","error",
                        path+"/overflow","Politica de modulo minimo invalida.",
                        "Use error para bloquear ou allow para aceitar com aviso.",element.id));
                if(!element.format)
                    issues.push(issue("BARCODE_FORMAT_REQUIRED","error",path+"/format",
                        "O barcode precisa de um formato.",
                        "Informe AUTO ou uma simbologia suportada pelo JsBarcode.",element.id));
            }
            if(element.type==="container"){
                const config=element.layout;
                if(element.rotation%360!==0)
                    issues.push(issue("CONTAINER_ROTATION_UNSUPPORTED","error",path+"/rotation",
                        "Containers ainda nao aceitam rotacao propria.",
                        "Use rotacao zero no container e rotacione os filhos quando necessario.",element.id));
                if(["vertical","horizontal"].indexOf(config.direction)<0)
                    issues.push(issue("CONTAINER_DIRECTION_INVALID","error",path+"/layout/direction",
                        "Direcao de container invalida.","Use vertical ou horizontal.",element.id));
                if(["none","shrink","equal","distribute"].indexOf(config.sizing)<0)
                    issues.push(issue("CONTAINER_SIZING_INVALID","error",path+"/layout/sizing",
                        "Politica de dimensionamento invalida.",
                        "Use none, shrink, equal ou distribute.",element.id));
                const crossValues=config.direction==="horizontal"?
                    ["stretch","top","middle","bottom","start","center","end"]:
                    ["stretch","left","center","right","start","end"];
                if(crossValues.indexOf(config.crossAlign)<0)
                    issues.push(issue("CONTAINER_CROSS_ALIGN_INVALID","error",
                        path+"/layout/crossAlign","Alinhamento transversal invalido.",
                        "Use um alinhamento compativel com a direcao.",element.id));
                if(["start","center","end","space-between"].indexOf(config.mainAlign)<0)
                    issues.push(issue("CONTAINER_MAIN_ALIGN_INVALID","error",
                        path+"/layout/mainAlign","Alinhamento principal invalido.",
                        "Use start, center, end ou space-between.",element.id));
                if(["error","visible","clip"].indexOf(config.overflow)<0)
                    issues.push(issue("CONTAINER_OVERFLOW_POLICY_INVALID","error",
                        path+"/layout/overflow","Politica de excesso do container invalida.",
                        "Use error, visible ou clip.",element.id));
                if(config.gap<0||Object.keys(config.padding).some(function(side){
                    return !Number.isFinite(config.padding[side])||config.padding[side]<0;
                }))issues.push(issue("CONTAINER_SPACING_INVALID","error",path+"/layout",
                    "Padding e gap do container devem ser nao negativos.",
                    "Corrija padding e gap.",element.id));
            }
        });
        const containers=elements.filter(function(element){return element.type==="container";});
        elements.forEach(function(element,index){
            if(element.containerId){
                const parent=ids.get(element.containerId);
                if(!parent)issues.push(issue("CONTAINER_NOT_FOUND","error",
                    pointer("elements",index,"containerId"),
                    "Container "+element.containerId+" nao existe.",
                    "Remova ou corrija containerId.",element.id));
                else if(parent.type!=="container")issues.push(issue("CONTAINER_PARENT_TYPE_INVALID","error",
                    pointer("elements",index,"containerId"),
                    element.containerId+" nao e um container.",
                    "Associe o elemento a um componente do tipo container.",element.id));
            }
            if(element.containerId===element.id)
                issues.push(issue("CONTAINER_SELF_REFERENCE","error",
                    pointer("elements",index,"containerId"),
                    "Elemento nao pode ser filho de si mesmo.","Remova o ciclo.",element.id));
        });
        containers.forEach(function(container){
            const containerIndex=elementIndexes.get(container);
            const actualChildren=elements.filter(function(element){return element.containerId===container.id;});
            const ordered=container.layout.children,seenChildren=new Set();
            ordered.forEach(function(childId,childIndex){
                const child=ids.get(childId),childPath=pointer("elements",containerIndex,"layout","children",childIndex);
                if(seenChildren.has(childId))issues.push(issue("CONTAINER_CHILD_DUPLICATE","error",childPath,
                    "Filho repetido na ordem do container: "+childId+".",
                    "Mantenha cada ID uma unica vez.",container.id));
                seenChildren.add(childId);
                if(!child)issues.push(issue("CONTAINER_CHILD_NOT_FOUND","error",childPath,
                    "Filho "+childId+" nao existe.","Remova ou corrija o ID.",container.id));
                else if(child.containerId!==container.id)
                    issues.push(issue("CONTAINER_CHILD_PARENT_MISMATCH","error",childPath,
                        "O filho "+childId+" nao aponta para o container "+container.id+".",
                        "Sincronize containerId e layout.children.",child.id));
            });
            actualChildren.forEach(function(child){
                if(ordered.indexOf(child.id)<0)issues.push(issue("CONTAINER_CHILD_ORDER_MISSING","warning",
                    pointer("elements",containerIndex,"layout","children"),
                    "O filho "+child.id+" nao esta na ordem explicita do container.",
                    "Inclua o ID em layout.children.",child.id));
            });
            if(!actualChildren.length)issues.push(issue("CONTAINER_EMPTY","warning",
                pointer("elements",containerIndex,"layout","children"),
                "Container "+container.id+" nao possui filhos.",
                "Associe elementos ou remova o container.",container.id));
        });
        const reportedCycles=new Set();
        elements.forEach(function(element,index){
            let current=element,visited=new Set();
            while(current&&current.containerId){
                if(visited.has(current.id)||visited.has(current.containerId)){
                    const key=Array.from(visited).sort().join("|");
                    if(!reportedCycles.has(key)){
                        reportedCycles.add(key);
                        issues.push(issue("CONTAINER_CYCLE","error",
                            pointer("elements",index,"containerId"),
                            "Ciclo detectado na hierarquia de containers.",
                            "Remova um dos vinculos circulares.",element.id));
                    }
                    break;
                }
                visited.add(current.id);current=ids.get(current.containerId);
            }
        });
        elements.filter(function(element){
            return element.type!=="container"&&!element.containerId;
        }).forEach(function(element){
            const center={x:element.box.x+element.box.width/2,y:element.box.y+element.box.height/2};
            const container=containers.find(function(candidate){
                return center.x>=candidate.box.x&&center.x<=candidate.box.x+candidate.box.width&&
                    center.y>=candidate.box.y&&center.y<=candidate.box.y+candidate.box.height;
            });
            if(container)issues.push(issue("ELEMENT_OVER_CONTAINER_UNASSIGNED","warning",
                pointer("elements",elementIndexes.get(element),"containerId"),
                "Elemento esta visualmente dentro de "+container.id+", mas nao pertence a ele.",
                "Defina containerId ou mova o elemento para fora da area.",element.id));
        });
        const declared=new Map(),used=new Map();
        layout.variables.forEach(function(variable,index){
            if(!variable||!variable.name)return;
            const name=String(variable.name),path=pointer("variables",index,"name");
            if(!isSafePath(name))issues.push(issue("VARIABLE_PATH_UNSAFE","error",path,
                "Caminho de variavel inseguro: "+name+".","Renomeie a variavel.",null));
            if(declared.has(name))issues.push(issue("VARIABLE_DUPLICATE","error",path,
                "Variavel duplicada: "+name+".","Mantenha uma unica declaracao.",null));
            else declared.set(name,{variable:variable,index:index});
        });
        elements.forEach(function(element,index){
            templatePaths(element.template).forEach(function(path){
                if(!isSafePath(path)){
                    issues.push(issue("VARIABLE_PATH_UNSAFE","error",
                        pointer("elements",index,"template"),
                        "Caminho de variavel inseguro no template: "+path+".",
                        "Renomeie o mnemonico.",element.id));
                    return;
                }
                if(!used.has(path))used.set(path,[]);
                used.get(path).push(element.id);
                if(!declared.has(path))issues.push(issue("VARIABLE_UNDECLARED","warning",
                    pointer("elements",index,"template"),
                    "Mnemonico "+path+" usado mas nao declarado.",
                    "Adicione-o em variables.",element.id));
            });
        });
        declared.forEach(function(entry,name){
            if(!used.has(name))issues.push(issue("VARIABLE_UNUSED","warning",
                pointer("variables",entry.index),
                "Mnemonico "+name+" foi declarado mas nao e usado.",
                "Remova-o ou utilize-o em um template."));
        });
        preparedRecords.forEach(function(record,recordIndex){
            layout.variables.forEach(function(variable,index){
                if(!variable||!variable.name||!isSafePath(variable.name))return;
                const name=String(variable.name),path=pointer("variables",index),raw=getPath(record,name);
                if(emptyValue(raw)&&variable.default!==undefined)setPath(record,name,clone(variable.default));
                const resolved=getPath(record,name);
                if(variable.required===true&&emptyValue(resolved))
                    issues.push(issue("VARIABLE_REQUIRED_MISSING","error",path,
                        "Valor obrigatorio ausente para "+name+".",
                        "Informe o valor ou configure default.",null,recordIndex));
                else if(!emptyValue(resolved)&&variable.type&&!variableTypeMatches(resolved,variable.type))
                    issues.push(issue("VARIABLE_TYPE_INVALID","error",path+"/type",
                        "Valor de "+name+" nao corresponde ao tipo "+variable.type+".",
                        "Corrija o dado ou a declaracao de tipo.",null,recordIndex,"data",
                        {expectedType:variable.type,actualType:Array.isArray(resolved)?"array":typeof resolved}));
            });
        });
        const errors=issues.filter(function(item){return item.severity==="error";});
        return {valid:!errors.length,issues:issues,errors:errors,
            warnings:issues.filter(function(item){return item.severity==="warning";}),
            layout:layout,records:preparedRecords,metrics:{}};
    }
    function value(template,data){
        return String(template==null?"":template).replace(/\{\{\s*([\w.]+)\s*\}\}/g,function(_,path){
            const current=getPath(data,path);
            return current==null?"":String(current);
        });
    }
    function prepareData(layout,input){
        const data=clone(input||{});
        (layout.variables||[]).forEach(function(variable){
            const name=variable.name;
            if(!name)return;
            const current=getPath(data,name);
            if((current===undefined||current===null||current==="") && variable.default!==undefined){
                setPath(data,name,variable.default);
            }
            const resolved=getPath(data,name);
            if(variable.required===true && (resolved===undefined||resolved===null||resolved==="")){
                throw new Error("Valor obrigatorio ausente para o mnemonico "+name+".");
            }
        });
        return data;
    }
    function engineError(problem){
        const error=new Error(problem.message);error.name="FWWebExLabelEngineError";
        error.code=problem.code;error.issue=problem;error.issues=[problem];return error;
    }
    function barcodeFormat(text,element,layout){
        const requested=String(element.format||"AUTO").toUpperCase();
        if(requested!=="AUTO")return requested;
        const rules=Array.isArray(layout.barcodeAutoRules)?layout.barcodeAutoRules:[];
        for(let index=0;index<rules.length;index++){
            const rule=rules[index];
            if(rule.length!=null && text.length!==Number(rule.length))continue;
            if(rule.pattern && !(new RegExp(rule.pattern)).test(text))continue;
            if(rule.format)return String(rule.format).toUpperCase();
        }
        return String(element.fallbackFormat||layout.barcodeFallbackFormat||"CODE128").toUpperCase();
    }
    function pdfBaseFont(name){
        name=String(name||"").toLowerCase();
        if(name==="monospace"||name==="courier"||name.indexOf("courier")>=0)return "courier";
        if(name==="serif"||name==="times"||name.indexOf("times")>=0)return "times";
        if(name==="sans-serif"||name==="arial"||name==="helvetica"||
            name.indexOf("arial")>=0||name.indexOf("helvetica")>=0)return "helvetica";
        return String(name||"helvetica");
    }
    function pdfFontStyle(value){
        value=String(value||"normal").toLowerCase().replace(/\s+/g,"");
        const bold=value.indexOf("bold")>=0,italic=value.indexOf("italic")>=0;
        return bold&&italic?"bolditalic":bold?"bold":italic?"italic":"normal";
    }
    function resolvePDFFont(pdf,requestedFamily,requestedStyle){
        const requested=String(requestedFamily||"helvetica");
        const mapped=pdfBaseFont(requested),style=pdfFontStyle(requestedStyle);
        if(typeof pdf.getFontList!=="function")
            return {family:mapped,style:style,fallback:false,requestedFamily:requested,
                requestedStyle:String(requestedStyle||"normal")};
        const list=pdf.getFontList()||{},families=Object.keys(list);
        function find(name){
            name=String(name||"").toLowerCase();
            return families.find(function(candidate){return candidate.toLowerCase()===name;});
        }
        let family=find(requested)||find(mapped),fallback=false;
        if(!family){family=find("helvetica")||families[0]||"helvetica";fallback=true;}
        else fallback=family.toLowerCase()!==requested.toLowerCase();
        const styles=Array.isArray(list[family])?list[family].map(function(item){
            return String(item).toLowerCase().replace(/\s+/g,"");
        }):[];
        let resolvedStyle=style;
        if(styles.length&&styles.indexOf(style)<0){
            resolvedStyle=styles.indexOf("normal")>=0?"normal":styles[0];fallback=true;
        }
        return {family:family,style:resolvedStyle,fallback:fallback,
            requestedFamily:requested,requestedStyle:String(requestedStyle||"normal")};
    }
    function barcode(text,element,boxWidth,boxHeight,layout,path,recordIndex){
        if(typeof JsBarcode!=="function")
            throw engineError(issue("BARCODE_DEPENDENCY_MISSING","error",path,
                "A dependencia JsBarcode nao esta disponivel.",
                "Habilite WebExFeatureLabels e aguarde o carregamento do script.",
                element.id,recordIndex,"dependency"));
        const format=barcodeFormat(text,element,layout);
        const barcodeOptions=Object.assign({width:2,height:80},element.barcodeOptions||{},{
            format:format,displayValue:false,margin:0,textMargin:0});
        const renderWidth=finite(barcodeOptions.width,2);
        if(!(renderWidth>0))throw engineError(issue("BARCODE_RENDER_WIDTH_INVALID","error",
            path+"/barcodeOptions/width","A largura de modulo do JsBarcode deve ser positiva.",
            "Use barcodeOptions.width maior que zero.",element.id,recordIndex,"barcode"));
        const metadata={};
        try{
            JsBarcode(metadata,text,barcodeOptions);
        }catch(error){
            throw engineError(issue("BARCODE_VALUE_INVALID","error",path+"/template",
                "Nao foi possivel gerar "+format+" com o valor informado: "+text+".",
                "Revise o valor, o formato e as regras AUTO.",element.id,recordIndex,"barcode",
                {format:format,value:text,cause:error&&error.message?error.message:String(error)}));
        }
        let encodedDisplayText=String(defined(barcodeOptions.text,text));
        if(element.displayValue!==false){
            const textMetadata={};
            try{
                JsBarcode(textMetadata,text,Object.assign({},barcodeOptions,{displayValue:true}));
                const canonical=(textMetadata.encodings||[]).map(function(encoding){
                    return encoding.text==null?"":String(encoding.text);
                }).join("");
                if(canonical)encodedDisplayText=canonical;
            }catch(error){
                throw engineError(issue("BARCODE_DISPLAY_VALUE_INVALID","error",path+"/template",
                    "O texto canonico do barcode nao pode ser determinado.",
                    "Revise valor, formato e opcoes do JsBarcode.",element.id,recordIndex,
                    "barcode",{format:format,value:text,
                        cause:error&&error.message?error.message:String(error)}));
            }
        }
        const encodings=(metadata.encodings||[]).map(function(encoding){
            return {data:String(encoding.data||""),
                height:Math.max(0.1,finite(encoding.options&&encoding.options.height,80)),
                lineColor:String(defined(encoding.options&&encoding.options.lineColor,
                    barcodeOptions.lineColor||"#000000"))};
        });
        const modules=encodings.reduce(function(total,encoding){
            return total+String(encoding.data||"").length;
        },0);
        if(!(modules>0))throw engineError(issue("BARCODE_ENCODING_EMPTY","error",path+"/template",
            "O codigo de barras nao produziu modulos.",
            "Revise o valor e o formato.",element.id,recordIndex,"barcode",{format:format,value:text}));
        const moduleWidth=boxWidth/modules;
        const minimum=Math.max(0,finite(element.minModuleWidth,0));
        const moduleBelowMinimum=minimum>0&&moduleWidth+0.000001<minimum;
        const requiredWidth=modules*minimum+Math.max(0,Number(element.quietZone)||0)*2;
        if(moduleBelowMinimum&&(element.overflow||"error")==="error"){
            throw engineError(issue("BARCODE_MODULE_TOO_NARROW","error",path+"/box/width",
                "Area insuficiente para o codigo "+text+": modulo "+
                    moduleWidth.toFixed(3)+" mm, minimo "+minimum+" mm.",
                "Aumente a largura do elemento para pelo menos "+requiredWidth.toFixed(2)+
                    " mm ou revise minModuleWidth, quietZone, formato e overflow.",
                element.id,recordIndex,"barcode",
                {format:format,value:text,moduleCount:modules,moduleWidth:moduleWidth,
                    minModuleWidth:minimum,requiredWidth:requiredWidth,availableWidth:boxWidth}));
        }
        return {encodings:encodings,format:format,moduleWidth:moduleWidth,
            moduleCount:modules,value:encodedDisplayText,
            inputValue:String(text),moduleBelowMinimum:moduleBelowMinimum,
            requiredWidth:requiredWidth,
            lineColor:String(defined(barcodeOptions.lineColor,"#000000")),
            background:String(defined(barcodeOptions.background,"#ffffff"))};
    }
    function fitBarcodeText(pdf,rendered,element,width,height,path,recordIndex){
        if(element.displayValue===false){
            rendered.displayText="";rendered.textSize=0;rendered.textHeight=0;
            rendered.textMargin=0;rendered.barsHeight=height;return rendered;
        }
        let size=Math.max(0.1,finite(element.humanReadableFontSize,16));
        const minimum=Math.max(0.1,finite(element.humanReadableMinFontSize,size));
        let displayText=rendered.value;
        const font=resolvePDFFont(pdf,element.humanReadableFontFamily,
            element.humanReadableFontStyle);
        pdf.setFont(font.family,font.style);pdf.setFontSize(size);
        let textWidth=pdf.getTextWidth(displayText);
        if(element.autoFit!==false){
            while(textWidth>width+0.0001&&size>minimum){
                size=Math.max(minimum,size-0.25);pdf.setFontSize(size);
                textWidth=pdf.getTextWidth(displayText);
            }
        }
        if(textWidth>width+0.0001){
            if(element.textOverflow==="ellipsis"){
                displayText=ellipsize(pdf,displayText,width);
                textWidth=pdf.getTextWidth(displayText);
            }else if(element.textOverflow!=="clip"){
                throw engineError(issue("BARCODE_TEXT_OVERFLOW","error",path+"/textOverflow",
                    "O texto legivel do codigo de barras nao cabe na largura disponivel.",
                    "Aumente a largura, reduza humanReadableMinFontSize ou use clip/ellipsis.",
                    element.id,recordIndex,"barcode",
                    {availableWidth:width,textWidth:textWidth,fontSize:size,minFontSize:minimum}));
            }
        }
        const textHeight=size*0.352778,textMargin=Math.max(0,finite(element.textMargin,0));
        const barsHeight=height-textHeight-textMargin;
        if(!(barsHeight>0))throw engineError(issue("BARCODE_HEIGHT_INSUFFICIENT","error",
            path+"/box/height","A altura do elemento nao comporta barras e texto legivel.",
            "Aumente a altura ou reduza humanReadableFontSize/textMargin.",
            element.id,recordIndex,"barcode",
            {availableHeight:height,barsHeight:barsHeight,humanReadableFontSize:size,
                humanReadableHeight:textHeight,textMargin:textMargin}));
        rendered.displayText=displayText;rendered.textSize=size;rendered.textHeight=textHeight;
        rendered.textMargin=textMargin;rendered.barsHeight=barsHeight;rendered.textWidth=textWidth;
        rendered.textFontFamily=font.family;rendered.textFontStyle=font.style;
        rendered.fontFallback=font.fallback?font:null;
        rendered.textColor=element.humanReadableColor;rendered.textPosition=element.humanReadablePosition;
        rendered.textAlign=element.humanReadableAlign;
        return rendered;
    }
    function ellipsize(pdf,text,width){
        let marker="...",source=String(text==null?"":text);
        while(marker&&pdf.getTextWidth(marker)>width+0.0001)marker=marker.slice(0,-1);
        if(!marker)return "";
        while(source&&pdf.getTextWidth(source+marker)>width+0.0001)
            source=source.slice(0,-1);
        return source+marker;
    }
    function textBaselineY(box,contentBox,style,size,lineHeight,lineCount){
        if(!(lineCount>0))return null;
        const contentHeight=lineCount*lineHeight;
        let baseline=contentBox.y+size*0.352778;
        if(style.verticalAlign==="middle")
            baseline+=(contentBox.height-contentHeight)/2;
        if(style.verticalAlign==="bottom")
            baseline+=contentBox.height-contentHeight;
        return baseline;
    }
    function fitText(pdf,text,element,path,recordIndex){
        const style=element.style||{},fit=element.fit||{},box=element.box;
        const padding=normalizeInsets(style.padding,0);
        const width=box.width-padding.left-padding.right;
        const height=box.height-padding.top-padding.bottom;
        const maximum=Math.max(0.1,finite(style.fontSize,10));
        const configuredMinimum=style.minFontSize==null?Math.max(3,maximum/3):
            finite(style.minFontSize,maximum);
        const minimum=Math.max(0.1,configuredMinimum);
        const factor=Math.max(0.5,finite(style.lineHeightFactor,1.15));
        const maxLines=Math.max(1,Math.floor(finite(fit.maxLines,999)));
        if(!(width>0&&height>0))throw engineError(issue("TEXT_CONTENT_BOX_INVALID","error",
            path+"/style/padding","O padding eliminou a area util do texto.",
            "Aumente a caixa ou reduza o padding.",element.id,recordIndex,"text",
            {contentBox:{x:box.x+padding.left,y:box.y+padding.top,width:width,height:height},
                padding:padding}));
        if(minimum>maximum)throw engineError(issue("TEXT_FONT_RANGE_INVALID","error",
            path+"/style/minFontSize","minFontSize nao pode superar fontSize.",
            "Reduza minFontSize ou aumente fontSize.",element.id,recordIndex,"text",
            {fontSize:maximum,minFontSize:minimum}));
        if(String(text)==="")
            return {lines:[],size:maximum,padding:padding,
                lineHeight:maximum*0.352778*factor,
                contentBox:{x:box.x+padding.left,y:box.y+padding.top,
                    width:width,height:height},overflowed:false,
                metrics:{contentBox:{x:box.x+padding.left,y:box.y+padding.top,
                    width:width,height:height},fontSize:maximum,minFontSize:minimum,
                    finalFontSize:maximum,lineCount:0,maxLines:maxLines,
                    overflowed:false,overflowPolicy:fit.overflow||"error",empty:true,
                    lineHeight:maximum*0.352778*factor,contentHeight:0,
                    baselineY:null,baselineOffset:null}};
        let size=maximum,lines=[];
        function measure(candidate){
            pdf.setFontSize(candidate);
            const split=pdf.splitTextToSize(text,width);
            const lineHeight=candidate*0.352778*factor;
            return {lines:split,lineHeight:lineHeight,height:split.length*lineHeight,
