    function resolveLayout(input,records,options){
        options=options||{};
        let report=validateContract(input,records,{
            deferContainerBounds:true,
            requireRecord:options.requireRecord===true
        });
        if(!report.valid)throw validationError(report);
        let layout=report.layout;
        records=report.records;
        const preliminaryIssues=report.issues.slice();
        try{layout=applyContainers(clone(layout));}
        catch(error){
            const failures=error.issues||[issue(error.code||"LAYOUT_FAILED","error","",
                error.message||"Falha no layout.","Revise containers e geometria.",
                null,null,"layout")];
            throw validationError(combinedReport(layout,records,failures,null));
        }
        const flowedLayout=layout;
        report=validateContract(layout,records,{
            requireRecord:options.requireRecord===true
        });
        if(!report.valid)throw validationError(report);
        layout=report.layout;records=report.records;
        const flowedById=new Map(flowedLayout.elements.map(function(element){
            return [element.id,element];
        }));
        layout.elements.forEach(function(element){
            const flowed=flowedById.get(element.id);
            if(element.type==="container"&&flowed&&flowed.hasOverflow===true)
                element.hasOverflow=true;
        });
        report=combinedReport(layout,records,preliminaryIssues,
            {issues:report.issues,metrics:{}});
        return {layout:layout,records:records,report:report};
    }
    function graphIndex(layout){
        const elements=Array.isArray(layout.elements)?layout.elements:[],
            byId=new Map(elements.map(function(item){return [item.id,item];}));
        function childrenOf(item){
            if(!item||item.type!=="container")return [];
            const explicit=item.layout&&Array.isArray(item.layout.children)?
                item.layout.children:[];
            const result=[],seen=new Set();
            explicit.forEach(function(id){
                const child=byId.get(id);
                if(child&&child.id!==item.id&&child.containerId===item.id&&!seen.has(child.id)){
                    seen.add(child.id);result.push(child);
                }
            });
            elements.forEach(function(child){
                if(child.id!==item.id&&child.containerId===item.id&&!seen.has(child.id)){
                    seen.add(child.id);result.push(child);
                }
            });
            return result;
        }
        function descendants(id,result){
            result=result||new Set();
            const parent=byId.get(id);
            childrenOf(parent).forEach(function(child){
                if(result.has(child.id))return;
                result.add(child.id);
                if(child.type==="container")descendants(child.id,result);
            });
            return result;
        }
        return {elements:elements,byId:byId,childrenOf:childrenOf,descendants:descendants};
    }
    function graphAssign(input,ids,containerId,options){
        options=options||{};
        const layout=clone(input),graph=graphIndex(layout);
        ids=Array.isArray(ids)?ids:[ids];
        ids=ids.map(String).filter(function(id,index,list){
            return graph.byId.has(id)&&id!==containerId&&list.indexOf(id)===index;
        });
        const container=graph.byId.get(containerId);
        if(!container||container.type!=="container")
            throw new Error("FWWebEx Labels: container de destino inexistente.");
        ids.forEach(function(id){
            const item=graph.byId.get(id);
            if(item.type==="container"&&graph.descendants(item.id).has(container.id))
                throw new Error("FWWebEx Labels: atribuicao criaria um ciclo de containers.");
        });
        graph.elements.forEach(function(item){
            if(item.type==="container"&&item.layout&&Array.isArray(item.layout.children))
                item.layout.children=item.layout.children.filter(function(id){
                    return ids.indexOf(id)<0;
                });
        });
        const children=container.layout.children||[];
        let index=Number.isFinite(Number(options.index))?
            Math.max(0,Math.min(children.length,Number(options.index))):children.length;
        ids.forEach(function(id,offset){
            const item=graph.byId.get(id);
            item.containerId=container.id;
            if(!item.basisBox)item.basisBox={
                width:item.box.width,height:item.box.height
            };
            children.splice(index+offset,0,id);
        });
        container.layout.children=children;
        return {layout:layout,ids:ids.slice()};
    }
    function graphDuplicate(input,ids,options){
        options=options||{};
        const layout=clone(input),graph=graphIndex(layout),
            selected=(Array.isArray(ids)?ids:[ids]).map(String).filter(function(id,index,list){
                return graph.byId.has(id)&&list.indexOf(id)===index;
            }),copyIds=new Set(selected);
        selected.forEach(function(id){
            const item=graph.byId.get(id);
            if(item&&item.type==="container")
                graph.descendants(id).forEach(function(childId){copyIds.add(childId);});
        });
        const sources=graph.elements.filter(function(item){return copyIds.has(item.id);}),
            idMap=Object.create(null),used=new Set(graph.elements.map(function(item){
                return item.id;
            })),factory=typeof options.idFactory==="function"?options.idFactory:function(id,index){
                return id+"-copy-"+(index+1);
            };
        sources.forEach(function(item,index){
            let next=String(factory(item.id,index,item)||"");
            if(!next)next=item.id+"-copy";
            let suffix=2,base=next;
            while(used.has(next)){next=base+"-"+suffix;suffix++;}
            used.add(next);idMap[item.id]=next;
        });
        const dx=finite(options.offsetX,2),dy=finite(options.offsetY,2),
            copiesBySource=new Map();
        sources.forEach(function(source){
            const copy=clone(source);
            copy.id=idMap[source.id];
            copy.locked=false;
            copy.box.x+=dx;copy.box.y+=dy;
            if(copy.containerId&&idMap[copy.containerId])
                copy.containerId=idMap[copy.containerId];
            if(copy.type==="container"){
                copy.layout.children=(copy.layout.children||[])
                    .filter(function(id){return !!idMap[id];})
                    .map(function(id){return idMap[id];});
            }
            copiesBySource.set(source.id,copy);
        });
        const output=[];
        graph.elements.forEach(function(item){
            output.push(item);
            const copy=copiesBySource.get(item.id);
            if(copy)output.push(copy);
        });
        layout.elements=output;
        const outputById=new Map(output.map(function(item){return [item.id,item];}));
        selected.forEach(function(sourceId){
            const source=graph.byId.get(sourceId),copyId=idMap[sourceId];
            if(!source||!copyId||!source.containerId||idMap[source.containerId])return;
            const parent=outputById.get(source.containerId);
            if(!parent||parent.type!=="container")return;
            const children=parent.layout.children||[],
                sourceIndex=children.indexOf(sourceId);
            if(sourceIndex>=0)children.splice(sourceIndex+1,0,copyId);
            else children.push(copyId);
            parent.layout.children=children;
        });
        return {
            layout:layout,
            ids:selected.map(function(id){return idMap[id];}).filter(Boolean),
            idMap:idMap
        };
    }
    function graphRemove(input,ids,options){
        options=options||{};
        const layout=clone(input),graph=graphIndex(layout),
            removed=new Set((Array.isArray(ids)?ids:[ids]).map(String)
                .filter(function(id){return graph.byId.has(id);}));
        if(options.cascade!==false){
            Array.from(removed).forEach(function(id){
                const item=graph.byId.get(id);
                if(item&&item.type==="container")
                    graph.descendants(id).forEach(function(childId){removed.add(childId);});
            });
        }
        layout.elements=graph.elements.filter(function(item){return !removed.has(item.id);});
        const remaining=new Set(layout.elements.map(function(item){return item.id;}));
        layout.elements.forEach(function(item){
            if(item.containerId&&!remaining.has(item.containerId))item.containerId=null;
            if(item.type==="container")
                item.layout.children=(item.layout.children||[]).filter(function(id){
                    return remaining.has(id)&&!removed.has(id);
                });
        });
        return {layout:layout,removedIds:Array.from(removed)};
    }
    function graphTranslate(input,ids,delta,options){
        options=options||{};delta=delta||{};
        const layout=clone(input),graph=graphIndex(layout),
            roots=(Array.isArray(ids)?ids:[ids]).map(String)
                .filter(function(id,index,list){return graph.byId.has(id)&&list.indexOf(id)===index;}),
            changed=new Set(),dx=finite(delta.dx,0),dy=finite(delta.dy,0);
        roots.forEach(function(id){
            const item=graph.byId.get(id);
            if(options.respectLocked!==false&&item.locked===true)return;
            changed.add(id);
            if(item.type==="container")
                graph.descendants(id).forEach(function(childId){changed.add(childId);});
        });
        layout.elements.forEach(function(item){
            if(!changed.has(item.id))return;
            item.box.x+=dx;item.box.y+=dy;
        });
        return {layout:layout,changedIds:Array.from(changed)};
