    function normalizeElement(source,index,sourceVersion){
        source=source||{};
        const type=String(source.type||"text").toLowerCase();
        const flatBox=source.box||{x:source.x,y:source.y,width:source.width,height:source.height};
        const element={
            id:String(source.id||("element-"+(index+1))),
            name:String(defined(source.name,"")),
            type:type,
            template:String(defined(source.template,defined(source.value,""))),
            box:{
                x:finite(flatBox.x,0),y:finite(flatBox.y,0),
                width:finite(flatBox.width,0),height:finite(flatBox.height,0)
