            placeholder="Buscar ID, nome ou mnem&ocirc;nico" aria-label="Buscar camadas">
          <button type="button" data-action="layer-up" aria-label="Subir camada">&#8593;</button>
          <button type="button" data-action="layer-down" aria-label="Descer camada">&#8595;</button>
