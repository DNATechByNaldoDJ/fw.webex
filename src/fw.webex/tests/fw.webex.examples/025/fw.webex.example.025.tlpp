#include "fw.webex.th"

using namespace FWWebEx
using namespace FWWebEx.Tools

procedure u_FWWebExExample_025()
    local bExecute as codeblock
    local cHTML as character
    local cHTMLFile as character
    local cProcName:=ProcName() as character
    local oTWebChannel:=WebApp():GetTWebChannel() as object
    bExecute:={||FWMsgRun(nil,{||cHTMLFile:=FWWebExExample_025(@cHTML)},"Aguarde",cProcName)}
    FWExampleTools():Execute(bExecute,cProcName,.F.,.F.)
    if (!Empty(cHTMLFile).and.File(cHTMLFile))
        FWExampleTools():htmlFileShow(cHTML,cProcName,cHTMLFile,oTWebChannel)
        fErase(cHTMLFile)
    endif
    WebFileTools():ObliterateFWWebExTmpFiles(.T.)
return

static function FWWebExExample_025(cHTML as character) as character

    local cProcName:=ProcName() as character
    local cHTMLFile:=cProcName as character
    local cConteinerASCII as character

    local jASCIIArt:=LoadASCIIArt() as json

    local oFWWebExPage as object

    WITH WEBEXOBJECT oFWWebExPage CLASS WebExPage ARGS cProcName+" :: FWWebEx :: ASCIIArt"
        WITH WEBEXOBJECT oFWWebExBody CLASS WebExBody
            WITH WEBEXOBJECT oConteinerASCII CLASS WebExStyle
                beginContent var cConteinerASCII
                    .container-ascii {
                        display: grid;
                        grid-template-columns: repeat(2, 1fr);
                        gap: 1rem;
                    }
                endContent
                .:SetContent(cConteinerASCII)
                .:AddInHeader(.this)
            END WEBEXOBJECT NOADDCHILD
            WITH WEBEXOBJECT oFWWebExDivASCIIContainer CLASS WebExDiv
                .:AddClass("container-ascii")
                WITH WEBEXOBJECT oFWWebExDivBaseBall CLASS WebExDiv
                    .:SetAttr("style","height:175px; overflow:hidden;")
                    WITH WEBEXOBJECT oWebExAsciiLoaderBaseBall CLASS WebExAsciiLoader ARGS jASCIIArt["baseball.ascii.art"][1]
                        .:SetMaxLines(jASCIIArt["baseball.ascii.art"][2])
                        .:SetInterval(60)
                        .:SetFrameTimeFactor(1.5)
                        .:SetMaxFrameTime(140)
                     END WEBEXOBJECT
                END WEBEXOBJECT
                WITH WEBEXOBJECT oFWWebExDivBasketBall CLASS WebExDiv
                    .:SetAttr("style","height:175px; overflow:hidden;")
                    WITH WEBEXOBJECT oWebExAsciiLoaderBasketBall CLASS WebExAsciiLoader ARGS jASCIIArt["basketball.ascii.art"][1]
                        .:SetMaxLines(jASCIIArt["baseball.ascii.art"][2])
                        .:SetInterval(60)
                        .:SetFrameTimeFactor(1.5)
                        .:SetMaxFrameTime(140)
                    END WEBEXOBJECT
                END WEBEXOBJECT
                WITH WEBEXOBJECT oFWWebExDivBicycling CLASS WebExDiv
                    .:SetAttr("style","height:175px; overflow:hidden;")
                    WITH WEBEXOBJECT oWebExAsciiLoaderBicycling CLASS WebExAsciiLoader ARGS jASCIIArt["bicycling.ascii.art"][1]
                        .:SetMaxLines(jASCIIArt["baseball.ascii.art"][2])
                        .:SetInterval(60)
                        .:SetFrameTimeFactor(1.5)
                        .:SetMaxFrameTime(140)
                    END WEBEXOBJECT
                END WEBEXOBJECT
                WITH WEBEXOBJECT oFWWebExDivMacarena CLASS WebExDiv
                    .:SetAttr("style","height:175px; overflow:hidden;")
                    WITH WEBEXOBJECT oWebExAsciiLoaderMacarena CLASS WebExAsciiLoader ARGS jASCIIArt["macarena.ascii.art"][1]
                        .:SetMaxLines(jASCIIArt["baseball.ascii.art"][2])
                        .:SetInterval(60)
                        .:SetFrameTimeFactor(1.5)
                        .:SetMaxFrameTime(140)
                    END WEBEXOBJECT
                END WEBEXOBJECT
                WITH WEBEXOBJECT oFWWebExDivStationTraffic CLASS WebExDiv
                    .:SetAttr("style","height:175px; overflow:hidden;")
                    WITH WEBEXOBJECT oWebExAsciiLoaderStationTraffic CLASS WebExAsciiLoader ARGS jASCIIArt["stationtraffic.ascii.art"][1]
                        .:SetMaxLines(jASCIIArt["baseball.ascii.art"][2])
                        .:SetInterval(60)
                        .:SetFrameTimeFactor(1.5)
                        .:SetMaxFrameTime(140)
                    END WEBEXOBJECT
                END WEBEXOBJECT
                WITH WEBEXOBJECT oFWWebExDivSwimming CLASS WebExDiv
                    .:SetAttr("style","height:175px; overflow:hidden;")
                    WITH WEBEXOBJECT oWebExAsciiLoaderSwimming CLASS WebExAsciiLoader ARGS jASCIIArt["swimming.ascii.art"][1]
                        .:SetMaxLines(jASCIIArt["baseball.ascii.art"][2])
                        .:SetInterval(60)
                        .:SetFrameTimeFactor(1.5)
                        .:SetMaxFrameTime(140)
                    END WEBEXOBJECT
                END WEBEXOBJECT
            END WEBEXOBJECT
        END WEBEXOBJECT
    END WEBEXOBJECT NOADDCHILD

    aEval(jASCIIArt:GetNames(),{|cName|FWFreeArray(jASCIIArt[cName]),jASCIIArt:DelName(cName)})
    FreeObj(@jASCIIArt)

    WebFileTools():HTMLFromControl(oFWWebExPage,oFWWebExPage:GetFWWebExTmpPath(),@cHTMLFile,@cHTML,.T.)

    WEBEXOBJECT CLEAN

return(cHTMLFile)

static function LoadASCIIArt() as json
    local jASCIIArt:=JSONObject():New() as json
    jASCIIArt["baseball.ascii.art"]:=baseball_ascii_art_Load()
    jASCIIArt["basketball.ascii.art"]:=basketball_ascii_art_Load()
    jASCIIArt["bicycling.ascii.art"]:=bicycling_ascii_art_Load()
    jASCIIArt["macarena.ascii.art"]:=macarena_ascii_art_Load()
    jASCIIArt["stationtraffic.ascii.art"]:=stationtraffic_ascii_art_Load()
    jASCIIArt["swimming.ascii.art"]:=swimming_ascii_art_Load()
return(jASCIIArt)

