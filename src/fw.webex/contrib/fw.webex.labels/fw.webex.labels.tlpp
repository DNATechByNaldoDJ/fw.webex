        <button type="button" data-action="grid" aria-pressed="false">Grid</button>
        <button type="button" data-action="snap" aria-pressed="false">Snap</button>
        <button type="button" data-action="print-overlay" aria-pressed="false">Caixas no preview</button>
        <label data-role="overlay-opacity-field">Opacidade das caixas <input data-role="overlay-opacity" type="range"
          min=".1" max="1" step=".1" value=".5"></label>
        <button type="button" data-action="discover-variables">Descobrir vari&aacute;veis</button>
      </div>
