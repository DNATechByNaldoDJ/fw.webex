                    {box:clone(box),contentBox:{x:box.x+padding.left,y:box.y+padding.top,
                        width:width,height:height},padding:padding,fontSize:maximum,
                        minFontSize:minimum,finalFontSize:size,lineCount:referenceLines.length,
                        maxLines:maxLines,requiredHeight:requiredHeight,
                        estimatedSingleLineWidth:singleLineWidth,fitMode:fit.mode}));
            }
            const visibleByHeight=Math.max(0,Math.floor(height/measured.lineHeight));
            const visibleLines=Math.min(maxLines,visibleByHeight);
            if(policy==="ellipsis"){
                lines=lines.slice(0,visibleLines);
