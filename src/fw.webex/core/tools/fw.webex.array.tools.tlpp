#include "totvs.ch"
#include "parmtype.ch"

namespace FWWebEx
using namespace FWWebEx

/* {Protheus.doc} ArrayTools
    Classe utilitaria para operacoes comuns com arrays em TLPP/ADVPL.

    Funcionalidades:
    - Merge simples de arrays
    - Merge ordenado
    - Merge sem duplicidade
    - Merge profundo/recursivo
    - Merge linear de arrays previamente ordenados
    - Zip de arrays
    - Union, Intersect e Diff
    - Clone seguro
    - Busca por igualdade com codeblock opcional

    @type       Class
    @author     Marinaldo de Jesus
    @since      19/05/2026
*/
class ArrayTools

    static method Merge(aArray1 as array, aArray2 as array, lSort as logical, bSort as codeblock, lClone as logical) as array
    static method MergeSorted(aArray1 as array, aArray2 as array, bLess as codeblock, lClone as logical) as array
    static method MergeUnique(aArray1 as array, aArray2 as array, bEqual as codeblock, lSort as logical, bSort as codeblock) as array
    static method MergeDeep(aArray1 as array, aArray2 as array, lClone as logical) as array
    static method Zip(aArray1 as array, aArray2 as array, xDefault as variant) as array
    static method Union(aArray1 as array, aArray2 as array, bEqual as codeblock) as array
    static method Intersect(aArray1 as array, aArray2 as array, bEqual as codeblock) as array
    static method Diff(aArray1 as array, aArray2 as array, bEqual as codeblock) as array
    static method Clone(aArray as array) as array
    static method Contains(aArray as array, xValue as variant, bEqual as codeblock) as logical
    static method IndexOf(aArray as array, xValue as variant, bEqual as codeblock) as numeric

endclass

/*{Protheus.doc} Merge
    Realiza merge de 2 arrays.

    @type       Static Method
    @param      aArray1 , array     , Primeiro array
    @param      aArray2 , array     , Segundo array
    @param      lSort   , logical   , Indica se deve ordenar o resultado
    @param      bSort   , codeblock , Bloco de ordenacao opcional
    @param      lClone  , logical   , Indica se deve clonar os arrays de origem
    @return     array   , Array resultante

    @example
        aResult:=ArrayTools():Merge({3,1},{2},.T.)
        aResult:=ArrayTools():Merge(aA,aB,.T.,{|x,y| x[1] < y[1]})
*/
static method Merge(aArray1,aArray2,lSort,bSort,lClone) class ArrayTools

    local aMerged as array

    local nLen1 as numeric
    local nLen2 as numeric

    paramtype 1 var aArray1 as array optional default {}
    paramtype 2 var aArray2 as array optional default {}
    paramtype 3 var lSort as logical optional default .F.
    paramtype 4 var bSort as block optional
    paramtype 5 var lClone as logical optional default .T.

    if (lClone)
        aArray1:=ArrayTools():Clone(aArray1)
        aArray2:=ArrayTools():Clone(aArray2)
    endif

    nLen1:=Len(aArray1)
    nLen2:=Len(aArray2)

    aMerged:=Array(nLen1 + nLen2)

    if (nLen1 > 0)
        aCopy(aArray1,@aMerged,1,nLen1,1)
    endif

    if (nLen2 > 0)
        aCopy(aArray2,@aMerged,1,nLen2,nLen1 + 1)
    endif

    if (lSort)
        if (ValType(bSort)=="B")
            aSort(aMerged,,,bSort)
        else
            aSort(aMerged)
        endif
    endif

return(aMerged)

/*{Protheus.doc} MergeSorted
    Realiza merge linear de 2 arrays previamente ordenados.
    Evita fazer ASort no final.

    Complexidade aproximada: O(n + m).

    @type       Static Method
    @param      aArray1 , array     , Primeiro array ja ordenado
    @param      aArray2 , array     , Segundo array ja ordenado
    @param      bLess   , codeblock , Comparador opcional: {|x,y| x < y}
    @param      lClone  , logical   , Indica se deve clonar os elementos retornados quando forem arrays
    @return     array   , Array final ordenado

    @example
        aResult:=ArrayTools():MergeSorted({1,3,5},{2,4,6})
        aResult:=ArrayTools():MergeSorted(aA,aB,{|x,y| x[1] < y[1]})
*/
static method MergeSorted(aArray1,aArray2,bLess,lClone) class ArrayTools

    local aMerged as array

    local lTake1 as logical
    local lbLess as logical

    local nI as numeric
    local nJ as numeric
    local nK as numeric
    local nLen1 as numeric
    local nLen2 as numeric

    paramtype 1 var aArray1 as array optional default {}
    paramtype 2 var aArray2 as array optional default {}
    paramtype 3 var bLess as block optional
    paramtype 4 var lClone as logical optional default .T.

    nLen1:=Len(aArray1)
    nLen2:=Len(aArray2)

    aMerged:=Array(nLen1 + nLen2)

    nI:=1
    nJ:=1
    nK:=1

    lbLess:=(ValType(bLess)=="B")

    while ((nI<=nLen1).and.(nJ<=nLen2))

        if (lbLess)
            lTake1:=Eval(bLess,aArray1[nI],aArray2[nJ])
        else
            lTake1:=(aArray1[nI]<=aArray2[nJ])
        endif

        if (lTake1)
            aMerged[nK]:=if(lClone.and.ValType(aArray1[nI])=="A",ArrayTools():Clone(aArray1[nI]),aArray1[nI])
            nI++
        else
            aMerged[nK]:=if(lClone.and.ValType(aArray2[nJ])=="A",ArrayTools():Clone(aArray2[nJ]),aArray2[nJ])
            nJ++
        endif

        nK++

    end while

    while (nI<=nLen1)
        aMerged[nK]:=if(lClone.and.ValType(aArray1[nI])=="A",ArrayTools():Clone(aArray1[nI]),aArray1[nI])
        nI++
        nK++
    end while

    while (nJ<=nLen2)
        aMerged[nK]:=if(lClone.and.ValType(aArray2[nJ])=="A",ArrayTools():Clone(aArray2[nJ]),aArray2[nJ])
        nJ++
        nK++
    end while

return(aMerged)

/*{Protheus.doc} MergeUnique
    Realiza merge de 2 arrays removendo duplicidades.

    @type       Static Method
    @param      aArray1 , array     , Primeiro array
    @param      aArray2 , array     , Segundo array
    @param      bEqual  , codeblock , Comparador opcional: {|x,y| x==y}
    @param      lSort   , logical   , Indica se deve ordenar o resultado
    @param      bSort   , codeblock , Bloco de ordenacao opcional
    @return     array   , Array resultante sem duplicidade

    @example
        aResult:=ArrayTools():MergeUnique({1,2},{2,3})
        // Resultado: {1,2,3}
*/
static method MergeUnique(aArray1,aArray2,bEqual,lSort,bSort) class ArrayTools

    local aMerged as array
    local aUnique as array

    local nI as numeric

    paramtype 1 var aArray1 as array optional default {}
    paramtype 2 var aArray2 as array optional default {}
    paramtype 3 var bEqual as block optional
    paramtype 4 var lSort as logical optional default .F.
    paramtype 5 var bSort as block optional

    aMerged:=ArrayTools():Merge(aArray1,aArray2,.F.,nil,.T.)
    aUnique:={}

    for nI:=1 to Len(aMerged)
        if (!ArrayTools():Contains(aUnique,aMerged[nI],bEqual))
            aAdd(aUnique,if(ValType(aMerged[nI])=="A",ArrayTools():Clone(aMerged[nI]),aMerged[nI]))
        endif
    next nI

    if (lSort)
        if (ValType(bSort)=="B")
            aSort(aUnique,,,bSort)
        else
            aSort(aUnique)
        endif
    endif

return(aUnique)

/*{Protheus.doc} MergeDeep
    Realiza merge profundo de arrays.
    Quando a mesma posicao dos dois arrays possuir outro array, faz merge recursivo.
    Caso contrario, o valor do segundo array prevalece quando existir.

    @type       Static Method
    @param      aArray1 , array   , Primeiro array
    @param      aArray2 , array   , Segundo array
    @param      lClone  , logical , Indica se deve clonar valores de array
    @return     array   , Array resultante

    @example
        aResult:=ArrayTools():MergeDeep({1,{"A"}},{2,{"B"}})
        // Resultado aproximado: {2,{"A","B"}}
*/
static method MergeDeep(aArray1,aArray2,lClone) class ArrayTools

    local aResult as array

    local lHas1 as logical
    local lHas2 as logical

    local nI as numeric
    local nMax as numeric

    local xValue1 as variant
    local xValue2 as variant

    paramtype 1 var aArray1 as array optional default {}
    paramtype 2 var aArray2 as array optional default {}
    paramtype 3 var lClone as logical optional default .T.

    nMax:=Max(Len(aArray1),Len(aArray2))
    aResult:=Array(nMax)

    for nI:=1 to nMax

        lHas1:=(nI<=Len(aArray1))
        lHas2:=(nI<=Len(aArray2))

        xValue1:=nil
        xValue2:=nil

        if (lHas1)
            xValue1:=aArray1[nI]
        endif

        if (lHas2)
            xValue2:=aArray2[nI]
        endif

        if (lHas1.and.lHas2.and.ValType(xValue1)=="A".and.ValType(xValue2)=="A")
            aResult[nI]:=ArrayTools():Merge(xValue1,xValue2,.F.,nil,lClone)
        elseif (lHas2)
            aResult[nI]:=if(lClone.and.ValType(xValue2)=="A",ArrayTools():Clone(xValue2),xValue2)
        else
            aResult[nI]:=if(lClone.and.ValType(xValue1)=="A",ArrayTools():Clone(xValue1),xValue1)
        endif

    next nI

return(aResult)

/*{Protheus.doc} Zip
    Agrupa dois arrays por posicao.

    @type       Static Method
    @param      aArray1  , array   , Primeiro array
    @param      aArray2  , array   , Segundo array
    @param      xDefault , variant , Valor padrao quando uma das posicoes nao existir
    @return     array    , Array no formato {{x1,y1},{x2,y2},...}

    @example
        aResult:=ArrayTools():Zip({"A","B"},{1,2})
        // Resultado: {{"A",1},{"B",2}}
*/
static method Zip(aArray1,aArray2,xDefault)class ArrayTools

    local aResult as array

    local nI as numeric
    local nMax as numeric

    local xValue1 as variant
    local xValue2 as variant

    paramtype 1 var aArray1 as array optional default {}
    paramtype 2 var aArray2 as array optional default {}
    paramtype 3 var xDefault as array,block,character,date,json,logical,numeric optional

    nMax:=Max(Len(aArray1),Len(aArray2))
    aResult:=Array(nMax)

    for nI:=1 to nMax

        xValue1:=if(nI<=Len(aArray1),aArray1[nI],xDefault)
        xValue2:=if(nI<=Len(aArray2),aArray2[nI],xDefault)

        aResult[nI]:={xValue1,xValue2}

    next nI

return(aResult)

/*{Protheus.doc} Union
    Retorna uniao entre dois arrays, sem duplicidade.
*/
static method Union(aArray1,aArray2,bEqual) class ArrayTools
return(ArrayTools():MergeUnique(aArray1,aArray2,bEqual,.F.,nil))

/*{Protheus.doc} Intersect
    Retorna apenas itens existentes nos dois arrays.
*/
static method Intersect(aArray1,aArray2,bEqual) class ArrayTools

    local aResult as array

    local nI as numeric

    paramtype 1 var aArray1 as array optional default {}
    paramtype 2 var aArray2 as array optional default {}
    paramtype 3 var bEqual as block optional

    aResult:={}

    for nI:=1 to Len(aArray1)
        if (ArrayTools():Contains(aArray2,aArray1[nI],bEqual).and.!ArrayTools():Contains(aResult,aArray1[nI],bEqual))
            aAdd(aResult,if(ValType(aArray1[nI])=="A",ArrayTools():Clone(aArray1[nI]),aArray1[nI]))
        endif
    next nI

return(aResult)

/*{Protheus.doc} Diff
    Retorna itens existentes no primeiro array e ausentes no segundo.
*/
static method Diff(aArray1,aArray2,bEqual) class ArrayTools

    local aResult as array
    local nI as numeric

    paramtype 1 var aArray1 as array optional default {}
    paramtype 2 var aArray2 as array optional default {}
    paramtype 3 var bEqual as block optional

    aResult:={}

    for nI:=1 to Len(aArray1)
        if (!ArrayTools():Contains(aArray2,aArray1[nI],bEqual))
            aAdd(aResult,if(ValType(aArray1[nI])=="A",ArrayTools():Clone(aArray1[nI]),aArray1[nI]))
        endif
    next nI

return(aResult)

/*{Protheus.doc} Clone
    Clona array recursivamente.
*/
static method Clone(aArray) class ArrayTools

    local aCloneArray as array

    local nI as numeric

    paramtype 1 var aArray as array optional default {}

    aCloneArray:=Array(Len(aArray))

    for nI:=1 to Len(aArray)
        if (ValType(aArray[nI])=="A")
            aCloneArray[nI]:=ArrayTools():Clone(aArray[nI])
        else
            aCloneArray[nI]:=aArray[nI]
        endif
    next nI

return(aCloneArray)

/*{Protheus.doc} Contains
    Verifica se um array contem determinado valor.
*/
static method Contains(aArray,xValue,bEqual) class ArrayTools
return(ArrayTools():IndexOf(aArray,xValue,bEqual)>0)

/*{Protheus.doc} IndexOf
    Retorna a posicao de um valor no array.
    Retorna 0 quando nao encontrar.
*/
static method IndexOf(aArray,xValue,bEqual) class ArrayTools

    local lEqual as logical
    local lbEqual as logical

    local nI as numeric

    paramtype 1 var aArray as array optional default {}
    paramtype 2 var xValue as array,block,character,date,json,logical,numeric optional
    paramtype 3 var bEqual as block optional

    lbEqual:=(ValType(bEqual)=="B")

    for nI:=1 to Len(aArray)

        if (lbEqual)
            lEqual:=Eval(bEqual,aArray[nI],xValue)
        else
            lEqual:=(aArray[nI]==xValue)
        endif

        if (lEqual)
            return(nI)
        endif

    next nI

return(0)
