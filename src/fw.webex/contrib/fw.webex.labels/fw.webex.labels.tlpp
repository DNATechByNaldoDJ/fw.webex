    function issue(code,severity,path,message,suggestion,elementId,recordIndex,phase,details){
        return {code:code,severity:severity,path:path||"",elementId:elementId||null,
            recordIndex:recordIndex==null?null:recordIndex,phase:phase||"contract",
            message:message,suggestion:suggestion||"",details:details||{}};
    }
    function templateTokens(template){
        const source=String(template||""),tokens=[],problems=[];
        const complete=/\{\{([\s\S]*?)\}\}/g;
        let cleaned=source.replace(complete,function(match,inner,offset){
            const path=String(inner).trim();
            if(!/^[A-Za-z_][A-Za-z0-9_.]*$/.test(path))
                problems.push({offset:offset,token:match,
                    reason:"Mnemonico vazio ou com caracteres nao suportados."});
            else tokens.push(path);
