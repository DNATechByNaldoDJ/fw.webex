method EvalRaw(oBrowse,xRowData,nRowIndex) class WebExBrowseColumn
    local xValue as variant
    local oError as object
    if (ValType(::bData) == "B")
        try
            xValue := Eval(::bData,oBrowse,xRowData,nRowIndex)
        catch oError
            xValue := ""
            ConOut("FWWebEx.WebExBrowseColumn:EvalRaw -> " + oError:Description)
            FreeObj(@oError)
        endtry
    else
        xValue := ""
    endif
return(xValue)

method FormatValue(xRawValue) class WebExBrowseColumn
    local cPicture as character
    local cType as character
    local xFormatted as variant

    cType := ValType(xRawValue)
    if (cType == "U")
        return("")
    endif

    if (ValType(::xPicture) == "B")
        cPicture := cValToChar(Eval(::xPicture,xRawValue))
    elseif (ValType(::xPicture) == "C")
        cPicture := AllTrim(::xPicture)
    else
        cPicture := ""
    endif

    if (!Empty(cPicture))
        xFormatted := AllTrim(Transform(xRawValue,cPicture))
    else
        do case
            case (cType == "C")
                xFormatted := RTrim(xRawValue)
            case (cType == "D")
                xFormatted := if(Empty(xRawValue),"",DToC(xRawValue))
            case (cType == "L")
                xFormatted := if(xRawValue,"Sim","Nao")
            case (cType == "N")
                xFormatted := AllTrim(Str(xRawValue,Max(::nSize,12),::nDecimal))
            otherwise
                xFormatted := cValToChar(xRawValue)
        end case
    endif
return(xFormatted)

method ToDataTableColumn(cFallbackField) class WebExBrowseColumn
    local cFieldKey as character
    local jCol := JSONObject():New() as json

    paramtype 1 var cFallbackField as character optional default "col"

    cFieldKey := if(!Empty(::cField),::cField,cFallbackField)
    ::cField  := cFieldKey

    jCol["data"]       := cFieldKey
    jCol["title"]      := ::cTitle
    jCol["visible"]    := ::lVisible
    jCol["orderable"]  := ::lOrderable
    jCol["searchable"] := ::lSearchable
    jCol["className"]  := ::GetAlignClass()

return(jCol)

method Clean() class WebExBrowseColumn
    ::bData        := NIL
    ::bDoubleClick := NIL
    ::bHeaderClick := NIL
    ::bValid       := NIL
    ::xPicture     := NIL
return(self)
