namespace FWWebEx

#include "fw.webex.th"

class WebExDataTable from WebExTable

    protected data cTableTitle as character

    protected data cPreInitJS as character      // Funcoes customizadas de Pre Inicializacao AJAX (como string JS)
    protected data cPostInitJS as character     // Funcoes customizadas de Pos Inicializacao AJAX (como string JS)
    protected data cAjaxFunction as character   // Funcao AJAX customizada (como string JS)

    protected data jActions as json             // Acoes/buttons por linha (para coluna de acoes)
    protected data jDataTableFields as json
    protected data jDataTableColumns as json    // Colunas para DataTable (incluindo renderers customizados)
    protected data jDataTableOptions as json    // Opcoes gerais para inicializacao do DataTable

    protected data lServerSide as logical       // Flag para processamento server-side

    protected data oDataTableScript as object   // Script JS para inicializacao do DataTable

    private method __BuildColumns() as object
    private method __AddColumnsHeader(jDataTableFields as json) as object
    private method __GenerateActionRender(cID as character) as character

    public method New(cTableTitle as character,lServerSide as logical) as object

    public method AddActionButton(cLabel as character,cIcon as character,cOnClick as character,cClass as character,cStyle as character) as object

    public method SetPreInitJS(cPreInitJS as character) as object
    public method SetPostInitJS(cPostInitJS as character) as object
    public method SetAjaxFunction(cAjaxFunction as character) as object
    public method SetDataTableFields(jDataTableFields as json) as object
    public method SetDataTableOptions(jDataTableOptions as json) as object

    public method EnableServerSide(lEnable as logical) as object

    public method RenderHTML() as character

endclass

method __BuildColumns() class WebExDataTable
    // Constroi as colunas para DataTable JS
    local aColumns:=Array(0) as array
    local jDataTableColumns:=::jDataTableColumns as json
    aEval(jDataTableColumns:GetNames(),{|cName|aAdd(aColumns,jDataTableColumns[cName])})
    ::jDataTableOptions["columns"]:=aColumns
return(self)

method __GenerateActionRender(cID,cStyle) class WebExDataTable

    local cIDIcon as character
    local cRenderJS as character

    local jAction as json

    paramtype 1 var cID as character
    paramtype 2 var cStyle as character

    // Build action buttons
    jAction:=::jActions[cID]

    cIDIcon:=::NewID()

    // Base JS render function
    beginContent var cRenderJS
        function (data, type, row) {
            let buttons = "";
            buttons += '<button id="__ID__" type="button" class="__CLASS__" onclick="__ON_CLICK__" style="__STYLE__">';
            if (__HAS_ICON__) {
                buttons += '<i id="__ID_ICON__" class="__ICON__ me-1"></i>';
            }
            buttons += '__LABEL__</button>';
            return buttons;
        }
    endContent

    cRenderJS:=WebExHelper():StrReplaceEx(;
        cRenderJS;
        ,{"__ID__",cID};
        ,{"__CLASS__",jAction["class"]};
        ,{"__ON_CLICK__",WebExHelper():StrReplaceEx(jAction["onclick"],{"data","row"})};
        ,{"__STYLE__",cStyle};
        ,{"__HAS_ICON__",if(!Empty(jAction["icon"]),"true","false")};
        ,{"__ID_ICON__",cIDIcon};
        ,{"__ICON__", jAction["icon"]};
        ,{"__LABEL__",jAction["label"]};
    )

return(cRenderJS)

method New(cTableTitle,lServerSide) class WebExDataTable

    paramtype 1 var cTableTitle as character optional
    paramtype 2 var lServerSide as logical optional default .F.

    ::cTableTitle:=cTableTitle

    ::cPreInitJS:=""
    ::cPostInitJS:=""
    ::cAjaxFunction:=""

    ::jActions:=JSONObject():New()
    ::jDataTableFields:=JSONObject():New()
    ::jDataTableColumns:=JSONObject():New()
    ::jDataTableOptions:=JSONObject():New()

    ::lServerSide:=lServerSide

    ::oDataTableScript:=WebExScript():New()

    _Super:New(cTableTitle)

    ::SetEnableDataTable(.T.)  // Ativa DataTable por padrao

    // Opcoes padrao do DataTable
    ::jDataTableOptions["processing"]:=.T.
    ::jDataTableOptions["dom"]:='Blfrtip'
    ::jDataTableOptions["lengthMenu"]:={5,10,25,50,100,-1}
    ::jDataTableOptions["pageLength"]:=10
    ::jDataTableOptions["language"]:={"url": "https://cdn.datatables.net/plug-ins/2.3.2/i18n/pt-BR.json"}

    ::EnableServerSide(::lServerSide)

return(self)

method __AddColumnsHeader(jDataTableFields) class WebExDataTable

    local bRender as codeblock
    local cTableColumnLabel as character
    local cTableColumnFieldName as character

    local jColumn as json

    local nField as numeric
    local nFields as numeric

    local oTH as object

    paramtype 1 var jDataTableFields as json

    if ((jDataTableFields:HasProperty("fields").and.(ValType(jDataTableFields["fields"])=="A")))

        aFields:=jDataTableFields["fields"]
        nFields:=Len(aFields)
        for nField:=1 to nFields
            if (ValType(aFields[nField])!="J")
                loop
            endif
            jColumn:=JSONObjectTools():CloneJSON(aFields[nField])
            if (!jColumn:HasProperty("visible"))
                jColumn["visible"]:=.T.
            endif
            cTableColumnLabel:=if(jColumn:HasProperty("title"),jColumn["title"],"col_"+::NewID())
            jColumn["title"]:=cTableColumnLabel
            cTableColumnFieldName:=if(jColumn:HasProperty("data"),jColumn["data"],cTableColumnLabel)
            jColumn["data"]:=cTableColumnFieldName
            oTH:=_Super:AddColumnHeader(cTableColumnLabel,cTableColumnFieldName)
            oTH:SetVisible(jColumn["visible"])
            if (jColumn:HasProperty("bRender"))
                bRender:=jColumn["bRender"]
                jColumn:DelName("bRender")
                if (ValType(bRender)=="B")
                    jColumn["render"]:=JSONObjectTools():ToJSFunctionToken(Eval(bRender,oTH:GetFixedID()))  // Assume que o codeblock retorna uma string JS para render
                endif
            endif
            ::jDataTableColumns[oTH:GetID()]:=jColumn
        next nField

    endif

return(self)

method AddActionButton(cLabel,cIcon,cOnClick,cClass,cStyle) class WebExDataTable
    local cID as character
    local jAction as json
    local jActionsColumn as json
    paramtype 1 var cLabel as character
    paramtype 2 var cIcon as character optional
    paramtype 3 var cOnClick as character optional  // String JS para onclick,e.g.,"myFunction(data)"
    paramtype 4 var cClass as character optional default "btn btn-sm"
    paramtype 5 var cStyle as character optional default "white-space: nowrap; padding: 0.25rem 0.5rem; font-size: 0.875rem;"
    cID:=::NewID()
    jAction:=JSONObject():New()
    jAction["label"]:=cLabel
    jAction["icon"]:=cIcon
    jAction["onclick"]:=cOnClick
    jAction["class"]:=cClass
    ::jActions[cID]:=jAction
    // Adiciona coluna de acoes
    jActionsColumn:=JSONObject():New()
    jActionsColumn["data"]:=NIL  // Coluna nao mapeada a dados
    jActionsColumn["title"]:=""
    jActionsColumn["orderable"]:=.F.
    jActionsColumn["searchable"]:=.F.
    jActionsColumn["width"]:="80px"// Largura fixa para compactar a coluna
    jActionsColumn["render"]:=JSONObjectTools():ToJSFunctionToken(::__GenerateActionRender(cID,cStyle))  // Gera funcao render JS
    ::jDataTableColumns[cID]:=jActionsColumn
return(self)

method SetPreInitJS(cPreInitJS) class WebExDataTable
    paramtype cPreInitJS as character optional default ::cPreInitJS
    ::cPreInitJS:=cPreInitJS
return(self)

method SetPostInitJS(cPostInitJS) class WebExDataTable
    paramtype cPostInitJS as character optional default ::cPostInitJS
    ::cPostInitJS:=cPostInitJS
return(self)

method SetAjaxFunction(cAjaxFunction) class WebExDataTable
    paramtype 1 var cAjaxFunction as character optional default ::cAjaxFunction // String com a funcao AJAX completa
    ::cAjaxFunction:=cAjaxFunction
return(self)

method SetDataTableFields(jDataTableFields) class WebExDataTable
    paramtype 1 var jDataTableFields as json
    ::jDataTableFields:=jDataTableFields
    ::__AddColumnsHeader(::jDataTableFields)
return(self)

method SetDataTableOptions(jDataTableOptions) class WebExDataTable
    paramtype 1 var jDataTableOptions as json
    ::jDataTableOptions:=JSONObjectTools():MergeJSON(::jDataTableOptions,jDataTableOptions)
return(self)

method EnableServerSide(lEnable) class WebExDataTable
    paramtype 1 var lEnable as logical optional default ::lServerSide
    ::lServerSide:=lEnable
    ::jDataTableOptions["serverSide"]:=lEnable
    if ((::lServerSide).and.(!Empty(::cAjaxFunction)))
        ::jDataTableOptions["ajax"]:=JSONObjectTools():ToJSFunctionToken(::cAjaxFunction)
    elseif (::jDataTableOptions:HasProperty("ajax"))
        ::jDataTableOptions:DelName("ajax")
    endif
return(self)

method RenderHTML() class WebExDataTable

    local cHTML as character
    local cScript as character

    // Gera o script de inicializacao se necessario
    ::EnableServerSide(::lServerSide)

    // Finaliza colunas
    ::__BuildColumns()

    beginContent var cScript
        document.addEventListener("DOMContentLoaded",function () {
            __PRE_INIT_JS__
            const table = new DataTable(
                "#__ID_TABLE__"
                ,__DATATABLE_OPTIONS__
            );
            __POST_INIT_JS__
        });
    endContent

    cScript:=WebExHelper():StrReplaceEx(;
        cScript;
        ,{"__ID_TABLE__",::GetFixedID()};
        ,{"__DATATABLE_OPTIONS__",JSONObjectTools():ToJSObjectString(::jDataTableOptions)};
        ,{"__PRE_INIT_JS__",::cPreInitJS};
        ,{"__POST_INIT_JS__",::cPostInitJS};
    )

    ::oDataTableScript:SetContent(cScript)

    cHTML:=_Super:RenderHTML()

return(cHTML)
