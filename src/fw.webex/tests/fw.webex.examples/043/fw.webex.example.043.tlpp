Exemplo 043: Master-Detail com Itens em Dialog Modal Bootstrap 5
Pedidos em tela cheia; duplo clique ou botao "Ver Itens" abre o modal com os itens filtrados.
Released to Public Domain.
--------------------------------------------------------------------------------------
*/

#include "fw.webex.browse.th"

using namespace FWWebEx
using namespace FWWebEx.Tools

user function FWWebExExample_043()
    local bExecute as codeblock
    local cTitle := "FWWebEx :: Example 043 - Master-Detail em Modal" as character
    bExecute := {|| FWWebExRelationModal043() }
    FWExampleTools():Execute(bExecute,cTitle,.F.,.F.)
return

static procedure FWWebExRelationModal043()

    local aItensAll as array
    local aPedidos as array
    local bPrevious as codeblock
    local cFile := "fwwebex-example-043" as character
    local cHTML := "" as character
    local cModalID := "fwwebex_modal_itens_043" as character
    local cTitle := "FWWebEx :: Example 043 - Pedidos x Itens (Dialog Modal)" as character
    local oBrwItens as object
    local oBrwPed as object
    local oChannel as object
    local oCloseBtn as object
    local oCloseFooter as object
    local oContainer as object
    local oContent as object
    local oDialog as object
    local oError as object
    local oFooter as object
    local oHeader as object
    local oModal as object
    local oModalBody as object
    local oModalTitle as object
    local oPage as object

    aPedidos := {;
        {"PV0001","DNATech Engenharia Protheus Ltda",  Date() - 3, 18500.00, "L"};
        ,{"PV0002","Industria Metalurgica Capixaba SA",Date() - 2, 42300.00, "A"};
        ,{"PV0003","Comercial Serra Logistica Ltda",   Date() - 1,  9400.00, "F"};
        ,{"PV0004","Alimentos Espirito Santo Ltda",    Date(),     27800.00, "L"};
    }

    aItensAll := {;
        {"PV0001","01","Consultoria TL++ Avancada",        40,  350.00, 14000.00};
        ,{"PV0001","02","Arquitetura FWWebEx",             10,  450.00,  4500.00};
        ,{"PV0002","01","Tuning SQL Server Protheus",      60,  420.00, 25200.00};
        ,{"PV0002","02","Sustentacao N3 Mensal",            1, 12100.00, 12100.00};
        ,{"PV0002","03","Integracao Webhook REST",          1,  5000.00,  5000.00};
        ,{"PV0003","01","Migracao FWBrowse para Web",      20,  470.00,  9400.00};
        ,{"PV0004","01","Modernizacao MVC Protheus",       40,  480.00, 19200.00};
        ,{"PV0004","02","Treinamento Equipe TL++",         16,  537.50,  8600.00};
    }

    oChannel := WebApp():GetTWebChannel(.T.)
    if (!oChannel:lConnected)
        MsgStop("Nao foi possivel conectar o TWebChannel.",cTitle)
        FWFreeArray(@aPedidos)
        FWFreeArray(@aItensAll)
        return
    endif

    bPrevious := WebExBrowseDispatcher():BindChannel(oChannel)

    try
        // Browse de Itens que sera embutido no Modal Bootstrap
        oBrwItens := WebExBrowse():New("")
        oBrwItens:SetDataArray()
        oBrwItens:SetArray(Array(0))
        oBrwItens:SetPageLength(10)
        oBrwItens:AddColumn({"Pedido",  {|oBrw,aRow| aRow[1] },"C","@!",            FWWEBEX_BROWSE_ALIGN_CENTER,10,0})
        oBrwItens:AddColumn({"Item",    {|oBrw,aRow| aRow[2] },"C","@!",            FWWEBEX_BROWSE_ALIGN_CENTER, 6,0})
        oBrwItens:AddColumn({"Produto", {|oBrw,aRow| aRow[3] },"C","",              FWWEBEX_BROWSE_ALIGN_LEFT,  36,0})
        oBrwItens:AddColumn({"Qtd",     {|oBrw,aRow| aRow[4] },"N","@E 999,999",    FWWEBEX_BROWSE_ALIGN_RIGHT,  8,0})
        oBrwItens:AddColumn({"Vl. Unit",{|oBrw,aRow| aRow[5] },"N","@E 999,999.99", FWWEBEX_BROWSE_ALIGN_RIGHT, 12,2})
        oBrwItens:AddColumn({"Total",   {|oBrw,aRow| aRow[6] },"N","@E 999,999.99", FWWEBEX_BROWSE_ALIGN_RIGHT, 14,2})

        BEGIN FWWEBEX oPage CLASS WebExPage ARGS cTitle
            WITH WEBEXOBJECT CLASS WebExBody
                WITH WEBEXOBJECT CLASS WebExMain
                    WITH WEBEXOBJECT oContainer CLASS WebExContainer ARGS .T.
                        .:AddClass("px-2 py-2")
                        WITH WEBEXOBJECT oBrwPed CLASS WebExFormBrowse ARGS "Pedidos de Venda (Duplo clique ou 'Ver Itens' abre o Modal)"

                            .:SetDataArray()
                            .:SetArray(aPedidos)
                            .:SetPageLength(10)
                            .:SetOptionsPosition("RIGHT")
                            .:SetOptionsTitle("Opcoes")

                            .:AddLegend({|oBrw,aRow| aRow[5] == "L" },"GREEN", "Liberado")
                            .:AddLegend({|oBrw,aRow| aRow[5] == "A" },"YELLOW","Em Aberto")
                            .:AddLegend({|oBrw,aRow| aRow[5] == "F" },"BLUE",  "Faturado")

                            .:AddColumn({"Pedido",  {|oBrw,aRow| aRow[1] },"C","@!",            FWWEBEX_BROWSE_ALIGN_CENTER,10,0})
                            .:AddColumn({"Cliente", {|oBrw,aRow| aRow[2] },"C","",              FWWEBEX_BROWSE_ALIGN_LEFT,  38,0})
                            .:AddColumn({"Emissao", {|oBrw,aRow| aRow[3] },"D","",              FWWEBEX_BROWSE_ALIGN_CENTER,10,0})
                            .:AddColumn({"Total",   {|oBrw,aRow| aRow[4] },"N","@E 999,999.99", FWWEBEX_BROWSE_ALIGN_RIGHT, 14,2})

                            .:AddSeekOrder("Por Cliente","col_2",1)
                            .:AddSeekOrder("Por Pedido", "col_1",2)

                            .:SetDoubleClick({|oBrw,nKey,aRow| AbrirModalItens043(aRow,aItensAll,oBrwItens,cModalID) })
                            .:AddRowAction("Ver Itens",{|oBrw,nKey,aRow| AbrirModalItens043(aRow,aItensAll,oBrwItens,cModalID) },"","btn btn-sm btn-primary")

                        END WEBEXOBJECT
                    END WEBEXOBJECT
                END WEBEXOBJECT
            END WEBEXOBJECT
        END FWWEBEX

        // Monta o Dialog Modal Bootstrap 5 contendo o Browse de Itens
        oModal := WebExDiv():New()
        oModal:SetFixedID(cModalID)
        oModal:AddClass("modal fade")
        oModal:SetAttr("tabindex","-1")
        oModal:SetAttr("aria-hidden","true")

        oDialog := WebExDiv():New()
        oDialog:AddClass("modal-dialog modal-xl modal-dialog-centered modal-dialog-scrollable")

        oContent := WebExDiv():New()
        oContent:AddClass("modal-content")

        oHeader := WebExDiv():New()
        oHeader:AddClass("modal-header py-2")

        oModalTitle := WebExH5():New()
        oModalTitle:AddClass("modal-title")
        oModalTitle:SetAttr("data-fwwebex-modal-title",cModalID)
        oModalTitle:SetContent("Itens do Pedido")
        oHeader:AddChild(oModalTitle)

        oCloseBtn := WebExControl():New("button")
        oCloseBtn:SetAttr("type","button")
        oCloseBtn:SetAttr("data-bs-dismiss","modal")
        oCloseBtn:SetAttr("aria-label","Fechar")
        oCloseBtn:AddClass("btn-close")
        oHeader:AddChild(oCloseBtn)

        oModalBody := WebExDiv():New()
        oModalBody:AddClass("modal-body p-2")
        oModalBody:AddChild(oBrwItens)

        oFooter := WebExDiv():New()
        oFooter:AddClass("modal-footer py-2")

        oCloseFooter := WebExControl():New("button")
        oCloseFooter:SetAttr("type","button")
        oCloseFooter:SetAttr("data-bs-dismiss","modal")
        oCloseFooter:AddClass("btn btn-sm btn-secondary")
        oCloseFooter:SetContent("Fechar")
        oFooter:AddChild(oCloseFooter)

        oContent:AddChild(oHeader)
        oContent:AddChild(oModalBody)
        oContent:AddChild(oFooter)
        oDialog:AddChild(oContent)
        oModal:AddChild(oDialog)

        oContainer:AddChild(oModal)

        if (WebFileTools():HTMLFromControl(oPage,oPage:GetFWWebExTmpPath(),@cFile,@cHTML,.T.))
            if (!Empty(cFile) .and. File(cFile))
                FWExampleTools():HtmlFileShow(cHTML,cTitle,cFile,oChannel,oChannel:bJSToAdvPL)
            endif
        endif

    catch oError
        MsgStop("Falha ao abrir Master-Detail Modal: " + oError:Description,cTitle)
        FreeObj(@oError)
    endtry

    oChannel:bJSToAdvPL := bPrevious

    if (ValType(oBrwPed) == "O")
        oBrwPed:Clean()
        FreeObj(@oBrwPed)
    endif
    if (ValType(oBrwItens) == "O")
        oBrwItens:Clean()
        FreeObj(@oBrwItens)
    endif

    WEBEXOBJECT CLEAN

    if (!Empty(cFile) .and. File(cFile))
        fErase(cFile)
    endif
    WebFileTools():ObliterateFWWebExTmpFiles(.T.)
    FWFreeArray(@aPedidos)
    FWFreeArray(@aItensAll)

return

static function AbrirModalItens043(aRow as array,aItensAll as array,oBrwItens as object,cModalID as character) as variant
    local aFiltrados := Array(0) as array
    local jRet := JSONObject():New() as json
    local nI as numeric

    if (ValType(aRow) != "A")
        FreeObj(@jRet)
        return("Selecione um pedido antes de abrir os itens.")
    endif

    for nI := 1 to Len(aItensAll)
        if (aItensAll[nI][1] == aRow[1])
            aAdd(aFiltrados,aItensAll[nI])
        endif
    next nI

    oBrwItens:SetArray(aFiltrados)

    jRet["openModal"]     := cModalID
    jRet["modalTitle"]    := "Itens do Pedido " + aRow[1] + " - " + aRow[2]
    jRet["reloadTargets"] := {oBrwItens:GetFixedID()}
    jRet["message"]       := "Exibindo " + AllTrim(cValToChar(Len(aFiltrados))) + " item(ns) do pedido " + aRow[1] + "."
return(jRet)
