method SetAlign(nAlign) class WebExBrowseColumn
    paramtype 1 var nAlign as numeric
    ::nAlign := nAlign
return(self)

method GetAlign() class WebExBrowseColumn
return(::nAlign)

method GetAlignClass() class WebExBrowseColumn
    local cClass as character
    do case
        case (::nAlign == FWWEBEX_BROWSE_ALIGN_LEFT)
            cClass := "text-start"
        case (::nAlign == FWWEBEX_BROWSE_ALIGN_RIGHT)
            cClass := "text-end"
        case (::nAlign == FWWEBEX_BROWSE_ALIGN_CENTER)
            cClass := "text-center"
        otherwise
            if (::cType == "N")
                cClass := "text-end"
            elseif (::cType $ "D|L")
                cClass := "text-center"
            else
                cClass := "text-start"
            endif
    end case
return(cClass)

method SetVisible(lVisible) class WebExBrowseColumn
    paramtype 1 var lVisible as logical
    ::lVisible := lVisible
return(self)

method IsVisible() class WebExBrowseColumn
return(::lVisible)

