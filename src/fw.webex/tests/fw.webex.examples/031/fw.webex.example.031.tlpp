#include "fw.webex.th"

using namespace FWWebEx
using namespace FWWebEx.Tools

procedure u_FWWebExExample_031()
    local bExecute as codeblock
    local cHTML as character
    local cHTMLFile as character
    local cProcName:=ProcName() as character
    local oTWebChannel:=WebApp():GetTWebChannel() as object
    bExecute:={||FWMsgRun(nil,{||cHTMLFile:=FWWebExExample_031(@cHTML)},"Aguarde",cProcName)}
    FWExampleTools():Execute(bExecute,cProcName,.F.,.F.)
    if (!Empty(cHTMLFile).and.File(cHTMLFile))
        FWExampleTools():htmlFileShow(cHTML,cProcName,cHTMLFile,oTWebChannel)
        fErase(cHTMLFile)
    endif
    WebFileTools():ObliterateFWWebExTmpFiles(.T.)
return

static function FWWebExExample_031(cHTML as character) as character

    local cHTMLFile:=ProcName() as character
    local cLayoutJSON as character
    local cOptionsJSON as character
    local cRecordsJSON as character
    local oFWWebExPage as object

    beginContent var cLayoutJSON
{
  "schema": "fwwebex.labels",
  "version": 2,
  "name": "rotulo-demonstracao",
  "unit": "mm",
  "page": {
    "width": 100,
    "height": 60,
    "rotation": 0,
    "margins": {"top": 0, "right": 0, "bottom": 0, "left": 0},
    "safeArea": 2,
    "bleed": 0
