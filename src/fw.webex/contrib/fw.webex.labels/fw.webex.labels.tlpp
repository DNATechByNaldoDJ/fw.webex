        }
        function geometric(items,axis,reverse){
            const coordinate=axis==="x"?"x":"y",other=axis==="x"?"y":"x";
            return items.slice().sort(function(a,b){
                const primary=a.box[coordinate]-b.box[coordinate],
                    secondary=a.box[other]-b.box[other];
