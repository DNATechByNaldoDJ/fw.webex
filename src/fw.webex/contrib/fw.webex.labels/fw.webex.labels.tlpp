    function applyContainers(layout){
        const elements=layout.elements||[],byId=new Map(elements.map(function(item){return [item.id,item];}));
        const indexes=new Map(elements.map(function(item,index){return [item,index];}));
        function orderedChildren(container){
            const explicit=(container.layout.children||[]).map(function(id){return byId.get(id);}).filter(Boolean);
            elements.forEach(function(item){
                if(item.containerId===container.id&&explicit.indexOf(item)<0)explicit.push(item);
            });
            return explicit;
        }
        function apply(container,visited){
            if(visited.has(container.id))return;
            visited.add(container.id);
            const config=container.layout,children=orderedChildren(container),vertical=config.direction!=="horizontal";
            const padding=config.padding,box=container.box,gap=config.gap;
            const mainStart=(vertical?box.y+padding.top:box.x+padding.left);
            const mainSize=Math.max(0,vertical?box.height-padding.top-padding.bottom:box.width-padding.left-padding.right);
            const crossStart=vertical?box.x+padding.left:box.y+padding.top;
            const crossSize=Math.max(0,vertical?box.width-padding.left-padding.right:box.height-padding.top-padding.bottom);
            const dimensions=children.map(function(item){
                const margin=item.type==="text"?item.style.margin:normalizeInsets(0);
                const basis=item.basisBox||item.box;
                return {item:item,margin:margin,width:basis.width,height:basis.height};
            });
            const baseTotal=dimensions.reduce(function(sum,entry){
                return sum+(vertical?entry.margin.top+entry.height+entry.margin.bottom:
                    entry.margin.left+entry.width+entry.margin.right);
            },0);
            let actualGap=gap,total=baseTotal+Math.max(0,children.length-1)*gap;
            if((config.sizing==="distribute"||config.mainAlign==="space-between")&&children.length>1&&mainSize>baseTotal){
                actualGap=(mainSize-baseTotal)/(children.length-1);total=mainSize;
            }
            const marginTotal=dimensions.reduce(function(sum,entry){
                return sum+(vertical?entry.margin.top+entry.margin.bottom:entry.margin.left+entry.margin.right);
            },0);
            const contentTotal=dimensions.reduce(function(sum,entry){return sum+(vertical?entry.height:entry.width);},0);
            let scale=1;
            if(config.sizing==="shrink"&&total>mainSize&&contentTotal>0){
                scale=Math.max(0,(mainSize-marginTotal-Math.max(0,children.length-1)*gap)/contentTotal);
            }
            const equalMain=config.sizing==="equal"&&children.length?
                Math.max(0,(mainSize-marginTotal-Math.max(0,children.length-1)*gap)/children.length):null;
            const adjustedContentTotal=equalMain!==null?equalMain*children.length:
                contentTotal*(scale<1?scale:1);
            total=marginTotal+adjustedContentTotal+
                Math.max(0,children.length-1)*actualGap;
            let cursor=mainStart,crossOverflow=false;
            if(config.mainAlign==="center"&&total<mainSize)cursor+=(mainSize-total)/2;
            if(config.mainAlign==="end"&&total<mainSize)cursor+=mainSize-total;
            dimensions.forEach(function(entry){
                const item=entry.item,margin=entry.margin;item.box.width=entry.width;item.box.height=entry.height;
                if(vertical){
                    cursor+=margin.top;item.box.y=cursor;
                    if(equalMain!==null)item.box.height=equalMain;else if(scale<1)item.box.height=entry.height*scale;
                    if(config.crossAlign==="stretch"){item.box.x=crossStart+margin.left;
                        item.box.width=Math.max(0,crossSize-margin.left-margin.right);}
                    if(config.crossAlign==="left"||config.crossAlign==="start")item.box.x=crossStart+margin.left;
                    if(config.crossAlign==="center")item.box.x=crossStart+(crossSize-item.box.width)/2;
                    if(config.crossAlign==="right"||config.crossAlign==="end")
                        item.box.x=crossStart+crossSize-margin.right-item.box.width;
                    cursor+=item.box.height+margin.bottom;
                }else{
                    cursor+=margin.left;item.box.x=cursor;
                    if(equalMain!==null)item.box.width=equalMain;else if(scale<1)item.box.width=entry.width*scale;
                    if(config.crossAlign==="stretch"){item.box.y=crossStart+margin.top;
                        item.box.height=Math.max(0,crossSize-margin.top-margin.bottom);}
                    if(config.crossAlign==="top"||config.crossAlign==="start")item.box.y=crossStart+margin.top;
                    if(config.crossAlign==="middle"||config.crossAlign==="center")
                        item.box.y=crossStart+(crossSize-item.box.height)/2;
                    if(config.crossAlign==="bottom"||config.crossAlign==="end")
                        item.box.y=crossStart+crossSize-margin.bottom-item.box.height;
                    cursor+=item.box.width+margin.right;
                }
                const crossBegin=vertical?item.box.x:item.box.y;
                const crossLength=vertical?item.box.width:item.box.height;
                const crossMarginStart=vertical?margin.left:margin.top;
                const crossMarginEnd=vertical?margin.right:margin.bottom;
