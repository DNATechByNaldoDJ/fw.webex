#include "totvs.ch"

using namespace FWWebEx
using namespace FWWebEx.Tools

/*{Protheus.doc} u_FlattenJSONSample
    Exemplos rapidos de uso.
    @type User Procedure
*/
procedure u_FlattenJSONSample()

    if (!FWIsInCallStack("Execute"))
        private cCadastro:="Exemplos FWWebEx :: FlattenJSONSample" as character
        FWExampleTools():Execute({||FlattenJSONSample()},cCadastro,.T.)
    else
        FlattenJSONSample()
    endif

return

static procedure FlattenJSONSample()

    local jJSON as json
    local jFlatten as json
    local jUFlatten as json

    jJSON:=GetJSON()
    jFlatten:=FlattenJSON():Flatten(jJSON)
    EECView(WebExHelper():JSONPrettify(jFlatten:ToJSON()),"jFlatten")
    jUFlatten:=FlattenJSON():UnFlatten(jFlatten)
    EECView(WebExHelper():JSONPrettify(jUFlatten:ToJSON()),"jUFlatten")

    FreeObj(@jUFlatten)
    FreeObj(@jFlatten)
    FreeObj(@jJSON)

return

