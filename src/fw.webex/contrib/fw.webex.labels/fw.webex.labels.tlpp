        if(hasOwn.call(variable,"default")&&!emptyValue(variable.default))
            return {value:clone(variable.default),source:"default"};
        const type=String(variable.type||"string").toLowerCase();
        if(type==="number"||type==="integer")return {value:0,source:"type"};
        if(type==="boolean")return {value:false,source:"type"};
        if(type==="object")return {value:{},source:"type"};
        if(type==="array")return {value:[],source:"type"};
        if(descriptor.barcodeFormats.length)return {
            value:barcodeSampleValue(descriptor.barcodeFormats[0],
                layout.barcodeFallbackFormat),source:"barcode"
        };
