static function GetRecordsJSON() as character

    local cTmpPath as character
    local cRecordsJSON as character
    local cTmpFullPathFile as character

    cTmpPath:={"Path":StrTran("\\tmp\\fwwebex\\fw.webex.rotulos.json\\","\\",BACK_SLASH)}["Path"]
    cTmpFullPathFile:=cTmpPath+"fwwebex_rotulos_dados_contrato_1.json"
    if (File(cTmpFullPathFile))
        if (FindClass("dna.tech.FileTools"))
            cLayoutJSON:=dna.tech.FileTools():FullContentTextFile(cTmpFullPathFile)
        else
            oFileReader:=FWFileReader():New(cTmpFullPathFile)
            oFileReader:Open()
            cLayoutJSON:=oFileReader():FullRead()
            oFileReader:Close()
            FreeObj(@oFileReader)
        endif
    endif

    //Fallback
    if (Empty(cRecordsJSON))
        beginContent var cRecordsJSON
