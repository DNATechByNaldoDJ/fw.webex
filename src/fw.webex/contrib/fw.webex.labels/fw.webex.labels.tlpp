        <button type="button" role="tab" data-tab-group="inspector" data-tab-target="barcode"
          data-tab-type="barcode" aria-selected="false" tabindex="-1">C&oacute;digo de barras</button>
      </div>
      <div class="fwwebex-label-tabpanel" role="tabpanel" data-tab-group="inspector"
        data-tab-panel="element">
        <div class="fwwebex-label-form-grid">
          <div class="is-wide" data-role="resolved-value"></div>
          <label class="is-wide">ID<input data-property="id" type="text"></label>
          <label class="is-wide">Nome<input data-property="name" type="text"></label>
          <label class="is-wide">Conte&uacute;do / mnem&ocirc;nico<input data-property="template" type="text"></label>
          <label class="is-wide">&Aacute;rea pai<select data-property="containerId"></select></label>
          <label>Tipo <input data-property="type" type="text" readonly></label>
          <label>Bloqueado<select data-property="locked" data-value-type="boolean"><option value="false">N&atilde;o</option><option value="true">Sim</option></select></label>
          <label>Oculto<select data-property="hidden" data-value-type="boolean"><option value="false">N&atilde;o</option><option value="true">Sim</option></select></label>
        </div>
      </div>
      <div class="fwwebex-label-tabpanel" role="tabpanel" data-tab-group="inspector"
        data-tab-panel="geometry" hidden>
        <div class="fwwebex-label-form-grid">
          <label>X (mm)<input data-property="box.x" type="number" step=".1"></label>
          <label>Y (mm)<input data-property="box.y" type="number" step=".1"></label>
          <label>Largura<input data-property="box.width" type="number" min=".1" step=".1"></label>
          <label>Altura<input data-property="box.height" type="number" min=".1" step=".1"></label>
          <label>Rota&ccedil;&atilde;o<input data-property="rotation" type="number" step="1"></label>
          <label>Camada<input data-property="zIndex" type="number" step="1"></label>
        </div>
      </div>
      <div class="fwwebex-label-tabpanel" role="tabpanel" data-tab-group="inspector"
        data-tab-panel="appearance" data-tab-type="text" hidden>
        <div class="fwwebex-label-form-grid">
          <label data-for-type="text">Fam&iacute;lia<select data-property="style.fontFamily"><option value="helvetica">Helvetica</option><option value="times">Times</option><option value="courier">Courier</option></select></label>
          <label data-for-type="text">Fonte (pt)<input data-property="style.fontSize" type="number" min="1" step=".25"></label>
          <label data-for-type="text">Fonte m&iacute;nima<input data-property="style.minFontSize" type="number" min="1" step=".25"></label>
          <label data-for-type="text">Estilo<select data-property="style.fontStyle"><option value="normal">Normal</option><option value="bold">Negrito</option><option value="italic">It&aacute;lico</option><option value="bolditalic">Negrito + it&aacute;lico</option></select></label>
          <label data-for-type="text">Cor<input data-property="style.color" type="color"></label>
          <label data-for-type="text">Altura da linha<input data-property="style.lineHeightFactor" type="number" min=".1" step=".05"></label>
          <label data-for-type="text">Espa&ccedil;amento letras<input data-property="style.letterSpacing" type="number" step=".01"></label>
          <label data-for-type="text">Autoajuste<select data-property="fit.mode"><option value="shrink">Reduzir at&eacute; caber</option><option value="none">Desativado</option></select></label>
          <label data-for-type="text">Alinhamento<select data-property="style.align"><option value="left">Esquerda</option><option value="center">Centro</option><option value="right">Direita</option><option value="justify">Justificado</option></select></label>
          <label data-for-type="text">Vertical<select data-property="style.verticalAlign"><option value="top">Topo</option><option value="middle">Centro</option><option value="bottom">Base</option></select></label>
          <label data-for-type="text">M&aacute;x. linhas<input data-property="fit.maxLines" type="number" min="1" step="1"></label>
          <label data-for-type="text">Excesso<select data-property="fit.overflow"><option value="error">Erro</option><option value="clip">Recortar</option><option value="ellipsis">Retic&ecirc;ncias</option></select></label>
          <label data-for-type="text">Padding topo<input data-property="style.padding.top" type="number" min="0" step=".1"></label>
          <label data-for-type="text">Padding direita<input data-property="style.padding.right" type="number" min="0" step=".1"></label>
          <label data-for-type="text">Padding base<input data-property="style.padding.bottom" type="number" min="0" step=".1"></label>
          <label data-for-type="text">Padding esquerda<input data-property="style.padding.left" type="number" min="0" step=".1"></label>
          <label data-for-type="text">Margem topo<input data-property="style.margin.top" type="number" min="0" step=".1"></label>
          <label data-for-type="text">Margem direita<input data-property="style.margin.right" type="number" min="0" step=".1"></label>
          <label data-for-type="text">Margem base<input data-property="style.margin.bottom" type="number" min="0" step=".1"></label>
          <label data-for-type="text">Margem esquerda<input data-property="style.margin.left" type="number" min="0" step=".1"></label>
          <details class="is-wide" data-for-type="text"><summary>Avan&ccedil;ado</summary>
            <label>textOptions (JSON)<textarea data-property="textOptions"
              data-value-type="json"></textarea></label>
          </details>
        </div>
      </div>
      <div class="fwwebex-label-tabpanel" role="tabpanel" data-tab-group="inspector"
        data-tab-panel="layout" data-tab-type="container" hidden>
        <div class="fwwebex-label-form-grid">
          <label data-for-type="container">Dire&ccedil;&atilde;o<select data-property="layout.direction"><option value="vertical">Vertical</option><option value="horizontal">Horizontal</option></select></label>
          <label data-for-type="container">Espa&ccedil;amento<input data-property="layout.gap" type="number" min="0" step=".1"></label>
          <label data-for-type="container">Padding topo<input data-property="layout.padding.top" type="number" min="0" step=".1"></label>
          <label data-for-type="container">Padding direita<input data-property="layout.padding.right" type="number" min="0" step=".1"></label>
          <label data-for-type="container">Padding base<input data-property="layout.padding.bottom" type="number" min="0" step=".1"></label>
          <label data-for-type="container">Padding esquerda<input data-property="layout.padding.left" type="number" min="0" step=".1"></label>
          <label data-for-type="container">Alinhamento transversal<select data-property="layout.crossAlign"><option value="start">In&iacute;cio</option><option value="center">Centro</option><option value="end">Fim</option><option value="stretch">Esticar</option></select></label>
          <label data-for-type="container">Alinhamento principal<select data-property="layout.mainAlign"><option value="start">In&iacute;cio</option><option value="center">Centro</option><option value="end">Fim</option><option value="space-between">Distribuir</option></select></label>
          <label data-for-type="container">Dimensionamento<select data-property="layout.sizing"><option value="none">Preservar</option><option value="shrink">Reduzir</option><option value="equal">Igualar</option><option value="distribute">Distribuir</option></select></label>
          <label data-for-type="container">Excesso<select data-property="layout.overflow"><option value="error">Erro</option><option value="visible">Vis&iacute;vel</option><option value="clip">Recortar</option></select></label>
          <label data-for-type="container">Recortar filhos<select data-property="layout.clipChildren" data-value-type="boolean"><option value="false">N&atilde;o</option><option value="true">Sim</option></select></label>
        </div>
      </div>
      <div class="fwwebex-label-tabpanel" role="tabpanel" data-tab-group="inspector"
        data-tab-panel="barcode" data-tab-type="barcode" hidden>
        <div class="fwwebex-label-form-grid">
          <label data-for-type="barcode">Formato<select data-property="format"><option>CODE128</option><option>EAN13</option><option>EAN8</option><option>UPC</option><option>CODE39</option><option>ITF14</option><option>MSI</option><option>pharmacode</option><option>AUTO</option></select></label>
          <label data-for-type="barcode">M&oacute;dulo m&iacute;nimo<input data-property="minModuleWidth" type="number" min="0" step=".01"></label>
          <label data-for-type="barcode">Zona silenciosa<input data-property="quietZone" type="number" min="0" step=".1"></label>
          <label data-for-type="barcode">Margem do texto<input data-property="textMargin" type="number" min="0" step=".1"></label>
          <label data-for-type="barcode">Mostrar valor<select data-property="displayValue" data-value-type="boolean"><option value="true">Sim</option><option value="false">N&atilde;o</option></select></label>
          <label data-for-type="barcode">Autoajuste<select data-property="autoFit" data-value-type="boolean"><option value="true">Sim</option><option value="false">N&atilde;o</option></select></label>
          <label data-for-type="barcode">Excesso<select data-property="overflow"><option value="error">Erro</option><option value="allow">Permitir com aviso</option></select></label>
          <label data-for-type="barcode">Fonte do valor<input data-property="humanReadableFontFamily" type="text"></label>
          <label data-for-type="barcode">Tamanho do valor<input data-property="humanReadableFontSize" type="number" min="1" step=".25"></label>
          <label data-for-type="barcode">Tamanho m&iacute;nimo<input data-property="humanReadableMinFontSize" type="number" min="1" step=".25"></label>
          <label data-for-type="barcode">Estilo do valor<select data-property="humanReadableFontStyle"><option value="normal">Normal</option><option value="bold">Negrito</option><option value="italic">It&aacute;lico</option><option value="bolditalic">Negrito + it&aacute;lico</option></select></label>
          <label data-for-type="barcode">Cor do valor<input data-property="humanReadableColor" type="color"></label>
          <label data-for-type="barcode">Posi&ccedil;&atilde;o do valor<select data-property="humanReadablePosition"><option value="top">Topo</option><option value="bottom">Base</option></select></label>
          <label data-for-type="barcode">Alinhamento do valor<select data-property="humanReadableAlign"><option value="left">Esquerda</option><option value="center">Centro</option><option value="right">Direita</option></select></label>
          <label data-for-type="barcode">Excesso do valor<select data-property="textOverflow"><option value="error">Erro</option><option value="clip">Recortar</option><option value="ellipsis">Retic&ecirc;ncias</option></select></label>
          <details class="is-wide" data-for-type="barcode"><summary>Avan&ccedil;ado</summary>
            <label>barcodeOptions (JSON)<textarea data-property="barcodeOptions"
              data-value-type="json"></textarea></label>
          </details>
        </div>
      </div>
    </div>
  </aside>
</div>
<section class="fwwebex-label-pane fwwebex-label-drawer fwwebex-label-drawers"
  data-role="drawers" data-collapsed="false">
  <div class="fwwebex-label-panel-head fwwebex-label-drawer-head">
    <div class="fwwebex-label-tablist" role="tablist" aria-label="Dados e diagn&oacute;sticos">
      <button type="button" role="tab" data-tab-group="drawers" data-tab-target="data"
        aria-selected="true" tabindex="0">Dados</button>
      <button type="button" role="tab" data-tab-group="drawers" data-tab-target="contract"
        aria-selected="false" tabindex="-1">Contrato</button>
      <button type="button" role="tab" data-tab-group="drawers" data-tab-target="problems"
        aria-selected="false" tabindex="-1">Problemas
        <span class="fwwebex-label-problem-count" data-role="problem-count"
          aria-label="0 problemas">0</span></button>
    </div>
    <button type="button" data-action="toggle-drawers" aria-expanded="true"
      aria-label="Recolher painel inferior">Recolher</button>
  </div>
  <div class="fwwebex-label-drawer-content">
    <div class="fwwebex-label-tabpanel" role="tabpanel" data-tab-group="drawers"
      data-tab-panel="data">
      <div class="fwwebex-label-panel-head"><span>Dados JSON para valida&ccedil;&atilde;o e preview</span>
        <button type="button" data-action="generate-sample-records" data-tone="success"
          title="Cria os mnem&ocirc;nicos ausentes sem substituir valores existentes">
          Gerar / completar dados</button></div>
      <div class="fwwebex-label-panel-body"><textarea data-role="records-editor"
        aria-label="Dados JSON para valida&ccedil;&atilde;o e preview"></textarea></div>
    </div>
    <div class="fwwebex-label-tabpanel" role="tabpanel" data-tab-group="drawers"
      data-tab-panel="contract" hidden>
      <div class="fwwebex-label-panel-head"><span>Contrato JSON do layout</span>
        <span data-role="contract-state">Sincronizado</span></div>
      <div class="fwwebex-label-panel-body"><textarea data-role="contract-editor"
        aria-label="Contrato JSON do layout"></textarea>
        <div class="fwwebex-label-toolbar fwwebex-label-drawer-actions">
          <button type="button" data-action="format-json">Formatar JSON</button>
          <button type="button" data-action="apply-json">Aplicar JSON editado</button>
          <button type="button" data-action="discard-json">Descartar edi&ccedil;&atilde;o</button>
        </div>
      </div>
    </div>
    <div class="fwwebex-label-tabpanel" role="tabpanel" data-tab-group="drawers"
      data-tab-panel="problems" hidden>
      <div class="fwwebex-label-panel-head"><span>Erros e avisos de valida&ccedil;&atilde;o</span></div>
      <div class="fwwebex-label-panel-body">
        <div class="fwwebex-label-problems" data-role="problems" aria-live="polite">
          Valide o layout para atualizar os diagn&oacute;sticos.
        </div>
      </div>
    </div>
  </div>
</section>
<div class="fwwebex-label-statusbar" data-role="status" aria-live="polite">
  <span data-role="status-message">Pronto.</span><span data-role="status-selection">Nenhuma sele&ccedil;&atilde;o</span>
</div>`);
    }
    let stage=root.querySelector("[data-role=stage]");
    let image=root.querySelector("[data-role=background]");
    let fields=root.querySelector("[data-role=fields]");
    if(!stage&&!image&&!fields){
        buildShell();
        stage=root.querySelector("[data-role=stage]");
        image=root.querySelector("[data-role=background]");
        fields=root.querySelector("[data-role=fields]");
    }
    if(!stage||!image||!fields)throw new Error(
        "FWWebEx Labels: estrutura do designer incompleta; stage, background e fields sao obrigatorios.");
    const SCHEMA="fwwebex.labels",CONTRACT_VERSION=2;
    const state={
        layout:{
            schema:SCHEMA,version:CONTRACT_VERSION,name:"rotulo",unit:"mm",
            page:{
                width:__WIDTH__,height:__HEIGHT__,rotation:0,
                margins:{top:0,right:0,bottom:0,left:0},safeArea:0,bleed:0
            },
            background:null,
            editor:{
                grid:{enabled:false,step:1},
                snap:{enabled:false,tolerancePx:8,referenceElementId:null,chainMode:false},
                guides:[]
            },
            variables:[],barcodeAutoRules:[],barcodeFallbackFormat:"CODE128",elements:[]
        },
        records:[],selected:null,selection:[],recordIndex:0,mode:"design",
        printOverlay:false,overlayOpacity:.5,
        zoom:"fit",options:{},contractDirty:false,autoSampleRecords:true,
        tabs:{toolbar:"document",sidebar:"layers",inspector:"element",drawers:"data"},
        drawersCollapsed:false,elementsCollapsed:false,elementsMinimized:false,
        history:[],historyIndex:-1,
        lastReport:null,previewViewport:null,previewPending:false,
        snapFeedback:{x:null,y:null}
    };
    const containerOverflow=Object.create(null);
    let action=null,renderFrame=null,previewTimer=null,previewToken=0,
        previewAbort=null,previewHandle=null;

    function uid(){ return "field-"+Date.now().toString(36)+"-"+Math.random().toString(36).slice(2,6); }
    function clone(value){return value==null?value:JSON.parse(JSON.stringify(value));}
    function defined(value,fallback){return value===undefined||value===null?fallback:value;}
    function num(value,fallback){ value=Number(value); return Number.isFinite(value)?value:fallback; }
    function normalizeInsets(value,fallback){
        fallback=num(fallback,0);
        if(typeof value==="number"&&Number.isFinite(value))
            return {top:value,right:value,bottom:value,left:value};
        value=value&&typeof value==="object"?value:{};
        const vertical=num(value.y,fallback),horizontal=num(value.x,fallback);
        return {
            top:num(value.top,vertical),right:num(value.right,horizontal),
            bottom:num(value.bottom,vertical),left:num(value.left,horizontal)
        };
    }
    function insetShortcut(value){
        value=normalizeInsets(value,0);
        return value.top===value.right&&value.top===value.bottom&&value.top===value.left?
            value.top:clone(value);
    }
    function page(){return state.layout.page;}
    function elements(){return state.layout.elements;}
    function pageGeometry(){
        const api=window.FWWebExLabels&&window.FWWebExLabels.geometry;
        if(api&&typeof api.pageTransform==="function")return api.pageTransform(page());
        const width=num(page().width,0),height=num(page().height,0),
            rotation=((num(page().rotation,0)%360)+360)%360;
        if(rotation===90)return {rotation:rotation,sourceWidth:width,sourceHeight:height,
            width:height,height:width,matrix:[0,1,-1,0,height,0]};
        if(rotation===180)return {rotation:rotation,sourceWidth:width,sourceHeight:height,
            width:width,height:height,matrix:[-1,0,0,-1,width,height]};
        if(rotation===270)return {rotation:rotation,sourceWidth:width,sourceHeight:height,
            width:height,height:width,matrix:[0,-1,1,0,0,width]};
        return {rotation:0,sourceWidth:width,sourceHeight:height,
            width:width,height:height,matrix:[1,0,0,1,0,0]};
    }
    function transformPoint(matrix,point){
        const api=window.FWWebExLabels&&window.FWWebExLabels.geometry;
        if(api&&typeof api.transformPoint==="function")return api.transformPoint(matrix,point);
        return {
            x:matrix[0]*point.x+matrix[2]*point.y+matrix[4],
            y:matrix[1]*point.x+matrix[3]*point.y+matrix[5]
        };
    }
    function inverseMatrix(matrix){
        const api=window.FWWebExLabels&&window.FWWebExLabels.geometry;
        if(api&&typeof api.invertMatrix==="function")return api.invertMatrix(matrix);
        const determinant=matrix[0]*matrix[3]-matrix[1]*matrix[2];
        return [matrix[3]/determinant,-matrix[1]/determinant,
            -matrix[2]/determinant,matrix[0]/determinant,
            (matrix[2]*matrix[5]-matrix[3]*matrix[4])/determinant,
            (matrix[1]*matrix[4]-matrix[0]*matrix[5])/determinant];
    }
    function ensureEditor(){
        state.layout.editor=state.layout.editor&&typeof state.layout.editor==="object"?
            state.layout.editor:{};
        state.layout.editor.grid=Object.assign({enabled:false,step:1},
            state.layout.editor.grid||{});
        state.layout.editor.snap=Object.assign({
            enabled:false,tolerancePx:8,referenceElementId:null,chainMode:false
        },state.layout.editor.snap||{});
        if(!Array.isArray(state.layout.editor.guides))state.layout.editor.guides=[];
        return state.layout.editor;
    }
    function pxmm(){
        const geometry=pageGeometry(),rect=stage.getBoundingClientRect&&
            stage.getBoundingClientRect();
        if(state.mode==="print"&&state.previewViewport)
            return Math.max(.0001,(rect&&rect.width||stage.clientWidth||
                state.previewViewport.width)/geometry.width);
        return Math.max(.0001,(rect&&rect.width||stage.clientWidth||1)/page().width);
    }
    function pointerSourcePoint(event){
        const rect=typeof stage.getBoundingClientRect==="function"?
                stage.getBoundingClientRect():{
                    left:0,top:0,width:stage.clientWidth||page().width,
                    height:stage.clientHeight||page().height
                },geometry=pageGeometry(),
            outputWidth=state.mode==="print"&&state.previewViewport?
                geometry.width:page().width,
            outputHeight=state.mode==="print"&&state.previewViewport?
                geometry.height:page().height,
            x=(event.clientX-rect.left)/(rect.width||1)*outputWidth,
            y=(event.clientY-rect.top)/(rect.height||1)*outputHeight,
            point=state.mode==="print"&&state.previewViewport?
                transformPoint(inverseMatrix(geometry.matrix),{x:x,y:y}):{x:x,y:y};
        return {
            x:Math.max(0,Math.min(page().width,point.x)),
            y:Math.max(0,Math.min(page().height,point.y))
        };
    }
    function selected(){ return elements().find(function(item){return item.id===state.selected;}); }
    function selectedItems(){return elements().filter(function(item){return state.selection.indexOf(item.id)>=0;});}
    function defineLegacy(item,name,getter,setter){
        if(Object.prototype.hasOwnProperty.call(item,name))return;
        Object.defineProperty(item,name,{
            configurable:true,enumerable:false,get:getter,set:setter
        });
    }
    function setBoldStyle(item,value){
        const current=String(item.style.fontStyle||"normal").toLowerCase();
        const italic=current.indexOf("italic")>=0;
        item.style.fontStyle=value===true?(italic?"bolditalic":"bold"):(italic?"italic":"normal");
    }
    function attachLegacyAccessors(item){
        defineLegacy(item,"x",function(){return item.box.x;},
            function(value){item.box.x=num(value,item.box.x);});
        defineLegacy(item,"y",function(){return item.box.y;},
            function(value){item.box.y=num(value,item.box.y);});
        defineLegacy(item,"width",function(){return item.box.width;},
            function(value){item.box.width=num(value,item.box.width);});
        defineLegacy(item,"height",function(){return item.box.height;},
            function(value){item.box.height=num(value,item.box.height);});
        defineLegacy(item,"value",function(){return item.template;},
            function(value){item.template=String(defined(value,""));});
        defineLegacy(item,"basisWidth",function(){return item.basisBox&&item.basisBox.width;},
            function(value){
                item.basisBox=item.basisBox||{width:item.box.width,height:item.box.height};
                item.basisBox.width=num(value,item.basisBox.width);
            });
        defineLegacy(item,"basisHeight",function(){return item.basisBox&&item.basisBox.height;},
            function(value){
                item.basisBox=item.basisBox||{width:item.box.width,height:item.box.height};
                item.basisBox.height=num(value,item.basisBox.height);
            });
        if(item.type==="text"){
            ["fontFamily","align","verticalAlign","color"].forEach(function(name){
                defineLegacy(item,name,function(){return item.style[name];},
                    function(value){item.style[name]=String(value);});
            });
            ["fontSize","minFontSize","lineHeightFactor","letterSpacing"]
                .forEach(function(name){
                    defineLegacy(item,name,function(){return item.style[name];},
                        function(value){item.style[name]=num(value,item.style[name]);});
            });
            defineLegacy(item,"padding",function(){return insetShortcut(item.style.padding);},
                function(value){item.style.padding=normalizeInsets(value,0);});
            defineLegacy(item,"margin",function(){return insetShortcut(item.style.margin);},
                function(value){item.style.margin=normalizeInsets(value,0);});
            defineLegacy(item,"maxLines",function(){return item.fit.maxLines;},
                function(value){item.fit.maxLines=Math.max(1,num(value,item.fit.maxLines));});
            defineLegacy(item,"overflow",function(){return item.fit.overflow;},
                function(value){item.fit.overflow=String(value);});
            defineLegacy(item,"autoFit",function(){return item.fit.mode==="shrink";},
                function(value){item.fit.mode=value===false?"none":"shrink";});
            defineLegacy(item,"bold",function(){
                return String(item.style.fontStyle||"").toLowerCase().indexOf("bold")>=0;
            },function(value){setBoldStyle(item,value);});
        }else if(item.type==="container"){
            ["direction","crossAlign","mainAlign","sizing","overflow"].forEach(function(name){
                    defineLegacy(item,name,function(){return item.layout[name];},
                        function(value){item.layout[name]=String(value);});
                });
            defineLegacy(item,"gap",function(){return item.layout.gap;},
                function(value){item.layout.gap=num(value,item.layout.gap);});
            defineLegacy(item,"clipChildren",function(){return item.layout.clipChildren;},
                function(value){item.layout.clipChildren=value===true;});
            defineLegacy(item,"padding",function(){return insetShortcut(item.layout.padding);},
                function(value){item.layout.padding=normalizeInsets(value,0);});
        }
        return item;
    }
    function attachLayoutAccessors(layout){
        layout.elements.forEach(attachLegacyAccessors);
        return layout;
    }
    function elementBase(type,mnemonic){
        const index=elements().length,barcode=type==="barcode";
        const item={
            id:uid(),name:"",type:type,template:"{{"+mnemonic+"}}",
            box:{x:5,y:5,width:barcode?45:35,height:barcode?16:8},
            rotation:0,zIndex:index,locked:false,hidden:false,containerId:null
        };
        if(type==="text"){
            item.style={
                fontFamily:"helvetica",fontSize:14,minFontSize:5,fontStyle:"normal",
                color:"#000000",lineHeightFactor:1.15,letterSpacing:0,
                align:"left",verticalAlign:"top",padding:normalizeInsets(1,0),
                margin:normalizeInsets(0,0)
            };
            item.fit={mode:"shrink",maxLines:2,overflow:"error"};
            item.textOptions={};
        }else if(type==="barcode"){
            item.format="CODE128";item.fallbackFormat="CODE128";item.displayValue=true;
            item.quietZone=2;item.minModuleWidth=0.19;item.overflow="error";
            item.humanReadableFontSize=16;item.humanReadableMinFontSize=6;
            item.humanReadableFontFamily="courier";item.humanReadableFontStyle="normal";
            item.humanReadableColor="#000000";item.humanReadablePosition="bottom";
            item.humanReadableAlign="center";item.textMargin=2;item.autoFit=true;
            item.textOverflow="error";item.barcodeOptions={};
        }else if(type==="container"){
            item.name="Area de layout";item.template="";
            item.box.width=45;item.box.height=40;
            item.layout={
                direction:"vertical",padding:normalizeInsets(1,0),gap:1,
                crossAlign:"stretch",mainAlign:"start",sizing:"shrink",
                overflow:"error",clipChildren:false,children:[]
            };
        }
        return attachLegacyAccessors(item);
    }
    function applyElementPatch(item,patch){
        patch=patch||{};
        if(patch.box&&typeof patch.box==="object"){
            ["x","y","width","height"].forEach(function(name){
                if(patch.box[name]!==undefined)item.box[name]=num(patch.box[name],item.box[name]);
            });
        }
        if(item.type==="text"&&patch.style&&typeof patch.style==="object"){
            const style=patch.style;
            Object.keys(style).forEach(function(name){
                if(name==="padding"||name==="margin")
                    item.style[name]=normalizeInsets(style[name],0);
                else if(["fontSize","minFontSize","lineHeightFactor","letterSpacing"]
                    .indexOf(name)>=0)item.style[name]=num(style[name],item.style[name]);
                else if(["fontFamily","fontStyle","color","align","verticalAlign"]
                    .indexOf(name)>=0)item.style[name]=String(style[name]);
            });
        }
        if(item.type==="text"&&patch.fit&&typeof patch.fit==="object"){
            if(patch.fit.mode!==undefined)item.fit.mode=String(patch.fit.mode);
            if(patch.fit.maxLines!==undefined)
                item.fit.maxLines=Math.max(1,num(patch.fit.maxLines,item.fit.maxLines));
            if(patch.fit.overflow!==undefined)item.fit.overflow=String(patch.fit.overflow);
        }
        if(item.type==="container"&&patch.layout&&typeof patch.layout==="object"){
            Object.keys(patch.layout).forEach(function(name){
                if(name==="padding")item.layout.padding=normalizeInsets(patch.layout.padding,0);
                else if(name==="children")item.layout.children=Array.isArray(patch.layout.children)?
                    patch.layout.children.map(String):[];
                else if(name==="gap")item.layout.gap=num(patch.layout.gap,item.layout.gap);
                else if(name==="clipChildren")
                    item.layout.clipChildren=patch.layout.clipChildren===true;
                else if(["direction","crossAlign","mainAlign","sizing","overflow"]
                    .indexOf(name)>=0)item.layout[name]=String(patch.layout[name]);
            });
        }
        if(patch.basisBox&&typeof patch.basisBox==="object"){
            item.basisBox=item.basisBox||{width:item.box.width,height:item.box.height};
            if(patch.basisBox.width!==undefined)
                item.basisBox.width=num(patch.basisBox.width,item.basisBox.width);
            if(patch.basisBox.height!==undefined)
                item.basisBox.height=num(patch.basisBox.height,item.basisBox.height);
        }
        const nested={box:true,style:true,fit:true,layout:true,basisBox:true,type:true};
        const aliases=["x","y","width","height","value","basisWidth","basisHeight"];
        if(item.type==="text")aliases.push(
            "fontFamily","fontSize","minFontSize","lineHeightFactor","letterSpacing",
            "align","verticalAlign","color","padding","margin","maxLines","overflow",
            "autoFit","bold"
        );
        if(item.type==="container")aliases.push(
            "direction","padding","gap","crossAlign","mainAlign","sizing","overflow",
            "clipChildren"
        );
        const common=["id","name","template","rotation","zIndex","locked","hidden","containerId"];
        const barcodeStrings=[
            "format","fallbackFormat","overflow","humanReadableFontFamily",
            "humanReadableFontStyle","humanReadableColor","humanReadablePosition",
            "humanReadableAlign","textOverflow"
        ];
        const barcodeNumbers=[
            "quietZone","minModuleWidth","humanReadableFontSize",
            "humanReadableMinFontSize","textMargin"
        ];
        Object.keys(patch).forEach(function(name){
            if(nested[name]||name==="mnemonic")return;
            if(aliases.indexOf(name)>=0){item[name]=clone(patch[name]);return;}
            if(common.indexOf(name)>=0){
                if(name==="id"||name==="name"||name==="template")
                    item[name]=String(defined(patch[name],""));
                else if(name==="rotation"||name==="zIndex")
                    item[name]=num(patch[name],item[name]);
                else if(name==="locked"||name==="hidden")item[name]=patch[name]===true;
                else item[name]=patch[name]==null?null:String(patch[name]);
                return;
            }
            if(item.type==="text"&&name==="textOptions")
                item.textOptions=clone(patch.textOptions||{});
            if(item.type==="barcode"&&barcodeStrings.indexOf(name)>=0)
                item[name]=name==="format"||name==="fallbackFormat"?
                    String(patch[name]).toUpperCase():String(patch[name]);
            if(item.type==="barcode"&&barcodeNumbers.indexOf(name)>=0)
                item[name]=num(patch[name],item[name]);
            if(item.type==="barcode"&&(name==="displayValue"||name==="autoFit"))
                item[name]=patch[name]!==false;
            if(item.type==="barcode"&&name==="barcodeOptions")
                item.barcodeOptions=clone(patch.barcodeOptions||{});
        });
        return item;
    }
    function textStyle(item){return item.style;}
    function textFit(item){return item.fit;}
    function styleTextPreview(el,item){
        const content=el.querySelector(".fwwebex-label-field-content")||el;
        const style=textStyle(item),fit=textFit(item),scale=pxmm();
        const maximum=Math.max(1,num(style.fontSize,10));
        const minimum=Math.min(maximum,Math.max(1,num(style.minFontSize,Math.max(3,maximum/3))));
        let size=maximum;
        const fontStyle=String(style.fontStyle||"normal").toLowerCase();
        const padding=normalizeInsets(style.padding,0);
        content.style.fontFamily=style.fontFamily||"Arial";
        content.style.fontWeight=fontStyle.indexOf("bold")>=0?"700":"400";
        content.style.fontStyle=fontStyle.indexOf("italic")>=0?"italic":"normal";
        content.style.color=style.color||"#000000";
        content.style.fontSize=(size*0.352778*scale)+"px";
        content.style.lineHeight=String(Math.max(.5,num(style.lineHeightFactor,1.15)));
        content.style.padding=[
            Math.max(0,padding.top)*scale+"px",Math.max(0,padding.right)*scale+"px",
            Math.max(0,padding.bottom)*scale+"px",Math.max(0,padding.left)*scale+"px"
        ].join(" ");
        content.style.textAlign=style.align==="justify"?"justify":style.align||"left";
        content.style.justifyContent=style.align==="center"?"center":
            style.align==="right"?"flex-end":"flex-start";
        content.style.alignItems=style.verticalAlign==="middle"?"center":
            style.verticalAlign==="bottom"?"flex-end":"flex-start";
        content.style.whiteSpace="pre-wrap";content.style.overflow="hidden";
        if(fit.mode==="shrink"){
            while(size>minimum&&(content.scrollWidth>content.clientWidth+1||content.scrollHeight>content.clientHeight+1)){
                size=Math.max(minimum,size-.25);content.style.fontSize=(size*0.352778*scale)+"px";
            }
        }
    }
    function role(name){return root.querySelector("[data-role="+name+"]");}
    function isRole(control,name){
        return control===role(name)||
            !!(control&&control.dataset&&control.dataset.role===name);
    }
    const listeners=[];
    function listen(target,type,handler,options){
        target.addEventListener(type,handler,options);
        listeners.push({target:target,type:type,handler:handler,options:options});
    }
    function removeListeners(){
        listeners.splice(0).forEach(function(entry){
            if(typeof entry.target.removeEventListener==="function")
                entry.target.removeEventListener(
                    entry.type,entry.handler,entry.options);
        });
    }
    function roleAll(selector){
        return typeof root.querySelectorAll==="function"?
            Array.prototype.slice.call(root.querySelectorAll(selector)):[];
    }
    function tabButtons(group){
        return roleAll('[role="tab"][data-tab-group="'+group+'"]');
    }
    function tabPanels(group){
        return roleAll('[role="tabpanel"][data-tab-group="'+group+'"]');
    }
    function tabAvailable(button){
        return !!button&&button.hidden!==true&&button.getAttribute("aria-disabled")!=="true";
    }
    function activateTab(group,target,focus){
        group=String(group||"");target=String(target||"");
        const buttons=tabButtons(group),panels=tabPanels(group),available=buttons.filter(tabAvailable);
        if(!available.length)return null;
        let active=available.find(function(button){return button.dataset.tabTarget===target;})||
            available.find(function(button){return button.getAttribute("aria-selected")==="true";})||
            available[0];
        target=active.dataset.tabTarget;
        buttons.forEach(function(button){
            const selected=button===active;
            button.setAttribute("aria-selected",String(selected));
            button.tabIndex=selected?0:-1;
        });
        panels.forEach(function(panel){
            const selected=panel.dataset.tabPanel===target;
            panel.hidden=!selected;panel.setAttribute("aria-hidden",String(!selected));
        });
        state.tabs[group]=target;
        if(focus===true&&typeof active.focus==="function")active.focus();
        return active;
    }
    function initializeTabs(){
        const buttons=roleAll('[role="tab"][data-tab-group]'),groups=[];
        buttons.forEach(function(button){
            const group=button.dataset.tabGroup,target=button.dataset.tabTarget;
            if(groups.indexOf(group)<0)groups.push(group);
            const panel=tabPanels(group).find(function(candidate){
                return candidate.dataset.tabPanel===target;
            }),prefix=String(root.id||"fwwebex-label").replace(/[^A-Za-z0-9_-]/g,"-")+
                "-"+group+"-"+target;
            button.id=prefix+"-tab";
            if(panel){
                panel.id=prefix+"-panel";
                button.setAttribute("aria-controls",panel.id);
                panel.setAttribute("aria-labelledby",button.id);
            }
        });
        groups.forEach(function(group){activateTab(group,state.tabs[group],false);});
    }
    function syncInspectorTabs(item){
        const previous=tabPanels("inspector").find(function(panel){
                return panel.dataset.tabPanel===state.tabs.inspector;
            }),previousButton=tabButtons("inspector").find(function(button){
                return button.dataset.tabTarget===state.tabs.inspector;
            }),focusWithin=!!(previous&&typeof previous.contains==="function"&&
                previous.contains(document.activeElement))||previousButton===document.activeElement;
        tabButtons("inspector").forEach(function(button){
            const type=button.dataset.tabType;
            button.hidden=!!type&&(!item||item.type!==type);
        });
        const current=tabButtons("inspector").find(function(button){
            return button.dataset.tabTarget===state.tabs.inspector;
        }),valid=tabAvailable(current);
        activateTab("inspector",valid?state.tabs.inspector:"element",!valid&&focusWithin);
    }
    function setDrawersCollapsed(collapsed,restoreFocus){
        const drawers=role("drawers"),activeInside=!!(drawers&&
                typeof drawers.contains==="function"&&drawers.contains(document.activeElement)),
            button=root.querySelector('[data-action="toggle-drawers"]');
        state.drawersCollapsed=collapsed===true;
        if(drawers)drawers.dataset.collapsed=String(state.drawersCollapsed);
        if(button){
            button.setAttribute("aria-expanded",String(!state.drawersCollapsed));
            button.setAttribute("aria-label",state.drawersCollapsed?
                "Expandir painel inferior":"Recolher painel inferior");
            button.textContent=state.drawersCollapsed?"Expandir":"Recolher";
            if(state.drawersCollapsed&&(restoreFocus===true||activeInside)&&
                typeof button.focus==="function")button.focus();
        }
        return state.drawersCollapsed;
    }
    function refreshWorkspaceViewport(){
        if(state.mode==="print"&&state.previewViewport)schedulePreview(0);
        else if(state.zoom==="fit")syncStageZoom();
    }
    function workspaceLayoutState(workspace){
        if(!workspace)return "";
        return ["showLayers","showInspector","elementsCollapsed","elementsMinimized"]
            .map(function(name){return workspace.dataset[name]||"";}).join("|");
    }
    function setElementsCollapsed(collapsed,restoreFocus,deferRefresh){
        const layers=role("layers"),pane=layers&&layers.closest?
                layers.closest(".fwwebex-label-layers"):null,
            workspace=role("workspace"),
            button=root.querySelector('[data-action="toggle-elements"]'),
            activeInside=!!(pane&&typeof pane.contains==="function"&&
                pane.contains(document.activeElement)),
            available=state.options.showLayers!==false,
            wasHidden=workspace?workspace.dataset.elementsCollapsed==="true":
                !!(pane&&pane.hidden);
        state.elementsCollapsed=collapsed===true;
        const hidden=!available||state.elementsCollapsed;
        if(pane){
            pane.hidden=hidden;
            if(!pane.id)pane.id=String(root.id||"fwwebex-label").replace(
                /[^A-Za-z0-9_-]/g,"-")+"-elements-pane";
        }
        if(workspace)workspace.dataset.elementsCollapsed=String(hidden);
        if(button){
            button.hidden=!available;
            button.setAttribute("aria-expanded",String(!hidden));
            button.setAttribute("aria-label",hidden?
                "Mostrar painel Elementos":"Ocultar painel Elementos");
            button.textContent=hidden?"Mostrar Elementos":"Ocultar Elementos";
            if(hidden&&(restoreFocus===true||activeInside)&&
                typeof button.focus==="function")button.focus();
            if(pane)button.setAttribute("aria-controls",pane.id);
        }
        if(hidden!==wasHidden&&deferRefresh!==true)refreshWorkspaceViewport();
        return state.elementsCollapsed;
    }
    function setElementsMinimized(minimized,restoreFocus,deferRefresh){
        const layers=role("layers"),pane=layers&&layers.closest?
                layers.closest(".fwwebex-label-layers"):null,
            body=pane&&pane.querySelector?
                pane.querySelector(".fwwebex-label-panel-body"):null,
            workspace=role("workspace"),
            button=root.querySelector('[data-action="toggle-elements-size"]'),
            activeInside=!!(body&&typeof body.contains==="function"&&
                body.contains(document.activeElement)),
            wasMinimized=workspace?workspace.dataset.elementsMinimized==="true":
                !!(pane&&pane.dataset.minimized==="true");
        state.elementsMinimized=minimized===true;
        if(pane){
            pane.dataset.minimized=String(state.elementsMinimized);
            if(!pane.id)pane.id=String(root.id||"fwwebex-label").replace(
                /[^A-Za-z0-9_-]/g,"-")+"-elements-pane";
        }
        if(body){
            body.hidden=state.elementsMinimized;
            if(!body.id)body.id=String(root.id||"fwwebex-label").replace(
                /[^A-Za-z0-9_-]/g,"-")+"-elements-body";
        }
        if(workspace)workspace.dataset.elementsMinimized=String(state.elementsMinimized);
        if(button){
            button.setAttribute("aria-expanded",String(!state.elementsMinimized));
            button.setAttribute("aria-label",state.elementsMinimized?
                "Expandir painel Elementos":"Recolher painel Elementos");
            button.title=state.elementsMinimized?
                "Expandir painel Elementos":"Recolher painel Elementos";
            button.textContent=state.elementsMinimized?"\u203a":"Recolher";
            if(state.elementsMinimized&&(restoreFocus===true||activeInside)&&
                typeof button.focus==="function")button.focus();
            if(body)button.setAttribute("aria-controls",body.id);
        }
        if(state.elementsMinimized!==wasMinimized&&
            state.options.showLayers!==false&&!state.elementsCollapsed&&deferRefresh!==true)
            refreshWorkspaceViewport();
        return state.elementsMinimized;
    }
    function dataRecord(){
        if(!state.records.length)return {};
        return state.records[Math.max(0,Math.min(state.records.length-1,state.recordIndex))]||{};
    }
    function getValue(source,path){
        return String(path||"").split(".").reduce(function(value,part){
            return value!=null&&Object.prototype.hasOwnProperty.call(Object(value),part)?
                value[part]:undefined;
        },source);
    }
    function resolvedTemplate(template){
        return String(template||"").replace(/{{\s*([A-Za-z_][A-Za-z0-9_.]*)\s*}}/g,
            function(all,path){
                const value=getValue(dataRecord(),path);
                return value===undefined||value===null?all:String(value);
            });
    }
    function getProperty(source,path){
        return String(path).split(".").reduce(function(value,part){
            return value==null?undefined:value[part];
        },source);
    }
    function propertyPatch(path,value,source){
        const patch={},parts=String(path).split("."),first=parts.shift();
        if(!parts.length){patch[first]=value;return patch;}
        patch[first]=clone(source&&source[first]||{});
        let cursor=patch[first];
        parts.forEach(function(part,index){
            if(index===parts.length-1)cursor[part]=value;
            else cursor=cursor[part]=cursor[part]&&typeof cursor[part]==="object"?
                clone(cursor[part]):{};
        });
        return patch;
    }
    function setStatus(message,stateName){
        const status=role("status-message");
        if(!status)return;
        status.textContent=String(message||"");
        status.dataset.state=stateName||"";
    }
    function setDirty(dirty){
        if(state.contractDirty===dirty)return;
        state.contractDirty=dirty;
        const badge=role("contract-state");
        if(badge){
            badge.textContent=dirty?"Edi\u00e7\u00e3o pendente":"Sincronizado";
            badge.dataset.state=dirty?"dirty":"clean";
        }
        if(role("toolbar"))
            root.dispatchEvent(new CustomEvent("fwwebex:label-dirtychange",{
                detail:{dirty:dirty},bubbles:true
            }));
    }
    function syncContract(force){
        const editor=role("contract-editor");
        if(!editor||state.contractDirty&&!force)return;
        editor.value=JSON.stringify(exportLayout(),null,2);
        if(force)setDirty(false);
    }
    function syncRecordsEditor(force){
        const editor=role("records-editor");
        if(editor&&(force||!editor.value))
            editor.value=JSON.stringify(state.records,null,2);
    }
    function emitRecordsChange(source,result){
        if(!role("toolbar"))return;
        root.dispatchEvent(new CustomEvent("fwwebex:label-datachange",{
            detail:{source:source,records:clone(state.records),result:result||null},
            bubbles:true
        }));
    }
    function generateSampleRecords(options){
        options=options||{};
        const contract=window.FWWebExLabels&&window.FWWebExLabels.contract;
        if(!contract||typeof contract.createSampleRecords!=="function"){
            if(options.required===false)return null;
            throw new Error("Gerador de dados de exemplo indisponivel.");
        }
        let records=clone(state.records),editor=role("records-editor");
        if(options.readEditor===true&&editor){
            const source=String(editor.value||"").trim();
            records=source?JSON.parse(source):[];
            records=Array.isArray(records)?records:[records];
        }
        const result=contract.createSampleRecords(state.layout,records,options);
        state.records=clone(result.records);
        state.recordIndex=Math.min(state.recordIndex,Math.max(0,state.records.length-1));
        state.lastReport=null;
        if(options.enableAutomatic===true)
            state.autoSampleRecords=state.options.autoSampleRecords!==false;
        if(result.changed||options.forceSync===true)syncRecordsEditor(true);
        if(result.changed){
            schedulePreview();emitRecordsChange(options.source||"sample",clone(result));
        }
        if(options.render!==false)
            render({emit:false,skipAutoSample:true});
        return clone(result);
    }
    function layerDepth(item,byId){
        let depth=0,parent=byId.get(item.containerId),seen=new Set();
        while(parent&&!seen.has(parent.id)){
            seen.add(parent.id);depth++;parent=byId.get(parent.containerId);
        }
        return Math.min(depth,4);
    }
    function renderLayers(){
        const list=role("layers");if(!list)return;
        list.innerHTML="";
        const byId=new Map(elements().map(function(item){return [item.id,item];})),
            visited=new Set(),search=role("layer-search"),
            query=String(search&&search.value||"").trim().toLowerCase(),
            visibleIds=new Set();
        if(query)elements().forEach(function(item){
            const haystack=[item.id,item.name,item.template,item.type].join(" ").toLowerCase();
            if(haystack.indexOf(query)<0)return;
            let current=item,parents=new Set();
            while(current&&!parents.has(current.id)){
                parents.add(current.id);visibleIds.add(current.id);
                current=byId.get(current.containerId);
            }
        });
        function append(item){
            if(!item||visited.has(item.id)||(query&&!visibleIds.has(item.id)))return;
            visited.add(item.id);
            const row=document.createElement("li");
            row.className="fwwebex-label-layer"+
                (state.selection.indexOf(item.id)>=0?" is-selected":"");
            row.dataset.id=item.id;row.dataset.depth=String(layerDepth(item,byId));
            const title=document.createElement("span");
            title.textContent=(item.type==="container"?"\u25a3 ":
                item.type==="barcode"?"\u258c\u258c ":"T ")+(item.name||item.id);
            row.appendChild(title);
            const visible=document.createElement("button");
            visible.type="button";visible.dataset.action="visibility";visible.dataset.id=item.id;
            visible.title=item.hidden?"Mostrar":"Ocultar";visible.textContent=item.hidden?"\u25cb":"\u25c9";
            row.appendChild(visible);
            const lock=document.createElement("button");
            lock.type="button";lock.dataset.action="layer-lock";lock.dataset.id=item.id;
            lock.title=item.locked?"Destravar":"Travar";lock.textContent=item.locked?"\ud83d\udd12":"\ud83d\udd13";
            row.appendChild(lock);list.appendChild(row);
            if(item.type==="container")containerChildren(item).forEach(append);
        }
        elements().filter(function(item){
            return !item.containerId||!byId.has(item.containerId);
        }).sort(function(a,b){return num(b.zIndex,0)-num(a.zIndex,0);}).forEach(append);
        elements().forEach(append);
    }
    function renderInspector(){
        const item=selected(),count=role("selection-count");
        syncInspectorTabs(item);
        if(count)count.textContent=state.selection.length+" selecionado(s)";
        const resolved=role("resolved-value");
        if(resolved){
            let description=item&&item.type!=="container"?
                "Template: "+item.template+" \u00b7 Valor: "+resolvedTemplate(item.template):"";
            const recordMetrics=state.lastReport&&state.lastReport.metrics&&
                state.lastReport.metrics.records&&
                state.lastReport.metrics.records[state.recordIndex],
                metric=item&&recordMetrics&&recordMetrics.elements&&
                    recordMetrics.elements[item.id];
            if(metric&&metric.finalFontSize!==undefined)
                description+=" \u00b7 Fonte final: "+metric.finalFontSize+" pt"+
                    (metric.lineCount!==undefined?" \u00b7 Linhas: "+metric.lineCount:"");
            if(metric&&metric.contentBox)
                description+=" \u00b7 \u00c1rea \u00fatil: "+
                    metric.contentBox.width.toFixed(2)+" x "+
                    metric.contentBox.height.toFixed(2)+" mm";
            resolved.textContent=description;
        }
        roleAll("[data-property]").forEach(function(control){
            const wrapper=control.closest&&control.closest("[data-for-type]")||
                    control.parentElement,
                type=wrapper&&wrapper.dataset?wrapper.dataset.forType:null;
            if(wrapper&&type)wrapper.hidden=!item||item.type!==type;
            if(!item){control.disabled=true;control.value="";return;}
            control.disabled=control.readOnly===true;
            if(control.dataset.property==="containerId"&&control.tagName==="SELECT"){
                const byId=new Map(elements().map(function(candidate){
                    return [candidate.id,candidate];
                }));
                function isInsideSelected(candidate){
                    const visited=new Set();let parent=candidate;
                    while(parent&&!visited.has(parent.id)){
                        if(parent.id===item.id)return true;
                        visited.add(parent.id);parent=byId.get(parent.containerId);
                    }
                    return false;
                }
                control.innerHTML="";
                const empty=document.createElement("option");
                empty.value="";empty.textContent="Sem \u00e1rea";
                control.appendChild(empty);
                elements().filter(function(candidate){
                    return candidate.type==="container"&&candidate.id!==item.id&&
                        !isInsideSelected(candidate);
                }).forEach(function(candidate){
                    const option=document.createElement("option");
                    option.value=candidate.id;
                    option.textContent=candidate.name||candidate.id;
                    control.appendChild(option);
                });
            }
            const value=getProperty(item,control.dataset.property);
            if(control.dataset.valueType === "json")
                control.value=JSON.stringify(value||{},null,2);
            else control.value=value===undefined||value===null?"":String(value);
        });
    }
    function renderRulers(){
        [["ruler-x",page().width],["ruler-y",page().height]].forEach(function(entry){
            const ruler=role(entry[0]);if(!ruler)return;
            ruler.innerHTML="";
            for(let index=0;index<=10;index++){
                const mark=document.createElement("span");
                mark.textContent=String(Math.round(entry[1]*index/10*10)/10);
                if(entry[0]==="ruler-x")mark.style.left=(index*10)+"%";
                else mark.style.top=(index*10)+"%";
                ruler.appendChild(mark);
            }
        });
    }
    function snapOriginLabel(origin){
        return {
            reference:"Refer\u00eancia",container:"Cont\u00eainer",
            "manual-guide":"Guia manual",element:"Elemento",grid:"Grid",page:"P\u00e1gina"
        }[origin]||String(origin||"Snap");
    }
    function renderSnapFeedback(){
        const host=role("snap-guides");if(!host)return;
        host.innerHTML="";
        ["x","y"].forEach(function(axis){
            const winner=state.snapFeedback&&state.snapFeedback[axis];
            if(!winner)return;
            const guide=document.createElement("i"),label=document.createElement("span"),
                dimension=axis==="x"?page().width:page().height;
            guide.className="fwwebex-label-snap-guide";
            guide.dataset.axis=axis;guide.dataset.origin=winner.origin;
            guide.dataset.anchor=winner.targetAnchor||winner.movingAnchor||"";
            guide.dataset.sourceId=winner.sourceId||"";
            guide.dataset.distanceMm=String(num(winner.distanceMm,0));
            if(axis==="x")guide.style.left=(winner.targetMm/dimension*100)+"%";
            else guide.style.top=(winner.targetMm/dimension*100)+"%";
            label.textContent=snapOriginLabel(winner.origin)+" \u00b7 "+
                (winner.targetAnchor||winner.movingAnchor||axis)+" \u00b7 \u0394 "+
                num(winner.distanceMm,0).toFixed(2).replace(".",",")+" mm";
            guide.appendChild(label);host.appendChild(guide);
        });
    }
    function setSnapFeedback(winners){
        state.snapFeedback={x:winners&&winners.x||null,y:winners&&winners.y||null};
        renderSnapFeedback();
        const active=[state.snapFeedback.x,state.snapFeedback.y].filter(Boolean);
        if(active.length){
            setStatus(active.map(function(winner){
                return snapOriginLabel(winner.origin)+" "+
                    (winner.targetAnchor||winner.movingAnchor||winner.axis)+" ("+
                    num(winner.distanceMm,0).toFixed(2).replace(".",",")+" mm)";
            }).join(" \u00b7 "),"snap");
        }else{
            const status=role("status-message");
            if(status&&status.dataset.state==="snap")setStatus("Pronto.");
        }
    }
    function clearSnapFeedback(){setSnapFeedback({x:null,y:null});}
    function syncViewportGeometry(){
        const geometry=pageGeometry(),planes=[fields,role("grid-overlay"),
            role("page-guides"),role("snap-guides")]
            .filter(function(plane){return !!plane;});
        if(state.mode==="print"&&state.previewViewport){
            const viewport=state.previewViewport,
                scale=viewport.pixelsPerMm||viewport.width/geometry.width,
                matrix=geometry.matrix,
                cssMatrix=[matrix[0],matrix[1],matrix[2],matrix[3],
                    matrix[4]*scale,matrix[5]*scale];
            stage.style.aspectRatio=geometry.width+"/"+geometry.height;
            stage.style.width=viewport.width+"px";
            stage.style.height=viewport.height+"px";
            planes.forEach(function(plane){
                plane.style.left="0";plane.style.top="0";
                plane.style.right="auto";plane.style.bottom="auto";
                plane.style.width=(geometry.sourceWidth*scale)+"px";
                plane.style.height=(geometry.sourceHeight*scale)+"px";
                plane.style.transformOrigin="0 0";
                plane.style.transform="matrix("+cssMatrix.join(",")+")";
            });
        }else{
            stage.style.aspectRatio=page().width+"/"+page().height;
            stage.style.height="";
            planes.forEach(function(plane){
                plane.style.left="0";plane.style.top="0";
                plane.style.right="0";plane.style.bottom="0";
                plane.style.width="100%";plane.style.height="100%";
                plane.style.transformOrigin="0 0";
                plane.style.transform="none";
            });
        }
    }
    function syncStageZoom(){
        const viewport=role("stage-viewport");
        if(state.mode==="print"&&state.previewViewport){
            syncViewportGeometry();
        }else if(state.zoom==="fit"&&viewport&&viewport.clientWidth){
            const availableWidth=Math.max(40,viewport.clientWidth-32),
                availableHeight=Math.max(40,(viewport.clientHeight||340)-32),
                fittedWidth=Math.min(1000,availableWidth,
                    availableHeight*(page().width/page().height));
            stage.style.width=fittedWidth+"px";
            syncViewportGeometry();
        }else{
            const zoom=num(state.zoom,1);
            stage.style.width=(zoom*100)+"%";
            syncViewportGeometry();
        }
    }
    function renderProductUI(){
        root.dataset.mode=state.mode;
        const name=role("document-name"),metrics=role("canvas-metrics"),
            statusSelection=role("status-selection"),preview=role("preview-canvas");
        if(name)name.textContent=state.layout.name||"R\u00f3tulo";
        if(metrics)metrics.textContent=page().width+" x "+page().height+" mm";
        if(statusSelection){
            const reference=state.layout.editor&&state.layout.editor.snap?
                    state.layout.editor.snap.referenceElementId:null,
                referenceItem=reference&&elements().find(function(item){
                    return item.id===reference;
                }),
                referenceLabel=referenceItem&&referenceItem.name?
                    referenceItem.name+" ("+referenceItem.id+")":reference;
            statusSelection.textContent=state.selection.length?
                state.selection.length+" selecionado(s)"+
                    (referenceLabel?" \u00b7 Refer\u00eancia: "+referenceLabel:""):
                (referenceLabel?"Refer\u00eancia: "+referenceLabel:"Nenhuma sele\u00e7\u00e3o");
        }
        const arrangeMenu=role("arrange-menu"),arrangeReference=arrangementReference(),
            arrangeParticipants=new Set(state.selection),chainActive=
                state.layout.editor.snap.chainMode===true;
        if(arrangeReference)arrangeParticipants.add(arrangeReference.id);
        if(arrangeMenu){
            arrangeMenu.hidden=state.selection.length<2&&!chainActive;
            if(arrangeMenu.hidden)arrangeMenu.open=false;
        }
        roleAll(".fwwebex-label-arrange-actions button").forEach(function(button){
            button.disabled=state.selection.length<2;
        });
        ["distribute-horizontal","distribute-vertical"].forEach(function(action){
            const button=root.querySelector("[data-action="+action+"]");
            if(button)button.disabled=arrangeParticipants.size<3;
        });
        if(preview)preview.style.display=state.mode==="print"&&state.previewViewport?
            "block":"none";
        fields.style.visibility=state.mode==="print"&&!state.printOverlay?"hidden":"visible";
        fields.style.opacity=state.mode==="print"?String(state.overlayOpacity):"1";
        image.style.visibility=state.mode==="print"?"hidden":"visible";
        const pageGuides=role("page-guides");
        if(pageGuides)pageGuides.style.visibility=
            state.mode==="print"&&!state.printOverlay?"hidden":"visible";
        roleAll("[data-action=mode]").forEach(function(button){
            button.setAttribute("aria-pressed",String(button.dataset.mode===state.mode));
        });
        const overlayButton=root.querySelector("[data-action=print-overlay]");
        if(overlayButton){
            overlayButton.hidden=state.mode!=="print";
            overlayButton.setAttribute("aria-pressed",String(state.printOverlay===true));
        }
        const overlayOpacity=role("overlay-opacity"),overlayOpacityField=
            role("overlay-opacity-field");
        if(overlayOpacity)overlayOpacity.hidden=state.mode!=="print";
        if(overlayOpacityField)overlayOpacityField.hidden=state.mode!=="print";
        const gridButton=root.querySelector("[data-action=grid]"),
            snapButton=root.querySelector("[data-action=snap]"),
            referenceButton=root.querySelector("[data-action=reference]"),
            chainButton=root.querySelector("[data-action=chain]");
        if(gridButton)gridButton.setAttribute("aria-pressed",
            String(state.layout.editor.grid.enabled===true));
        if(snapButton)snapButton.setAttribute("aria-pressed",
            String(state.layout.editor.snap.enabled===true));
        if(referenceButton)referenceButton.setAttribute("aria-pressed",
            String(!!state.layout.editor.snap.referenceElementId));
        if(chainButton)chainButton.setAttribute("aria-pressed",
            String(state.layout.editor.snap.chainMode===true));
        const recordSelect=role("record-index");
        if(recordSelect){
            recordSelect.hidden=state.mode!=="data";
            if(recordSelect.options.length!==state.records.length){
                recordSelect.innerHTML="";
                state.records.forEach(function(record,index){
                    const option=document.createElement("option");
                    option.value=String(index);option.textContent="Registro "+(index+1);
                    recordSelect.appendChild(option);
                });
            }
            recordSelect.disabled=state.records.length<2;
            recordSelect.value=String(state.recordIndex);
        }
        syncStageZoom();
        if(stage.classList)stage.classList.toggle("has-grid",
            state.layout.editor.grid.enabled===true&&
                (state.mode!=="print"||state.printOverlay));
        const gridStep=Math.max(.01,num(state.layout.editor.grid.step,1))*pxmm();
        if(typeof stage.style.setProperty==="function"){
            stage.style.setProperty("--fw-label-grid-x",gridStep+"px");
            stage.style.setProperty("--fw-label-grid-y",gridStep+"px");
        }
        const margins=normalizeInsets(page().margins,0),safe=Math.max(0,num(page().safeArea,0));
        [
            [role("margin-guide"),margins],
            [role("safe-guide"),{
                top:margins.top+safe,right:margins.right+safe,
                bottom:margins.bottom+safe,left:margins.left+safe
            }]
        ].forEach(function(entry){
            const guide=entry[0],insets=entry[1];if(!guide)return;
            guide.style.left=(insets.left/page().width*100)+"%";
            guide.style.top=(insets.top/page().height*100)+"%";
            guide.style.right=(insets.right/page().width*100)+"%";
            guide.style.bottom=(insets.bottom/page().height*100)+"%";
        });
        [
            ["page-width",page().width],["page-height",page().height],
            ["page-rotation",page().rotation],
            ["page-margin-top",margins.top],["page-margin-right",margins.right],
            ["page-margin-bottom",margins.bottom],["page-margin-left",margins.left],
            ["page-safe-area",page().safeArea],["page-bleed",page().bleed],
            ["grid-step",state.layout.editor.grid.step],
            ["snap-tolerance",state.layout.editor.snap.tolerancePx],
            ["background-fit",state.layout.background&&state.layout.background.fit||"fill"],
            ["background-opacity",state.layout.background?
                num(state.layout.background.opacity,1):1],
            ["background-locked",state.layout.background?
                state.layout.background.locked!==false:true]
        ].forEach(function(entry){
            const control=role(entry[0]);
            if(control&&document.activeElement!==control)control.value=String(entry[1]);
        });
        renderLayers();renderInspector();renderRulers();syncContract(false);
    }
    function showReport(report){
        state.lastReport=report;
        const issues=report.issues||[],problemCount=role("problem-count"),
            errors=issues.filter(function(problem){return problem.severity==="error";}).length,
            warnings=issues.length-errors;
        if(problemCount){
            problemCount.textContent=String(issues.length);
            problemCount.dataset.state=errors?"error":warnings?"warning":"";
            problemCount.setAttribute("aria-label",issues.length+" problema(s): "+
                errors+" erro(s) e "+warnings+" aviso(s)");
        }
        const host=role("problems");if(host){
            host.innerHTML="";
            issues.forEach(function(problem){
                const row=document.createElement("div");
                row.className="fwwebex-label-problem";
                row.dataset.severity=problem.severity||"warning";
                row.dataset.elementId=problem.elementId||"";
                row.textContent=(problem.severity==="error"?"Erro: ":"Aviso: ")+
                    problem.message+(problem.suggestion?" \u2014 "+problem.suggestion:"");
                host.appendChild(row);
            });
            if(!issues.length)host.textContent="Nenhum problema encontrado.";
        }
        setStatus(report.valid?"Layout v\u00e1lido.":"Foram encontrados erros no layout.",
            report.valid?"valid":"error");
        render({emit:false,visualOnly:true});
        renderInspector();
        if(role("toolbar"))
            root.dispatchEvent(new CustomEvent("fwwebex:label-validation",{
                detail:report,bubbles:true
            }));
        return report;
    }
    function currentRecords(){
        const editor=role("records-editor");
        if(!editor)return clone(state.records);
        const parsed=JSON.parse(editor.value||"[]");
        return Array.isArray(parsed)?parsed:[parsed];
    }
    function currentLayout(){
        const editor=role("contract-editor");
        if(state.contractDirty&&editor)return JSON.parse(editor.value);
        return exportLayout();
    }
    async function validateProduct(){
        try{
            const api=window.FWWebExLabels&&window.FWWebExLabels.renderer;
            if(!api||typeof api.generate!=="function")
                throw new Error("Renderer Labels indispon\u00edvel.");
            setStatus("Validando\u2026");
            const result=await api.generate(currentLayout(),currentRecords(),{
                output:"none",returnResult:true
            });
            return showReport(result.report);
        }catch(error){
            const report=error.report||{valid:false,issues:error.issues||[{
                severity:"error",message:error.message||String(error),suggestion:"Revise o contrato e os dados."
            }],errors:error.issues||[]};
            showReport(report);
            if(role("toolbar"))root.dispatchEvent(new CustomEvent("fwwebex:label-error",{
                detail:{error:error,report:report},bubbles:true
            }));
            throw error;
        }
    }
    function previewTargetSize(){
        const geometry=pageGeometry(),viewport=role("stage-viewport"),
            availableWidth=Math.max(40,(viewport&&viewport.clientWidth||700)-32),
            availableHeight=Math.max(40,(viewport&&viewport.clientHeight||500)-32),
            width=Math.min(1000,availableWidth,
                availableHeight*(geometry.width/geometry.height));
        return {width:width,height:width*(geometry.height/geometry.width)};
    }
    function schedulePreview(delay){
        if(state.mode!=="print"||!state.previewViewport)return;
        if(previewTimer!==null)window.clearTimeout(previewTimer);
        setStatus("Atualizando visualiza\u00e7\u00e3o\u2026");
        previewTimer=window.setTimeout(function(){
            previewTimer=null;
            previewProduct({scheduled:true}).catch(function(){});
        },Math.max(100,num(delay,180)));
    }
    function stopPendingPreview(){
        if(previewTimer!==null){window.clearTimeout(previewTimer);previewTimer=null;}
        previewToken++;
        if(previewAbort&&typeof previewAbort.abort==="function")previewAbort.abort();
        previewAbort=null;state.previewPending=false;
        if(previewHandle&&typeof previewHandle.destroy==="function"){
            try{Promise.resolve(previewHandle.destroy()).catch(function(){});}
            catch(ignore){}
        }
        previewHandle=null;state.previewViewport=null;
    }
    async function previewProduct(options){
        options=options||{};
        if(previewTimer!==null){window.clearTimeout(previewTimer);previewTimer=null;}
        if(previewAbort&&typeof previewAbort.abort==="function")previewAbort.abort();
        const token=++previewToken,
            controller=typeof AbortController==="function"?new AbortController():{
                signal:null,abort:function(){}
            };
        previewAbort=controller;state.previewPending=true;
        try{
            const api=window.FWWebExLabels&&window.FWWebExLabels.renderer;
            const viewer=window.FWWebEx&&window.FWWebEx.PDFViewer;
            if(!api||typeof api.generate!=="function")
                throw new Error("Renderer Labels indispon\u00edvel.");
            if(!viewer||typeof viewer.renderPage!=="function"){
                const missing=new Error(
                    "PDF.js indispon\u00edvel para rasterizar o preview de impress\u00e3o.");
                missing.name="FWWebExPDFViewerDependencyError";
                missing.code="FWPDFVIEWER_DEPENDENCY_MISSING";
                throw missing;
            }
            setStatus(options.scheduled?"Atualizando visualiza\u00e7\u00e3o\u2026":
                "Gerando preview\u2026");
            const records=currentRecords();
            const result=await api.generate(currentLayout(),records,{
                output:"arraybuffer",returnResult:true
            });
            if(token!==previewToken)return null;
            const canvas=role("preview-canvas"),target=previewTargetSize(),
                raster=await viewer.renderPage(result.output,{
                    canvas:canvas,
                    pageNumber:Math.max(1,Math.min(Math.max(1,records.length),
                        state.recordIndex+1)),
                    targetWidth:target.width,targetHeight:target.height,
                    pixelRatio:Math.max(1,num(window.devicePixelRatio,1)),
                    signal:controller.signal
                });
            if(token!==previewToken){
                if(raster&&typeof raster.destroy==="function")await raster.destroy();
                return null;
            }
            if(previewHandle&&previewHandle!==raster&&
                typeof previewHandle.destroy==="function")
                await previewHandle.destroy();
            previewHandle=raster;
            const geometry=pageGeometry(),width=num(raster.width,
                    raster.viewport&&raster.viewport.width),
                height=num(raster.height,raster.viewport&&raster.viewport.height),
                pixelsPerMm=width/geometry.width;
            state.previewViewport={
                width:width,height:height,pixelsPerMm:pixelsPerMm,
                pageNumber:Math.max(1,state.recordIndex+1),
                pixelRatio:num(raster.pixelRatio,1)
            };
            state.mode="print";render({emit:false});
            showReport(result.report);
            result.preview=raster;
            if(role("toolbar"))root.dispatchEvent(new CustomEvent("fwwebex:label-preview",{
                detail:result,bubbles:true
            }));
            return result;
        }catch(error){
            if(token!==previewToken||error&&(
                error.code==="FWPDFVIEWER_RENDER_CANCELLED"||error.name==="AbortError"))
                return null;
            const report=error.report||{valid:false,issues:error.issues||[{
                severity:"error",message:error.message||String(error),
                suggestion:"Revise o layout ou verifique o carregamento do PDF.js."
            }],errors:error.issues||[]};
            if(previewHandle&&typeof previewHandle.destroy==="function"){
                try{await previewHandle.destroy();}catch(ignore){}
            }
            previewHandle=null;
            state.mode="design";state.previewViewport=null;
            render({emit:false});showReport(report);
            setStatus(error.message||String(error),"error");
            if(role("toolbar"))root.dispatchEvent(new CustomEvent("fwwebex:label-error",{
                detail:{error:error,report:report},bubbles:true
            }));
            throw error;
        }finally{
            if(token===previewToken){
                state.previewPending=false;
                if(previewAbort===controller)previewAbort=null;
            }
        }
    }
    function snapshot(){
        return {layout:exportLayout(),selection:state.selection.slice(),selected:state.selected};
    }
    function resetHistory(){
        state.history=[snapshot()];state.historyIndex=0;
    }
    function checkpoint(){
        const next=snapshot();
        state.history=state.history.slice(0,state.historyIndex+1);
        state.history.push(next);
        if(state.history.length>60)state.history.shift();
        state.historyIndex=state.history.length-1;
        schedulePreview();
    }
    function restoreHistory(index){
        if(index<0||index>=state.history.length)return false;
        clearSnapFeedback();
        const entry=state.history[index];
        state.historyIndex=index;
        state.layout=attachLayoutAccessors(clone(entry.layout));
        state.selection=entry.selection.filter(function(id){
            return elements().some(function(item){return item.id===id;});
        });
        state.selected=state.selection.indexOf(entry.selected)>=0?entry.selected:
            state.selection[state.selection.length-1]||null;
        syncStage();return true;
    }
    function undo(){return restoreHistory(state.historyIndex-1);}
    function redo(){return restoreHistory(state.historyIndex+1);}
    function syncStage(){
        const background=state.layout.background,dataUrl=background&&background.dataUrl;
        stage.style.aspectRatio=page().width+"/"+page().height;
        if(image.src!==(dataUrl||""))image.src=dataUrl||"";
        image.hidden=!dataUrl;
        image.style.objectFit=background&&background.fit==="contain"?"contain":
            background&&background.fit==="cover"?"cover":
            background&&background.fit==="none"?"none":"fill";
        image.style.opacity=String(background?num(background.opacity,1):1);
        render();
        schedulePreview();
    }
    function setPage(settings,height,rotation){
        const target=page(),source=settings&&typeof settings==="object"?
            settings:{width:settings,height:height,rotation:rotation};
        if(source.width!==undefined)target.width=Math.max(1,num(source.width,target.width));
        if(source.height!==undefined)target.height=Math.max(1,num(source.height,target.height));
        if(source.rotation!==undefined){
            const nextRotation=num(source.rotation,target.rotation);
            if([0,90,180,270].indexOf(nextRotation)<0)
                throw new Error("A rotacao da pagina deve ser 0, 90, 180 ou 270 graus.");
            target.rotation=nextRotation;
        }
        if(source.margins!==undefined){
            const marginSource=typeof source.margins==="number"?source.margins:
                Object.assign({},target.margins||{},source.margins||{});
            target.margins=normalizeInsets(marginSource,0);
            Object.keys(target.margins).forEach(function(side){
                target.margins[side]=Math.max(0,num(target.margins[side],0));
            });
        }
        if(source.safeArea!==undefined)
            target.safeArea=Math.max(0,num(source.safeArea,target.safeArea));
        if(source.bleed!==undefined)
            target.bleed=Math.max(0,num(source.bleed,target.bleed));
        syncStage();return clone(target);
    }
    function render(options){
        options=options||{};
        if(options.visualOnly!==true&&options.skipAutoSample!==true&&
            state.autoSampleRecords===true&&state.options.autoSampleRecords!==false){
            const recordsEditor=role("records-editor"),focused=
                typeof document!=="undefined"&&document.activeElement===recordsEditor;
            if(!focused)generateSampleRecords({
                required:false,render:false,source:"automatic"
            });
        }
        fields.innerHTML="";
        const issueSeverity={};
        ((state.lastReport&&state.lastReport.issues)||[]).forEach(function(problem){
            if(!problem.elementId)return;
            if(problem.severity==="error"||!issueSeverity[problem.elementId])
                issueSeverity[problem.elementId]=problem.severity||"warning";
        });
        elements().forEach(function(item){
            if(item.hidden===true)return;
            const shown=state.mode==="design"?item.template:resolvedTemplate(item.template);
            const el=document.createElement("div");
            el.className="fwwebex-label-field type-"+item.type+
                (state.selection.indexOf(item.id)>=0?" is-selected":"")+
                (item.id===state.selected?" is-primary":"")+(item.locked===true?" is-locked":"")+
                (state.layout.editor.snap.referenceElementId===item.id?" is-reference":"")+
                (item.type==="container"&&containerChildren(item).length===0?" is-empty":"")+
                (state.mode==="data"&&String(shown).indexOf("{{")>=0?" has-unresolved":"")+
                (containerOverflow[item.id]===true?" has-overflow":"")+
                (issueSeverity[item.id]?" has-issue-"+issueSeverity[item.id]:"");
            el.dataset.id=item.id;
            if(issueSeverity[item.id]){
                el.dataset.issueSeverity=issueSeverity[item.id];
                el.setAttribute("aria-invalid",
                    issueSeverity[item.id]==="error"?"true":"false");
            }
            el.style.left=(item.box.x/page().width*100)+"%";
            el.style.top=(item.box.y/page().height*100)+"%";
            el.style.width=(item.box.width/page().width*100)+"%";
            el.style.height=(item.box.height/page().height*100)+"%";
            el.style.transform="rotate("+(item.rotation||0)+"deg)";
            el.style.zIndex=String(num(item.zIndex,0));
            const content=document.createElement("span");content.className="fwwebex-label-field-content";
            content.textContent=item.type==="container" ?
                (item.name||"Area de layout") : item.type==="barcode" ?
                    "||||  "+shown : shown;
            el.appendChild(content);
            const grip=document.createElement("i"); grip.dataset.resize="1"; el.appendChild(grip);
            fields.appendChild(el);
            if(item.type==="text")styleTextPreview(el,item);
        });
        if(options.visualOnly!==true)renderProductUI();
        renderSnapFeedback();
        if(options.emit!==false)
            root.dispatchEvent(new CustomEvent("fwwebex:label-change",{detail:exportLayout()}));
        if(options.emit!==false&&role("toolbar"))
            root.dispatchEvent(new CustomEvent("fwwebex:label-selection",{
                detail:{selectedId:state.selected,selection:state.selection.slice()},bubbles:true
            }));
    }
    function scheduleVisualRender(){
        if(renderFrame!==null)return;
        const request=window.requestAnimationFrame||function(callback){
            callback();return 0;
        };
        renderFrame=request(function(){
            renderFrame=null;
            render({emit:false,visualOnly:true});
        });
    }
    function finishPointerAction(){
        if(!action){clearSnapFeedback();return;}
        const completed=action;
        if(renderFrame!==null&&typeof window.cancelAnimationFrame==="function"){
            window.cancelAnimationFrame(renderFrame);
            renderFrame=null;
        }
        action=null;
        clearSnapFeedback();
        if(completed.marquee){
            const box=role("selection-box");
            if(box)box.style.display="none";
            const x1=Math.min(completed.x1,completed.x2),
                x2=Math.max(completed.x1,completed.x2),
                y1=Math.min(completed.y1,completed.y2),
                y2=Math.max(completed.y1,completed.y2);
            state.selection=elements().filter(function(item){
                return item.hidden!==true&&item.box.x<x2&&item.box.x+item.box.width>x1&&
                    item.box.y<y2&&item.box.y+item.box.height>y1;
            }).map(function(item){return item.id;});
            state.selected=state.selection[state.selection.length-1]||null;
        }else checkpoint();
        render();
    }
    function add(type,options){
        options=options||{};
        const previous=selected(),chained=previous&&state.layout.editor.snap.chainMode===true&&
            options.box===undefined&&options.x===undefined&&options.y===undefined;
        const mnemonic=String(defined(options.mnemonic,type==="barcode"?"barcode":"texto"));
        let item=elementBase(type,mnemonic);
        applyElementPatch(item,options);
        if(elements().some(function(existing){return existing.id===item.id;}))item.id=uid();
        elements().push(item);
        if(chained){
            const gap=Math.max(0,num(role("stack-gap")&&role("stack-gap").value,1)),
                direction=String(role("position-direction")&&
                    role("position-direction").value||"below"),
                crossAlign=String(role("cross-align")&&role("cross-align").value||"start"),
                api=window.FWWebExLabels&&window.FWWebExLabels.layout,
                result=api&&api.arrange(state.layout,[item.id],"position-"+direction,{
                    referenceId:previous.id,gap:gap,crossAlign:crossAlign
                });
            if(result&&!result.overflowIds.length){
                state.layout=attachLayoutAccessors(clone(result.layout));ensureEditor();
                item=elements().find(function(candidate){return candidate.id===item.id;})||item;
            }else if(result)setStatus(
                "A posicao encadeada ultrapassaria a pagina; o novo componente foi mantido na posicao inicial.",
                "warning");
        }
        state.selected=item.id;
        state.selection=[item.id]; render(); return item;
    }
    function remove(){
        if(!state.selection.length)return;
        const api=window.FWWebExLabels&&window.FWWebExLabels.layout;
        if(!api||typeof api.remove!=="function")
            throw new Error("FWWebEx Labels: LayoutEngine compartilhado indisponivel.");
        const result=api.remove(exportLayout(),state.selection,{cascade:true});
        state.layout=attachLayoutAccessors(clone(result.layout));
        result.removedIds.forEach(function(id){delete containerOverflow[id];});
        state.selected=null;state.selection=[];render();
        return result;
    }
    function duplicate(){
        const api=window.FWWebExLabels&&window.FWWebExLabels.layout;
        if(!api||typeof api.duplicate!=="function")
            throw new Error("FWWebEx Labels: LayoutEngine compartilhado indisponivel.");
        const result=api.duplicate(exportLayout(),state.selection,{
            offsetX:2,offsetY:2,idFactory:function(){return uid();}
        });
        state.layout=attachLayoutAccessors(clone(result.layout));
        state.selection=result.ids.slice();
        state.selected=state.selection[state.selection.length-1]||null;
        render();return selectedItems();
    }
    function toggleLock(){
        const items=selectedItems();if(!items.length)return;
        const lock=items.some(function(item){return item.locked!==true;});
        items.forEach(function(item){item.locked=lock;});render();
    }
    function currentTextMetrics(){
        const records=state.lastReport&&state.lastReport.metrics&&
                state.lastReport.metrics.records,
            record=records&&records[state.recordIndex];
        return record&&record.elements||{};
    }
    function baselineOffset(item,metrics){
        const api=window.FWWebExLabels&&window.FWWebExLabels.snap;
        return api&&typeof api.textBaselineOffset==="function"?
            api.textBaselineOffset(item,(metrics||currentTextMetrics())[item.id]):null;
    }
    function arrangementReference(options){
        options=options||{};
        const explicit=options.referenceId&&elements().find(function(item){
                return item.id===options.referenceId;
            }),magneticId=state.layout.editor&&state.layout.editor.snap&&
                state.layout.editor.snap.referenceElementId,
            magnetic=magneticId&&elements().find(function(item){return item.id===magneticId;});
        return explicit||magnetic||selected();
    }
    function arrangeSelection(command,options){
        options=options||{};
        const api=window.FWWebExLabels&&window.FWWebExLabels.layout;
        if(!api||typeof api.arrange!=="function")
            throw new Error("FWWebEx Labels: comando de organizacao indisponivel.");
        const reference=arrangementReference(options),ids=Array.isArray(options.ids)?
                options.ids.slice():state.selection.slice();
        if(!reference)throw new Error("Selecione uma referencia para organizar os elementos.");
        const arrangeOptions=Object.assign({},options,{referenceId:reference.id}),
            result=api.arrange(exportLayout(),ids,command,arrangeOptions);
        result.applied=false;
        if(!result.changedIds.length)return clone(result);
        if(result.overflowIds.length&&options.overflow==="reject"){
            result.previewLayout=clone(result.layout);return clone(result);
        }
        if(result.overflowIds.length&&options.overflow==="confirm"&&
            typeof window.confirm==="function"&&!window.confirm(
                "A organizacao deixa "+result.overflowIds.length+
                " elemento(s) fora da pagina. Aplicar mesmo assim?")){
            result.previewLayout=clone(result.layout);return clone(result);
        }
        if(options.apply===false)return clone(result);
        state.layout=attachLayoutAccessors(clone(result.layout));ensureEditor();
        if(options.advanceReference===true&&state.layout.editor.snap.chainMode===true){
            const next=state.selection.slice().reverse().find(function(id){
                return id!==reference.id&&result.changedIds.indexOf(id)>=0;
            });
            if(next){
                state.layout.editor.snap.referenceElementId=next;
                state.selected=next;
            }
        }
        result.applied=true;render();
        if(role("toolbar"))root.dispatchEvent(new CustomEvent("fwwebex:label-arrange",{
            detail:{command:command,referenceId:result.referenceId,
                changedIds:result.changedIds.slice(),skippedIds:result.skippedIds.slice(),
                overflowIds:result.overflowIds.slice()},bubbles:true
        }));
        return clone(result);
    }
    function align(mode){
        if(mode!=="baseline")return arrangeSelection("align-"+mode,{});
        const reference=arrangementReference(),items=selectedItems(),metrics=currentTextMetrics();
        if(!reference||items.length<2)return;
        const referenceBaseline=mode==="baseline"?baselineOffset(reference,metrics):null;
        items.forEach(function(item){
            if(item.id===reference.id||item.locked===true)return;
            if(mode==="left")item.box.x=reference.box.x;
            if(mode==="center")item.box.x=reference.box.x+(reference.box.width-item.box.width)/2;
            if(mode==="right")item.box.x=reference.box.x+reference.box.width-item.box.width;
            if(mode==="top")item.box.y=reference.box.y;
            if(mode==="middle")item.box.y=reference.box.y+(reference.box.height-item.box.height)/2;
            if(mode==="bottom")item.box.y=reference.box.y+reference.box.height-item.box.height;
            if(mode==="baseline"&&referenceBaseline!==null){
                const itemBaseline=baselineOffset(item,metrics);
                if(itemBaseline!==null)
                    item.box.y=reference.box.y+referenceBaseline-itemBaseline;
            }
        });render();
        return {applied:true,changedIds:items.filter(function(item){
            return item.id!==reference.id&&item.locked!==true;
        }).map(function(item){return item.id;}),skippedIds:items.filter(function(item){
            return item.id!==reference.id&&item.locked===true;
        }).map(function(item){return item.id;}),overflowIds:[]};
    }
    function copyStyle(){
        const reference=selected(),items=selectedItems();if(!reference||items.length<2)return;
        items.forEach(function(item){
            if(item.id===reference.id||item.type!==reference.type||item.locked===true)return;
            if(item.type==="text"){
                item.style=clone(reference.style);item.fit=clone(reference.fit);
                item.textOptions=clone(reference.textOptions);
            }else if(item.type==="barcode"){
                [
                    "format","fallbackFormat","displayValue","quietZone","minModuleWidth",
                    "overflow","humanReadableFontSize","humanReadableMinFontSize",
                    "humanReadableFontFamily","humanReadableFontStyle","humanReadableColor",
                    "humanReadablePosition","humanReadableAlign","textMargin","autoFit",
                    "textOverflow","barcodeOptions"
                ].forEach(function(name){item[name]=clone(reference[name]);});
            }else if(item.type==="container"){
                const children=item.layout.children;
                item.layout=clone(reference.layout);item.layout.children=children;
            }
        });render();
    }
    function stack(direction,gap,crossAlign){
        const aliases={left:"start",top:"start",middle:"center",center:"center",
                right:"end",bottom:"end",stretch:"stretch"},
            result=arrangeSelection(direction==="horizontal"?"position-right":
                "position-below",{gap:gap,crossAlign:aliases[crossAlign]||"start"});
        result.overflow=result.overflowIds.length>0;result.count=state.selection.length;
        return result;
    }
    function finishArrange(result,label){
        if(!result)return;
        if(result.applied===false){
            setStatus(result.overflowIds&&result.overflowIds.length?
                "Organizacao cancelada; a posicao anterior foi preservada.":
                "Nenhuma alteracao de organizacao foi necessaria.",
                result.overflowIds&&result.overflowIds.length?"warning":"");
            return result;
        }
        if(result.changedIds&&result.changedIds.length)checkpoint();
        const skipped=result.skippedIds&&result.skippedIds.length?
            " "+result.skippedIds.length+" elemento(s) travado(s) foram preservados.":"";
        setStatus(label+" aplicada a "+(result.changedIds||[]).length+
            " elemento(s)."+skipped,skipped?"warning":"");
        return result;
    }
    function containerChildren(container){
        const byId=new Map(elements().map(function(item){return [item.id,item];}));
        const ordered=(container.layout.children||[]).map(function(id){return byId.get(id);})
            .filter(function(item){return item&&item.id!==container.id&&item.containerId===container.id;});
        elements().forEach(function(item){
            if(item.id!==container.id&&item.containerId===container.id&&ordered.indexOf(item)<0)
                ordered.push(item);
        });
        return ordered;
    }
    function elementMargins(item){
        return item.type==="text"?normalizeInsets(item.style.margin,0):normalizeInsets(0,0);
    }
    function layoutContainer(containerOrId){
        const container=typeof containerOrId==="string"?
            elements().find(function(item){return item.id===containerOrId;}):containerOrId;
        if(!container||container.type!=="container")return {overflow:false,count:0};
        const count=containerChildren(container).length;
        const api=window.FWWebExLabels&&window.FWWebExLabels.layout;
        if(!api||typeof api.resolve!=="function")
            throw new Error("FWWebEx Labels: LayoutEngine compartilhado indisponivel.");
        const resolved=api.resolve(exportLayout(),[]);
        state.layout=attachLayoutAccessors(clone(resolved.layout));
        const available=new Set(elements().map(function(item){return item.id;}));
        state.selection=state.selection.filter(function(id){return available.has(id);});
        if(!available.has(state.selected))state.selected=state.selection[
            state.selection.length-1]||null;
        Object.keys(containerOverflow).forEach(function(id){delete containerOverflow[id];});
        elements().filter(function(item){return item.type==="container";})
            .forEach(function(item){containerOverflow[item.id]=item.hasOverflow===true;});
        const current=elements().find(function(item){return item.id===container.id;});
        const overflow=current&&current.hasOverflow===true;
        render();
        return {overflow:overflow,count:count,report:resolved.report};
    }
    function assignToContainer(){
        const containers=selectedItems().filter(function(item){return item.type==="container";});
        const container=containers[0]||(selected()&&selected().type==="container"?selected():null);
        if(!container)return {error:"Selecione uma area e os componentes.",count:0};
        const ids=selectedItems().filter(function(item){
            return item.id!==container.id&&item.locked!==true;
        }).map(function(item){return item.id;});
        if(!ids.length)return {error:"Selecione componentes alem da area.",count:0};
        const api=window.FWWebExLabels&&window.FWWebExLabels.layout;
        if(!api||typeof api.assign!=="function")
            throw new Error("FWWebEx Labels: LayoutEngine compartilhado indisponivel.");
        const result=api.assign(exportLayout(),ids,container.id);
        state.layout=attachLayoutAccessors(clone(result.layout));
        state.selection=[container.id].concat(result.ids);
        state.selected=container.id;
        return layoutContainer(container.id);
    }
    function exportLayout(){
        const exported=clone(state.layout);
        exported.elements.forEach(function(item){delete item.hasOverflow;});
        return exported;
    }
    function contractAPI(){
        const api=window.FWWebExLabels&&window.FWWebExLabels.contract;
        if(!api||typeof api.normalize!=="function")
            throw new Error("FWWebEx Labels: a API FWWebExLabels.contract.normalize nao esta disponivel. "+
                "Habilite o contrato Labels antes de carregar um layout no designer.");
        return api;
    }
    function load(layout,options){
        options=options||{};
        clearSnapFeedback();
        if(state.contractDirty&&options.discardDirty!==true){
            const error=new Error(
                "Existe uma edi\u00e7\u00e3o JSON pendente. Aplique, descarte ou force a substitui\u00e7\u00e3o.");
            error.name="FWWebExLabelDirtyContractError";
            error.code="LABEL_CONTRACT_DIRTY";
            throw error;
        }
        let normalized;
        try{normalized=contractAPI().normalize(layout);}
        catch(error){
            throw new Error("FWWebEx Labels: nao foi possivel carregar/migrar o layout. "+
                (error&&error.message?error.message:String(error)));
        }
        if(!normalized||normalized.schema!==SCHEMA||normalized.version!==CONTRACT_VERSION||
            !normalized.page||!Array.isArray(normalized.elements))
            throw new Error("FWWebEx Labels: o normalizador retornou um contrato v2 invalido.");
        const next=attachLayoutAccessors(clone(normalized));
        state.layout=next;state.selected=null;state.selection=[];ensureEditor();
        const reference=state.layout.editor&&state.layout.editor.snap?
            state.layout.editor.snap.referenceElementId:null;
        const invalidReference=reference&&
            !state.layout.elements.some(function(item){return item.id===reference;})?
                reference:null;
        if(invalidReference)
            state.layout.editor.snap.referenceElementId=null;
        Object.keys(containerOverflow).forEach(function(id){delete containerOverflow[id];});
        resetHistory();syncStage();
        if(invalidReference)setStatus(
            "A referencia "+invalidReference+" nao existe e foi removida do layout.","warning");
        if(options.discardDirty===true)syncContract(true);
        return exportLayout();
    }
    function setBackground(file){
        return new Promise(function(resolve,reject){
            const reader=new FileReader();
            reader.onload=function(){
                const current=state.layout.background||{};
                state.layout.background={
                    dataUrl:String(defined(reader.result,"")),
                    fit:String(defined(current.fit,"fill")),
                    opacity:num(current.opacity,1),locked:current.locked!==false
                };
                syncStage();resolve(reader.result);
            };
            reader.onerror=reject; reader.readAsDataURL(file);
        });
    }
    function setRecords(records){
        if(typeof records==="string")records=JSON.parse(records||"[]");
        state.records=clone(Array.isArray(records)?records:
            records&&typeof records==="object"?[records]:[]);
        state.autoSampleRecords=!state.records.length||state.records.every(function(record){
            return record&&typeof record==="object"&&!Array.isArray(record)&&
                Object.keys(record).length===0;
        });
        state.recordIndex=Math.min(state.recordIndex,Math.max(0,state.records.length-1));
        syncRecordsEditor(true);
        if(state.mode==="data")render({emit:false});
        schedulePreview();
        return clone(state.records);
    }
    function setOptions(options){
        if(typeof options==="string")options=JSON.parse(options||"{}");
        const changed=clone(options||{}),workspace=role("workspace"),
            previousWorkspaceState=workspaceLayoutState(workspace);
        state.options=Object.assign({},state.options,changed);
        ["toolbar","layers","inspector","drawers"].forEach(function(name){
            const node=role(name),key="show"+name.charAt(0).toUpperCase()+name.slice(1);
            let region=node;
            if(node&&(name==="layers"||name==="inspector")&&node.closest)
                region=node.closest(".fwwebex-label-pane");
            if(region&&Object.prototype.hasOwnProperty.call(state.options,key))
                region.hidden=state.options[key]===false;
        });
        const showLayers=state.options.showLayers!==false,
            showInspector=state.options.showInspector!==false;
        if(workspace){
            workspace.dataset.showLayers=String(showLayers);
            workspace.dataset.showInspector=String(showInspector);
        }
        if(Object.prototype.hasOwnProperty.call(changed,"elementsCollapsed"))
            state.elementsCollapsed=changed.elementsCollapsed===true;
        if(Object.prototype.hasOwnProperty.call(changed,"elementsMinimized"))
            state.elementsMinimized=changed.elementsMinimized===true;
        setElementsCollapsed(state.elementsCollapsed,false,true);
        setElementsMinimized(state.elementsMinimized,false,true);
        if(workspaceLayoutState(workspace)!==previousWorkspaceState)
            refreshWorkspaceViewport();
        if(changed.tabs&&typeof changed.tabs==="object")
            Object.keys(changed.tabs).forEach(function(group){
                activateTab(group,changed.tabs[group],false);
            });
        if(Object.prototype.hasOwnProperty.call(changed,"drawersCollapsed"))
            setDrawersCollapsed(changed.drawersCollapsed===true);
        return clone(state.options);
    }
    function discoverVariables(addMissing){
        if(!Array.isArray(state.layout.variables))state.layout.variables=[];
        const used=[],pattern=/{{\s*([A-Za-z_][A-Za-z0-9_.]*)\s*}}/g;
        elements().forEach(function(item){
            let match;
            while((match=pattern.exec(String(item.template||"")))!==null)
                if(used.indexOf(match[1])<0)used.push(match[1]);
        });
        const declared=new Set((state.layout.variables||[]).map(function(variable){
            return variable.name;
        })),missing=used.filter(function(name){return !declared.has(name);});
        if(addMissing!==false)missing.forEach(function(name){
            state.layout.variables.push({
                name:name,label:name,type:"string",required:false,default:""
            });
        });
        return {used:used,missing:missing,unused:(state.layout.variables||[])
            .map(function(variable){return variable.name;})
            .filter(function(name){return used.indexOf(name)<0;})};
    }
    function snapPosition(item,x,y,event){
        const api=window.FWWebExLabels&&window.FWWebExLabels.snap;
        if(!api||typeof api.resolve!=="function")return {x:x,y:y};
        const excluded=new Set([item.id].concat(state.selection||[]));
        if(action&&Array.isArray(action.children))action.children.forEach(function(child){
            excluded.add(child.item.id);
        });
        const result=api.resolve(state.layout,{
            elementId:item.id,position:{x:x,y:y},excludeIds:Array.from(excluded),
            pixelsPerMm:pxmm(),disabled:!!(event&&event.altKey),
            metricsById:action&&action.snapMetrics||currentTextMetrics(),
            latch:action&&action.snapLatch||{x:null,y:null},hysteresisFactor:1.5
        });
        if(action)action.snapLatch=result.latch;
        setSnapFeedback(result.winners);
        return {x:result.x,y:result.y};
    }
    function selectId(id,append){
        if(!elements().some(function(item){return item.id===id;}))return;
        if(append){
            const index=state.selection.indexOf(id);
            if(index>=0)state.selection.splice(index,1);else state.selection.push(id);
        }else state.selection=[id];
        state.selected=state.selection.indexOf(id)>=0?id:
            state.selection[state.selection.length-1]||null;
        render();
    }
    function reorderSelected(direction){
        const item=selected();if(!item)return;
        if(item.containerId){
            const parent=elements().find(function(candidate){
                return candidate.id===item.containerId&&candidate.type==="container";
            });
            if(parent){
                const children=parent.layout.children,index=children.indexOf(item.id),
                    target=Math.max(0,Math.min(children.length-1,index-direction));
                if(index>=0&&index!==target){
                    const swap=children[target];children[target]=item.id;children[index]=swap;
                    layoutContainer(parent.id);checkpoint();
                }
                return;
            }
        }
        const ordered=elements().slice().sort(function(a,b){
            return num(a.zIndex,0)-num(b.zIndex,0);
        }),index=ordered.indexOf(item),
            target=Math.max(0,Math.min(ordered.length-1,index+direction));
        if(index===target)return;
        const swap=ordered[target];ordered[target]=item;ordered[index]=swap;
        ordered.forEach(function(candidate,z){candidate.zIndex=z;});
        render();checkpoint();
    }
    function nudge(dx,dy){
        const moved=window.FWWebExLabels.layout.translate(exportLayout(),state.selection,
            {dx:dx,dy:dy},{respectLocked:true}),
            byId=new Map(moved.layout.elements.map(function(next){return [next.id,next];}));
        moved.changedIds.forEach(function(id){
            const target=elements().find(function(candidate){return candidate.id===id;}),
                next=byId.get(id);
            if(target&&next){
                target.box.x=Math.max(0,Math.min(page().width-target.box.width,next.box.x));
                target.box.y=Math.max(0,Math.min(page().height-target.box.height,next.box.y));
            }
        });
        if(moved.changedIds.length){render();checkpoint();}
    }
    function exportJSON(){
        const text=JSON.stringify(currentLayout(),null,2);
        if(typeof Blob==="undefined"||!window.URL)return text;
        const link=document.createElement("a"),url=window.URL.createObjectURL(
            new Blob([text],{type:"application/json;charset=utf-8"}));
        link.href=url;link.download=(state.layout.name||"layout-rotulo")+".json";
        link.click();window.setTimeout(function(){window.URL.revokeObjectURL(url);},0);
        return text;
    }
    async function downloadProduct(){
        const result=await window.FWWebExLabels.renderer.generate(
            currentLayout(),currentRecords(),{
                fileName:state.options.fileName||((state.layout.name||"rotulos")+".pdf"),
                rotation:page().rotation,returnResult:true
            });
        if(role("toolbar"))root.dispatchEvent(new CustomEvent("fwwebex:label-generated",{
            detail:result,bubbles:true
        }));
        return result;
    }
    async function printProduct(){
        const result=await window.FWWebExLabels.renderer.generate(
            currentLayout(),currentRecords(),{
                output:"pdf",autoPrint:true,rotation:page().rotation,returnResult:true
            });
        if(result.pdf&&typeof result.pdf.output==="function")
            window.open(result.pdf.output("bloburl"),"_blank");
        return result;
    }
    function applyEditedJSON(){
        const editor=role("contract-editor");
        if(!editor)return;
        const result=load(JSON.parse(editor.value),{discardDirty:true});
        setStatus("Contrato aplicado.");return result;
    }
    function formatEditedJSON(){
        const editor=role("contract-editor");
        if(!editor)return;
        editor.value=JSON.stringify(JSON.parse(editor.value),null,2);
        setStatus("Contrato JSON formatado.");
    }
    function applyInspector(control){
        const path=control.dataset.property,item=selected();
        if(!item||!path||path==="type")return;
        let value=control.value;
        if(control.type==="number")value=num(value,getProperty(item,path));
        if(control.dataset.valueType==="boolean")value=value==="true";
        if(control.dataset.valueType === "json")value=JSON.parse(value||"{}");
        if(path==="containerId")value=value?String(value):null;
        root.__labelDesigner.updateSelected(propertyPatch(path,value,item));
        checkpoint();
    }
    function handleAction(action,button){
        try{
            if(action==="background"){const input=role("background-file");if(input)input.click();return;}
            if(action==="remove-background"){
                state.layout.background=null;syncStage();checkpoint();return;
            }
            if(action==="apply-background"){
                if(state.layout.background){
                    const fit=role("background-fit"),opacity=role("background-opacity"),
                        locked=role("background-locked");
                    state.layout.background.fit=fit?fit.value:"fill";
                    state.layout.background.opacity=Math.max(0,Math.min(1,
                        num(opacity&&opacity.value,1)));
                    state.layout.background.locked=locked?locked.value!=="false":true;
                    syncStage();checkpoint();
                }
                return;
            }
            if(action==="add-text"){add("text");checkpoint();return;}
            if(action==="add-barcode"){add("barcode");checkpoint();return;}
            if(action==="add-container"){add("container");checkpoint();return;}
            if(action==="remove"){
                const hasTree=selectedItems().some(function(item){
                    return item.type==="container"&&containerChildren(item).length>0;
                });
                if(hasTree&&typeof window.confirm==="function"&&!window.confirm(
                    "A area possui componentes. Excluir toda a subarvore?"))return;
                remove();checkpoint();return;
            }
            if(action==="duplicate"){duplicate();checkpoint();return;}
            if(action==="lock"){toggleLock();checkpoint();return;}
            if(action==="lock-reference"){
                const reference=selected();
                if(reference){
                    reference.locked=true;
                    state.layout.editor.snap.referenceElementId=reference.id;
                    render();checkpoint();
                }
                return;
            }
            if(action==="undo"){undo();return;}
            if(action==="redo"){redo();return;}
            if(action==="align"){
                const mode=role("align-mode"),value=mode?mode.value:"left",
                    result=value==="baseline"?align(value):arrangeSelection("align-"+value,{
                        overflow:"confirm"
                    });
                finishArrange(result,"Alinhamento");return;
            }
            if(action==="position-relative"){
                const direction=role("position-direction"),gap=role("stack-gap"),
                    cross=role("cross-align"),result=arrangeSelection("position-"+
                        (direction?direction.value:"below"),{
                        gap:gap?gap.value:1,crossAlign:cross?cross.value:"start",
                        overflow:"confirm",advanceReference:true
                    });
                finishArrange(result,"Posicionamento");return;
            }
            if(action==="distribute-horizontal"||action==="distribute-vertical"){
                finishArrange(arrangeSelection(action,{overflow:"confirm"}),"Distribuicao");
                return;
            }
            if(action==="equal-width"||action==="equal-height"||action==="equal-size"){
                finishArrange(arrangeSelection(action,{overflow:"confirm"}),"Dimensionamento");
                return;
            }
            if(action==="stack-down"||action==="stack-right"){
                const gap=role("stack-gap");
                finishArrange(stack(action==="stack-down"?"vertical":"horizontal",
                    gap?gap.value:1,action==="stack-down"?"left":"top"),
                    "Posicionamento");return;
            }
            if(action==="assign"){assignToContainer();checkpoint();return;}
            if(action==="reflow"){
                const item=selected();
                if(item&&item.type==="container"){layoutContainer(item.id);checkpoint();}
                return;
            }
            if(action==="grid"){
                state.layout.editor.grid.enabled=!state.layout.editor.grid.enabled;
                render();checkpoint();return;
            }
            if(action==="snap"){
                state.layout.editor.snap.enabled=!state.layout.editor.snap.enabled;
                render();checkpoint();return;
            }
            if(action==="reference"){
                state.layout.editor.snap.referenceElementId=
                    state.layout.editor.snap.referenceElementId===state.selected?null:state.selected;
                render();checkpoint();return;
            }
            if(action==="chain"){
                state.layout.editor.snap.chainMode=!state.layout.editor.snap.chainMode;
                render();checkpoint();return;
            }
            if(action==="discover-variables"){
                const result=discoverVariables(true);
                render();checkpoint();
                setStatus(result.missing.length?
                    result.missing.length+" vari\u00e1vel(is) adicionada(s).":
                    "Todos os mnem\u00f4nicos j\u00e1 estavam declarados.");
                return;
            }
            if(action==="generate-sample-records"){
                const result=generateSampleRecords({
                    readEditor:true,forceSync:true,enableAutomatic:true,
                    source:"button"
                }),added=result.added.length,conflicts=result.conflicts.length,
                    warnings=result.warnings.length,message=conflicts?
                        added+" valor(es) adicionado(s); "+conflicts+
                            " caminho(s) nao puderam ser criados sem substituir dados.":
                        added?added+" valor(es) de exemplo adicionado(s); "+
                            "os existentes foram preservados.":
                        "Os dados ja contem todos os mnemonicos do layout.";
                setStatus(message,
                    conflicts||warnings?"warning":"");
                return;
            }
            if(action==="apply-page"){
                const width=role("page-width"),height=role("page-height"),
                    rotation=role("page-rotation"),gridStep=role("grid-step"),
                    snapTolerance=role("snap-tolerance");
                setPage({
                    width:width&&width.value,height:height&&height.value,
                    rotation:rotation&&rotation.value,
                    margins:{
                        top:role("page-margin-top")&&role("page-margin-top").value,
                        right:role("page-margin-right")&&role("page-margin-right").value,
                        bottom:role("page-margin-bottom")&&role("page-margin-bottom").value,
                        left:role("page-margin-left")&&role("page-margin-left").value
                    },
                    safeArea:role("page-safe-area")&&role("page-safe-area").value,
                    bleed:role("page-bleed")&&role("page-bleed").value
                });
                state.layout.editor.grid.step=Math.max(.01,
                    num(gridStep&&gridStep.value,state.layout.editor.grid.step));
                state.layout.editor.snap.tolerancePx=Math.max(0,
                    num(snapTolerance&&snapTolerance.value,
                        state.layout.editor.snap.tolerancePx));
                render();checkpoint();return;
            }
            if(action==="mode"){
                const mode=button.dataset.mode;
                if(mode==="print"){previewProduct().catch(function(){});return;}
                stopPendingPreview();
                state.mode=mode;render({emit:false});return;
            }
            if(action==="print-overlay"){
                state.printOverlay=!state.printOverlay;render({emit:false});return;
            }
            if(action==="validate"){validateProduct().catch(function(){});return;}
            if(action==="preview"){previewProduct().catch(function(){});return;}
            if(action==="export"){exportJSON();return;}
            if(action==="import"){const input=role("layout-file");if(input)input.click();return;}
            if(action==="toggle-drawers"){
                setDrawersCollapsed(!state.drawersCollapsed);return;
            }
            if(action==="toggle-elements"){
                setElementsCollapsed(!state.elementsCollapsed,false);return;
            }
            if(action==="toggle-elements-size"){
                setElementsMinimized(!state.elementsMinimized,false);return;
            }
            if(action==="format-json"){formatEditedJSON();return;}
            if(action==="apply-json"){applyEditedJSON();return;}
            if(action==="discard-json"){syncContract(true);setStatus("Edi\u00e7\u00e3o descartada.");return;}
            if(action==="layer-up"){reorderSelected(1);return;}
            if(action==="layer-down"){reorderSelected(-1);return;}
            if(action==="visibility"||action==="layer-lock"){
                const item=elements().find(function(candidate){return candidate.id===button.dataset.id;});
                if(item){
                    if(action==="visibility")item.hidden=!item.hidden;else item.locked=!item.locked;
                    render();checkpoint();
                }
            }
        }catch(error){
            setStatus(error.message||String(error),"error");
            if(role("toolbar"))root.dispatchEvent(new CustomEvent("fwwebex:label-error",{
                detail:{error:error},bubbles:true
            }));
        }
    }
    listen(root,"click",function(event){
        const tab=event.target.closest&&event.target.closest(
            '[role="tab"][data-tab-group]');
        if(tab){
            if(tabAvailable(tab)){
                activateTab(tab.dataset.tabGroup,tab.dataset.tabTarget,false);
                if(tab.dataset.tabGroup==="drawers")setDrawersCollapsed(false);
            }
            return;
        }
        const actionButton=event.target.closest&&event.target.closest("[data-action]");
        if(actionButton){handleAction(actionButton.dataset.action,actionButton);return;}
        const layer=event.target.closest&&event.target.closest(".fwwebex-label-layer");
        if(layer)selectId(layer.dataset.id,event.shiftKey);
        const problem=event.target.closest&&event.target.closest(".fwwebex-label-problem");
        if(problem&&problem.dataset.elementId){
            selectId(problem.dataset.elementId,false);
            const target=Array.prototype.find.call(fields.children,function(child){
                return child.dataset.id===problem.dataset.elementId;
            });
            if(target&&typeof target.scrollIntoView==="function")
                target.scrollIntoView({block:"center",inline:"center"});
        }
    });
    listen(root,"change",function(event){
        const control=event.target;
        if(control.dataset&&control.dataset.property){
            try{applyInspector(control);}
            catch(error){setStatus(error.message||String(error),"error");render({emit:false});}
            return;
        }
        if(isRole(control,"zoom")){
            state.zoom=control.value;render({emit:false});return;
        }
        if(isRole(control,"record-index")){
            state.recordIndex=Math.max(0,Math.min(state.records.length-1,
                num(control.value,0)));
            if(state.mode==="data")render({emit:false});
            schedulePreview();
            return;
        }
        if(isRole(control,"overlay-opacity")){
            state.overlayOpacity=Math.max(.1,Math.min(1,num(control.value,.5)));
            render({emit:false});return;
        }
        if(isRole(control,"background-file")&&control.files&&control.files[0])
            setBackground(control.files[0]).then(function(){checkpoint();})
                .catch(function(error){setStatus(error.message||String(error),"error");});
        if(isRole(control,"layout-file")&&control.files&&control.files[0]){
            if(state.contractDirty&&typeof window.confirm==="function"&&!window.confirm(
                "H\u00e1 uma edi\u00e7\u00e3o JSON pendente. Descartar e importar o arquivo?")){
                control.value="";return;
            }
            const reader=new FileReader();
            reader.onload=function(){
                try{load(JSON.parse(String(reader.result||"")),{discardDirty:true});}
                catch(error){setStatus(error.message||String(error),"error");}
            };
            reader.readAsText(control.files[0]);
        }
    });
    listen(root,"input",function(event){
        const control=event.target;
        if(isRole(control,"layer-search")){renderLayers();return;}
        if(isRole(control,"contract-editor")){setDirty(true);return;}
        if(isRole(control,"records-editor")){
            state.autoSampleRecords=false;
            try{
                const value=JSON.parse(control.value||"[]");
                state.records=clone(Array.isArray(value)?value:[value]);
                emitRecordsChange("editor",null);
                if(state.mode==="data")render({emit:false});
                schedulePreview();
            }catch(error){setStatus("Dados JSON ainda incompletos.","error");}
        }
    });
    listen(root,"keydown",function(event){
        const target=event.target,key=String(event.key||"").toLowerCase(),
            tab=target&&target.closest&&target.closest(
                '[role="tab"][data-tab-group]');
        if(tab&&["arrowleft","arrowright","arrowup","arrowdown","home","end"].indexOf(key)>=0){
            const buttons=tabButtons(tab.dataset.tabGroup).filter(tabAvailable),
                index=Math.max(0,buttons.indexOf(tab));
            let next=index;
            if(key==="home")next=0;
            else if(key==="end")next=buttons.length-1;
            else if(key==="arrowleft"||key==="arrowup")
                next=(index-1+buttons.length)%buttons.length;
            else next=(index+1)%buttons.length;
            event.preventDefault();
            if(buttons[next]){
                activateTab(tab.dataset.tabGroup,buttons[next].dataset.tabTarget,true);
                if(tab.dataset.tabGroup==="drawers")setDrawersCollapsed(false);
            }
            return;
        }
        if(key==="escape"){
            const openDetails=roleAll("details[open]");
            if(openDetails.length){
                const detail=openDetails[openDetails.length-1],summary=
                    detail.querySelector&&detail.querySelector("summary");
                detail.open=false;event.preventDefault();
                if(summary&&typeof summary.focus==="function")summary.focus();
                return;
            }
            const drawers=role("drawers");
            if(!state.drawersCollapsed&&drawers&&typeof drawers.contains==="function"&&
                drawers.contains(target)){
                setDrawersCollapsed(true,true);event.preventDefault();return;
            }
        }
        const editing=target&&
            /^(INPUT|TEXTAREA|SELECT)$/.test(target.tagName||"");
        if(editing)return;
        const ctrl=event.ctrlKey||event.metaKey;
        if(ctrl&&key==="z"){event.preventDefault();event.shiftKey?redo():undo();return;}
        if(ctrl&&key==="y"){event.preventDefault();redo();return;}
        if(ctrl&&key==="d"){event.preventDefault();duplicate();checkpoint();return;}
        if(ctrl&&key==="c"){state.clipboard=clone(selectedItems());return;}
        if(ctrl&&key==="v"&&state.clipboard&&state.clipboard.length){
            const ids=state.clipboard.map(function(item){return item.id;});
            const result=window.FWWebExLabels.layout.duplicate(exportLayout(),ids,{
                offsetX:2,offsetY:2,idFactory:function(){return uid();}
            });
            state.layout=attachLayoutAccessors(clone(result.layout));
            state.selection=result.ids;state.selected=result.ids[result.ids.length-1]||null;
            render();checkpoint();return;
        }
        if(key==="delete"||key==="backspace"){
            if(state.selection.length){event.preventDefault();handleAction("remove",null);}return;
        }
        const amount=event.shiftKey?1:.1;
        if(key==="arrowleft"){event.preventDefault();nudge(-amount,0);}
        if(key==="arrowright"){event.preventDefault();nudge(amount,0);}
        if(key==="arrowup"){event.preventDefault();nudge(0,-amount);}
        if(key==="arrowdown"){event.preventDefault();nudge(0,amount);}
        if(key==="escape"){
            action=null;state.selection=[];state.selected=null;
            clearSnapFeedback();
            const endedChain=state.layout.editor.snap.chainMode===true;
            state.layout.editor.snap.chainMode=false;render();
            if(endedChain)setStatus("Posicionamento encadeado encerrado.");
        }
    });
    function positionMarquee(box,current){
        if(!box)return;
        const source={
                left:Math.min(current.x1,current.x2),
                top:Math.min(current.y1,current.y2),
                right:Math.max(current.x1,current.x2),
                bottom:Math.max(current.y1,current.y2)
            },geometry=pageGeometry();
        let bounds=source,width=page().width,height=page().height;
        if(state.mode==="print"&&state.previewViewport){
            const corners=[
                transformPoint(geometry.matrix,{x:source.left,y:source.top}),
                transformPoint(geometry.matrix,{x:source.right,y:source.top}),
                transformPoint(geometry.matrix,{x:source.left,y:source.bottom}),
                transformPoint(geometry.matrix,{x:source.right,y:source.bottom})
            ],xs=corners.map(function(point){return point.x;}),
                ys=corners.map(function(point){return point.y;});
            bounds={left:Math.min.apply(Math,xs),top:Math.min.apply(Math,ys),
                right:Math.max.apply(Math,xs),bottom:Math.max.apply(Math,ys)};
            width=geometry.width;height=geometry.height;
        }
        box.style.left=(bounds.left/width*100)+"%";
        box.style.top=(bounds.top/height*100)+"%";
        box.style.width=((bounds.right-bounds.left)/width*100)+"%";
        box.style.height=((bounds.bottom-bounds.top)/height*100)+"%";
    }
    listen(stage,"pointerdown",function(ev){
        clearSnapFeedback();
        const field=ev.target.closest(".fwwebex-label-field");
        if(!field){
            const point=pointerSourcePoint(ev),x=point.x,y=point.y,
                box=role("selection-box");
            state.selected=null;state.selection=[];
            action={marquee:true,x1:x,y1:y,x2:x,y2:y};
            if(box){
                box.style.display="block";positionMarquee(box,action);
            }
            render({emit:false,visualOnly:true});ev.preventDefault();return;
        }
        const id=field.dataset.id;
        if(ev.shiftKey){
            const index=state.selection.indexOf(id);
            if(index>=0){state.selection.splice(index,1);state.selected=state.selection[state.selection.length-1]||null;}
            else{state.selection.push(id);state.selected=id;}
            render();ev.preventDefault();return;
        }
        if(state.selection.indexOf(id)<0)state.selection=[id];
        state.selected=id; const item=selected(),start=pointerSourcePoint(ev);
        if(item.locked===true){render();ev.preventDefault();return;}
        const referenceId=state.layout.editor&&state.layout.editor.snap&&
            state.layout.editor.snap.referenceElementId;
        const movingMap=new Map();
        selectedItems().filter(function(candidate){
            return candidate.id!==item.id&&candidate.id!==referenceId&&
                candidate.locked!==true;
        }).forEach(function(candidate){movingMap.set(candidate.id,candidate);});
        function includeChildren(container){
            containerChildren(container).forEach(function(child){
                movingMap.set(child.id,child);
                if(child.type==="container")includeChildren(child);
            });
        }
        if(item.type==="container")includeChildren(item);
        const movingChildren=Array.from(movingMap.values()).map(function(child){
            return {item:child,x:child.box.x,y:child.box.y};
        });
        action={item:item,resize:ev.target.dataset.resize==="1",
            startX:start.x,startY:start.y,
            ox:item.box.x,oy:item.box.y,ow:item.box.width,oh:item.box.height,
            children:movingChildren,snapLatch:{x:null,y:null},
            snapMetrics:currentTextMetrics()};
        field.setPointerCapture(ev.pointerId); render(); ev.preventDefault();
    });
    listen(stage,"pointermove",function(ev){
        if(action&&action.marquee){
            const point=pointerSourcePoint(ev),box=role("selection-box");
            action.x2=point.x;action.y2=point.y;positionMarquee(box,action);
            return;
        }
        if(!action)return;
        const point=pointerSourcePoint(ev),dx=point.x-action.startX,dy=point.y-action.startY;
        if(action.resize){
            action.item.box.width=Math.max(3,action.ow+dx);
            action.item.box.height=Math.max(3,action.oh+dy);
        }else{
            const target=snapPosition(action.item,
                Math.max(0,Math.min(page().width-action.item.box.width,action.ox+dx)),
                Math.max(0,Math.min(page().height-action.item.box.height,action.oy+dy)),ev);
            action.item.box.x=target.x;action.item.box.y=target.y;
            action.children.forEach(function(child){
                child.item.box.x=child.x+(action.item.box.x-action.ox);
                child.item.box.y=child.y+(action.item.box.y-action.oy);
            });}
        scheduleVisualRender();
    });
    listen(stage,"pointerup",finishPointerAction);
    listen(stage,"pointercancel",finishPointerAction);
    listen(stage,"dblclick",function(ev){
        const field=ev.target.closest(".fwwebex-label-field"); if(!field)return;
        state.selected=field.dataset.id;if(state.selection.indexOf(state.selected)<0)state.selection=[state.selected];
        const item=selected();
        const next=item.type==="container"?
            window.prompt("Nome da area:",item.name||"Area de layout"):
            window.prompt("Conteudo dinamico (use {{campo}}):",item.template);
        if(next!==null){
            if(item.type==="container")item.name=next;else item.template=next;
            render();
        }
    });
    root.__labelDesigner={addText:function(options){return add("text",options);},
        addBarcode:function(options){return add("barcode",options);},
        addContainer:function(options){return add("container",options);},
        remove:remove,duplicate:duplicate,toggleLock:toggleLock,align:align,
        arrange:arrangeSelection,copyStyle:copyStyle,stack:stack,
        assignToContainer:assignToContainer,
        layoutContainer:layoutContainer,
        exportLayout:exportLayout,load:load,setBackground:setBackground,
        setRecords:setRecords,setOptions:setOptions,validate:validateProduct,
        preview:previewProduct,download:downloadProduct,print:printProduct,
        undo:undo,redo:redo,exportJSON:exportJSON,
        selectTab:function(group,target,focus){
            return !!activateTab(group,target,focus===true);
        },
        getActiveTabs:function(){return clone(state.tabs);},
        setDrawersCollapsed:setDrawersCollapsed,
        setElementsCollapsed:setElementsCollapsed,
        setElementsMinimized:setElementsMinimized,
        discoverVariables:discoverVariables,generateSampleRecords:function(options){
            return generateSampleRecords(Object.assign({
                readEditor:true,forceSync:true,enableAutomatic:true,source:"api"
            },options||{}));
        },
        setMode:function(mode){
            if(["design","data","print"].indexOf(mode)<0)
                throw new Error("Modo do designer invalido.");
            if(mode==="print")return previewProduct();
            stopPendingPreview();state.mode=mode;return render({emit:false});
        },
        setPage:setPage,getSelected:selected,getSelectedItems:selectedItems,
        updateSelected:function(patch){
            const item=selected();
            if(item){
                patch=patch||{};
                const oldId=item.id,oldContainerId=item.containerId;
                if(patch.id!==undefined&&!String(patch.id).trim())
                    throw new Error("O ID do elemento nao pode ficar vazio.");
                if(patch.id!==undefined&&String(patch.id)!==oldId&&
                    elements().some(function(candidate){
                        return candidate.id===String(patch.id);
                    }))
                    throw new Error("Ja existe um elemento com o ID "+patch.id+".");
                applyElementPatch(item,patch);
                if(item.type!=="container"&&(
                    patch.width!==undefined||patch.height!==undefined||
                    patch.box&&(
                        patch.box.width!==undefined||patch.box.height!==undefined
                    )
                )){
                    item.basisBox=item.basisBox||{
                        width:item.box.width,height:item.box.height
                    };
                    if(patch.width!==undefined||patch.box&&patch.box.width!==undefined)
                        item.basisBox.width=item.box.width;
                    if(patch.height!==undefined||patch.box&&patch.box.height!==undefined)
                        item.basisBox.height=item.box.height;
                }
                if(item.id!==oldId){
                    state.selection=state.selection.map(function(id){return id===oldId?item.id:id;});
                    state.selected=item.id;
                    elements().forEach(function(candidate){
                        if(candidate.containerId===oldId)candidate.containerId=item.id;
                        if(candidate.type==="container")candidate.layout.children=
                            candidate.layout.children.map(function(id){
                                return id===oldId?item.id:id;
                            });
                    });
                    if(state.layout.editor&&state.layout.editor.snap&&
                        state.layout.editor.snap.referenceElementId===oldId)
                        state.layout.editor.snap.referenceElementId=item.id;
                    if(Object.prototype.hasOwnProperty.call(containerOverflow,oldId)){
                        containerOverflow[item.id]=containerOverflow[oldId];
                        delete containerOverflow[oldId];
                    }
                }
                if(item.containerId!==oldContainerId){
                    elements().filter(function(candidate){return candidate.type==="container";})
                        .forEach(function(candidate){
                            candidate.layout.children=candidate.layout.children
                                .filter(function(id){return id!==item.id;});
                        });
                    const nextContainer=elements().find(function(candidate){
                        return candidate.type==="container"&&candidate.id===item.containerId;
                    });
                    if(nextContainer&&nextContainer.layout.children.indexOf(item.id)<0)
                        nextContainer.layout.children.push(item.id);
                }
                render();schedulePreview();
            }
            return item;
        },
        setVariables:function(variables){
            state.layout.variables=clone(Array.isArray(variables)?variables:[]);render();
        },
        setBarcodeAutoRules:function(rules){
            state.layout.barcodeAutoRules=clone(Array.isArray(rules)?rules:[]);render();
        },
        render:render,
        destroy:function(){
            clearSnapFeedback();
            stopPendingPreview();
            if(renderFrame!==null&&typeof window.cancelAnimationFrame==="function")
                window.cancelAnimationFrame(renderFrame);
            removeListeners();
            const canvas=role("preview-canvas");
            if(canvas){canvas.width=1;canvas.height=1;canvas.style.display="none";}
            root.__labelDesigner=null;
        }};
    window.FWWebExLabels=window.FWWebExLabels||{};
    window.FWWebExLabels.designer=window.FWWebExLabels.designer||{};
    window.FWWebExLabels.designer.get=function(rootOrId){
        const element=typeof rootOrId==="string"?document.getElementById(rootOrId):rootOrId;
        return element&&element.__labelDesigner||null;
    };
    window.FWWebExLabels.designer.create=function(rootOrId,options){
        const instance=window.FWWebExLabels.designer.get(rootOrId);
        if(!instance)throw new Error(
            "FWWebEx Labels: use WebExLabelDesigner para preparar o host antes de create().");
        if(options)instance.setOptions(options);
        return instance;
    };
    window.FWWebExLabels.designer.destroy=function(rootOrId){
        const instance=window.FWWebExLabels.designer.get(rootOrId);
        if(instance&&typeof instance.destroy==="function")instance.destroy();
    };
    function initialJSON(source,fallback,label){
        if(!source||source.indexOf("__")===0)return fallback;
        try{return JSON.parse(source);}
        catch(error){
            setStatus("Configura\u00e7\u00e3o inicial inv\u00e1lida em "+label+
                ": "+error.message,"error");
            return fallback;
        }
    }
    initializeTabs();setDrawersCollapsed(false);setElementsCollapsed(false,false);
    setElementsMinimized(false,false);
    resetHistory();syncStage();
    Promise.resolve().then(function(){
        const options=initialJSON('__OPTIONS_JSON__',{},"op\u00e7\u00f5es"),
            records=initialJSON('__RECORDS_JSON__',[],"dados"),
            layout=initialJSON('__LAYOUT_JSON__',null,"layout");
        setOptions(options);setRecords(records);
        if(layout)load(layout);
        syncRecordsEditor(true);
    });
})();
    endContent
    cScript:=WebExHelper():StrReplaceEx(cScript,;
        {"__ID__",::GetFixedID()},;
        {"__WIDTH__",cWidth},;
        {"__HEIGHT__",cHeight},;
        {"__LAYOUT_JSON__",cLayoutJSON},;
        {"__RECORDS_JSON__",cRecordsJSON},;
        {"__OPTIONS_JSON__",cOptionsJSON})
    ::oDesignerScript:SetContent(cScript)
    cHTML:=_Super:RenderHTML()
return(cHTML)

method New() class WebExLabelPDFGenerator
    WebExFeatureLabels():Enable()
    _Super:New()
    ::oFacadeScript:=WebExScript():New()
    ::AddClass("fwwebex-label-pdf-generator")
return(self)

method RenderHTML() class WebExLabelPDFGenerator
    local cHTML as character
    local cFacade as character
    beginContent var cFacade
(function(){
    const root=document.getElementById("__ID__");
    if(!root||root.__labelPDF)return;
    Promise.resolve().then(function(){
        const labels=window.FWWebExLabels;
        if(!labels||!labels.contract||!labels.renderer||!labels.layout)
            throw new Error("FWWebEx Labels: runtime compartilhado indisponivel.");
        root.__labelPDF={
            generate:labels.renderer.generate,
            normalize:labels.contract.normalize,
            serialize:labels.contract.serialize,
            validate:labels.contract.validate,
            resolveLayout:labels.layout.resolve,
            layout:labels.layout
        };
    });
})();
    endContent
    cFacade:=WebExHelper():StrReplaceEx(cFacade,{"__ID__",::GetFixedID()})
    ::oFacadeScript:SetContent(cFacade)
    cHTML:=_Super:RenderHTML()
return(cHTML)
