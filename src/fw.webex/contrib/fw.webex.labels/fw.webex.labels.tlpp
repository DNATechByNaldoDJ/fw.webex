    beginContent var cRuntime
(function(){
    const installed=window.FWWebExLabels;
    if(installed&&installed.contract&&installed.renderer&&installed.layout&&
        installed.geometry&&typeof installed.geometry.pageRotationGeometry==="function"&&
        installed.snap&&typeof installed.snap.resolve==="function"&&
        typeof installed.contract.normalize==="function"&&
        typeof installed.contract.createSampleRecords==="function"&&
        typeof installed.renderer.generate==="function"&&
        typeof installed.layout.resolve==="function"&&
        typeof installed.layout.arrange==="function")return;
    const SCHEMA="fwwebex.labels",CONTRACT_VERSION=2;
    const UNSAFE_PATH_SEGMENTS=new Set(["__proto__","prototype","constructor"]);
    function clone(value){return value==null?value:JSON.parse(JSON.stringify(value));}
    function defined(value,fallback){return value===undefined||value===null?fallback:value;}
    function finite(value,fallback){
        const number=Number(value);return Number.isFinite(number)?number:fallback;
    }
    function contractError(code,message,path){
        const problem=issue(code,"error",path||"",message,"Corrija o contrato e tente novamente.");
        const error=new Error(message);error.name="FWWebExLabelContractError";
        error.code=code;error.issues=[problem];return error;
    }
    function pointer(){
        return "/"+Array.prototype.slice.call(arguments).map(function(part){
            return String(part).replace(/~/g,"~0").replace(/\//g,"~1");
        }).join("/");
    }
    function pathParts(path){
        const source=String(path||"");
        if(!source||source.charAt(0)==="."||source.charAt(source.length-1)==="."||
            source.indexOf("..")>=0)return null;
        const parts=source.split(".");
        return parts.every(function(part){
            return /^[A-Za-z_][A-Za-z0-9_]*$/.test(part)&&
                !UNSAFE_PATH_SEGMENTS.has(part);
        })?parts:null;
    }
    function isSafePath(path){return pathParts(path)!==null;}
    function normalizeInsets(value,fallback){
        fallback=finite(fallback,0);
        if(typeof value==="number")return {top:value,right:value,bottom:value,left:value};
        value=value&&typeof value==="object"?value:{};
        const vertical=finite(value.y,fallback),horizontal=finite(value.x,fallback);
        return {
            top:finite(value.top,vertical),
            right:finite(value.right,horizontal),
            bottom:finite(value.bottom,vertical),
            left:finite(value.left,horizontal)
        };
    }
    function normalizeEditor(value){
        const source=value&&typeof value==="object"&&!Array.isArray(value)?value:{},
            grid=source.grid&&typeof source.grid==="object"&&!Array.isArray(source.grid)?
                source.grid:{},
            snap=source.snap&&typeof source.snap==="object"&&!Array.isArray(source.snap)?
                source.snap:{},
            guides=(Array.isArray(source.guides)?source.guides:[]).map(function(guide,index){
                if(!guide||typeof guide!=="object"||Array.isArray(guide))return null;
                const axis=guide.axis==="x"||guide.axis==="vertical"?"x":
                    guide.axis==="y"||guide.axis==="horizontal"?"y":null,
                    position=Number(guide.position);
                if(!axis||!Number.isFinite(position))return null;
                const normalized={axis:axis,position:position};
                if(guide.id!==undefined)normalized.id=String(guide.id);
                if(guide.name!==undefined)normalized.name=String(guide.name);
                else if(guide.label!==undefined)normalized.name=String(guide.label);
                if(guide.locked!==undefined)normalized.locked=guide.locked===true;
                normalized.order=index;
                return normalized;
            }).filter(Boolean).map(function(guide){delete guide.order;return guide;});
        return {
            grid:{
                enabled:grid.enabled===true,
                step:Math.max(.01,finite(grid.step,1))
            },
            snap:{
                enabled:snap.enabled===true,
                tolerancePx:Math.max(0,finite(snap.tolerancePx,8)),
                referenceElementId:snap.referenceElementId==null?null:
                    String(snap.referenceElementId),
                chainMode:snap.chainMode===true
