    const ARRANGE_COMMANDS=new Set([
        "align-left","align-center","align-right","align-top","align-middle",
        "align-bottom","position-above","position-below","position-left",
        "position-right","equal-width","equal-height","equal-size",
        "distribute-horizontal","distribute-vertical"
    ]);
    function arrangeCommand(command,options){
        if(typeof command==="string")return String(command).toLowerCase();
        const spec=command&&typeof command==="object"?command:{};
        Object.keys(spec).forEach(function(key){
            if(options[key]===undefined)options[key]=spec[key];
        });
        const operation=String(spec.operation||"").toLowerCase();
        if(operation==="align")return "align-"+String(spec.mode||"left").toLowerCase();
        if(operation==="position")return "position-"+
            String(spec.direction||"below").toLowerCase();
        if(operation==="distribute")return "distribute-"+
            String(spec.axis||"horizontal").toLowerCase();
        if(operation==="match-size"||operation==="equal"){
            const dimension=String(spec.dimension||"both").toLowerCase();
            return dimension==="both"?"equal-size":"equal-"+dimension;
        }
        return operation;
    }
    function graphArrange(input,ids,command,options){
        options=options&&typeof options==="object"?Object.assign({},options):{};
        command=arrangeCommand(command,options);
        if(!ARRANGE_COMMANDS.has(command))
            throw new Error("FWWebEx Labels: comando arrange invalido: "+command+".");
        const layout=clone(input),graph=graphIndex(layout),seen=new Set();
        let requested=[];
        (Array.isArray(ids)?ids:[ids]).forEach(function(id){
            id=String(id==null?"":id);
            if(id&&graph.byId.has(id)&&!seen.has(id)){seen.add(id);requested.push(id);}
        });
        let referenceId=String(options.referenceId==null?"":options.referenceId);
        if(!graph.byId.has(referenceId))referenceId=requested[requested.length-1]||"";
        const reference=graph.byId.get(referenceId);
        if(!reference)
            throw new Error("FWWebEx Labels: referencia do comando arrange inexistente.");
        const effective=new Set(requested);
        requested.forEach(function(id){
            const item=graph.byId.get(id);
            if(item&&item.type==="container"&&id!==referenceId&&
                graph.descendants(id).has(referenceId))effective.delete(id);
        });
        requested=requested.filter(function(id){
            if(!effective.has(id))return false;
            let parent=graph.byId.get(id),visited=new Set();
            parent=parent&&graph.byId.get(parent.containerId);
            while(parent&&!visited.has(parent.id)){
                if(effective.has(parent.id))return false;
                visited.add(parent.id);parent=graph.byId.get(parent.containerId);
