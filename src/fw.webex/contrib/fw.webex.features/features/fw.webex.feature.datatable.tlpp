#include "fw.webex.th"

namespace FWWebEx

class WebExFeatureDataTable from WebExControl
    protected data oFeature as object
    public method Enable() as object
    public method Load(oControl as object) as object
end class

method Enable() class WebExFeatureDataTable
    local oFeature as object
    _Super:New()
    ::oFeature:=self
    oFeature:=::oFeature
    ::AddFeature(oFeature,{|oControl|oFeature:Load(oControl)},5)
return(self)

method Load(oControl) class WebExFeatureDataTable

    local cDataTableStyle as character
    local cDataTableScript as character

