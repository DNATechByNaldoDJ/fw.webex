namespace FWWebEx

#include "fw.webex.th"

class WebExMarkDown from WebExPre

    public method New() as object

    public method ConvertMD() as object

endclass

method New() class WebExMarkDown

    _Super:New()
    ::SetEnableMarkDown(.T.)
    ::AddClass("markdown")
    ::AddClass("print-only")

return(self)

method ConvertMD() class WebExMarkDown

    local cMarkDownScript as character

    beginContent var cMarkDownScript
        document.addEventListener('DOMContentLoaded', function () {
            FWWebExWaitForElementID("__ID__", function (element) {
                MarkdownHighlightInFWWebExPage?.convertMD(element?.id);
            });
        });
    endContent

    cMarkDownScript:=::StrReplaceEx(cMarkDownScript,{"__ID__",::GetFixedID()})

    WITH WEBEXOBJECT CLASS WebExScript
        .:SetContent(cMarkDownScript)
    END WEBEXOBJECT

return(self)

class FWMarkDown from FWWebEx.ClassBase

    protected data aFootNotes as array

    protected data cCRLF as character
    protected data cOutput as character
    protected data cBuffer as character

    protected data lHasHeader as logical
    protected data lHasEmojis as logical
    protected data lEncodeUTF8 as logical
    protected data lBufferEnabled as logical
    protected data lEscapeHTMLAttribute as logical

    // ------------------------------------------------------
    public method New() as object

    // ------------------------------------------------------
    public method Clean() as object

    // ------------------------------------------------------
    public method EnableUTF8(lEncodeUTF8 as logical) as object
    public method EnableEmoji(lHasEmojis as logical) as object
    public method EnableBuffer(lBufferEnabled as logical) as object
    public method EnableHeader(lHasHeader as logical) as object
    public method EnableEscapeHTMLAttribute(lEscapeHTMLAttribute as logical) as object

    // ------------------------------------------------------
    public method Header(cText as character,nLevel as numeric) as object
    public method Paragraph(cText as character) as object
    public method ListItem(cText as character,nLevel as numeric,lOrdered as logical) as object
    public method ListItemTask(cText as character,lChecked as logical,nLevel as numeric) as object
    public method Bold(cText as character) as character
    public method Italic(cText as character) as character
    public method Strike(cText as character) as character
    public method Highlight(cText as character) as character
    public method Subscript(cText as character) as character
    public method SuperScript(cText as character) as character
    public method Link(cText as character,cUrl as character) as character
    public method Image(cAlt as character,cURL as character,nWidth as numeric,nHeight as numeric,cClass as character) as character
    public method VideoEmbed(cUrl,nWidth,nHeight) as object
    public method Code(cText as character) as character
    public method Comment(cText as character,lHTML as logical) as character
    public method CodeBlock(cText as character,cLang as character) as object
    public method Quote(cText as character,nLevel as numeric) as object
    public method Table(aHeader as array,aRows as array,aAlign as array) as object
    public method DefinitionList(cTerm as character,cDef as character) as object
    public method Rule() as object
    public method FootNoteRef(cId as character) as character
    public method FootNoteDef(cId as character,cText as character) as object
    public method FrontMatter(jMeta as json) as object

    // ------------------------------------------------------
    public method PageHeader(cHeaderText as character) as object
    public method PageFooter(cFooterText as character)
    public method PageBreak(cPageBreak as character,cStyle as character) as object

    // ------------------------------------------------------
    public method BuildOutPut() as character
    public method Save(cFile as character) as logical

end class

// ------------------------------------------------------
method New() class FWMarkDown
    ::cCRLF:=CRLF
    ::cOutput:=""
    ::cBuffer:=""
    ::lHasHeader:=.F.
    ::lHasEmojis:=.F.
    ::lEncodeUTF8:=.F.
    ::lBufferEnabled:=.T.
    ::lEscapeHTMLAttribute:=.F.
    ::aFootNotes:={}
return(self)

// ------------------------------------------------------
method Clean() class FWMarkDown
    ::cOutput:=""
    ::cBuffer:=""
    aSize(::aFootNotes,0)
return(self)

// ------------------------------------------------------
method EnableUTF8(lEncodeUTF8) class FWMarkDown
    paramtype 1 var lEncodeUTF8 as logical optional default ::lEncodeUTF8
    ::lEncodeUTF8:=lEncodeUTF8
return(self)

// ------------------------------------------------------
method EnableEmoji(lHasEmojis) class FWMarkDown
    paramtype 1 var lHasEmojis as logical optional default ::lHasEmojis
    ::lHasEmojis:=lHasEmojis
return(self)

// ------------------------------------------------------
method EnableBuffer(lBufferEnabled) class FWMarkDown
    paramtype 1 var lBufferEnabled as logical optional default ::lBufferEnabled
    ::lBufferEnabled:=lBufferEnabled
return(self)

// ------------------------------------------------------
method EnableHeader(lHasHeader) class FWMarkDown
    paramtype 1 var lHasHeader as logical optional default ::lHasHeader
    ::lHasHeader:=lHasHeader
return(self)

// ------------------------------------------------------
method EnableEscapeHTMLAttribute(lEscapeHTMLAttribute) class FWMarkDown
    paramtype 1 var lEscapeHTMLAttribute as logical optional default ::lEscapeHTMLAttribute
    ::lEscapeHTMLAttribute:=lEscapeHTMLAttribute
return(self)

// ------------------------------------------------------
method Header(cText,nLevel) class FWMarkDown
    paramtype 1 var cText as character optional default ""
    paramtype 2 var nLevel as numeric optional default 1
    ::cOutput:=Replicate("#",nLevel)+" "+cText
    ::cOutput+=::cCRLF+::cCRLF
    if (::lBufferEnabled)
        ::cBuffer+=::cOutput
    endif
return(self)

// ------------------------------------------------------
method Paragraph(cText) class FWMarkDown
    paramtype 1 var cText as character optional default ""
    ::cOutput:=cText+::cCRLF+::cCRLF
    if (::lBufferEnabled)
        ::cBuffer+=::cOutput
    endif
return(self)

// ------------------------------------------------------
// Lista com suporte a multiplos niveis e ordenada/nao ordenada
method ListItem(cText,nLevel,lOrdered) class FWMarkDown
    local cIndent as character
    paramtype 1 var cText as character optional default ""
    paramtype 2 var nLevel as numeric optional default 1
    paramtype 3 var lOrdered as logical optional default .F.
    cIndent:=Space((nLevel-1)*3)
    if (lOrdered)
        ::cOutput:=cIndent+"1. "+cText+::cCRLF
    else
        ::cOutput:=cIndent+"- "+cText+::cCRLF
    endif
    if (::lBufferEnabled)
        ::cBuffer+=::cOutput
    endif
return(self)

// ------------------------------------------------------
method ListItemTask(cText,lChecked,nLevel) class FWMarkDown
    local cIndent as character
    local cCheck as character
    paramtype 1 var cText as character optional default ""
    paramtype 2 var lChecked as logical optional default .F.
    paramtype 3 var nLevel as numeric optional default 1
    cIndent:=Space((nLevel-1)*3)
    cCheck:=iif(lChecked,"[x]","[ ]")
    ::cOutput:=cIndent+"- "+cCheck+" "+cText+::cCRLF
    if (::lBufferEnabled)
        ::cBuffer+=::cOutput
    endif
return(self)

// ------------------------------------------------------
method Bold(cText) class FWMarkDown
    paramtype 1 var cText as character optional default ""
    ::cOutput:="**"+cText+"**"
return(::cOutput)

// ------------------------------------------------------
method Italic(cText) class FWMarkDown
    paramtype 1 var cText as character optional default ""
    ::cOutput:="*"+cText+"*"
return(::cOutput)

// ------------------------------------------------------
method Strike(cText) class FWMarkDown
    paramtype 1 var cText as character optional default ""
    ::cOutput:="~~"+cText+"~~"
return(::cOutput)

// ------------------------------------------------------
method Highlight(cText) class FWMarkDown
    paramtype 1 var cText as character optional default ""
    ::cOutput:="=="+cText+"=="
return(::cOutput)

// ------------------------------------------------------
method Subscript(cText) class FWMarkDown
    paramtype 1 var cText as character optional default ""
    ::cOutput:="~"+cText+"~"
return(::cOutput)

// ------------------------------------------------------
method SuperScript(cText) class FWMarkDown
    paramtype 1 var cText as character optional default ""
    ::cOutput:="^"+cText+"^"
return(::cOutput)

// ------------------------------------------------------
method Link(cText,cUrl) class FWMarkDown
    paramtype 1 var cText as character optional default ""
    paramtype 2 var cUrl as character optional default ""
    ::cOutput:="["+cText+"]("+cUrl+")"
return(::cOutput)

// ------------------------------------------------------
method Image(cAlt,cURL,nWidth,nHeight,cClass) class FWMarkdown

    local cOutput:="" as character

    paramtype 1 var cAlt as character
    paramtype 2 var cURL as character
    paramtype 3 var nWidth as numeric optional
    paramtype 4 var nHeight as numeric optional
    paramtype 5 var cClass as character optional

    //Use HTML <img> tag if width, height, or class is provided
    if ((ValType(nWidth)=="N").or.(ValType(nHeight)=="N").or.(!Empty(cClass)))
        cOutput:='<img src="'+cURL+'" alt="'+cAlt+'"'
        if (ValType(nWidth)=="N")
            cOutput+=' width="'+cValToChar(nWidth)+'"'
        endif
        if (ValType(nHeight)=="N")
            cOutput+=' height="'+cValToChar(nHeight)+'"'
        endif
        if (!Empty(cClass))
            cOutput+=' class="'+cClass+'"'
        endif
        cOutput+='>'
    else
        cOutput:="!["+cAlt+"]("+cURL+")"
    endif

    if (::lEscapeHTMLAttribute)
        ::cOutput:=WebExHelper():EscapeHTMLAttribute(cOutput)
    else
        ::cOutput:=cOutput
    endif

return(::cOutput)

// ------------------------------------------------------
method VideoEmbed(cUrl,nWidth,nHeight) class FWMarkDown

    local cId as character
    local cEmbedUrl as character

    paramtype 1 var cUrl as character optional default ""
    paramtype 2 var nWidth as numeric optional default 560
    paramtype 3 var nHeight as numeric optional default 315

    cEmbedUrl:=cUrl

    if ("youtube.com/watch?v="$Lower(cUrl))
        cId:=SubStr(cUrl,AT("v=",cUrl)+2)
        if (AT("&",cId)>0)
            cId:=SubStr(cId,1,AT("&",cId)-1)
        endif
        cEmbedUrl:="https://www.youtube.com/embed/"+cId
    endif

    // Embed em HTML
    ::cOutput:=;
        '<iframe width="'+cValToChar(nWidth)+;
        '" height="'+cValToChar(nHeight)+;
        '" src="'+cEmbedUrl+;
        '" frameborder="0" allowfullscreen></iframe>'

    if (::lEscapeHTMLAttribute)
        ::cOutput:=WebExHelper():EscapeHTMLAttribute(::cOutput)
    endif

    ::cOutput+=::cCRLF
    ::cOutput+=::cCRLF

    // Fallback em Markdown
    ::cOutput+="[Open video in Web browser]("+cUrl+")"+::cCRLF

    ::cOutput+=::cCRLF

    if (::lBufferEnabled)
        ::cBuffer+=::cOutput
    endif

return(self)

// ------------------------------------------------------
method Code(cText) class FWMarkDown
    paramtype 1 var cText as character optional default ""
    ::cOutput:="`"+cText+"`"
return(::cOutput)

// ------------------------------------------------------
method Comment(cText,lHTML) class FWMarkDown

    paramtype 1 var cText as character optional default ""
    paramtype 2 var lHTML as logical optional default .F.

    if (lHTML)
        ::cOutput:="<!--"+::cCRLF
        ::cOutput+=cText+::cCRLF
        ::cOutput+="-->"+::cCRLF
    else
        ::cOutput:="[//]: # ("+cText+")"+::cCRLF
    endif

    ::cOutput+=::cCRLF

    if (::lBufferEnabled)
        ::cBuffer+=::cOutput
    endif

return(self)

// ------------------------------------------------------
method CodeBlock(cText,cLang) class FWMarkDown
    paramtype 1 var cText as character optional default ""
    paramtype 2 var cLang as character optional default ""
    ::cOutput:="```"+cLang+::cCRLF
    ::cOutput+=cText+::cCRLF
    ::cOutput+="```"+::cCRLF
    ::cOutput+=::cCRLF
    if (::lBufferEnabled)
        ::cBuffer+=::cOutput
    endif
return(self)

// ------------------------------------------------------
method Quote(cText,nLevel) class FWMarkDown
    local aLines as array
    local cPrefix as character
    local i as numeric
    paramtype 1 var cText as character optional default ""
    paramtype 2 var nLevel as numeric optional default 1
    cPrefix:=Replicate("> ",nLevel)
    aLines:=StrTokArr2(cText,::cCRLF,.T.)
    ::cOutput:=""
    for i:=1 to Len(aLines)
        ::cOutput+=cPrefix+aLines[i]+::cCRLF
    next
    ::cOutput+=::cCRLF
    if (::lBufferEnabled)
        ::cBuffer+=::cOutput
    endif
return(self)

// ------------------------------------------------------
method Table(aHeader,aRows,aAlign) class FWMarkDown

    local cSep

    local i as numeric
    local j as numeric
    local nCols as numeric

    paramtype 1 var aHeader as array optional default {}
    paramtype 2 var aRows as array optional default {}
    paramtype 3 var aAlign as array optional default Array(Len(aHeader),"left")

    nCols:=Len(aHeader)

    // Cabecalho
    ::cOutput:="|"
    for i:=1 to nCols
        ::cOutput+=" "+aHeader[i]+" |"
    next i
    ::cOutput+=::cCRLF

    // Linha de separador
    ::cOutput+="|"
    for i:=1 to nCols
        cSep:=Replicate("-",Max(Len(aHeader[i]),3))  // Minimo 3 para alinhamento
        do case
            case (aAlign[i]=="center")
                ::cOutput+=" :"+SubStr(cSep,2,Len(cSep)-2)+": |"
            case (aAlign[i]=="right")
                ::cOutput+=" "+SubStr(cSep,1,Len(cSep)-1)+": |"
            otherwise  // left or default
                ::cOutput+=" :"+SubStr(cSep,1,Len(cSep)-1)+" |"
        endcase
    next i
    ::cOutput+=::cCRLF

    // Linhas
    for i:=1 to Len( aRows )
        ::cOutput+="|"
        for j:=1 to nCols
            ::cOutput+=" "+aRows[i][j]+" |"
        next j
        ::cOutput+=::cCRLF
    next i

    ::cOutput+=::cCRLF

    if (::lBufferEnabled)
        ::cBuffer+=::cOutput
    endif

return(self)

// ------------------------------------------------------
method DefinitionList(cTerm,cDef) class FWMarkDown
    paramtype 1 var cTerm as character optional default ""
    paramtype 2 var cDef as character optional default ""
    ::cOutput:=cTerm+::cCRLF+": "+cDef+::cCRLF+::cCRLF
    if (::lBufferEnabled)
        ::cBuffer+=::cOutput
    endif
return(self)

// ------------------------------------------------------
method Rule() class FWMarkDown
    ::cOutput:="---"+::cCRLF
    ::cOutput+=::cCRLF
    if (::lBufferEnabled)
        ::cBuffer+=::cOutput
    endif
return(self)

// ------------------------------------------------------
method FootNoteRef(cId) class FWMarkDown
    paramtype 1 var cId as character optional default ""
    ::cOutput:="[^"+cId+"]"
return(::cOutput)

// ------------------------------------------------------
method FootNoteDef(cId,cText) class FWMarkDown
    paramtype 1 var cId as character optional default ""
    paramtype 2 var cText as character optional default ""
    aAdd(::aFootNotes,{cId,cText})
return(self)

// ------------------------------------------------------
method FrontMatter(jMeta) class FWMarkDown

    local aKeys as array

    local cKey as character

    local i as numeric

    paramtype 1 var jMeta as json

    aKeys:=jMeta:GetNames()
    ::cOutput:="---"+::cCRLF
    for i:=1 to Len(aKeys)
        cKey:=aKeys[i]
        ::cOutput+=cKey+": "+jMeta[cKey]+::cCRLF
    next i
    ::cOutput+="---"+::cCRLF
    ::cOutput+=::cCRLF

    if (::lBufferEnabled)
        ::cBuffer+=::cOutput
    endif

return(self)

// ------------------------------------------------------
method PageHeader(cHeaderText) class FWMarkDown

    local cHeader as character

    paramtype 1 var cHeaderText as character optional default ""

    ::EnableHeader(.T.)

    beginContent var cHeader
<div class="print-only header" style="position: fixed; top: 0; width: 100%; text-align: center;">__HEADER_TEXT__</div>
    endContent

    //Fix mixed EOL types
    cHeader:=WebExHelper():StrReplaceEx(cHeader,{{CRLF,CHR(13),CHR(10)},"__CRLF__"},{"__CRLF__",CRLF})
    cHeader:=WebExHelper():StrReplaceEx(cHeader,{"__HEADER_TEXT__",cHeaderText})
    if (::lEscapeHTMLAttribute)
        cHeader:=WebExHelper():EscapeHTMLAttribute(cHeader)
    endif

    ::Paragraph(cHeader)

return(self)

// ------------------------------------------------------
method PageFooter(cFooterText) class FWMarkDown

    local cFooter as character

    paramtype 1 var cFooterText as character optional default ""

    beginContent var cFooter
<div class="print-only footer" style="position: fixed; bottom: 0; width: 100%; text-align: center;">__FOOTER_TEXT__</div>
    endContent

    //Fix mixed EOL types
    cFooter:=WebExHelper():StrReplaceEx(cFooter,{{CRLF,CHR(13),CHR(10)},"__CRLF__"},{"__CRLF__",CRLF})
    cFooter:=WebExHelper():StrReplaceEx(cFooter,{"__FOOTER_TEXT__",cFooterText})
    if (::lEscapeHTMLAttribute)
        cFooter:=WebExHelper():EscapeHTMLAttribute(cFooter)
    endif

    ::Paragraph(cFooter)

return(self)

// ------------------------------------------------------
method PageBreak(cPageBreak,cStyle) class FWMarkDown
    if (Empty(cPageBreak))
        paramtype 1 var cPageBreak as character optional default '<div class="page-break" style="__STYLE__"></div>'
        if (Empty(cStyle))
            paramtype 2 var cStyle as character optional default "page-break-after: always;"
            cPageBreak:=WebExHelper():StrReplaceEx(cPageBreak,{"__STYLE__",cStyle})
        endif
    endif
    if (::lEscapeHTMLAttribute)
        ::cOutput:=WebExHelper():EscapeHTMLAttribute(cPageBreak)
    else
        ::cOutput:=cPageBreak
    endif
    // Fallback em Markdown
    //'<!-- pagebreak -->') Alguns parsers (ex.: Pandoc) reconhecem isso como quebra
    ::cOutput+=::cCRLF
    ::cOutput+="<!-- pagebreak -->"
    ::cOutput+=::cCRLF
    if (::lBufferEnabled)
        ::cBuffer+=::cOutput
    endif
    if (::lHasHeader)
        ::Paragraph("")
        ::Rule()
    endif
return(self)

// ------------------------------------------------------
method BuildOutPut() class FWMarkDown

    local i as numeric

    ::cOutput:=::cBuffer
    if (Len(::aFootNotes)>0)
        ::cOutput+=::cCRLF+"---"+::cCRLF  // Separador opcional
        for i:=1 to Len(::aFootNotes)
            ::cOutput+="[^"+::aFootNotes[i][1]+"]: "+::aFootNotes[i][2]+::cCRLF
        next i
    endif

    if (::lHasEmojis)
        ::cOutput:=WebExHelper():UpdEmojiHtmlCode(::cOutput)
    endif

    if (::lEncodeUTF8)
        ::cOutput:=EncodeUTF8(::cOutput)
    endif

return(::cOutput)

// ------------------------------------------------------
method Save(cFile) class FWMarkDown

    local cSPDrive as character
    local cSPPath as character
    local cSPFile as character
    local cSPExt as character
    local cDirMake as character

    local cOutput as character

    local lSaveOK as logical

    paramtype 1 var cFile as character

    SplitPath(cFile,@cSPDrive,@cSPPath,@cSPFile,@cSPExt)

    cDirMake:=cSPDrive
    cDirMake+=cSPPath

    lSaveOK:=lIsDir(cDirMake)
    if (!lSaveOK)
        lSaveOK:=FWMakeDir(cSPPath)
    endif

    cOutput:=::BuildOutPut()

    lSaveOK:=((lSaveOK).and.(MemoWrite(cFile,cOutput)))

return(lSaveOK)
