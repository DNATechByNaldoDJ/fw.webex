// EXEMPLO 1: Analise de Desempenho de Funcoes
function u_AnaliseDesempenhoFuncoes()
return(FWMsgRun(nil,{||AnaliseDesempenhoFuncoes()},ProcName(),"Processando..."))
static procedure AnaliseDesempenhoFuncoes()

    local aFuncoes:={} as array

    local i as numeric

    local oStopWatchAnalise:=StopWatch():New("ANALISE_FUNCOES") as object

    // Lista de funcoes para analisar
    aAdd(aFuncoes,{"CALCULO_IMPOSTOS",{||Sleep(1500)}})
    aAdd(aFuncoes,{"GERACAO_RELATORIO",{||Sleep(2300)}})
    aAdd(aFuncoes,{"PROCESSAMENTO_LOTES",{||Sleep(800)}})
    aAdd(aFuncoes,{"VALIDACAO_DADOS",{||Sleep(1200)}})

    oStopWatchAnalise:Start()

    for i:=1 to Len(aFuncoes)
        oStopWatchAnalise:StartInterval(aFuncoes[i][1]):StartInterval("Teste")
        Eval(aFuncoes[i][2])
        oStopWatchAnalise:StopInterval(aFuncoes[i][1])
        // Log intermediario
        ConOut("Funcao "+aFuncoes[i][1]+" concluida: "+tlpp.ToStr(oStopWatchAnalise:GetIntervalElapsed(aFuncoes[i][1]))+"s")
    next i

    oStopWatchAnalise:Stop()

    // Relatorio comparativo
    ConOut("",oStopWatchAnalise:PrintReport(),"")

    // Analise estatistica
    ConOut("STATISTICAL ANALYSIS:")
    ConOut("Faster function: "+__GetFasterProcess(oStopWatchAnalise))
    ConOut("Slower function: "+__GetSlowerProcess(oStopWatchAnalise))
    ConOut("Average time per function: "+tlpp.ToStr(oStopWatchAnalise:GetTotalElapsedSeconds()/Len(aFuncoes))+"s")

    FreeObj(@oStopWatchAnalise)
    FWFreeArray(@aFuncoes)

return

static function __GetFasterProcess(oStopWatch)

    local aIntervals:=oStopWatch:GetIntervals() as array

    local cMaisRapida:="" as character

    local i as numeric
    local nMenorTempo:=999999999999999 as numeric

    for i:=1 to Len(aIntervals)
        if (aIntervals[i]:GetTotalElapsedSeconds() < nMenorTempo)
            nMenorTempo:=aIntervals[i]:GetTotalElapsedSeconds()
            cMaisRapida:=aIntervals[i]:GetName()
        endif
    next i

    FWFreeArray(@aIntervals)

return cMaisRapida+" ("+tlpp.ToStr(nMenorTempo)+"s)"

static function __GetSlowerProcess(oStopWatch)
    local aIntervals:=oStopWatch:GetIntervals() as array
    local cMaisLenta:="" as character
    local nMaiorTempo:=0 as numeric
    local i as numeric

    for i:=1 to Len(aIntervals)
        if (aIntervals[i]:GetTotalElapsedSeconds() > nMaiorTempo)
            nMaiorTempo:=aIntervals[i]:GetTotalElapsedSeconds()
            cMaisLenta:=aIntervals[i]:GetName()
        endif
    next i

return cMaisLenta+" ("+tlpp.ToStr(nMaiorTempo)+"s)"

// EXEMPLO 2: Processo Batch com Checkpoints
function u_ProcessoStopWatchBatchComCheckpoints()
return(FWMsgRun(nil,{||ProcessoStopWatchBatchComCheckpoints()},ProcName(),"Processando..."))
static procedure ProcessoStopWatchBatchComCheckpoints()

    local aIntervalos as array
    local oStopWatchBatch:=StopWatch():New("PROCESSO_BATCH") as object
    local i
    local nTotalRegistros:=1000 as numeric
    local nRegistroAtual:=0 as numeric
    local nLote:=100 as numeric

    oStopWatchBatch:Start()

    while nRegistroAtual < nTotalRegistros
        oStopWatchBatch:StartInterval("LOTE_"+StrZero(Int(nRegistroAtual/nLote)+1,3))

        // Simula processamento de lote
        Sleep(300)

        nRegistroAtual+=nLote
        if (nRegistroAtual > nTotalRegistros)
            nRegistroAtual:=nTotalRegistros
        endif

        oStopWatchBatch:StopInterval("LOTE_"+StrZero(Int((nRegistroAtual-1)/nLote)+1,3))

        // Checkpoint a cada 300 registros
        if (Mod(nRegistroAtual,300)==0)
            ConOut("Checkpoint: "+tlpp.ToStr(nRegistroAtual)+"/"+tlpp.ToStr(nTotalRegistros)+;
                   " registros processados")
            ConOut("Tempo parcial: "+oStopWatchBatch:GetFormattedElapsed())
        endif
    enddo

    oStopWatchBatch:Stop()

    // Relatorio final
    ConOut("PROCESSO BATCH FINALIZADO")
    ConOut("Total de registros: "+tlpp.ToStr(nTotalRegistros))
    ConOut("Tempo total: "+oStopWatchBatch:GetFormattedElapsed())
    ConOut("Taxa media: "+;
           tlpp.ToStr(nTotalRegistros/oStopWatchBatch:GetTotalElapsedSeconds())+" regs/segundo")

    // Detalhamento por lote
    aIntervalos:=oStopWatchBatch:GetIntervals()
    ConOut("Detalhamento por lote:")
    for i:=1 to Len(aIntervalos)
        ConOut("  "+aIntervalos[i]:GetName()+": "+aIntervalos[i]:GetFormattedElapsed())
    next i

    FWFreeArray(@aIntervalos)

    FreeObj(@oStopWatchBatch)
return

// EXEMPLO 3: Monitoramento de API com Timeouts
function u_MonitoramentoAPI()
return(FWMsgRun(nil,{||MonitoramentoAPI()},ProcName(),"Processando..."))
static procedure MonitoramentoAPI()

    local oStopWatchMonitorAPI:=StopWatch():New("MONITORAMENTO_API") as object
    local aEndpoints:={} as array
    local i as numeric
    local nTimeResposta
    local cJSON as character

    // Endpoints para monitorar
    aAdd(aEndpoints,{"API_LOGIN","https://api.exemplo.com/login"})
    aAdd(aEndpoints,{"API_CLIENTES","https://api.exemplo.com/clientes"})
    aAdd(aEndpoints,{"API_PRODUTOS","https://api.exemplo.com/produtos"})
    aAdd(aEndpoints,{"API_PEDIDOS","https://api.exemplo.com/pedidos"})

    oStopWatchMonitorAPI:Start()

    for i:=1 to Len(aEndpoints)
        oStopWatchMonitorAPI:StartInterval(aEndpoints[i][1])
        // Simula chamada HTTP (em producao seria HTTPGet ou similar)
        nTimeResposta:=Randomize(500,3000) // 0.5 a 3 seconds
        Sleep(nTimeResposta)
        // Verifica timeout
        if (oStopWatchMonitorAPI:GetIntervalElapsed(aEndpoints[i][1]) > 2000) // 2 seconds
            ConOut("ALERTA: Timeout em "+aEndpoints[i][1]+" - "+;
                   aEndpoints[i][2])
        endif
        oStopWatchMonitorAPI:StopInterval(aEndpoints[i][1])
    next i

    oStopWatchMonitorAPI:Stop()

    // Relatorio de saúde da API
    ConOut("RELATORIO DE SAUDE DA API")
    ConOut("Tempo total de monitoramento: "+oStopWatchMonitorAPI:GetFormattedElapsed())

    cStatistics:=oStopWatchMonitorAPI:PrintStatistics()
    ConOut(cStatistics)

    // Exporta para JSON para dashboard
    cJSON:=oStopWatchMonitorAPI:ToJSON()
    ConOut(cJSON)
    MemoWrite("api_monitor_"+DToS(Date())+".json",cJSON)

    FreeObj(@oStopWatchMonitorAPI)
    FWFreeArray(@aEndpoints)

return nil

static function __CalculateStatistics(oStopWatch) as array

    local aIntervals:=oStopWatch:GetIntervals() as array

    local cSlower:="" as character
    local cFast:="" as character

    local i as numeric
    local nTime as numeric
    local nAverage as numeric
    local nTimeouts:=0 as numeric
    local nMoreSlower:=0 as numeric
    local nSumOfTimes:=0 as numeric
    local nMoreFast:=999999999999999 as numeric
    local nSuccessRate as numeric

    for i:=1 to Len(aIntervals)

        nTime:=aIntervals[i]:GetTotalElapsedMilliSeconds()
        nSumOfTimes+=nTime

        if (nTime<nMoreFast)
            nMoreFast:=nTime
            cFast:=aIntervals[i]:GetName()
        endif

        if (nTime>nMoreSlower)
            nMoreSlower:=nTime
            cSlower:=aIntervals[i]:GetName()
        endif

        if (nTime>2000) // Considera timeout acima de 2 seconds
            nTimeouts++
        endif

    next i

    nAverage:=if(Len(aIntervals)>0,nSumOfTimes/Len(aIntervals),0)
    nSuccessRate:=if(Len(aIntervals)>0,;
                          ((Len(aIntervals)-nTimeouts)/Len(aIntervals))*100,100)

return({nAverage,cFast,cSlower,nSuccessRate})

// EXEMPLO 4: Sistema com Hierarquia Profunda
function u_SistemaHierarquico()
return(FWMsgRun(nil,{||SistemaHierarquico()},ProcName(),"Processando..."))
static function SistemaHierarquico()

    local oStopWatch:=StopWatch():New("SISTEMA_INTEGRADO") as object

    oStopWatch:Start()

    // Modulo 1: Autenticacao
    oStopWatch:StartInterval("MODULO_AUTENTICACAO")

    oStopWatch:StartInterval("SUB_VALIDACAO_USUARIO")
    Sleep(400)
    oStopWatch:StopInterval("SUB_VALIDACAO_USUARIO")

    oStopWatch:StartInterval("SUB_VERIFICACAO_PERMISSOES")
    Sleep(300)
    oStopWatch:StopInterval("SUB_VERIFICACAO_PERMISSOES")

    oStopWatch:StopInterval("MODULO_AUTENTICACAO")

    // Modulo 2: Processamento de Dados
    oStopWatch:StartInterval("MODULO_PROCESSAMENTO")

    oStopWatch:StartInterval("SUB_LEITURA_BANCO")
    Sleep(1200)
    oStopWatch:StopInterval("SUB_LEITURA_BANCO")

    oStopWatch:StartInterval("SUB_TRANSFORMACAO_DADOS")
    Sleep(1800)
    oStopWatch:StopInterval("SUB_TRANSFORMACAO_DADOS")

    oStopWatch:StartInterval("SUB_VALIDACAO_REGRA_NEGOCIO")
    Sleep(900)
    oStopWatch:StopInterval("SUB_VALIDACAO_REGRA_NEGOCIO")

    oStopWatch:StopInterval("MODULO_PROCESSAMENTO")

    // Modulo 3: Geracao de Saida
    oStopWatch:StartInterval("MODULO_SAIDA"):StartInterval("MODULO_SAIDA_HIERARQUIA")
        Sleep(600)
    oStopWatch:GetInterval("MODULO_SAIDA"):StopInterval("MODULO_SAIDA_HIERARQUIA")

    oStopWatch:StartInterval("SUB_GERACAO_RELATORIO")
    Sleep(1500)
    oStopWatch:StopInterval("SUB_GERACAO_RELATORIO")

    oStopWatch:StartInterval("SUB_ENVIO_EMAIL")
    Sleep(600)
    oStopWatch:StopInterval("SUB_ENVIO_EMAIL")

    oStopWatch:StopInterval("MODULO_SAIDA")

    oStopWatch:Stop()

    // Gera relatorio hierarquico completo
    __ImprimeHierarquia(oStopWatch,0)

    FreeObj(@oStopWatch)

return nil

static procedure __ImprimeHierarquia(oStopWatch,nLevel)
    ConOut(oStopWatch:PrintHierarchy(nLevel))
return
