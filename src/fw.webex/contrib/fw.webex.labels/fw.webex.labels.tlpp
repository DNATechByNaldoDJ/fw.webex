  <aside class="fwwebex-label-pane fwwebex-label-inspector">
    <div class="fwwebex-label-panel-head"><span>Inspetor</span><span data-role="selection-count">0 selecionados</span></div>
    <div class="fwwebex-label-panel-body" data-role="inspector">
      <div class="fwwebex-label-tablist" role="tablist" aria-label="Categorias do inspetor">
        <button type="button" role="tab" data-tab-group="inspector" data-tab-target="element"
          aria-selected="true" tabindex="0">Elemento</button>
        <button type="button" role="tab" data-tab-group="inspector" data-tab-target="geometry"
