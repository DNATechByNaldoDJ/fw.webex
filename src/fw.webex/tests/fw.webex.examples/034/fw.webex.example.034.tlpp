/*
  FWWebEx example 034 - SVG labels and consolidated PDF through CpyF2Web

  Released to Public Domain.
--------------------------------------------------------------------------------------
*/

#include "fw.webex.th"

using namespace FWWebEx
using namespace FWWebEx.Tools

procedure u_FWWebExExample_034()
    local bExecute as codeblock
    local bHTMLGet as codeblock
    local bJSToAdvPL as codeblock
    local cHTML as character
    local cHTMLFile as character
    local cSVGFile as character
    local cProcName:=ProcName() as character
    local oTWebChannel as object
    bHTMLGet:={||cHTMLFile:=FWWebExExample_034(@cHTML,@cSVGFile)}
    bExecute:={||FWMsgRun(nil,bHTMLGet,"Aguarde",cProcName)}
    FWExampleTools():Execute(bExecute,cProcName,.F.,.F.)
    if (!Empty(cHTMLFile).and.File(cHTMLFile))
        oTWebChannel:=WebApp():GetTWebChannel()
        bJSToAdvPL:={|oChannel as object,cType as character,cContent as character|FWWebEx034Callback(oChannel,cType,cContent)}
        FWExampleTools():HtmlFileShow(cHTML,cProcName,cHTMLFile,oTWebChannel,bJSToAdvPL)
        fErase(cHTMLFile)
    endif
    if (!Empty(cSVGFile).and.File(cSVGFile))
        fErase(cSVGFile)
    endif
    WebFileTools():ObliterateFWWebExTmpFiles(.T.)
return

static function FWWebExExample_034(cHTML as character,cSVGFile as character) as character

    local cHTMLFile:=ProcName() as character
    local cSVGWeb:="" as character
    local cTemplateURL:="" as character
    local cScript:="" as character
    local cAppScript:="" as character
    local cBarcodeJS:=GetApoRes("JsBarCode.all.min.js") as character
    local cCanvasJS:=GetApoRes("html2canvas.min.js") as character
    local cPDFJS:=GetApoRes("jspdf.umd.min.js") as character
    local oFWWebExPage as object

    if (Empty(cBarcodeJS).or.Empty(cCanvasJS).or.Empty(cPDFJS))
        MsgStop("Recursos JsBarcode, html2canvas ou jsPDF nao encontrados no RPO.",ProcName())
        return("")
    endif

    FWMakeDir(FWWEBEX_WEB_TMP_PATH,.F.)

    cSVGFile:=FWWEBEX_WEB_TMP_PATH+"fwwebex-example-034-template.svg"

    if (!MemoWrite(cSVGFile,FWWebEx034Template()))
        return("")
    endif

    cSVGWeb:=CpyF2Web(cSVGFile,.F.,.F.,.F.,.F.)
    cTemplateURL:=WebFileTools():CpyF2WebRelativeURL(cSVGWeb)

    if (Empty(cTemplateURL))
        return("")
    endif

    BeginContent var cAppScript
(function(){
    const templateURL='__TEMPLATE_URL__';
    const labels=[
        {product:'PA000001 · PRODUTO DEMONSTRATIVO',batch:'L240001',manufacture:'01/09/2026',expiration:'01/09/2028',weight:'20,000 KG',volume:'20 KG',species:'BOMBONA',gtin:'7891234567895'},
        {product:'PA000002 · PRODUTO PARA LIMPEZA PROFUNDA',batch:'L240002',manufacture:'02/09/2026',expiration:'02/09/2028',weight:'5,000 KG',volume:'5 LITROS',species:'FRASCO PARA EXTREMA LIMPEZA',gtin:'12345678901231'},
        {product:'',batch:'L240003',manufacture:'03/09/2026',expiration:'03/09/2028',weight:'1,000 KG',volume:'',species:'CAIXA',gtin:''}
    ];
    let running=false;
    const status=text=>document.getElementById('fwwebex-example-034-status').textContent=text;
    const paint=()=>new Promise(resolve=>requestAnimationFrame(()=>requestAnimationFrame(resolve)));

    function setText(root,id,value){
        const element=root.querySelector('#'+id);
        if(!element)return false;
        value=String(value==null?'':value);
        element.textContent=value;
        const visible=value.trim()!=='';
        element.style.display=visible?'':'none';
        const label=root.querySelector('[data-label-for="'+id+'"]');
        if(label)label.style.display=visible?'':'none';
        return visible;
    }
    /* Layout SVG independente do hospedeiro; as consultas ficam restritas a root.
     * rasterFontFactor preserva o fator historico do sistema de origem (4/3).
     * Nao e a conversao CSS px->pt. Templates sem data-font-unit usam unidades SVG.
     */
    function createSVGLabelLayout(root, templateName, rasterFontFactor = 4 / 3) {
        if (!root || String(root.tagName).toLowerCase() !== 'svg') {
            throw new Error('Template SVG [' + templateName + ']: elemento raiz <svg> nao encontrado.');
        }
        if (!Number.isFinite(rasterFontFactor) || rasterFontFactor <= 0) {
            throw new Error('Template SVG [' + templateName + ']: fator historico de fonte deve ser positivo e finito.');
        }
        const document = root.ownerDocument;
        const getComputedStyle = document.defaultView.getComputedStyle.bind(document.defaultView);
        const findById = id => root.querySelector('[id="' + id + '"]');
        function svgConfigNumber(element, name, optionalValue) {
            const raw = element.getAttribute(name);
            if (raw === null && optionalValue !== undefined) {
                return optionalValue;
            }
            if (raw === null || !/^(?:\d+(?:\.\d*)?|\.\d+)$/.test(raw.trim())) {
                throw new Error('#' + (element.id || element.tagName) + ': ' + name +
                    '=' + JSON.stringify(raw) + '. Informe um numero sem unidade, com ponto decimal (ex.: 7.25); nao use px, pt ou virgula.');
            }
            const value = Number(raw);
            if (!Number.isFinite(value)) {
                throw new Error('#' + element.id + ': ' + name + '=' + JSON.stringify(raw) + ' deve ser finito.');
            }
            return value;
        }

        function svgLocalUnitsPerMM(element) {
            const physicalHeight = parseFloat(root.getAttribute('height'));
            const viewHeight = root.viewBox.baseVal.height;
            const rootMatrix = root.getScreenCTM();
            const matrix = rootMatrix && element.getScreenCTM();
            const relative = matrix && rootMatrix.inverse().multiply(matrix);
            const scaleY = relative && Math.hypot(relative.c, relative.d);
            if (!/mm\s*$/.test(root.getAttribute('height') || '') ||
                !(physicalHeight > 0) || !(viewHeight > 0) || !(scaleY > 0)) {
                throw new Error('#' + element.id + ': fontes pt/raster e gap em mm exigem height="...mm", viewBox valido e transform sem escala zero.');
            }
            return viewHeight / physicalHeight / scaleY;
        }

        function svgFitConfig(element) {
            const width = svgConfigNumber(element, 'data-fit-width');
            const height = svgConfigNumber(element, 'data-fit-height');
            let minimum = svgConfigNumber(element, 'data-min-font-size');
            let maximum = svgConfigNumber(element, 'data-max-font-size');
            let unit = element.getAttribute('data-font-unit') || 'svg';
            const scaleX = svgConfigNumber(element, 'data-font-scale-x', 1);
            if (!(width > 0 && height > 0 && minimum > 0 && maximum >= minimum && scaleX > 0)) {
                throw new Error('#' + element.id + ': data-fit-width=' + width +
                    ', data-fit-height=' + height + ', data-min-font-size=' + minimum +
                    ', data-max-font-size=' + maximum + ', data-font-scale-x=' + scaleX +
                    '. Largura, altura, minimo e escala devem ser maiores que zero; o maximo deve ser maior ou igual ao minimo.');
            }
            if (['svg', 'pt', 'raster'].indexOf(unit) < 0) {
                throw new Error('#' + element.id + ': data-font-unit="' + unit + '" invalido. Use svg, pt ou raster.');
            }
            // A especie isolada pode usar a faixa do volume, como no fluxo raster.
            const group = element.parentElement;
            const volume = findById('volume');
            if (element.id === 'species' && group &&
                group.getAttribute('data-species-use-volume-font') === 'true' &&
                volume && volume.parentElement === group && !volume.textContent.trim()) {
                const volumeConfig = svgFitConfig(volume);
                return {width, height, minimum: volumeConfig.minimum, maximum: volumeConfig.maximum, scaleX};
            }
            const factor = unit === 'svg' ? 1 :
                (unit === 'raster' ? rasterFontFactor : 1) * 25.4 / 72 * svgLocalUnitsPerMM(element);
            return {width, height, minimum: minimum * factor, maximum: maximum * factor, scaleX};
        }

        function svgApplyFont(element, size, config) {
            element.style.fontSize = size.toFixed(4) + 'px';
            if (element.hasAttribute('data-font-scale-x')) {
                element.removeAttribute('textLength');
                element.removeAttribute('lengthAdjust');
                const length = element.getComputedTextLength();
                if (length > 0 && config.scaleX !== 1) {
                    element.setAttribute('textLength', (length * config.scaleX).toFixed(6));
                    element.setAttribute('lengthAdjust', 'spacingAndGlyphs');
                }
            }
            element.setAttribute('data-applied-font-size', size.toFixed(4));
            if (size < config.minimum - 0.0001) {
                element.setAttribute('data-fit-below-min', 'true');
            } else {
                element.removeAttribute('data-fit-below-min');
            }
        }

        function fitSVGText(element) {
            const config = svgFitConfig(element);
            if (element.style.display === 'none' || !element.textContent.trim()) {
                return;
            }
            let low = config.minimum;
            let high = config.maximum;
            let best = low;
            svgApplyFont(element, high, config);
            let bounds = element.getBBox();
            if (bounds.width <= config.width && bounds.height <= config.height) {
                best = high;
            } else {
                for (let attempt = 0; attempt < 20; attempt++) {
                    const candidate = (low + high) / 2;
                    svgApplyFont(element, candidate, config);
                    bounds = element.getBBox();
                    if (bounds.width <= config.width && bounds.height <= config.height) {
                        best = candidate;
                        low = candidate;
                    } else {
                        high = candidate;
                    }
                }
            }
            // Arredondar para baixo evita ultrapassar a caixa no ultimo decimal.
            best = Math.floor(best * 10000) / 10000;
            for (let attempt = 0; attempt < 12; attempt++) {
                svgApplyFont(element, best, config);
                bounds = element.getBBox();
                if (bounds.width <= config.width + 0.0001 && bounds.height <= config.height + 0.0001) {
                    return;
                }
                best *= Math.min(config.width / bounds.width, config.height / bounds.height) * 0.98;
            }
            throw new Error('#' + element.id + ': texto nao cabe em data-fit-width=' + config.width +
                ' e data-fit-height=' + config.height + '. Amplie a caixa ou reduza o conteudo.');
        }

        function svgGroupGuide(group) {
            return Array.prototype.find.call(group.children, function(child) {
                return String(child.tagName).toLowerCase() === 'rect';
            });
        }

        function svgVolumeLayoutConfig(group) {
            const gapMM = svgConfigNumber(group, 'data-volume-gap');
            const align = group.getAttribute('data-volume-align') || 'center';
            const guide = svgGroupGuide(group);
            if (!guide || !(Number(guide.getAttribute('width')) > 0) || !(Number(guide.getAttribute('height')) > 0)) {
                throw new Error('#volume-species: inclua um rect filho direto com width e height maiores que zero para limitar o bloco.');
            }
            if (['start', 'center', 'end'].indexOf(align) < 0) {
                throw new Error('#volume-species: data-volume-align="' + align + '" invalido. Use start, center ou end.');
            }
            const gap = gapMM * svgLocalUnitsPerMM(group);
            if (gap >= Number(guide.getAttribute('height'))) {
                throw new Error('#volume-species: data-volume-gap=' + gapMM + ' mm ocupa toda a altura da caixa. Reduza o gap ou aumente height do rect.');
            }
            return {gap, align, guide};
        }

        /* Mede a tinta dos glifos para manter o vao visual mesmo quando a fonte muda.
         * getBBox continua limitando a caixa inteira, inclusive ascendentes/descendentes.
         * A medicao ampliada evita arredondamento das fontes pequenas pelo Chromium. */
        function svgInkBounds(element) {
            const box = element.getBBox();
            const css = getComputedStyle(element);
            const context = document.createElement('canvas').getContext('2d');
            if (context && ['auto', 'alphabetic'].indexOf(css.dominantBaseline) >= 0) {
                context.font = css.fontStyle + ' ' + css.fontWeight + ' 1024px ' + css.fontFamily;
                const metrics = context.measureText(element.textContent);
                if (Number.isFinite(metrics.actualBoundingBoxAscent) && Number.isFinite(metrics.actualBoundingBoxDescent)) {
                    const factor = parseFloat(css.fontSize) / 1024;
                    const top = Number(element.getAttribute('y')) - metrics.actualBoundingBoxAscent * factor;
                    return {y: top, height: (metrics.actualBoundingBoxAscent + metrics.actualBoundingBoxDescent) * factor};
                }
            }
            return {y: box.y, height: box.height};
        }

        function layoutSVGVolumeSpecies() {
            const group = findById('volume-species');
            if (!group || !group.hasAttribute('data-volume-gap')) {
                return; // Templates antigos preservam suas coordenadas.
            }
            const config = svgVolumeLayoutConfig(group);
            const guide = config.guide.getBBox();
            const elements = ['volume', 'species'].map(function(id) {
                return findById(id);
            }).filter(function(element) {
                return element && element.style.display !== 'none' && element.textContent.trim();
            });
            if (!elements.length) {
                return;
            }
            elements.forEach(function(element) {
                if (element.parentElement !== group || element.hasAttribute('transform') ||
                    !element.hasAttribute('x') || !element.hasAttribute('y') ||
                    !Number.isFinite(Number(element.getAttribute('x'))) ||
                    !Number.isFinite(Number(element.getAttribute('y')))) {
                    throw new Error('#' + element.id + ': para usar data-volume-gap, mantenha o text diretamente em #volume-species, com x/y numericos e transform somente no grupo. Recebido x=' + JSON.stringify(element.getAttribute('x')) + ', y=' + JSON.stringify(element.getAttribute('y')));
                }
                if (!element.hasAttribute('data-runtime-original-x')) {
                    element.setAttribute('data-runtime-original-x', element.getAttribute('x'));
                }
                element.setAttribute('x', element.getAttribute('data-runtime-original-x'));
            });
            for (let attempt = 0; attempt < 16; attempt++) {
                let cursor = 0;
                elements.forEach(function(element, index) {
                    const ink = svgInkBounds(element);
                    element.setAttribute('y', String(Number(element.getAttribute('y')) + cursor - ink.y));
                    cursor += ink.height + (index < elements.length - 1 ? config.gap : 0);
                });
                const boxes = elements.map(function(element) { return element.getBBox(); });
                const top = Math.min.apply(null, boxes.map(function(box) { return box.y; }));
                const bottom = Math.max.apply(null, boxes.map(function(box) { return box.y + box.height; }));
                const height = bottom - top;
                const width = Math.max.apply(null, boxes.map(function(box) { return box.width; }));
                if (height <= guide.height + 0.0001 && width <= guide.width + 0.0001) {
                    const factor = config.align === 'start' ? 0 : (config.align === 'end' ? 1 : 0.5);
                    const delta = guide.y + (guide.height - height) * factor - top;
                    elements.forEach(function(element, index) {
                        const box = boxes[index];
                        element.setAttribute('y', (Number(element.getAttribute('y')) + delta).toFixed(6));
                        const dx = Math.max(guide.x - box.x, Math.min(0, guide.x + guide.width - box.x - box.width));
                        element.setAttribute('x', (Number(element.getAttribute('x')) + dx).toFixed(6));
                    });
                    group.setAttribute('data-applied-volume-gap', elements.length > 1 ? group.getAttribute('data-volume-gap') : '0');
                    return;
                }
                // Encolhe o par sem reduzir o gap solicitado pelo cliente.
                const reservedGap = elements.length > 1 ? config.gap : 0;
                const scale = Math.min((guide.height - reservedGap) / (height - reservedGap), guide.width / width) * 0.98;
                elements.forEach(function(element) {
                    svgApplyFont(element, parseFloat(element.style.fontSize) * scale, svgFitConfig(element));
                });
            }
            throw new Error('#volume-species: Volume/Especie nao cabem no rect com data-volume-gap=' +
                group.getAttribute('data-volume-gap') + '. Amplie a caixa ou reduza o gap.');
        }

        function validateSVGFields() {
            const errors = [];
            ['volume', 'species', 'volume-species', 'product', 'batch', 'manufacture', 'expiration', 'weight', 'barcode'].forEach(function(id) {
                const count = root.querySelectorAll('[id="' + id + '"]').length;
                if (count > 1) {
                    errors.push('#' + id + ': ID duplicado (' + count + ' ocorrencias). Mantenha apenas um elemento com esse ID no template.');
                }
            });
            root.querySelectorAll('[data-fit-width], [data-fit-height], [data-min-font-size], [data-max-font-size]').forEach(function(element) {
                try { svgFitConfig(element); } catch (error) { errors.push(error.message); }
            });
            const group = findById('volume-species');
            if (group && group.hasAttribute('data-volume-gap')) {
                try { svgVolumeLayoutConfig(group); } catch (error) { errors.push(error.message); }
            }
            if (errors.length) {
                throw new Error('Template SVG [' + templateName + ']: ' + errors.length +
                    ' configuracao(oes) invalida(s).\n- ' + errors.join('\n- '));
            }
        }



        function clipSVGGroupToGuide(groupId) {
            const svgNamespace = 'http://www.w3.org/2000/svg';
            const group = findById(groupId);
            if (!group || !group.ownerSVGElement) {
                return;
            }

            let guide = null;
            Array.prototype.some.call(group.children, function(child) {
                if (String(child.tagName).toLowerCase() === 'rect') {
                    guide = child;
                    return true;
                }
                return false;
            });
            if (!guide) {
                return;
            }

            const root = group.ownerSVGElement;
            let defs = root.querySelector('defs');
            if (!defs) {
                defs = document.createElementNS(svgNamespace, 'defs');
                root.insertBefore(defs, root.firstChild);
            }

            const clipId = group.getAttribute('data-runtime-clip-id') ||
                ('web-label-clip-' + groupId + '-' + Math.random().toString(36).slice(2));
            group.setAttribute('data-runtime-clip-id', clipId);
            let clipPath = findById(clipId);
            if (!clipPath) {
                clipPath = document.createElementNS(svgNamespace, 'clipPath');
                clipPath.setAttribute('id', clipId);
                clipPath.setAttribute('clipPathUnits', 'userSpaceOnUse');
                defs.appendChild(clipPath);
            }

            while (clipPath.firstChild) {
                clipPath.removeChild(clipPath.firstChild);
            }

            const clipRect = document.createElementNS(svgNamespace, 'rect');
            ['x', 'y', 'width', 'height', 'rx', 'ry'].forEach(function(name) {
                const value = guide.getAttribute(name);
                if (value !== null) {
                    clipRect.setAttribute(name, value);
                }
            });
            clipPath.appendChild(clipRect);
            group.setAttribute('clip-path', 'url(#' + clipId + ')');
            group.setAttribute('data-runtime-clip', 'true');
        }

        return {
            async fit() {
                try {
                    validateSVGFields();
                    if (document.fonts && document.fonts.load) {
                        await Promise.all(Array.prototype.map.call(root.querySelectorAll('text'), function(element) {
                            const css = getComputedStyle(element);
                            return document.fonts.load(css.fontStyle + ' ' + css.fontWeight + ' 16px ' + css.fontFamily, element.textContent);
                        }));
                        await document.fonts.ready;
                    }
                    root.querySelectorAll('[data-fit-width]').forEach(fitSVGText);
                    layoutSVGVolumeSpecies();
                    clipSVGGroupToGuide('volume-species');
                    clipSVGGroupToGuide('data-container');
                } catch (error) {
                    const message = error && error.message ? error.message : String(error);
                    const prefix = 'Template SVG [' + templateName + ']';
                    throw new Error(message.indexOf(prefix) === 0 ? message : prefix + ': ' + message);
                }
            }
        };
    }
    function createBarcode(root,item){
        const element=root.querySelector('#barcode');
        if(!element){
            if(item.gtin)throw new Error('#barcode: GTIN='+JSON.stringify(item.gtin)+' informado, mas o elemento nao existe. Inclua um <svg id="barcode"> no template.');
            return;
        }
        if(!item.gtin){element.replaceChildren();return;}
        const geometry={};
        ['x','y','width','height','preserveAspectRatio'].forEach(name=>geometry[name]=element.getAttribute(name));
        JsBarcode(element,item.gtin,{format:item.gtin.length===13?'EAN13':'CODE128',displayValue:true,textAlign:'center',
            font:'Arial',fontSize:13,textMargin:1,margin:0,width:2,height:52,background:'transparent',lineColor:'#000'});
        const width=parseFloat(element.getAttribute('width')),height=parseFloat(element.getAttribute('height')),padding=2;
        if(!Number.isFinite(width)||!Number.isFinite(height)||width<=0||height<=0){
            throw new Error('#barcode: width='+JSON.stringify(element.getAttribute('width'))+', height='+JSON.stringify(element.getAttribute('height'))+'. As dimensoes geradas pelo JsBarcode devem ser positivas e finitas. Verifique o GTIN e a configuracao do codigo de barras.');
        }
        element.removeAttribute('width');element.removeAttribute('height');
        element.setAttribute('viewBox',[-padding,-padding,width+padding*2,height+padding*2].join(' '));
        Object.keys(geometry).forEach(name=>{if(geometry[name]!==null)element.setAttribute(name,geometry[name]);});
    }
    async function prepare(root,item){
        if(!root)throw new Error('Template SVG ['+templateURL+']: elemento raiz svg nao encontrado. Inclua uma raiz <svg> valida.');
        setText(root,'product',item.product);setText(root,'batch',item.batch);setText(root,'manufacture',item.manufacture);
        setText(root,'expiration',item.expiration);setText(root,'weight',item.weight);
        const volume=setText(root,'volume',item.volume),species=setText(root,'species',item.species);
        const group=root.querySelector('#volume-species');if(group)group.style.display=(volume||species)?'':'none';
        await createSVGLabelLayout(root,templateURL).fit();
        createBarcode(root,item);
    }
    async function generate(){
        if(running)return;
        running=true;
        const button=document.getElementById('fwwebex-example-034-generate');
        button.disabled=true;
        let activeIndex=-1;
        try{
            status('Carregando template SVG por '+templateURL+'...');
            const response=await fetch(templateURL,{credentials:'same-origin',cache:'no-store'});
            if(!response.ok)throw new Error('Template SVG: HTTP '+response.status);
            const template=await response.text();
            if(!/<svg[\s>]/i.test(template))throw new Error('Template SVG invalido.');
            const pdf=new jspdf.jsPDF({orientation:'landscape',unit:'mm',format:[130,115],compress:true,putOnlyUsedFonts:true});
            const stage=document.getElementById('fwwebex-example-034-stage');
            for(let index=0;index<labels.length;index++){
                activeIndex=index;
                status('Gerando rotulo '+(index+1)+' de '+labels.length+'...');await paint();
                stage.innerHTML=template;await prepare(stage.querySelector('svg'),labels[index]);
                if(document.fonts&&document.fonts.ready)await document.fonts.ready;await paint();
                const canvas=await html2canvas(stage,{backgroundColor:'#fff',scale:3,useCORS:false,allowTaint:false,
                    logging:false,width:stage.offsetWidth,height:stage.offsetHeight});
                if(index>0)pdf.addPage([130,115],'landscape');
                pdf.addImage(canvas.toDataURL('image/png'),'PNG',0,0,130,115);
                stage.replaceChildren();await paint();
            }
            const blob=pdf.output('blob');
            if(!blob||!blob.size)throw new Error('PDF consolidado vazio.');
            const url=URL.createObjectURL(blob),popup=window.open(url,'_blank');
            if(!popup){const link=document.createElement('a');link.href=url;link.download='fwwebex-example-034-labels.pdf';link.click();}
            setTimeout(()=>URL.revokeObjectURL(url),60000);
            status('PDF concluido: '+labels.length+' rotulos.');
            await FWWebEx.TWebChannel.send('FWWEBEX_EXAMPLE_034_DONE',String(labels.length));
        }catch(error){
            const context=activeIndex>=0?' Rotulo ['+(activeIndex+1)+'/'+labels.length+'], Produto=['+(labels[activeIndex].product||'(vazio)')+'].':'';
            const message='Falha ao gerar PDF consolidado de rotulos.'+context+' Template=['+templateURL+']: '+(error.message||String(error));
            status(message);
            await FWWebEx.TWebChannel.send('FWWEBEX_EXAMPLE_034_ERROR',message);
        }finally{
            running=false;button.disabled=false;
        }
    }
    function init(){document.getElementById('fwwebex-example-034-generate').addEventListener('click',generate);}
    if(document.readyState==='loading')document.addEventListener('DOMContentLoaded',init,{once:true});else init();
})();
    EndContent

    cAppScript:=StrTran(cAppScript,"__TEMPLATE_URL__",FWWebEx034JSEscape(cTemplateURL))

    cScript:=cBarcodeJS+CRLF+cCanvasJS+CRLF+cPDFJS+CRLF+cAppScript

    BEGIN FWWEBEX oFWWebExPage CLASS WebExPage ARGS "FWWebEx :: SVG Web Labels"
        WITH WEBEXOBJECT CLASS WebExBody
            WITH WEBEXOBJECT CLASS WebExMain
                WITH WEBEXOBJECT CLASS WebExContainer ARGS .T.
                    .:AddClass("py-3")
                    WITH WEBEXOBJECT CLASS WebExH2
                        .:SetContent("R&oacute;tulos SVG e PDF consolidado")
                    END WEBEXOBJECT
                    WITH WEBEXOBJECT CLASS WebExParagraph
                        .:SetContent("Template publicado por CpyF2Web, barcode vetorial, fontes adaptativas, renderiza&ccedil;&atilde;o sequencial e abertura por Blob.")
                    END WEBEXOBJECT
                    WITH WEBEXOBJECT CLASS WebExControl TYPE div
                        .:AddClass("alert alert-info")
                        .:SetContent("O SVG n&atilde;o &eacute; incorporado em Base64: o navegador o carrega como <code>./arquivo.svg</code>.")
                    END WEBEXOBJECT
                    WITH WEBEXOBJECT CLASS WebExButton ARGS "Gerar PDF demonstrativo","button"
                        .:SetFixedID("fwwebex-example-034-generate")
                        .:AddClass("btn-primary mb-3")
                    END WEBEXOBJECT
                    WITH WEBEXOBJECT CLASS WebExControl TYPE div
                        .:SetFixedID("fwwebex-example-034-status")
                        .:AddClass("card card-body")
                        .:SetAttr("style","white-space:pre-wrap")
                        .:SetContent("Pronto para gerar tr&ecirc;s r&oacute;tulos demonstrativos.")
                    END WEBEXOBJECT
                    WITH WEBEXOBJECT CLASS WebExControl TYPE div
                        .:SetFixedID("fwwebex-example-034-stage")
                        .:SetAttr("style","position:absolute;left:-10000px;top:0;width:130mm;height:115mm;overflow:hidden;background:#fff")
                    END WEBEXOBJECT
                    WITH WEBEXOBJECT CLASS WebExScript
                        .:SetExternalAssets(.T.)
                        .:SetContent(cScript)
                    END WEBEXOBJECT
                END WEBEXOBJECT
            END WEBEXOBJECT
        END WEBEXOBJECT
    END FWWEBEX

    WebFileTools():HTMLFromControl(oFWWebExPage,oFWWebExPage:GetFWWebExTmpPath(),@cHTMLFile,@cHTML,.T.)

    WEBEXOBJECT CLEAN

return(cHTMLFile)

static function FWWebEx034Callback(oChannel as object,cType as character,cContent as character) as logical
    if (cType=="FWWEBEX_EXAMPLE_034_DONE")
        ConOut("FWWebEx example 034: PDF concluido com "+cContent+" rotulos.")
    elseif (cType=="FWWEBEX_EXAMPLE_034_ERROR")
        ConOut("FWWebEx example 034: "+cContent)
    else
        FWWebEx.WebApp():JSToAdvPL(oChannel,cType,cContent)
    endif
return(.T.)

static function FWWebEx034JSEscape(cValue as character) as character
    cValue:=WebExHelper():StrReplaceEx(;
         cValue;
        ,{"'",BACK_SLASH+"'"};
        ,{Chr(13),BACK_SLASH+"r"};
        ,{Chr(10),BACK_SLASH+"n"};
    )
return(cValue)

