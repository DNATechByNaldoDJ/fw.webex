namespace FWWebEx

#include "fw.webex.th"

class WebExPage from WebExHtml

    protected data cTheme as character
    protected data cPageTitle as character

    protected data jPageStyle as json

    protected data lAddFooter as logical
    protected data lDarkTheme as logical

    protected data oPage as object
    protected data oPageBody as object
    protected data oPageHeader as object

    public method New(cPageTitle as character) as object

    public method Clean() as variant

    public method AddChild(oPageChild as object) as object

    public method AddPageStyle(cPageStyle) as object
    public method SetObjPageBody(oPageBody as object) as object

    public method DisableFooter(lDisableFooter as logical) as object
    public method DisableDarkTheme(lDisableDarkTheme as logical)  as object

    public method GetObjPageAfterRender() as object

    public method RenderHTML() as character

endclass

method New(cPageTitle) class WebExPage

    paramtype cPageTitle as character optional default "FWWEBEX"

    ::cPageTitle:=cPageTitle
    ::jPageStyle:=JSONObject():New()
    ::lAddFooter:=.T.
    ::lDarkTheme:=WebApp():ThemeIsDark(@::cTheme)

    _Super:New()

    ::oPage:=self

    //JQuery First
        WebExFeatureJQuery():Enable()
    //JQuery

    WITH WEBEXOBJECT ::oPage CLASS WebExHtml
        .:SetAttr("lang","pt-br")
        WITH WEBEXOBJECT ::oPageHeader CLASS WebExHead
            ***************************************************************************************************************************
            //Title
            WITH WEBEXOBJECT ::jObjectsContainer["title"] CLASS WebExTitle ARGS ::cPageTitle
            END WEBEXOBJECT
            ***************************************************************************************************************************
            //Meta
            WITH WEBEXOBJECT ::jObjectsContainer["charset"] CLASS WebExMeta
                .:SetAttr("charset","UTF-8")
            END WEBEXOBJECT
            WITH WEBEXOBJECT ::jObjectsContainer["application-name"] CLASS WebExMeta
                .:SetAttr("application-name","FWWebEx")
            END WEBEXOBJECT
            WITH WEBEXOBJECT ::jObjectsContainer["meta-viewport"] CLASS WebExMeta
                .:SetAttr("name","viewport")
                .:SetAttr("content","width=device-width, initial-scale=1")
            END WEBEXOBJECT
            /*
            * Content Security Policy (CSP)
            *
            * Defines the security policy applied to resources loaded or created
            * by the WebEx page.
            *
            * Directives:
            *
            * default-src
            *   Defines the default source policy for resource types that do not
            *   have a more specific CSP directive.
            *
            *   'self'
            *     Allows resources from the same origin as the current document.
            *
            *   'unsafe-inline'
            *     Allows inline JavaScript and CSS. Required by WebEx components
            *     that generate or inject inline content dynamically.
            *
            *   'unsafe-eval'
            *     Allows dynamic JavaScript evaluation (eval(), Function(), etc.).
            *     Required by some JavaScript libraries/frameworks used by WebEx.
            *
            *   http: https:
            *     Allows resources to be loaded from HTTP and HTTPS origins.
            *
            *   ws:
            *     Allows WebSocket connections.
            *
            *   data:
            *     Allows resources represented by data: URLs.
            *
            *   file:
            *     Allows resources using the file: scheme when supported by the
            *     execution environment.
            *
            * worker-src 'self' blob:
            *   Defines the allowed sources for Web Workers.
            *
            *   'self'
            *     Allows workers loaded from the same origin.
            *
            *   blob:
            *     Allows workers created dynamically from Blob URLs.
            *     This is required by libraries such as PDF.js, which may create
            *     its PDF processing worker using a blob: URL.
            *
            * frame-src 'self' https: blob:
            *   Defines the allowed sources for nested browsing contexts, such as
            *   <frame> and <iframe> elements.
            *
            *   'self'
            *     Allows frames loaded from the same origin.
            *
            *   https:
            *     Allows frames loaded from HTTPS origins.
            *
            *   blob:
            *     Allows frames whose content is provided through Blob URLs.
            *     This is useful for dynamically generated or processed documents,
            *     such as PDF content rendered or previewed by WebEx components.
            *
            *   NOTE:
            *     frame-src does not control Web Workers. Worker creation is
            *     explicitly controlled by the worker-src directive above.
            *
            * SECURITY NOTE:
            *   'unsafe-inline' and 'unsafe-eval' weaken CSP protection and should
            *   only be enabled when required by the application/framework.
            *
            *   Allowing arbitrary HTTP/HTTPS origins in default-src also makes
            *   this policy intentionally permissive. More restrictive directives
            *   should be preferred whenever the required resource origins are
            *   known in advance.
            *
            * CSP META NOTE:
            *   A CSP declared through a
            *   <meta http-equiv="Content-Security-Policy"> element does not
            *   override a more restrictive Content-Security-Policy HTTP response
            *   header. When multiple policies are present, they are enforced
            *   together.
            *
            * CURRENT POLICY:
            *
            *   default-src 'self' 'unsafe-inline' 'unsafe-eval'
            *               http: https: ws: data: file:;
            *
            *   worker-src  'self' blob:;
            *
            *   frame-src   'self' https: blob:;
            *
            */
            WITH WEBEXOBJECT ::jObjectsContainer["Content-Security-Policy"] CLASS WebExMeta
                .:SetAttr("http-equiv","Content-Security-Policy")
                .:SetAttr("content";
                       ,"default-src 'self' 'unsafe-inline' 'unsafe-eval' http: https: ws: data: file:;";
                       +"worker-src 'self' blob:;";
                       +"frame-src 'self' https: blob:;";
                )
            END WEBEXOBJECT
            ***************************************************************************************************************************
            //Bootstrap CSS
                WITH WEBEXOBJECT ::jObjectsContainer["comment-bootstrap-css"] CLASS WebExComment
                    .:SetContent("Bootstrap CSS")
                END WEBEXOBJECT
                WITH WEBEXOBJECT ::jObjectsContainer["link-bootstrap-css"] CLASS WebExLink
                    .:SetAttr("href","https://cdn.jsdelivr.net/npm/bootstrap/dist/css/bootstrap.min.css")
                    .:SetAttr("rel","stylesheet")
                END WEBEXOBJECT
            //Bootstrap CSS
            ***************************************************************************************************************************
            //Bootstrap Optional JavaScript
                WITH WEBEXOBJECT ::jObjectsContainer["comment-bootstrap-script"] CLASS WebExComment
                    .:SetContent("Optional JavaScript: jQuery first, then Popper.js, then Bootstrap JS")
                END WEBEXOBJECT
                //popperjs
                    WITH WEBEXOBJECT ::jObjectsContainer["script-popperjs"] CLASS WebExScript ARGS .F.
                        .:SetContent("https://cdn.jsdelivr.net/npm/@popperjs/core/dist/umd/popper.min.js")
                    END WEBEXOBJECT
                //popperjs
                //bootstrap
                    WITH WEBEXOBJECT ::jObjectsContainer["script-bootstrap"] CLASS WebExScript ARGS .F.
                        .:SetContent("https://cdn.jsdelivr.net/npm/bootstrap/dist/js/bootstrap.min.js")
                    END WEBEXOBJECT
                //bootstrap
            //Bootstrap Optional JavaScript
            ***************************************************************************************************************************
            //PO UI CSS
                WITH WEBEXOBJECT ::jObjectsContainer["comment-poui-css"] CLASS WebExComment
                    .:SetContent("PO UI CSS")
                END WEBEXOBJECT
                WITH WEBEXOBJECT ::jObjectsContainer["link-poui-css"] CLASS WebExLink
                    .:SetAttr("href","https://cdn.jsdelivr.net/npm/@po-ui/style/css/po-theme-default.min.css")
                    .:SetAttr("rel","stylesheet")
                END WEBEXOBJECT
            //PO UI CSS
            ***************************************************************************************************************************
        END WEBEXOBJECT
        ***************************************************************************************************************************
        cPageScript:=FWWebExScripts()
        WITH WEBEXOBJECT CLASS WebExScript
            .:SetContent(cPageScript)
        END WEBEXOBJECT
        ***************************************************************************************************************************
    END WEBEXOBJECT NOADDCHILD

return(self)

method Clean() class WebExPage

    local jPageStyle as json

    //Styles
    jPageStyle:=::jPageStyle
    aEval(;
         jPageStyle:GetNames();
        ,{|cName as character|;
            if(;
                (ValType(jPageStyle[cName])=="O");
                ,(;
                    jPageStyle[cName]:CleanChildren();
                   ,FreeObj(@jPageStyle[cName]);
                );
                ,nil;
            );
            ,jPageStyle:DelName(cName);
        };
    )

    if (valType(::oPageBody)=="O")
        ::oPageBody:CleanChildren()
        FreeObj(@::oPageBody)
    endif

    if (valType(::oPage)=="O")
        ::oPage:CleanChildren()
    endif

    _Super:Clean()

return(nil)

method AddChild(oPageChild) class WebExPage
    local cClassName as character
    paramtype 1 var oPageChild as object
    cClassName:=GetClassName(oPageChild)
    if (!Left(cClassName,8)=="FWWEBEX.")
        CLASSPARAMEXCEPTION PARAM 1 VAR oPageChild TEXT cClassName MESSAGE "Object must belong to the FWWEBEX namespace. Got '"+cClassName+"' instead. Check your class declaration."
    elseif ((!MethIsMemberOf(oPageChild,"ISKINDOF",.T.)).or.(!oPageChild:IsKindOf("WEBEXCONTROL",.T.)))
        CLASSPARAMEXCEPTION PARAM 1 VAR oPageChild TEXT cClassName MESSAGE "Object must inherit from FWWEBEX.WebExControl. Received: "+cClassName+"."
    elseif (oPageChild:IsKindOf("WEBEXPAGE",.T.))
        CLASSPARAMEXCEPTION PARAM 1 VAR oPageChild TEXT cClassName MESSAGE "Cannot nest a WebExPage inside another WebExPage. Received: "+cClassName+". A WebExPage must be the top-level container."
    endif
    if (oPageChild:IsKindOf("WEBEXBODY"))
        ::SetObjPageBody(oPageChild)
    else
        _Super:AddChild(oPageChild)
    endif
return(self)

method AddPageStyle(cPageStyle) class WebExPage
    local oStyle as object
    paramtype 1 var cPageStyle as character
    WITH WEBEXOBJECT oStyle CLASS WebExControl TYPE style
        .:SetContent(cPageStyle)
        ::jPageStyle[oStyle:GetID()]:=oStyle
    END WEBEXOBJECT NOADDCHILD
return(self)

method SetObjPageBody(oPageBody) class WebExPage
    local cClassName as character
    paramtype 1 var oPageBody as object
    cClassName:=GetClassName(oPageBody)
    if (!Left(cClassName,8)=="FWWEBEX.")
        CLASSPARAMEXCEPTION PARAM 1 VAR oPageBody TEXT cClassName MESSAGE "Object must belong to the FWWEBEX namespace. Got '"+cClassName+"' instead. Check your class declaration."
    elseif ((!MethIsMemberOf(oPageBody,"ISKINDOF",.T.)).or.(!oPageBody:IsKindOf("WEBEXCONTROL",.T.)))
        CLASSPARAMEXCEPTION PARAM 1 VAR oPageBody TEXT cClassName MESSAGE "Object must inherit from FWWEBEX.WebExControl. Received: "+cClassName+"."
    endif
    if (!oPageBody:IsKindOf("WEBEXBODY",.T.))
        ::oPageBody:=WebExBody():New()
        ::oPageBody:AddChild(oPageBody)
    else
        ::oPageBody:=oPageBody
    endif
return(self)

method GetObjPageAfterRender() class WebExPage
return(::GetMemberData("oPage"))

method DisableFooter(lDisableFooter) class WebExPage
    paramtype 1 var lDisableFooter as logical optional default (!::lAddFooter)
    ::lAddFooter:=(!lDisableFooter)
return(self)

method DisableDarkTheme(lDisableDarkTheme) class WebExPage
    paramtype 1 var lDisableDarkTheme as logical optional default (!::lDarkTheme)
    ::lDarkTheme:=(!lDisableDarkTheme)
return(self)

method RenderHTML() class WebExPage

    local cHTML as character
    local cFWWebExThemeStyle as character
    local cPageStyle as character
    local cPageScript as character

    local jHeader as json
    local jAssets as json
    local jPageStyle as json
    local jHeadScripts as json
    local jPageScripts as json

    local lHasMain as logical
    local lHasBody as logical
    local lExternalAssets:=.F. as logical

    local oPageBody as object
    local oBodyMain as object

    cHTML:="<!DOCTYPE html>"

    if ((!::lDarkTheme).and.(!Empty(::cTheme)).and.(::cTheme=="SUNSET"))

        beginContent var cPageStyle

            :root {
                --totvs-red: #c62828;
                --totvs-light-gray: #f4f4f4;
                --totvs-dark-gray: #dcdcdc;
                --totvs-border: #ccc;
                --totvs-text: #000;
                --totvs-highlight: #e0e0e0;
                --totvs-btn-bg: #ffffff;
            }

            body {
                background-color: var(--totvs-light-gray) !important;
                color: var(--totvs-text) !important;
                font-family: "Segoe UI", sans-serif !important;
            }

            .btn {
                background-color: var(--totvs-btn-bg) !important;
                color: var(--totvs-red) !important;
                border: 1px solid var(--totvs-red) !important;
                border-radius: 4px !important;
                font-weight: bold;
                padding: 6px 12px;
                transition: all 0.2s ease-in-out !important;
            }

            .btn:hover,
            .btn:focus {
                background-color: var(--totvs-red) !important;
                color: #fff !important;
            }

            .form-control,
            .form-select {
                background-color: #fff !important;
                color: var(--totvs-text) !important;
                border: 1px solid var(--totvs-border) !important;
                border-radius: 3px !important;
                padding: 5px 10px;
            }

            .form-control:focus,
            .form-select:focus {
                border-color: var(--totvs-red) !important;
                box-shadow: 0 0 3px rgba(198, 40, 40, 0.4) !important;
            }

            .card {
                border: 1px solid var(--totvs-border) !important;
                border-radius: 6px;
                padding: 15px;
                color: var(--totvs-text);
                box-shadow: 0 0 10px rgba(0,0,0,0.05);
            }

            .navbar {
                background-color: #fff !important;
                border-bottom: 2px solid var(--totvs-red) !important;
            }

            .navbar .nav-link,
            .navbar-brand {
                color: var(--totvs-text) !important;
            }

            .navbar .nav-link:hover {
                color: var(--totvs-red) !important;
            }

            .table {
                background-color: #fff !important;
                color: var(--totvs-text) !important;
                border: 1px solid var(--totvs-border);
            }

            .table thead {
                background-color: var(--totvs-dark-gray) !important;
                color: var(--totvs-text) !important;
            }

            .table-bordered,
            .table-bordered th,
            .table-bordered td {
                border: 1px solid var(--totvs-border) !important;
            }

            .table tbody tr:hover {
                background-color: var(--totvs-highlight) !important;
            }

            a {
                color: var(--totvs-red) !important;
                text-decoration: none;
            }

            a:hover {
                text-decoration: underline;
            }

            input[type="checkbox"],
            input[type="radio"] {
                accent-color: var(--totvs-red) !important;
            }

            /* ------------ Pagination Sunset (Bootstrap 4/5 + legacy + DataTables) ------------ */
            /* IMPORTANTE: carregue este bloco DEPOIS do bootstrap / datatables CSS */

            /* Bootstrap 4/5 */
            .pagination .page-link {
                background-color: var(--totvs-btn-bg) !important;
                color: var(--totvs-red) !important;
                border: 1px solid var(--totvs-border) !important;
                border-radius: 4px !important;
                padding: .375rem .75rem !important;
                font-weight: 600 !important;
                transition: all .12s ease-in-out !important;
            }

            /* hover / focus */
            .pagination .page-link:hover,
            .pagination .page-link:focus {
                background-color: var(--totvs-red) !important;
                color: #fff !important;
                text-decoration: none !important;
                box-shadow: 0 0 0 .15rem rgba(198,40,40,0.12) !important;
            }

            /* active */
            .pagination .page-item.active .page-link,
            .pagination .page-item.active .page-link:hover,
            .pagination .page-item.active .page-link:focus {
                background-color: var(--totvs-red) !important;
                border-color: var(--totvs-red) !important;
                color: #fff !important;
                cursor: default !important;
                box-shadow: none !important;
            }

            /* disabled */
            .pagination .page-item.disabled .page-link {
                background-color: transparent !important;
                color: var(--totvs-dark-gray) !important;
                border-color: var(--totvs-border) !important;
                pointer-events: none !important;
                opacity: .65 !important;
            }

            /* Legacy Bootstrap 2/3 markup fallback */
            .pagination > li > a,
            .pagination > li > span {
                background-color: var(--totvs-btn-bg) !important;
                color: var(--totvs-red) !important;
                border: 1px solid var(--totvs-border) !important;
            }

            /* DataTables pagination (quando usado) */
            .dataTables_wrapper .dataTables_paginate .paginate_button {
                background-color: var(--totvs-btn-bg) !important;
                color: var(--totvs-red) !important;
                border: 1px solid var(--totvs-border) !important;
                border-radius: 4px !important;
                padding: 6px 10px !important;
                margin: 0 3px !important;
            }
            .dataTables_wrapper .dataTables_paginate .paginate_button.current,
            .dataTables_wrapper .dataTables_paginate .paginate_button:hover {
                background-color: var(--totvs-red) !important;
                color: #fff !important;
                border-color: var(--totvs-red) !important;
            }

            /* Forca maxima (use so se necessario) */
            body ul.pagination li.page-item a.page-link,
            body .dataTables_wrapper .dataTables_paginate a.paginate_button {
                /* fallback extra especifico */
            }

            /* ------------ ProgressBar Sunset (Bootstrap 4/5 + legacy) ------------ */
            /* IMPORTANTE: carregue este bloco DEPOIS do bootstrap.css e datatables.css */
            .progress {
                background-color: var(--totvs-btn-bg) !important;
                border-radius: 4px !important;
                height: 1.25rem !important;
                box-shadow: inset 0 0 3px rgba(0,0,0,0.2) !important;
            }

            .progress-bar {
                background-color: var(--totvs-red) !important;
                color: #fff !important;
                font-weight: 600 !important;
                text-align: center !important;
                transition: width .3s ease-in-out !important;
            }

            .progress-bar.bg-primary {
                /* forca conversao de "primary" pro red do sunset */
                background-color: var(--totvs-red) !important;
            }

            .progress-bar-striped {
                background-image: linear-gradient(
                    45deg,
                    rgba(255,255,255,.15) 25%,
                    transparent 25%,
                    transparent 50%,
                    rgba(255,255,255,.15) 50%,
                    rgba(255,255,255,.15) 75%,
                    transparent 75%,
                    transparent
                ) !important;
                background-size: 1rem 1rem !important;
            }

        endContent

        ::AddPageStyle(cPageStyle)

    endif

    if (Empty(::oPageBody))
        oBodyMain:=WebExMain():New()
        oPageBody:=WebExBody():New()
        oPageBody:AddChild(oBodyMain)
    else
        lHasMain:=::oPageBody:IsKindOf("WEBEXMAIN")
        lHasBody:=::oPageBody:IsKindOf("WEBEXBODY")
        if ((lHasMain).or.(lHasBody))
            oPageBody:=::oPageBody
        else
            oBodyMain:=WebExMain():New()
            oBodyMain:AddChild(::oPageBody)
            oPageBody:=WebExBody():New()
            oPageBody:AddChild(oBodyMain)
        endif
    endif
    ::oPageBody:=oPageBody
    if (::lAddFooter)
        WITH WEBEXOBJECT ::oPageBody
            WITH WEBEXOBJECT CLASS WebExFooter
            END WEBEXOBJECT
        END WEBEXOBJECT NOADDCHILD
    endif

    //Pre-Renderiza Body para Carregar os Dados: External Assets, etc.
    ::oPageBody:RenderHTML()
    //Desabilita a Renderizacao, de forma a Obter apenas o resultado da Renderizacao Anterior
    ::oPageBody:SetRenderChildren(.F.)

    WITH WEBEXOBJECT ::oPage
        if (::lDarkTheme)
            .:SetAttr("data-bs-theme","dark")
        endif
        WITH WEBEXOBJECT ::oPageHeader
            ***************************************************************************************************************************
            //Custom Header
            WITH WEBEXOBJECT CLASS WebExComment
                .:SetContent("Custom Header")
            END WEBEXOBJECT
            jHeader:=::oPageHeader:GetHeader()
            aEval(;
                 aSort(jHeader:GetNames(),nil,nil,{|x as character,y as character|jHeader[x]:GetPriority()<jHeader[y]:GetPriority()});
                ,{|cName as character|::GetMemberData("oPageHeader"):AddChild(jHeader[cName])};
            )
            ***************************************************************************************************************************
            //Custom Styles
            WITH WEBEXOBJECT CLASS WebExComment
                .:SetContent("Custom Styles")
            END WEBEXOBJECT
            jPageStyle:=::jPageStyle
            aEval(jPageStyle:GetNames(),{|cName as character|::GetMemberData("oPageHeader"):AddChild(jPageStyle[cName])})
            ***************************************************************************************************************************
            //Custom Scripts Head
            WITH WEBEXOBJECT CLASS WebExComment
                .:SetContent("Custom Scripts Head")
            END WEBEXOBJECT
            jHeadScripts:=::oPageHeader:GetHeadScripts()
            aEval(jHeadScripts:GetNames(),{|cName as character|::GetMemberData("oPageHeader"):AddChild(jHeadScripts[cName])})
            ***************************************************************************************************************************
            //O bridge TWebChannel e carregado sob demanda por FWWebEx.TWebChannel.
            //O TWebEngine do WebApp fornece o transporte no frame pai, mas nao
            //compartilha os objetos JavaScript com o documento filho.
            ***************************************************************************************************************************
            //Normalize CSS
                //(Do Not Use WebExComment Here)
                WITH WEBEXOBJECT CLASS WebExControl TYPE !--
                    .:SetContent("Normalize CSS")
                END WEBEXOBJECT
                //(Do Not Use WebExLink Here)
                WITH WEBEXOBJECT CLASS WebExControl TYPE link
                    .:SetAttr("href","https://csstools.github.io/normalize.css/latest/normalize.css")
                    .:SetAttr("rel","stylesheet")
                END WEBEXOBJECT
            //Normalize CSS
            ***************************************************************************************************************************
            //FWWebEx Theme Base
                WITH WEBEXOBJECT CLASS WebExStyle
                    beginContent var cFWWebExThemeStyle
                        html[data-bs-theme],
                        html[data-bs-theme] body {
                            background-color: var(--bs-body-bg);
                            color: var(--bs-body-color);
                        }

                        html[data-bs-theme] .card {
                            --bs-card-bg: var(--bs-body-bg);
                            --bs-card-border-color: var(--bs-border-color);
                            --bs-card-color: var(--bs-body-color);
                            background-color: var(--bs-card-bg);
                            border-color: var(--bs-card-border-color);
                            color: var(--bs-card-color);
                        }

                        html[data-bs-theme] .modal-content {
                            --bs-modal-bg: var(--bs-body-bg);
                            --bs-modal-border-color: var(--bs-border-color);
                            --bs-modal-color: var(--bs-body-color);
                            background-color: var(--bs-modal-bg);
                            border-color: var(--bs-modal-border-color);
                            color: var(--bs-modal-color);
                        }

                        html[data-bs-theme] .table {
                            --bs-table-bg: transparent;
                            --bs-table-border-color: var(--bs-border-color);
                            --bs-table-color: var(--bs-body-color);
                            border-color: var(--bs-table-border-color);
                            color: var(--bs-table-color);
                        }

                        html[data-bs-theme] .form-control,
                        html[data-bs-theme] .form-select {
                            background-color: var(--bs-body-bg);
                            border-color: var(--bs-border-color);
                            color: var(--bs-body-color);
                        }

                        html[data-bs-theme] .form-control::placeholder {
                            color: var(--bs-secondary-color);
                            opacity: 1;
                        }

                        html[data-bs-theme] pre,
                        html[data-bs-theme] code,
                        html[data-bs-theme] kbd,
                        html[data-bs-theme] samp {
                            color: inherit;
                        }

                        html[data-bs-theme] pre {
                            background-color: var(--bs-tertiary-bg);
                            border-color: var(--bs-border-color);
                            color: var(--bs-body-color);
                        }

                        html[data-bs-theme] .bg-body,
                        html[data-bs-theme] .bg-body-secondary,
                        html[data-bs-theme] .bg-body-tertiary {
                            color: var(--bs-body-color);
                        }

                        html[data-bs-theme] .text-muted {
                            color: var(--bs-secondary-color) !important;
                        }
                    endContent
                    .:SetContent(cFWWebExThemeStyle)
                END WEBEXOBJECT
            //FWWebEx Theme Base
            ***************************************************************************************************************************
        END WEBEXOBJECT NOADDCHILD
        ***************************************************************************************************************************
        WITH WEBEXOBJECT ::oPageBody
        END WEBEXOBJECT
        ***************************************************************************************************************************
        //ScriptBundle
        jPageScripts:=::oPage:GetPageScriptBundle()
        aEval(;
            jPageScripts:GetNames();
            ,{|cName as character|;
                if(;
                    !lExternalAssets;
                    ,lExternalAssets:=jPageScripts[cName]:GetExternalAssets(),nil);
                    ,::GetMemberData("oPage"):AddChild(jPageScripts[cName]);
            };
        )
        ::lExternalAssets:=lExternalAssets
        .:SetExternalAssets(::lExternalAssets)
        if (::ExternalAssetsIsEnabled().and.(::lExternalAssets))
            //External Assets (Do Not Use WebExScript Here)
            WITH WEBEXOBJECT CLASS WebExControl TYPE script
                .:SetContent("/*__EXTERNAL_ASSETS__*/")
            END WEBEXOBJECT
        endif
    END WEBEXOBJECT NOADDCHILD

    cHTML+=::oPage:RenderHTML()

    if ((::ExternalAssetsIsEnabled()).and.(::lExternalAssets))
        jAssets:=::GetAssets()
        if (Len(jAssets:GetNames())>0)
            beginContent var cPageScript
                (
                    function(){
                        var useLocal = (
                            location.protocol === "file:"
                        );
                        var assets = __jAssets__;
                        Object.keys(assets).forEach(function(id){
                            var asset = assets[id];
                            var el;
                            if (asset.type === "style") {
                                el = document.createElement("link");
                                el.rel = "stylesheet";
                                el.href = useLocal ? asset.local : asset.remote;
                            } else if (asset.type === "script") {
                                el = document.createElement("script");
                                el.src = useLocal ? asset.local : asset.remote;
                                el.type = "text/javascript";
                            }
                            if (el) {
                                el.setAttribute("data-id", asset.id); // opcional, pra rastrear depois
                                document.head.appendChild(el);
                            }
                        });
                    }
                )();
            endContent
            cPageScript:=WebExHelper():StrReplace(cPageScript,{"__jAssets__",jAssets:ToJSON()})
            cHTML:=WebExHelper():StrReplace(cHTML,{"/*__EXTERNAL_ASSETS__*/",cPageScript})
        endif
    endif

    FreeObj(@jHeader)
    FreeObj(@jPageStyle)
    FreeObj(@jHeadScripts)
    FreeObj(@jPageScripts)

return(cHTML)

static function FWWebExScripts() as character

    local cPageScript as character
    local cTWebChannelURI:="https://cdn.jsdelivr.net/gh/totvs/twebchannel-js@master/twebchannel.js" as character

    //FWWebEx Scripts
    beginContent var cPageScript
        /*FWWebExHasJQuery*/
        function FWWebExHasJQuery() {
            return !!window?.jQuery;
        }

        /*FWWebExWaitForElementID*/
        function FWWebExWaitForElementID(id, callback) {
            const element = document.getElementById(id);
            if (element) {
                callback(element);
            } else {
                setTimeout(() => FWWebExWaitForElementID(id, callback), 100);
            }
        }

        window.FWWebEx = window.FWWebEx || {};

        /***********************************************************************
        * FWWebEx.Events
        * - Event bus com memoria de eventos disparados
        * - Evita polling espalhado pela aplicacao
        **********************************************************************/
        FWWebEx.Events = (() => {

            const fired = {};

            function on(name, callback, options = {}) {
                const once = !!options.once;

                if (fired[name]) {
                    callback({ type: name, detail: fired[name] });
                    return;
                }

                const handler = (event) => {
                    callback(event);
                    if (once) {
                        document.removeEventListener(name, handler);
                    }
                };

                document.addEventListener(name, handler);
            }

            function once(name, callback) {
                on(name, callback, { once: true });
            }

            function emit(name, detail) {
                fired[name] = detail ?? true;
                document.dispatchEvent(new CustomEvent(name, { detail }));
            }

            function hasFired(name) {
                return Object.prototype.hasOwnProperty.call(fired, name);
            }

            return { on, once, emit, hasFired };

        })();

        /***********************************************************************
        * FWWebEx.TWebChannel
        * - Reutiliza o provider da TOTVS quando ele ja existe no documento
        * - Carrega somente twebchannel.js quando o iframe ainda nao o possui
        * - Nao depende dos detalhes privados de fwprotheus.js/totvstec.js
        * - Serializa load/connect e oferece um EventTarget estavel ao FWWebEx
        **********************************************************************/
        FWWebEx.TWebChannel = (() => {

            const PLATFORM_SOURCE = '__FWWEBEX_TWEBCHANNEL_PLATFORM_SOURCE__';
            const PINNED_SOURCE = 'https://cdn.jsdelivr.net/npm/@totvs/twebchannel-js@1.0.3/twebchannel.js';
            const SCRIPT_ATTRIBUTE = 'data-fwwebex-twebchannel';

            let loadPromise = null;
            let connectPromise = null;
            let responseTarget = null;
            let connected = false;
            let lastError = null;
            const receivers = new Set();

            function bridgeError(code, message, cause) {
                const error = new Error(message);
                error.name = 'FWWebExTWebChannelError';
                error.code = code;
                if (cause) {
                    error.cause = cause;
                }
                return error;
            }

            function withinDeadline(promise, deadline, code, message) {
                const remaining = deadline - Date.now();
                if (remaining <= 0) {
                    return Promise.reject(bridgeError(code, message));
                }
                return new Promise((resolve, reject) => {
                    let settled = false;
                    const timer = setTimeout(() => {
                        if (settled) return;
                        settled = true;
                        reject(bridgeError(code, message));
                    }, remaining);
                    const finish = callback => value => {
                        if (settled) return;
                        settled = true;
                        clearTimeout(timer);
                        callback(value);
                    };
                    promise.then(finish(resolve), finish(reject));
                });
            }

            function getChannel() {
                return window.twebchannel;
            }

            function isProvider(channel) {
                return !!channel &&
                    typeof channel.connect === 'function' &&
                    typeof channel.jsToAdvpl === 'function';
            }

            function getEventTarget() {
                const channel = getChannel();
                if (
                    !responseTarget &&
                    channel?.eventTarget &&
                    typeof channel.eventTarget.addEventListener === 'function' &&
                    typeof channel.eventTarget.removeEventListener === 'function' &&
                    typeof channel.eventTarget.dispatchEvent === 'function'
                ) {
                    responseTarget = channel.eventTarget;
                }
                if (!responseTarget) {
                    responseTarget = new EventTarget();
                }
                if (channel && !channel.eventTarget) {
                    // Alias de compatibilidade para exemplos legados. O dono do
                    // dispatcher continua sendo o bridge FWWebEx.
                    channel.eventTarget = responseTarget;
                }
                return responseTarget;
            }

            function installReceiver(channel) {
                if (!isProvider(channel) || channel.__fwwebexReceiverInstalled === true) {
                    return;
                }
                const previous = channel.advplToJs;
                channel.advplToJs = function (...args) {
                    let handled = false;
                    receivers.forEach(receiver => {
                        try {
                            if (receiver(...args) === true) handled = true;
                        } catch (error) {
                            console.error('[FWWebEx] Erro no receptor AdvPLToJS:', error);
                        }
                    });
                    // Retornar true declara a mensagem como tratada. Mensagens nao
                    // reconhecidas continuam no receptor anterior da plataforma.
                    if (!handled && typeof previous === 'function') {
                        try {
                            previous.apply(channel, args);
                        } catch (error) {
                            console.error('[FWWebEx] Erro no receptor AdvPLToJS anterior:', error);
                        }
                    }
                };
                channel.__fwwebexReceiverInstalled = true;
            }

            function onAdvplToJs(receiver) {
                if (typeof receiver !== 'function') {
                    throw new TypeError('O receptor AdvPLToJS deve ser uma funcao.');
                }
                receivers.add(receiver);
                installReceiver(getChannel());
                return () => receivers.delete(receiver);
            }

            function configuredSources() {
                const configured = FWWebEx.config?.twebchannel?.src;
                return [configured, PLATFORM_SOURCE, PINNED_SOURCE]
                    .filter(source => typeof source === 'string' && source.trim())
                    .filter((source, index, sources) => sources.indexOf(source) === index);
            }

            function loadScript(source, timeout) {
                return new Promise((resolve, reject) => {
                    const script = document.createElement('script');
                    let settled = false;
                    let timer = null;
                    const cleanup = () => {
                        if (timer) clearTimeout(timer);
                        script.onload = null;
                        script.onerror = null;
                    };
                    const succeed = channel => {
                        if (settled) return;
                        settled = true;
                        cleanup();
                        resolve(channel);
                    };
                    const fail = error => {
                        if (settled) return;
                        settled = true;
                        cleanup();
                        if (typeof script.remove === 'function') script.remove();
                        reject(error);
                    };
                    script.src = source;
                    script.async = true;
                    script.setAttribute(SCRIPT_ATTRIBUTE, source);
                    script.onload = () => {
                        if (isProvider(getChannel())) {
                            installReceiver(getChannel());
                            succeed(getChannel());
                        } else {
                            fail(bridgeError(
                                'FWWEBEX_TWEBCHANNEL_PROVIDER_INVALID',
                                'O script carregado nao publicou um twebchannel compativel.'
                            ));
                        }
                    };
                    script.onerror = () => fail(bridgeError(
                        'FWWEBEX_TWEBCHANNEL_LOAD_FAILED',
                        'Nao foi possivel carregar twebchannel.js de ' + source + '.'
                    ));
                    timer = setTimeout(() => fail(bridgeError(
                        'FWWEBEX_TWEBCHANNEL_LOAD_TIMEOUT',
                        'Tempo esgotado ao carregar twebchannel.js de ' + source + '.'
                    )), Math.max(1, Number(timeout) || 1));
                    document.head.appendChild(script);
                });
            }

            function load(options = {}) {
                const current = getChannel();
                if (isProvider(current)) {
                    getEventTarget();
                    installReceiver(current);
                    return Promise.resolve(current);
                }
                const timeout = Math.max(250, Number(options.timeout) || 5000);
                const requestedDeadline = Number(options.deadline);
                const callerDeadline = Number.isFinite(requestedDeadline) && requestedDeadline > 0
                    ? requestedDeadline
                    : Date.now() + timeout;
                if (loadPromise) {
                    return withinDeadline(
                        loadPromise,
                        callerDeadline,
                        'FWWEBEX_TWEBCHANNEL_LOAD_TIMEOUT',
                        'Tempo esgotado ao aguardar o carregamento de twebchannel.js.'
                    );
                }

                // O budget da tentativa compartilhada nao pertence ao primeiro
                // consumidor. Cada chamada conserva seu proprio deadline, enquanto
                // a carga subjacente pode servir consumidores posteriores.
                const loadTimeout = Math.max(
                    250,
                    Number(FWWebEx.config?.twebchannel?.loadTimeout) || 5000
                );
                const loadDeadline = Date.now() + loadTimeout;
                const sources = configuredSources();
                let sourceError = null;

                const trySource = index => {
                    if (index >= sources.length) {
                        return Promise.reject(sourceError || bridgeError(
                            'FWWEBEX_TWEBCHANNEL_DEPENDENCY_MISSING',
                            'Nenhuma origem de twebchannel.js foi configurada.'
                        ));
                    }
                    const remaining = loadDeadline - Date.now();
                    if (remaining <= 0) {
                        return Promise.reject(sourceError || bridgeError(
                            'FWWEBEX_TWEBCHANNEL_LOAD_TIMEOUT',
                            'Tempo esgotado ao localizar twebchannel.js.'
                        ));
                    }
                    const sourceTimeout = Math.max(
                        1,
                        Math.floor(remaining / (sources.length - index))
                    );
                    return loadScript(sources[index], sourceTimeout).catch(error => {
                        sourceError = error;
                        return trySource(index + 1);
                    });
                };

                const pending = trySource(0);
                const shared = pending.then(channel => {
                    if (loadPromise === shared) loadPromise = null;
                    lastError = null;
                    return channel;
                }).catch(error => {
                    if (loadPromise === shared) loadPromise = null;
                    lastError = bridgeError(
                        'FWWEBEX_TWEBCHANNEL_DEPENDENCY_MISSING',
                        'twebchannel.js nao esta disponivel no documento FWWebEx.',
                        error
                    );
                    FWWebEx.Events.emit('FWWebEx:twebchannel:error', { error: lastError });
                    throw lastError;
                });
                loadPromise = shared;
                return withinDeadline(
                    loadPromise,
                    callerDeadline,
                    'FWWEBEX_TWEBCHANNEL_LOAD_TIMEOUT',
                    'Tempo esgotado ao aguardar o carregamento de twebchannel.js.'
                );
            }

            function markConnected(channel) {
                const notify = !connected;
                connected = true;
                lastError = null;
                channel.gotConnection = true;
                getEventTarget();
                installReceiver(channel);
                if (notify) {
                    FWWebEx.Events.emit('FWWebEx:twebchannel:ready', {
                        version: channel.version || null
                    });
                }
                return channel;
            }

            function connect(options = {}) {
                const timeout = Math.max(250, Number(options.timeout) || 5000);
                const callerDeadline = Date.now() + timeout;
                return load({ timeout, deadline: callerDeadline }).then(channel => {
                    const forceReconnect = options.forceReconnect === true;
                    getEventTarget();
                    if (!forceReconnect && (connected || channel.gotConnection === true)) {
                        return markConnected(channel);
                    }
                    if (connectPromise) {
                        return withinDeadline(
                            connectPromise,
                            callerDeadline,
                            'FWWEBEX_TWEBCHANNEL_CONNECT_TIMEOUT',
                            'Tempo esgotado ao aguardar a conexao compartilhada.'
                        );
                    }
                    if (forceReconnect) {
                        connected = false;
                        if (Object.prototype.hasOwnProperty.call(channel, 'gotConnection')) {
                            channel.gotConnection = false;
                        }
                    }

                    const pending = new Promise((resolve, reject) => {
                        let settled = false;
                        let poll = null;
                        let timer = null;

                        const cleanup = () => {
                            document.removeEventListener('twebchannelready', ready);
                            if (poll) clearInterval(poll);
                            if (timer) clearTimeout(timer);
                        };
                        const ready = () => {
                            if (settled) return;
                            settled = true;
                            cleanup();
                            resolve(markConnected(channel));
                        };
                        const fail = error => {
                            if (settled) return;
                            settled = true;
                            cleanup();
                            lastError = error;
                            reject(error);
                        };

                        const connectTimeout = Math.max(
                            250,
                            Number(FWWebEx.config?.twebchannel?.connectTimeout) || 5000
                        );
                        const remaining = connectTimeout;
                        timer = setTimeout(() => fail(bridgeError(
                            'FWWEBEX_TWEBCHANNEL_CONNECT_TIMEOUT',
                            'O TWebChannel nao conectou ao Protheus dentro do prazo.'
                        )), remaining);

                        try {
                            const preloaderIsConnecting =
                                channel.gotConnection === false &&
                                (
                                    !!channel.channel?.port1 ||
                                    (
                                        Number(channel.internalPort) > 0 &&
                                        channel.remoteType !== undefined &&
                                        channel.remoteType !== null
                                    )
                                );
                            if (preloaderIsConnecting && !forceReconnect) {
                                // O preloader ja criou o transporte. Uma segunda
                                // chamada a connect() substituiria o MessageChannel
                                // em uso; apenas observamos a tentativa existente.
                                document.addEventListener('twebchannelready', ready);
                                poll = setInterval(() => {
                                    if (channel.gotConnection === true) ready();
                                }, 25);
                            } else {
                                channel.connect(ready);
                            }
                        } catch (error) {
                            fail(bridgeError(
                                'FWWEBEX_TWEBCHANNEL_CONNECT_FAILED',
                                'Falha ao iniciar a conexao com o TWebChannel.',
                                error
                            ));
                        }
                    });

                    const shared = pending.then(result => {
                        if (connectPromise === shared) connectPromise = null;
                        return result;
                    }).catch(error => {
                        if (connectPromise === shared) connectPromise = null;
                        FWWebEx.Events.emit('FWWebEx:twebchannel:error', { error });
                        throw error;
                    });
                    connectPromise = shared;

                    return withinDeadline(
                        connectPromise,
                        callerDeadline,
                        'FWWEBEX_TWEBCHANNEL_CONNECT_TIMEOUT',
                        'Tempo esgotado ao aguardar a conexao compartilhada.'
                    );
                });
            }

            function send(key, value, options = {}) {
                return connect(options).then(channel => {
                    channel.jsToAdvpl(key, value);
                    return true;
                });
            }

            function getState() {
                return {
                    loaded: isProvider(getChannel()),
                    connected: connected || getChannel()?.gotConnection === true,
                    loading: !!loadPromise,
                    connecting: !!connectPromise && !connected,
                    source: getChannel()?.version || null,
                    lastError
                };
            }

            return {
                load, connect, send, onAdvplToJs,
                getChannel, getEventTarget, getState
            };

        })();

        /***********************************************************************
        * FWWebEx.ready
        * - Executa callbacks quando o DOM estiver pronto
        * - Mantem memoria do estado de DOM pronto para scripts tardios
        **********************************************************************/
        FWWebEx.state = FWWebEx.state || {};
        FWWebEx.state.domReady = document.readyState !== 'loading';
        FWWebEx.state.initializing = FWWebEx.state.initializing || false;
        FWWebEx.state.initialized = FWWebEx.state.initialized || false;
        FWWebEx.state.initCount = FWWebEx.state.initCount || 0;

        FWWebEx.ready = (() => {

            let domReadyEmitted = false;

            function emitDOMReady() {
                FWWebEx.state.domReady = true;
                if (!domReadyEmitted) {
                    domReadyEmitted = true;
                    FWWebEx.Events.emit('FWWebEx:dom:ready', {
                        readyState: document.readyState
                    });
                }
            }

            function run(callback) {
                emitDOMReady();
                try {
                    callback(FWWebEx.state, FWWebEx);
                } catch (err) {
                    console.error('[FWWebEx] Erro em FWWebEx.ready:', err);
                    FWWebEx.Events.emit('FWWebEx:init:error', {
                        phase: 'ready',
                        error: err
                    });
                }
            }

            function ready(callback) {
                if (typeof callback !== 'function') {
                    console.warn('[FWWebEx] FWWebEx.ready espera uma funcao.');
                    return FWWebEx;
                }

                if (document.readyState === 'loading') {
                    document.addEventListener('DOMContentLoaded', () => run(callback), { once: true });
                } else {
                    setTimeout(() => run(callback), 0);
                }

                return FWWebEx;
            }

            if (document.readyState === 'loading') {
                document.addEventListener('DOMContentLoaded', emitDOMReady, { once: true });
            } else {
                emitDOMReady();
            }

            return ready;

        })();

        /***********************************************************************
        * FWWebEx.Ready
        * - Aguarda assets opcionais/obrigatorios sem loop infinito
        * - Dispara:
        *   FWWebEx:jquery:ready
        *   FWWebEx:bootstrap:ready
        *   FWWebEx:datatable:ready
        *   FWWebEx:datatable:timeout
        *   FWWebEx:ui:ready
        **********************************************************************/
        FWWebEx.Ready = (() => {

            function waitFor(checkFn, eventName, options = {}) {

                const timeout  = Number(options.timeout ?? 3000);
                const interval = Number(options.interval ?? 25);
                const optional = !!options.optional;
                const onTimeoutEmit = options.onTimeoutEmit || (eventName + ':timeout');

                let elapsed = 0;
                let done = false;

                function finish(success, payload = {}) {
                    if (done) {
                        return;
                    }

                    done = true;

                    if (success) {
                        FWWebEx.Events.emit(eventName, {
                            name: eventName,
                            success: true,
                            optional,
                            timeout: false,
                            ...payload
                        });
                    } else {
                        if (!optional) {
                            console.warn('[FWWebEx] Timeout aguardando:', eventName);
                        }
                        FWWebEx.Events.emit(onTimeoutEmit, {
                            name: eventName,
                            success: false,
                            optional,
                            timeout: true,
                            ...payload
                        });
                    }
                }

                function loop() {
                    try {
                        if (checkFn()) {
                            finish(true);
                            return;
                        }
                    } catch (e) {
                        console.warn('[FWWebEx] Erro ao avaliar dependencia:', eventName, e);
                    }

                    elapsed += interval;

                    if (elapsed >= timeout) {
                        finish(false);
                        return;
                    }

                    setTimeout(loop, interval);
                }

                loop();
            }

            function jquery(options = {}) {
                waitFor(
                    () => !!window.jQuery,
                    'FWWebEx:jquery:ready',
                    {
                        timeout: options.timeout ?? 4000,
                        interval: options.interval ?? 25,
                        optional: options.optional ?? false
                    }
                );
            }

            function bootstrap(options = {}) {
                waitFor(
                    () => !!window.bootstrap && !!window.bootstrap.Modal,
                    'FWWebEx:bootstrap:ready',
                    {
                        timeout: options.timeout ?? 4000,
                        interval: options.interval ?? 25,
                        optional: options.optional ?? false
                    }
                );
            }

            function datatable(options = {}) {
                waitFor(
                    () => !!window.jQuery && !!window.$?.fn?.DataTable,
                    'FWWebEx:datatable:ready',
                    {
                        timeout: options.timeout ?? 2000,
                        interval: options.interval ?? 25,
                        optional: options.optional ?? true
                    }
                );
            }

            function ui() {

                let hasJQuery = false;
                let hasBootstrap = false;

                function tryEmitUI() {
                    if (hasJQuery && hasBootstrap) {
                        FWWebEx.Events.emit('FWWebEx:ui:ready', {
                            jquery: true,
                            bootstrap: true
                        });
                    }
                }

                FWWebEx.Events.once('FWWebEx:jquery:ready', () => {
                    hasJQuery = true;
                    tryEmitUI();
                });

                FWWebEx.Events.once('FWWebEx:bootstrap:ready', () => {
                    hasBootstrap = true;
                    tryEmitUI();
                });
            }

            return { waitFor, jquery, bootstrap, datatable, ui };

        })();

        /***********************************************************************
        * FWWebEx.Actions
        * - Registro generico de acoes declarativas via data-fwwebex-action
        * - Evita onclick inline
        **********************************************************************/
        FWWebEx.Actions = (() => {

            const registry = {};

            function register(name, handler) {
                if (!name || typeof handler !== 'function') {
                    console.warn('[FWWebEx] Acao invalida ao registrar:', name);
                    return;
                }
                registry[name] = handler;
            }

            function execute(el, event) {
                if (!el) {
                    return;
                }

                const actionName = el.dataset.fwwebexAction;

                if (!actionName) {
                    return;
                }

                const handler = registry[actionName];

                if (typeof handler !== 'function') {
                    console.warn('[FWWebEx] Acao nao registrada:', actionName, el);
                    return;
                }

                try {
                    handler(el, event);
                } catch (err) {
                    console.error('[FWWebEx] Erro executando acao:', actionName, err);
                }
            }

            function bind(root = document) {

                let elements = [];

                if (root?.matches?.('[data-fwwebex-action]')) {
                    elements.push(root);
                }

                if (root?.querySelectorAll) {
                    elements = elements.concat(Array.from(root.querySelectorAll('[data-fwwebex-action]')));
                }

                elements.forEach(el => {

                    if (el.__fwwebexActionBound) {
                        return;
                    }

                    const eventName = el.dataset.fwwebexEvent || 'click';

                    el.addEventListener(eventName, function(event) {

                        const preventDefault = el.dataset.fwwebexPreventDefault;
                        const shouldPrevent =
                            preventDefault === undefined ||
                            String(preventDefault).toLowerCase() === 'true';

                        if (shouldPrevent && event?.preventDefault) {
                            event.preventDefault();
                        }

                        execute(el, event);
                    });

                    el.__fwwebexActionBound = true;
                });
            }

            return { register, execute, bind };

        })();

        /***********************************************************************
        * Acoes padrao
        **********************************************************************/
        FWWebEx.Actions.register('open-modal', function(el) {

            const target =
                el.dataset.target ||
                el.dataset.bsTarget ||
                el.getAttribute('href');

            if (!target || target === '#') {
                console.warn('[FWWebEx] open-modal sem target:', el);
                return;
            }

            const modalEl = document.querySelector(target);

            if (!modalEl) {
                console.warn('[FWWebEx] Modal nao encontrado:', target);
                return;
            }

            if (window.bootstrap?.Modal) {
                const modal = bootstrap.Modal.getOrCreateInstance(modalEl);
                modal.show();
                return;
            }

            if (FWWebExHasJQuery() && typeof window.jQuery(modalEl).modal === 'function') {
                window.jQuery(modalEl).modal('show');
                return;
            }

            console.warn('[FWWebEx] Nenhum motor de modal disponivel para:', target);
        });

        FWWebEx.Actions.register('close-modal', function(el) {

            const target =
                el.dataset.target ||
                el.dataset.bsTarget ||
                el.getAttribute('href');

            let modalEl = null;

            if (target && target !== '#') {
                modalEl = document.querySelector(target);
            } else {
                modalEl = el.closest('.modal');
            }

            if (!modalEl) {
                console.warn('[FWWebEx] close-modal sem modal alvo:', el);
                return;
            }

            if (window.bootstrap?.Modal) {
                const modal = bootstrap.Modal.getOrCreateInstance(modalEl);
                modal.hide();
                return;
            }

            if (FWWebExHasJQuery() && typeof window.jQuery(modalEl).modal === 'function') {
                window.jQuery(modalEl).modal('hide');
                return;
            }

            console.warn('[FWWebEx] Nenhum motor de modal disponivel para fechar:', modalEl);
        });

        FWWebEx.Actions.register('alert', function(el) {
            const message = el.dataset.message || 'OK';
            const title   = el.dataset.title   || 'Alert';
            const type    = el.dataset.type    || 'primary';
            FWWebExAlert(message, title, type, { dismissible: true });
        });

        FWWebEx.Actions.register('coming-soon', function(el) {
            const route = el.dataset.route || el.getAttribute('href') || '/';
            FWWebExShowComingSoon(route);
        });

        /***********************************************************************
        * FWWebEx.RequestHandler (v2) - agora 100% compativel
        * - Usa CustomEvent + event.detail (padrao DOM)
        * - Mantem fallback para event.protheusResponse (legado)
        * - Inclui logs de debug opcionais
        **********************************************************************/
        FWWebEx.RequestHandler = (() => {
            let _debug = true;
            const queues = new Map();
            const log = (...args) => _debug && console.log('[FWWebEx]', ...args);

            function requestError(code, message, cause) {
                const error = new Error(message);
                error.name = 'FWWebExTWebChannelError';
                error.code = code;
                if (cause) error.cause = cause;
                return error;
            }

            function enqueue(callbackEvent, operation) {
                const previous = queues.get(callbackEvent) || Promise.resolve();
                const current = previous.catch(() => false).then(operation);
                let tail = null;
                tail = current.catch(() => false).finally(() => {
                    if (queues.get(callbackEvent) === tail) {
                        queues.delete(callbackEvent);
                    }
                });
                queues.set(callbackEvent, tail);
                return current;
            }

            function startConnectingAnimation() {
                const status = document.getElementById('fwwebex-connection-status');
                if (!status) return () => {};
                const dots = [
                    document.getElementById('fwwebex_connection_status_dot1'),
                    document.getElementById('fwwebex_connection_status_dot2'),
                    document.getElementById('fwwebex_connection_status_dot3')
                ];
                let step = 0;
                status.style.display = 'inline';
                const interval = setInterval(() => {
                    dots.forEach((d, i) => d && (d.style.visibility = i <= step ? 'visible' : 'hidden'));
                    step = (step + 1) % 3;
                }, 400);
                return () => {
                    clearInterval(interval);
                    status.style.display = 'none';
                };
            }

            function waitForConnection(maxRetries = 5, interval = 1000) {
                const timeout = Math.max(1, Number(maxRetries) || 1) *
                    Math.max(1, Number(interval) || 1);
                log('Aguardando TWebChannel pelo bridge FWWebEx:', { timeout });
                return FWWebEx.TWebChannel.connect({ timeout }).then(() => true);
            }

            function execute({
                requestData,
                callbackEvent = 'CALLBACK_DATA_RESPONSE',
                execEvent = 'CALLBACK_EXEC',
                maxRetries = 5,
                interval = 1000,
                responseTimeout = 30000,
                onResponse,
                onError
            } = {}) {
                return enqueue(callbackEvent, () => {
                    const requestId = `req_${Date.now()}_${Math.random().toString(36).substr(2, 9)}`;
                    const connectionTimeout = Math.max(1, Number(maxRetries) || 1) *
                        Math.max(1, Number(interval) || 1);
                    const responseDeadline = Math.max(
                        250,
                        Number(responseTimeout) || 30000
                    );
                    const stopAnimation = startConnectingAnimation();

                    return new Promise(resolve => {
                        let responseTarget = null;
                        let responseTimer = null;
                        let settled = false;

                        const cleanup = () => {
                            if (responseTimer) clearTimeout(responseTimer);
                            responseTarget?.removeEventListener(callbackEvent, handleResponse);
                            stopAnimation();
                        };
                        const notifyError = error => {
                            console.error('[FWWebEx] Erro no request:', error);
                            try {
                                onError?.(error);
                            } catch (callbackError) {
                                console.error('[FWWebEx] Erro no onError:', callbackError);
                            }
                        };
                        const fail = error => {
                            if (settled) return;
                            settled = true;
                            cleanup();
                            notifyError(error);
                            resolve(false);
                        };
                        const handleResponse = event => {
                            if (settled) return;
                            log('Evento recebido:', event);
                            const data = event.detail ?? event.protheusResponse;
                            if (data === undefined || data === null) {
                                log('Evento sem payload esperado - ignorado');
                                return;
                            }
                            settled = true;
                            cleanup();
                            try {
                                onResponse?.(data);
                                resolve(true);
                            } catch (error) {
                                notifyError(error);
                                resolve(false);
                            }
                        };

                        waitForConnection(maxRetries, interval)
                            .then(() => {
                                if (settled) return false;
                                responseTarget = FWWebEx.TWebChannel.getEventTarget();
                                responseTarget.addEventListener(callbackEvent, handleResponse);
                                responseTimer = setTimeout(() => fail(requestError(
                                    'FWWEBEX_TWEBCHANNEL_RESPONSE_TIMEOUT',
                                    'O Protheus nao respondeu ao request ' + requestId +
                                        ' dentro do prazo.'
                                )), responseDeadline);
                                return FWWebEx.TWebChannel.send(
                                    execEvent,
                                    JSON.stringify({ ...requestData, requestId }),
                                    { timeout: connectionTimeout }
                                );
                            })
                            .catch(error => fail(error));
                    });
                });
            }

            function debug(flag = true) { _debug = !!flag; }
            return { execute, waitForConnection, startConnectingAnimation, debug };
        })();

        /**
        * =============================================================================
        * FWWebEx.Ready.withDependencies
        * =============================================================================
        *
        * Aguarda multiplos eventos de "ready" antes de executar um callback.
        *
        * Este metodo implementa um mecanismo declarativo de dependencias entre
        * componentes/features do FWWebEx, permitindo que modulos sejam carregados
        * de forma desacoplada e sincronizada atraves do sistema de eventos.
        *
        * -----------------------------------------------------------------------------
        * CONCEITO
        * -----------------------------------------------------------------------------
        * Em vez de depender da ordem de carregamento de scripts ou uso de polling
        * (setTimeout/setInterval), este metodo utiliza eventos explicitos de readiness.
        *
        * Cada dependencia deve emitir um evento no padrao:
        *
        *     FWWebEx.Events.emit('<namespace>:ready')
        *
        * Exemplo:
        *     FWWebEx.Events.emit('FWWebEx:ascii:ready')
        *
        * -----------------------------------------------------------------------------
        * PARAMETROS
        * -----------------------------------------------------------------------------
        * @param {Array<string>} deps
        * Lista de eventos que devem ser aguardados antes da execucao do callback.
        *
        * Exemplo:
        * [
        *   'FWWebEx:jquery:ready',
        *   'FWWebEx:ascii:ready'
        * ]
        *
        * @param {Function} callback
        * Funcao executada apos todas as dependencias terem sido resolvidas.
        *
        * Recebe como argumento um objeto "state" contendo o status das dependencias:
        *
        * {
        *   'FWWebEx:jquery:ready': true,
        *   'FWWebEx:ascii:ready' : true
        * }
        *
        * -----------------------------------------------------------------------------
        * COMPORTAMENTO
        * -----------------------------------------------------------------------------
        * - Cada dependencia e escutada utilizando FWWebEx.Events.once
        * - O callback sera executado apenas UMA vez
        * - A ordem dos eventos NAO importa
        * - Nao ha polling ou verificacao ativa (event-driven)
        *
        * -----------------------------------------------------------------------------
        * EXEMPLO DE USO
        * -----------------------------------------------------------------------------
        *
        * FWWebEx.Ready.withDependencies(
        *     [
        *         'FWWebEx:jquery:ready',
        *         'FWWebEx:ascii:ready'
        *     ],
        *     function (state) {
        *         FWWebExAsciiEngine.start({
        *             id: 'loader',
        *             script: '...'
        *         });
        *     }
        * );
        *
        * -----------------------------------------------------------------------------
        * BOAS PRATICAS
        * -----------------------------------------------------------------------------
        * - Cada feature deve ser responsavel por emitir seu proprio evento de ready
        * - Evite dependencias implicitas (ex: assumir que jQuery ja esta carregado)
        * - Use nomes de eventos padronizados: "FWWebEx:<feature>:ready"
        *
        * -----------------------------------------------------------------------------
        * LIMITACOES
        * -----------------------------------------------------------------------------
        * - Caso um evento nunca seja emitido, o callback nao sera executado
        * - Nao possui timeout nativo (pode ser implementado externamente)
        *
        * -----------------------------------------------------------------------------
        * VISAO ARQUITETURAL
        * -----------------------------------------------------------------------------
        * Este metodo e base para um modelo de carregamento orientado a eventos,
        * permitindo evolucao para:
        *
        * - Sistema de plugins/features com dependsOn
        * - Gerenciador de assets com prioridade
        * - Bootstrapping modular do FWWebEx
        *
        * Em essencia:
        *     "Nao pergunte se esta pronto. Espere ser avisado."
        *
        * =============================================================================
        */
        FWWebEx.Ready.withDependencies = function(deps, callback) {

            const state = {};
            let remaining = deps.length;

            deps.forEach(dep => {
                FWWebEx.Events.once(dep, () => {
                    state[dep] = true;
                    remaining--;

                    if (remaining === 0) {
                        callback(state);
                    }
                });
            });
        };

        /**
        * Executor generico FWWebEx para WS, REST Basic, REST OAuth2 e Link Direto
        * Executa acao a partir de um link/menu/card
        * @param {Object} options
        *   type: 'ws' | 'rest-basic' | 'rest-oauth2' | 'link'
        *   url: endpoint ou rota
        *   data: payload (objeto)
        *   target: seletor do elemento para renderizar ou 'overlay'
        *   auth: { user, pass } para basic ou { token } para oauth2
        *   ws: { action, callbackEvent, execEvent }
        */
        function FWWebExExecute(options) {
            const { type, url, data, target, auth, ws } = options;

            if (type === 'ws') {
                FWWebEx.RequestHandler.execute({
                    requestData: { ...data },
                    callbackEvent: ws?.callbackEvent || 'CALLBACK_DATA_RESPONSE',
                    execEvent: ws?.execEvent || 'CALLBACK_EXEC',
                    onResponse: (response) => FWWebExRenderResponse(response, target),
                    onError: (err) => console.error('Erro WS:', err)
                });
            }
            else if (type === 'rest-basic') {
                fetch(url, {
                    method: 'POST',
                    headers: {
                        'Authorization': 'Basic ' + btoa(`${auth.user}:${auth.pass}`),
                        'Content-Type': 'application/json'
                    },
                    body: JSON.stringify(data || {})
                })
                .then(r => r.text())
                .then(content => FWWebExRenderResponse(content, target))
                .catch(err => console.error('Erro REST Basic:', err));
            }
            else if (type === 'rest-oauth2') {
                let token = auth?.token;

                if (!token) {
                    try {
                        const erpTokenData = JSON.parse(sessionStorage.getItem('ERPTOKEN') || '{}');
                        if (erpTokenData?.access_token) {
                            token = erpTokenData.access_token;
                        }
                    } catch (e) {
                        console.warn('Nao foi possivel ler o ERPTOKEN:', e);
                    }
                }

                if (!token) {
                    console.error('Token OAuth2 nao encontrado! Verifique login ou configuracao.');
                    return;
                }

                fetch(url, {
                    method: 'POST',
                    headers: {
                        'Authorization': `Bearer ${token}`,
                        'Content-Type': 'application/json'
                    },
                    body: JSON.stringify(data || {})
                })
                .then(r => r.text())
                .then(content => FWWebExRenderResponse(content, target))
                .catch(err => console.error('Erro REST OAuth2:', err));
            }
            else if (type === 'link') {
                fetch(url)
                    .then(r => r.text())
                    .then(content => FWWebExRenderResponse(content, target))
                    .catch(err => console.error('Erro Link Direto:', err));
            }
        }

        /**
        * Renderiza resposta no destino ou overlay
        */
        function FWWebExRenderResponse(content, target) {
            if (target === 'overlay') {
                FWWebExShowOverlay(content);
            } else if (target && document.querySelector(target)) {
                document.querySelector(target).innerHTML = content;
                FWWebEx.Actions.bind(document.querySelector(target));
            } else {
                console.warn('Destino nao encontrado:', target);
            }
        }

        /**
        * Mostra sobreposicao
        */
        function FWWebExShowOverlay(html) {
            let overlay = document.getElementById('fwwebex-overlay');
            if (!overlay) {
                overlay = document.createElement('div');
                overlay.id = 'fwwebex-overlay';
                overlay.style.cssText = `
                    position: fixed; top:0; left:0; width:100%; height:100%;
                    background: rgba(0,0,0,0.7); z-index: 99999; padding:2rem; overflow:auto;
                `;
                document.body.appendChild(overlay);
                overlay.addEventListener('click', e => {
                    if (e.target.id === 'fwwebex-overlay') overlay.remove();
                });
            }
            overlay.innerHTML = `<div style="background:white;padding:1rem;border-radius:8px;">${html}</div>`;
            FWWebEx.Actions.bind(overlay);
        }

        /**
        * Captura cliques em qualquer elemento com data-fwwebex-action-type
        */
        document.addEventListener('click', function (e) {
            const el = e.target.closest('[data-fwwebex-action-type]');
            if (el) {
                e.preventDefault();
                FWWebExExecute({
                    type: el.dataset.fwwebexActionType,
                    url: el.dataset.fwwebexUrl,
                    target: el.dataset.fwwebexTarget || 'overlay',
                    data: el.dataset.fwwebexPayload ? JSON.parse(el.dataset.fwwebexPayload) : {},
                    auth: el.dataset.fwwebexAuth ? JSON.parse(el.dataset.fwwebexAuth) : {},
                    ws: el.dataset.fwwebexWs ? JSON.parse(el.dataset.fwwebexWs) : {}
                });
            }
        });

        /** Helper function
        * Creates and displays a customizable modal dialog using Bootstrap styling, similar to WebExDataTableFilterPanelEx.
        */
        function FWWebExAlert(message, title = 'Alert', type = 'primary', options = {}) {
            const defaultOptions = {
                autoClose: false,
                autoCloseDelay: 5000,
                dismissible: true,
                target: document.body,
                detailed: false
            };
            const settings = { ...defaultOptions, ...options };

            if (!message || typeof message !== 'string') {
                console.error('FWWebExAlert: Message is required and must be a string.');
                return null;
            }
            if (!['primary', 'secondary', 'success', 'danger', 'warning', 'info', 'light', 'dark'].includes(type)) {
                console.warn(`FWWebExAlert: Invalid type '${type}'. Defaulting to 'primary'.`);
                type = 'primary';
            }
            if (!settings.target || !settings.target.appendChild) {
                console.error('FWWebExAlert: Invalid target element. Using document.body.');
                settings.target = document.body;
            }

            const iconMap = {
                primary: 'bi-info-circle-fill',
                secondary: 'bi-info-circle-fill',
                success: 'bi-check-circle-fill',
                danger: 'bi-exclamation-circle-fill',
                warning: 'bi-exclamation-triangle-fill',
                info: 'bi-info-circle-fill',
                light: 'bi-info-circle-fill',
                dark: 'bi-info-circle-fill'
            };

            try {
                const modalId = 'fwwebex-alert-modal-' + Date.now();
                const dialogId = modalId + '-dialog';
                const contentId = modalId + '-content';

                const modalDiv = document.createElement('div');
                modalDiv.id = modalId;
                modalDiv.className = `modal fade ${settings.dismissible ? '' : 'modal-static'}`;
                modalDiv.setAttribute('tabindex', '-1');
                modalDiv.setAttribute('role', 'dialog');
                modalDiv.style.display = 'block';

                let modalBodyContent = '';
                if (settings.detailed && message.length > 100) {
                    modalBodyContent = `
                        <textarea class="form-control" rows="5" readonly>${message}</textarea>
                    `;
                } else {
                    modalBodyContent = `<p>${message}</p>`;
                }

                modalDiv.innerHTML = `
                    <div class="modal-dialog modal-dialog-centered modal-lg" id="${dialogId}" role="document">
                        <div class="modal-content" id="${contentId}">
                            <div class="modal-header bg-${type} text-white">
                                <h5 class="modal-title"><i class="bi ${iconMap[type]} me-2"></i>${title}</h5>
                                ${settings.dismissible ? '<button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>' : ''}
                            </div>
                            <div class="modal-body">
                                ${modalBodyContent}
                            </div>
                            <div class="modal-footer">
                                <button type="button" class="btn btn-${type}" data-bs-dismiss="modal">OK</button>
                            </div>
                        </div>
                    </div>
                `;

                settings.target.appendChild(modalDiv);

                if (typeof bootstrap !== 'undefined' && bootstrap.Modal) {
                    const bsModal = new bootstrap.Modal(modalDiv, {
                        backdrop: settings.dismissible ? 'static' : true,
                        keyboard: settings.dismissible,
                        focus: true
                    });

                    bsModal.show();

                    if (settings.autoClose) {
                        setTimeout(() => {
                            bsModal.hide();
                        }, settings.autoCloseDelay);
                    }

                    modalDiv.addEventListener('hidden.bs.modal', () => {
                        if (modalDiv.parentNode) {
                            modalDiv.parentNode.removeChild(modalDiv);
                        }
                    });
                } else {
                    console.warn('FWWebExAlert: Bootstrap JS not loaded. Modal will be static.');
                    modalDiv.classList.add('show');
                    modalDiv.style.display = 'block';
                    document.body.classList.add('modal-open');
                }

                return modalDiv;
            } catch (error) {
                console.error('FWWebExAlert: Failed to create modal:', error);
                return null;
            }
        }

        function FWWebExDecodeHTMLEntities(text) {
            const txt = document.createElement("textarea");
            txt.innerHTML = text;
            return txt.value;
        }

        function FWWebExShowComingSoon(route) {
            FWWebExAlert(FWWebExDecodeHTMLEntities('Rota '+route+' ainda n&atilde;o implementada!'), 'Info' ,'info', { dismissible: true });
        }

        function FWWebExAllTrim(str) {
            if (typeof str !== "string") {
                throw new TypeError("Input must be a string");
            }
            return str.trim().replace(/\s+/g, " ");
        }

        /***********************************************************************
        * FWWebEx.init
        * - Inicializador configuravel do runtime
        * - Hooks: beforeInit, afterInit, onError
        **********************************************************************/
        FWWebEx.Lifecycle = (() => {

            const DEFAULT_CONFIG = {
                ready: {
                    jquery: {
                        timeout: 4000,
                        interval: 25,
                        optional: false
                    },
                    bootstrap: {
                        timeout: 4000,
                        interval: 25,
                        optional: false
                    },
                    datatable: {
                        timeout: 2000,
                        interval: 25,
                        optional: true
                    }
                },
                features: {
                    ui: true,
                    jquery: true,
                    bootstrap: true,
                    datatable: true
                },
                actions: {
                    autoBind: true,
                    observeMutations: true
                },
                hooks: {
                    beforeInit: null,
                    afterInit: null,
                    onError: null
                }
            };

            let mutationObserver = null;

            function isPlainObject(value) {
                return Object.prototype.toString.call(value) === '[object Object]';
            }

            function mergeConfig(target, source) {
                Object.keys(source || {}).forEach(key => {
                    const sourceValue = source[key];
                    const targetValue = target[key];

                    if (isPlainObject(sourceValue)) {
                        target[key] = mergeConfig(
                            isPlainObject(targetValue) ? targetValue : {},
                            sourceValue
                        );
                    } else {
                        target[key] = sourceValue;
                    }
                });

                return target;
            }

            function buildConfig(config) {
                return mergeConfig(
                    mergeConfig({}, DEFAULT_CONFIG),
                    mergeConfig(mergeConfig({}, FWWebEx.config || {}), config || {})
                );
            }

            function callHook(name, config, payload) {
                const hook = config?.hooks?.[name];

                if (!hook) {
                    return;
                }

                const hooks = Array.isArray(hook) ? hook : [hook];

                hooks.forEach(fn => {
                    if (typeof fn === 'function') {
                        fn(payload || config, FWWebEx.state, FWWebEx);
                    }
                });
            }

            function handleError(error, config, phase) {
                FWWebEx.state.initializing = false;
                FWWebEx.state.lastError = error;

                console.error('[FWWebEx] Erro no bootstrap:', error);

                try {
                    callHook('onError', config || {}, {
                        phase,
                        error
                    });
                } catch (hookError) {
                    console.error('[FWWebEx] Erro no hook onError:', hookError);
                }

                FWWebEx.Events.emit('FWWebEx:init:error', {
                    phase,
                    error
                });
            }

            function startReadyChecks(config) {
                if (config.features.ui !== false) {
                    FWWebEx.Ready.ui();
                }

                if (config.features.jquery !== false) {
                    FWWebEx.Ready.jquery(config.ready.jquery);
                }

                if (config.features.bootstrap !== false) {
                    FWWebEx.Ready.bootstrap(config.ready.bootstrap);
                }

                if (config.features.datatable !== false) {
                    FWWebEx.Ready.datatable(config.ready.datatable);
                }
            }

            function bindActions(config) {
                if (config.actions.autoBind === false) {
                    return;
                }

                FWWebEx.Events.on('FWWebEx:ui:ready', function () {
                    FWWebEx.Actions.bind(document);
                });

                if (
                    config.actions.observeMutations !== false &&
                    window.MutationObserver &&
                    document.body &&
                    !mutationObserver
                ) {
                    mutationObserver = new MutationObserver(function(mutations) {
                        mutations.forEach(function(mutation) {
                            mutation.addedNodes.forEach(function(node) {
                                if (node.nodeType === 1) {
                                    FWWebEx.Actions.bind(node);
                                }
                            });
                        });
                    });

                    mutationObserver.observe(document.body, {
                        childList: true,
                        subtree: true
                    });
                }
            }

            function init(config = {}) {
                config = config || {};

                if (FWWebEx.state.initialized && config.force !== true) {
                    return FWWebEx.state;
                }

                if (FWWebEx.state.initializing) {
                    return FWWebEx.state;
                }

                const resolvedConfig = buildConfig(config);

                FWWebEx.config = resolvedConfig;
                FWWebEx.state.config = resolvedConfig;
                FWWebEx.state.initializing = true;

                try {
                    FWWebEx.Events.emit('FWWebEx:init:before', {
                        config: resolvedConfig
                    });

                    callHook('beforeInit', resolvedConfig);

                    startReadyChecks(resolvedConfig);
                    bindActions(resolvedConfig);

                    FWWebEx.state.initialized = true;
                    FWWebEx.state.initializing = false;
                    FWWebEx.state.initCount += 1;

                    FWWebEx.Events.emit('FWWebEx:init:after', {
                        config: resolvedConfig,
                        state: FWWebEx.state
                    });

                    callHook('afterInit', resolvedConfig);
                } catch (error) {
                    handleError(error, resolvedConfig, 'init');
                }

                return FWWebEx.state;
            }

            function getConfig() {
                return FWWebEx.config || buildConfig();
            }

            function isInitialized() {
                return !!FWWebEx.state.initialized;
            }

            return { init, getConfig, isInitialized };

        })();

        FWWebEx.init = FWWebEx.Lifecycle.init;
        FWWebEx.getConfig = FWWebEx.Lifecycle.getConfig;
        FWWebEx.isInitialized = FWWebEx.Lifecycle.isInitialized;

        /***********************************************************************
        * Bootstrap do runtime
        **********************************************************************/
        FWWebEx.ready(function () {
            FWWebEx.init();
        });
    endContent

    cPageScript:=WebExHelper():StrReplace(;
        cPageScript;
        ,{"__FWWEBEX_TWEBCHANNEL_PLATFORM_SOURCE__":cTWebChannelURI};
    )

return(cPageScript)
