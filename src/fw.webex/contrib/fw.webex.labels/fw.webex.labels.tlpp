        }
        let measured=measure(size);
        if(fit.mode==="shrink"){
            while(!measured.fits && size>minimum){
                size=Math.max(minimum,size-0.25); measured=measure(size);
            }
        }
        lines=measured.lines;
        if(!measured.fits){
            const policy=fit.overflow||"error";
            if(policy==="error"){
                const referenceSize=fit.mode==="shrink"?minimum:size;
                const referenceMeasure=measure(referenceSize),referenceLines=referenceMeasure.lines;
                const requiredHeight=referenceMeasure.height+padding.top+padding.bottom;
                const singleLineWidth=pdf.getTextWidth(text)+padding.left+padding.right;
                const fitMessage=fit.mode==="shrink"?
                    " sem reduzir abaixo de "+minimum.toFixed(2)+" pt.":
                    " no tamanho configurado de "+size.toFixed(2)+" pt.";
