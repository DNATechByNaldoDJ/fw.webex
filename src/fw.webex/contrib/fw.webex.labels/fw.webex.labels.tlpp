namespace FWWebEx

#include "fw.webex.th"

class WebExFeatureLabels from WebExControl
    protected data oFeature as object
    public method Enable() as object
    public method Load(oControl as object) as object
endclass

class WebExLabelDesigner from WebExDiv
    protected data oDesignerScript as object
    protected data nLabelWidth as numeric
    protected data nLabelHeight as numeric
    protected data cInitialLayout as character
    protected data cInitialRecords as character
    protected data cDesignerOptions as character
    public method New(nLabelWidth as numeric,nLabelHeight as numeric) as object
    public method SetLayout(xLayout as variant) as object
    public method SetRecords(xRecords as variant) as object
    public method SetOptions(xOptions as variant) as object
    public method RenderHTML() as character
endclass

class WebExLabelPDFGenerator from WebExDiv
    protected data oFacadeScript as object
    public method New() as object
    public method RenderHTML() as character
endclass

method Enable() class WebExFeatureLabels
    local oFeature as object
    _Super:New()
    WebExFeatureJsPDF():Enable(30)
    ::oFeature:=self
    oFeature:=::oFeature
    ::AddFeature(oFeature,{|oControl|oFeature:Load(oControl)},35)
return(self)

method Load(oControl) class WebExFeatureLabels
    local cStyle as character
    local cRuntime as character
    paramtype 1 var oControl as object
    beginContent var cStyle
.fwwebex-label-designer,.fwwebex-label-generator-panel{
    --fw-label-bg:var(--bs-body-bg,#fff);
    --fw-label-surface:var(--bs-tertiary-bg,#f4f6f8);
    --fw-label-border:var(--bs-border-color,#cbd2d9);
    --fw-label-text:var(--bs-body-color,#20262d);
    --fw-label-muted:var(--bs-secondary-color,#68737d);
    --fw-label-primary:var(--bs-primary,#0d6efd);
    --fw-label-success:var(--bs-success,#198754);
    --fw-label-warning:#ffc107;
    --fw-label-danger:var(--bs-danger,#dc3545);
    --fw-label-stage-bg:#fff;
    color:var(--fw-label-text);font:13px/1.35 Arial,sans-serif;min-width:0
}
.fwwebex-label-designer *,.fwwebex-label-generator-panel *{box-sizing:border-box}
.fwwebex-label-designer [hidden]{display:none!important}
.fwwebex-label-toolbar,.fwwebex-label-quickbar,.fwwebex-label-toolbar-cluster,
.fwwebex-label-modebar,.fwwebex-label-panel-head,.fwwebex-label-tablist,
.fwwebex-label-statusbar,.fwwebex-label-generator-actions{
    display:flex;align-items:center;gap:.35rem;flex-wrap:wrap
}
.fwwebex-label-toolbar{
    display:block;padding:.3rem;border:1px solid var(--fw-label-border);border-radius:.4rem;
    background:var(--fw-label-surface);margin-bottom:.45rem;overflow:visible
}
.fwwebex-label-quickbar{justify-content:space-between;min-height:34px}
.fwwebex-label-quickbar-primary,.fwwebex-label-quickbar-actions{
    display:flex;align-items:center;gap:.35rem;flex-wrap:wrap
}
.fwwebex-label-canvas-head-actions{display:flex;align-items:center;gap:.35rem}
.fwwebex-label-toolbar-cluster{padding:.35rem 0 0}
.fwwebex-label-designer button,.fwwebex-label-generator-panel button{
    min-height:28px;padding:.25rem .5rem;border:1px solid transparent;border-radius:.3rem;
    color:#fff;background:var(--fw-label-primary);font:600 11px/1.2 Arial,sans-serif;
    cursor:pointer;white-space:nowrap
}
.fwwebex-label-designer button:hover,.fwwebex-label-generator-panel button:hover{filter:brightness(.93)}
.fwwebex-label-designer button:focus-visible,.fwwebex-label-generator-panel button:focus-visible,
.fwwebex-label-designer input:focus-visible,.fwwebex-label-designer select:focus-visible,
.fwwebex-label-designer textarea:focus-visible,.fwwebex-label-generator-panel input:focus-visible,
.fwwebex-label-generator-panel select:focus-visible,.fwwebex-label-generator-panel textarea:focus-visible{
    outline:2px solid var(--fw-label-primary);outline-offset:1px
}
.fwwebex-label-designer button[data-tone=success],
.fwwebex-label-generator-panel button[data-tone=success]{background:var(--fw-label-success)}
.fwwebex-label-designer button[data-tone=warning]{background:#9a7200}
.fwwebex-label-designer button[data-tone=danger]{background:var(--fw-label-danger)}
.fwwebex-label-designer button[aria-pressed=true]{box-shadow:inset 0 0 0 2px #fff8}
.fwwebex-label-designer input,.fwwebex-label-designer select,.fwwebex-label-designer textarea,
.fwwebex-label-generator-panel input,.fwwebex-label-generator-panel select,
.fwwebex-label-generator-panel textarea{
    width:100%;min-height:28px;padding:.25rem .4rem;border:1px solid var(--fw-label-border);
    border-radius:.3rem;background:var(--fw-label-bg);color:var(--fw-label-text);font-size:11px
}
.fwwebex-label-toolbar select,.fwwebex-label-toolbar input{width:auto;max-width:125px}
.fwwebex-label-tablist{
    flex-wrap:nowrap;overflow-x:auto;min-width:0;border-bottom:1px solid var(--fw-label-border)
}
.fwwebex-label-tablist button[role=tab]{
    flex:0 0 auto;min-height:27px;padding:.28rem .55rem;border:0;border-bottom:2px solid transparent;
    border-radius:.3rem .3rem 0 0;color:var(--fw-label-muted);background:transparent;
    box-shadow:none
}
.fwwebex-label-tablist button[role=tab]:hover{color:var(--fw-label-text);background:#0d6efd12}
.fwwebex-label-tablist button[role=tab][aria-selected=true]{
    color:var(--fw-label-primary);background:var(--fw-label-bg);
    border-bottom-color:var(--fw-label-primary);box-shadow:none
}
.fwwebex-label-tablist button[role=tab][aria-disabled=true]{opacity:.48;cursor:not-allowed}
.fwwebex-label-tabpanel{min-width:0;padding:.45rem}
.fwwebex-label-tabpanel[hidden]{display:none!important}
.fwwebex-label-toolbar-tabs{margin-top:.25rem}
.fwwebex-label-toolbar-tabs>.fwwebex-label-tabpanel{padding:.2rem 0 0}
.fwwebex-label-settings{position:relative}
.fwwebex-label-settings>summary{
    min-height:28px;padding:.35rem .55rem;border-radius:.3rem;color:#fff;
    background:var(--fw-label-primary);font:600 11px/1.2 Arial,sans-serif;
    cursor:pointer;list-style:none;white-space:nowrap
}
.fwwebex-label-settings>summary::-webkit-details-marker{display:none}
.fwwebex-label-settings[open]>summary{box-shadow:inset 0 0 0 2px #fff8}
.fwwebex-label-settings-panel{
    position:absolute;right:0;top:calc(100% + .35rem);z-index:100;
    width:min(430px,calc(100vw - 2rem));padding:.55rem;border:1px solid var(--fw-label-border);
    border-radius:.4rem;background:var(--fw-label-surface);box-shadow:0 6px 22px #0004
}
.fwwebex-label-settings-grid{
    display:grid;grid-template-columns:repeat(3,minmax(100px,1fr));gap:.4rem
}
.fwwebex-label-settings-grid label{
    display:flex;flex-direction:column;gap:.15rem;color:var(--fw-label-muted);font-size:10px
}
.fwwebex-label-settings-panel input,.fwwebex-label-settings-panel select{
    width:100%;max-width:none
}
.fwwebex-label-settings-actions{display:flex;justify-content:flex-end;margin-top:.45rem}
.fwwebex-label-arrange-settings .fwwebex-label-settings-panel{
    left:0;right:auto;width:min(620px,calc(100vw - 2rem))
}
.fwwebex-label-background-settings .fwwebex-label-settings-panel,
.fwwebex-label-page-settings .fwwebex-label-settings-panel{left:0;right:auto}
.fwwebex-label-arrange-actions{
    display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:.35rem;margin-top:.45rem
}
.fwwebex-label-arrange-actions button{white-space:normal}
.fwwebex-label-workspace{
    display:grid;grid-template-columns:210px minmax(320px,1fr) 310px;
    grid-template-areas:"layers canvas inspector";gap:.5rem;align-items:stretch
}
.fwwebex-label-workspace[data-elements-collapsed=true],
.fwwebex-label-workspace[data-show-layers=false]{
    grid-template-columns:minmax(320px,1fr) 310px;grid-template-areas:"canvas inspector"
}
.fwwebex-label-workspace[data-show-inspector=false]{
    grid-template-columns:210px minmax(320px,1fr);grid-template-areas:"layers canvas"
}
.fwwebex-label-workspace[data-elements-collapsed=true][data-show-inspector=false],
.fwwebex-label-workspace[data-show-layers=false][data-show-inspector=false]{
    grid-template-columns:minmax(320px,1fr);grid-template-areas:"canvas"
}
.fwwebex-label-pane{
    min-width:0;border:1px solid var(--fw-label-border);border-radius:.4rem;
    background:var(--fw-label-surface);overflow:hidden
}
.fwwebex-label-layers{grid-area:layers}.fwwebex-label-canvas-pane{grid-area:canvas}
.fwwebex-label-inspector{grid-area:inspector}
.fwwebex-label-layers[data-minimized=true]>.fwwebex-label-panel-body{display:none}
.fwwebex-label-panel-head{
    justify-content:space-between;padding:.35rem .45rem;border-bottom:1px solid var(--fw-label-border);
    font-weight:700;font-size:11px
}
.fwwebex-label-panel-toggle{min-height:22px!important;padding:.12rem .35rem!important;font-size:10px!important}
.fwwebex-label-panel-body{padding:.45rem;overflow:auto}
.fwwebex-label-layers>.fwwebex-label-panel-body,
.fwwebex-label-inspector>.fwwebex-label-panel-body{padding:0}
.fwwebex-label-canvas-pane .fwwebex-label-panel-body{padding:.5rem}
.fwwebex-label-stage-viewport{position:relative;overflow:auto;min-height:340px;padding:22px .5rem .5rem 22px;background:#20262d}
.fwwebex-label-ruler{position:absolute;color:#d5dbe1;font:9px/1 Arial;pointer-events:none;z-index:3}
.fwwebex-label-ruler.is-x{left:22px;right:.5rem;top:4px;height:16px}
.fwwebex-label-ruler.is-y{left:3px;top:22px;bottom:.5rem;width:17px}
.fwwebex-label-ruler span{position:absolute;white-space:nowrap}
.fwwebex-label-ruler.is-x span{transform:translateX(-50%)}
.fwwebex-label-ruler.is-y span{transform:translateY(-50%)}
.fwwebex-label-stage{
    position:relative;width:100%;max-width:1000px;margin:auto;background:var(--fw-label-stage-bg);
    box-shadow:0 2px 14px #0005;overflow:hidden;touch-action:none;transform-origin:top left
}
.fwwebex-label-stage>[data-role=background],.fwwebex-label-stage>[data-role=fields],
.fwwebex-label-stage>[data-role=preview-canvas],.fwwebex-label-stage>[data-role=grid-overlay],
.fwwebex-label-stage>[data-role=page-guides],.fwwebex-label-stage>[data-role=snap-guides]{
    position:absolute;inset:0;width:100%;height:100%
}
.fwwebex-label-stage>[data-role=background]{object-fit:fill;pointer-events:none}
.fwwebex-label-stage>[data-role=preview-canvas]{display:none;border:0;pointer-events:none;background:#fff}
.fwwebex-label-stage>[data-role=grid-overlay]{
    display:none;pointer-events:none;background-image:linear-gradient(to right,#0d6efd22 1px,transparent 1px),
        linear-gradient(to bottom,#0d6efd22 1px,transparent 1px);
    background-size:var(--fw-label-grid-x,10px) var(--fw-label-grid-y,10px)
}
.fwwebex-label-stage.has-grid>[data-role=grid-overlay]{display:block}
.fwwebex-label-stage>[data-role=page-guides]{pointer-events:none}
.fwwebex-label-stage>[data-role=snap-guides]{pointer-events:none;z-index:10020;overflow:visible}
.fwwebex-label-snap-guide{position:absolute;display:block;pointer-events:none;color:#b000f5}
.fwwebex-label-snap-guide[data-axis=x]{top:0;bottom:0;border-left:1px solid currentColor}
.fwwebex-label-snap-guide[data-axis=y]{left:0;right:0;border-top:1px solid currentColor}
.fwwebex-label-snap-guide span{
    position:absolute;left:3px;top:3px;padding:1px 4px;border-radius:3px;
    color:#fff;background:#7000a8e8;font:600 9px/1.25 Arial,sans-serif;white-space:nowrap
}
.fwwebex-label-snap-guide[data-axis=y] span{top:3px}
.fwwebex-label-page-guide{position:absolute;border:1px dashed #fd7e14aa;pointer-events:none}
.fwwebex-label-page-guide.is-safe{border-color:#198754aa}
.fwwebex-label-selection-box{
    position:absolute;display:none;border:1px solid var(--fw-label-primary);background:#0d6efd18;
    pointer-events:none;z-index:9999
}
.fwwebex-label-field{
    position:absolute;display:flex;align-items:center;justify-content:center;border:1px dashed var(--fw-label-primary);
    background:#0d6efd20;color:#111;font:600 12px Arial;cursor:move;user-select:none;
    transform-origin:center center;overflow:visible
}
.fwwebex-label-field-content{display:flex;width:100%;height:100%;box-sizing:border-box}
.fwwebex-label-field.type-barcode{font-family:monospace;background:#19875420;border-color:var(--fw-label-success)}
.fwwebex-label-field.type-barcode>.fwwebex-label-field-content{align-items:center;justify-content:center}
.fwwebex-label-field.is-selected{outline:2px solid var(--fw-label-danger)}
.fwwebex-label-field.is-primary{outline-style:solid}
.fwwebex-label-field.is-reference{box-shadow:0 0 0 3px var(--fw-label-warning)}
.fwwebex-label-field.is-reference:before{
    content:"\25c6";position:absolute;left:-7px;top:-9px;color:#9a7200;font-size:10px
}
.fwwebex-label-field.is-locked{cursor:not-allowed;border-style:solid;opacity:.82}
.fwwebex-label-field.is-locked:after{content:"\1F512";position:absolute;right:2px;top:0;font-size:11px}
.fwwebex-label-field.has-overflow{border-color:var(--fw-label-danger);background:#dc354530}
.fwwebex-label-field.has-unresolved{border-color:var(--fw-label-danger);background:#dc354535}
.fwwebex-label-field.has-issue-warning{box-shadow:inset 0 0 0 2px var(--fw-label-warning)}
.fwwebex-label-field.has-issue-error{box-shadow:inset 0 0 0 2px var(--fw-label-danger)}
.fwwebex-label-field i{
    display:none;position:absolute;right:-5px;bottom:-5px;width:11px;height:11px;
    background:var(--fw-label-danger);border-radius:50%;cursor:nwse-resize
}
.fwwebex-label-field.is-selected i{display:block}.fwwebex-label-field.is-locked i{display:none}
.fwwebex-label-field.type-container{
    background:#ffc10718;border:2px dashed var(--fw-label-warning);color:#664d03;
    align-items:flex-start;justify-content:flex-start;padding:3px
}
.fwwebex-label-field.type-container>.fwwebex-label-field-content{align-items:flex-start;justify-content:flex-start}
.fwwebex-label-field.type-container.is-empty:after{
    content:"Area sem componentes";position:absolute;inset:auto 3px 3px;color:#8a6800;font-size:10px
}
.fwwebex-label-layer-list{list-style:none;margin:0;padding:0}
.fwwebex-label-layers [data-role=layer-search]{margin-bottom:.4rem}
.fwwebex-label-add-grid{display:grid;grid-template-columns:1fr;gap:.4rem}
.fwwebex-label-add-grid button{
    display:flex;justify-content:flex-start;align-items:center;width:100%;min-height:34px
}
.fwwebex-label-add-hint{margin:.45rem 0 0;color:var(--fw-label-muted);font-size:10px}
.fwwebex-label-layer{
    display:grid;grid-template-columns:1fr auto auto;align-items:center;gap:.2rem;
    padding:.25rem;border-bottom:1px solid var(--fw-label-border);cursor:pointer
}
.fwwebex-label-layer.is-selected{background:#0d6efd22}.fwwebex-label-layer[data-depth="1"]{padding-left:1rem}
.fwwebex-label-layer[data-depth="2"]{padding-left:1.75rem}
.fwwebex-label-layer button{min-height:22px;padding:.1rem .25rem;background:transparent;color:var(--fw-label-text)}
.fwwebex-label-form-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:.35rem}
.fwwebex-label-form-grid label{display:flex;flex-direction:column;gap:.12rem;color:var(--fw-label-muted);font-size:10px}
.fwwebex-label-form-grid .is-wide{grid-column:1/-1}
.fwwebex-label-drawers{
    margin-top:.5rem;min-height:205px;max-height:58vh;overflow:auto;resize:vertical
}
.fwwebex-label-drawers[data-collapsed=true]{min-height:0;height:auto!important;resize:none}
.fwwebex-label-drawers[data-collapsed=true] .fwwebex-label-drawer-content{display:none}
.fwwebex-label-drawer-head{border-bottom:1px solid var(--fw-label-border)}
.fwwebex-label-drawer-head .fwwebex-label-tablist{flex:1;border-bottom:0}
.fwwebex-label-drawer-content{min-height:150px}
.fwwebex-label-drawer textarea{min-height:170px;resize:vertical;font:11px/1.35 Consolas,monospace}
.fwwebex-label-drawer-actions{margin-top:.4rem;padding:0;border:0;background:transparent}
.fwwebex-label-problems{min-height:120px;overflow:auto;white-space:pre-wrap;font-size:11px}
.fwwebex-label-problem-count{
    display:inline-flex;align-items:center;justify-content:center;min-width:18px;height:18px;
    margin-left:.2rem;padding:0 .3rem;border-radius:9px;color:#fff;background:var(--fw-label-muted);
    font-size:9px
}
.fwwebex-label-problem-count[data-state=error]{background:var(--fw-label-danger)}
.fwwebex-label-problem-count[data-state=warning]{color:#332600;background:var(--fw-label-warning)}
.fwwebex-label-problem{padding:.25rem;border-bottom:1px solid var(--fw-label-border)}
.fwwebex-label-problem[data-severity=error]{color:var(--fw-label-danger)}
.fwwebex-label-problem[data-severity=warning]{color:#8a6800}
.fwwebex-label-statusbar{
    justify-content:space-between;margin-top:.4rem;padding:.3rem .45rem;border-radius:.3rem;
    background:var(--fw-label-surface);color:var(--fw-label-muted);font-size:10px
}
.fwwebex-label-statusbar [data-state=dirty]{color:#8a6800;font-weight:700}
.fwwebex-label-statusbar [data-state=error]{color:var(--fw-label-danger);font-weight:700}
.fwwebex-label-designer[data-mode=data] .fwwebex-label-field-content{font-weight:500}
.fwwebex-label-designer[data-mode=print] .fwwebex-label-field{opacity:.38}
.fwwebex-label-generator-panel{display:grid;gap:.55rem}
.fwwebex-label-generator-editors{display:grid;grid-template-columns:1fr 1fr;gap:.55rem}
.fwwebex-label-generator-editor textarea{min-height:45vh;font:11px/1.35 Consolas,monospace;resize:vertical}
.fwwebex-label-generator-actions{padding:.45rem;background:var(--fw-label-surface);border-radius:.4rem}
.fwwebex-label-generator-actions input{width:min(240px,100%)}
.fwwebex-label-generator-preview{width:100%;min-height:420px;border:1px solid var(--fw-label-border);border-radius:.4rem}
@media(min-width:900px){
    .fwwebex-label-workspace[data-elements-minimized=true]:not([data-elements-collapsed=true]):not([data-show-layers=false]){
        grid-template-columns:48px minmax(320px,1fr) 310px;
        grid-template-areas:"layers canvas inspector"
    }
    .fwwebex-label-workspace[data-elements-minimized=true]:not([data-elements-collapsed=true]):not([data-show-layers=false])[data-show-inspector=false]{
        grid-template-columns:48px minmax(320px,1fr);grid-template-areas:"layers canvas"
    }
    .fwwebex-label-layers[data-minimized=true]>.fwwebex-label-panel-head{
        height:100%;padding:.3rem;flex-direction:column;justify-content:flex-start;gap:.45rem
    }
    .fwwebex-label-layers[data-minimized=true] [data-role=elements-title]{
        writing-mode:vertical-rl;transform:rotate(180deg);white-space:nowrap
    }
    .fwwebex-label-layers[data-minimized=true] .fwwebex-label-panel-toggle{
        order:-1;width:100%;padding:.12rem!important
    }
}
@media(min-width:1400px){
    .fwwebex-label-workspace{grid-template-columns:240px minmax(420px,1fr) 360px;
        grid-template-areas:"layers canvas inspector"}
    .fwwebex-label-workspace[data-elements-minimized=true]:not([data-elements-collapsed=true]):not([data-show-layers=false]){
        grid-template-columns:48px minmax(420px,1fr) 360px;
        grid-template-areas:"layers canvas inspector"
    }
    .fwwebex-label-workspace[data-elements-minimized=true]:not([data-elements-collapsed=true]):not([data-show-layers=false])[data-show-inspector=false]{
        grid-template-columns:48px minmax(420px,1fr);grid-template-areas:"layers canvas"
    }
    .fwwebex-label-workspace[data-elements-collapsed=true],
    .fwwebex-label-workspace[data-show-layers=false]{
        grid-template-columns:minmax(420px,1fr) 360px;grid-template-areas:"canvas inspector"
    }
    .fwwebex-label-workspace[data-show-inspector=false]{
        grid-template-columns:240px minmax(420px,1fr);grid-template-areas:"layers canvas"
    }
    .fwwebex-label-workspace[data-elements-collapsed=true][data-show-inspector=false],
    .fwwebex-label-workspace[data-show-layers=false][data-show-inspector=false]{
        grid-template-columns:minmax(420px,1fr);grid-template-areas:"canvas"
    }
}
@media(max-width:899px){
    .fwwebex-label-workspace{grid-template-columns:1fr;grid-template-areas:"canvas" "layers" "inspector"}
    .fwwebex-label-workspace[data-elements-collapsed=true],
    .fwwebex-label-workspace[data-show-layers=false]{grid-template-columns:1fr;grid-template-areas:"canvas" "inspector"}
    .fwwebex-label-workspace[data-show-inspector=false]{grid-template-columns:1fr;grid-template-areas:"canvas" "layers"}
    .fwwebex-label-workspace[data-elements-collapsed=true][data-show-inspector=false],
    .fwwebex-label-workspace[data-show-layers=false][data-show-inspector=false]{grid-template-areas:"canvas"}
    .fwwebex-label-generator-editors{grid-template-columns:1fr}
    .fwwebex-label-quickbar{align-items:flex-start}
    .fwwebex-label-quickbar-actions{width:100%}
    .fwwebex-label-toolbar-tabs>.fwwebex-label-tabpanel{overflow-x:auto}
    .fwwebex-label-stage-viewport{min-height:260px}
}
.fwwebex-label-generator-panel {
    --fw-label-panel-border: #3f4852;
    --fw-label-panel-surface: #20252a;
    --fw-label-panel-surface-soft: #282e34;
    --fw-label-panel-text: #eef2f6;
    --fw-label-panel-muted: #aeb7c0;
    --fw-label-panel-primary: #0d6efd;
    --fw-label-panel-success: #198754;
    --fw-label-panel-warning: #ffc107;
    --fw-label-panel-danger: #dc3545;
    color: var(--fw-label-panel-text);
    display: block;
    font: 13px/1.4 Arial, sans-serif;
}
.fwwebex-label-generator-panel *,
.fwwebex-label-generator-panel *::before,
.fwwebex-label-generator-panel *::after {
    box-sizing: border-box;
}
.fwwebex-label-generator-panel .fwwebex-label-generator-shell {
    background: var(--fw-label-panel-surface);
    border: 1px solid var(--fw-label-panel-border);
    border-radius: 8px;
    display: grid;
    gap: 10px;
    padding: 12px;
}
.fwwebex-label-generator-panel .fwwebex-label-generator-editors {
    display: grid;
    gap: 10px;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
}
.fwwebex-label-generator-panel .fwwebex-label-generator-field {
    display: grid;
    gap: 5px;
    min-width: 0;
}
.fwwebex-label-generator-panel .fwwebex-label-generator-field > span {
    color: var(--fw-label-panel-muted);
    font-size: 12px;
    font-weight: 600;
}
.fwwebex-label-generator-panel textarea,
.fwwebex-label-generator-panel input,
.fwwebex-label-generator-panel select {
    background: #181c20;
    border: 1px solid var(--fw-label-panel-border);
    border-radius: 5px;
    color: var(--fw-label-panel-text);
    font: inherit;
    outline: none;
}
.fwwebex-label-generator-panel textarea:focus,
.fwwebex-label-generator-panel input:focus,
.fwwebex-label-generator-panel select:focus {
    border-color: #5aa2ff;
    box-shadow: 0 0 0 2px rgba(13, 110, 253, .22);
}
.fwwebex-label-generator-panel textarea {
    min-height: 250px;
    padding: 8px;
    resize: vertical;
    tab-size: 2;
    white-space: pre;
}
.fwwebex-label-generator-panel .fwwebex-label-generator-controls {
    align-items: end;
    display: grid;
    gap: 8px;
    grid-template-columns: minmax(180px, 1fr) 120px auto;
}
.fwwebex-label-generator-panel input,
.fwwebex-label-generator-panel select {
    height: 34px;
    padding: 5px 8px;
    width: 100%;
}
.fwwebex-label-generator-panel .fwwebex-label-generator-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
}
.fwwebex-label-generator-panel button {
    background: var(--fw-label-panel-primary);
    border: 0;
    border-radius: 5px;
    color: #fff;
    cursor: pointer;
    font: 600 12px/1 Arial, sans-serif;
    min-height: 34px;
    padding: 7px 12px;
}
.fwwebex-label-generator-panel button[data-action="validate"] {
    background: var(--fw-label-panel-success);
}
.fwwebex-label-generator-panel button[data-action="download"] {
    background: #087f5b;
}
.fwwebex-label-generator-panel button:disabled {
    cursor: wait;
    opacity: .58;
}
.fwwebex-label-generator-panel .fwwebex-label-generator-report {
    background: var(--fw-label-panel-surface-soft);
    border: 1px solid var(--fw-label-panel-border);
    border-left: 4px solid var(--fw-label-panel-primary);
    border-radius: 5px;
    min-height: 52px;
    padding: 8px 10px;
}
.fwwebex-label-generator-panel .fwwebex-label-generator-report[data-state="success"] {
    border-left-color: var(--fw-label-panel-success);
}
.fwwebex-label-generator-panel .fwwebex-label-generator-report[data-state="warning"] {
    border-left-color: var(--fw-label-panel-warning);
}
.fwwebex-label-generator-panel .fwwebex-label-generator-report[data-state="error"] {
    border-left-color: var(--fw-label-panel-danger);
}
.fwwebex-label-generator-panel .fwwebex-label-generator-status {
    font-weight: 600;
    margin: 0;
    white-space: pre-wrap;
}
.fwwebex-label-generator-panel .fwwebex-label-generator-issues {
    display: grid;
    gap: 6px;
    list-style: none;
    margin: 8px 0 0;
    padding: 0;
}
.fwwebex-label-generator-panel .fwwebex-label-generator-issue {
    background: rgba(0, 0, 0, .18);
    border-radius: 4px;
    display: grid;
    gap: 3px;
    padding: 7px 8px;
}
.fwwebex-label-generator-panel .fwwebex-label-generator-issue-header {
    align-items: center;
    display: flex;
    flex-wrap: wrap;
    gap: 7px;
}
.fwwebex-label-generator-panel .fwwebex-label-generator-severity {
    border-radius: 999px;
    color: #fff;
    font-size: 10px;
    font-weight: 700;
    padding: 2px 7px;
    text-transform: uppercase;
}
.fwwebex-label-generator-panel .fwwebex-label-generator-severity[data-severity="warning"] {
    background: #946c00;
}
.fwwebex-label-generator-panel .fwwebex-label-generator-severity[data-severity="error"] {
    background: var(--fw-label-panel-danger);
}
.fwwebex-label-generator-panel .fwwebex-label-generator-severity[data-severity="info"] {
    background: var(--fw-label-panel-primary);
}
.fwwebex-label-generator-panel .fwwebex-label-generator-code {
    font-family: Consolas, monospace;
    font-size: 12px;
    font-weight: 700;
}
.fwwebex-label-generator-panel .fwwebex-label-generator-path,
.fwwebex-label-generator-panel .fwwebex-label-generator-suggestion {
    color: var(--fw-label-panel-muted);
    font-size: 11px;
    overflow-wrap: anywhere;
}
.fwwebex-label-generator-panel .fwwebex-label-generator-empty {
    color: var(--fw-label-panel-muted);
    margin: 7px 0 0;
}
@media (max-width: 820px) {
    .fwwebex-label-generator-panel .fwwebex-label-generator-editors {
        grid-template-columns: 1fr;
    }
    .fwwebex-label-generator-panel .fwwebex-label-generator-controls {
        grid-template-columns: 1fr 110px;
    }
    .fwwebex-label-generator-panel .fwwebex-label-generator-actions {
        grid-column: 1 / -1;
    }
}
