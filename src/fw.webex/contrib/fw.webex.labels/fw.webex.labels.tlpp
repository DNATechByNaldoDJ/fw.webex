        function translate(item,x,y){
            const dx=finite(x,item.box.x)-item.box.x,dy=finite(y,item.box.y)-item.box.y;
            if(Math.abs(dx)<=epsilon&&Math.abs(dy)<=epsilon)return;
            const moving=new Set([item.id]);
            if(item.type==="container")
                graph.descendants(item.id).forEach(function(id){moving.add(id);});
            graph.elements.forEach(function(candidate){
                if(!moving.has(candidate.id))return;
                candidate.box.x+=dx;candidate.box.y+=dy;changed.add(candidate.id);
            });
        }
        function resize(item,width,height){
            width=width==null?item.box.width:Math.max(0,finite(width,item.box.width));
            height=height==null?item.box.height:Math.max(0,finite(height,item.box.height));
            if(Math.abs(item.box.width-width)<=epsilon&&
                Math.abs(item.box.height-height)<=epsilon)return;
            item.box.width=width;item.box.height=height;
            item.basisBox=item.basisBox&&typeof item.basisBox==="object"?
                item.basisBox:{};
