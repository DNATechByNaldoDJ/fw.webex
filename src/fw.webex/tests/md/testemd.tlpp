#include "totvs.ch"

using namespace FWWebEx

function u_TestaMD(lSave as logical,lAsciiToWebAccentuation as logical)

    local cCRLF:=CRLF as character
    local cOutPut as character

    local oMD:=FWMarkdown():New() as object
    local oComment:=FWMarkdown():New(.T.) as object

    DEFAULT lSave:=.T.
    DEFAULT lAsciiToWebAccentuation:=.F.

    // FrontMatter no topo
    oMD:FrontMatter(;
        {;
             "title" : __Accentuation(lAsciiToWebAccentuation,"Relat#1rio Teste","oacute");
            ,"author" : "DNATech";
            ,"date" : DToC(Date());
        };
    )

    oMD:Header(__Accentuation(lAsciiToWebAccentuation,"Relat#1rio Markdown","oacute"),1)
    oMD:Paragraph("Gerado em ADVPL com suporte a **Markdown**.")

    oMD:Header(__Accentuation(lAsciiToWebAccentuation,"Lista hier#1rquica","aacute"),2)
    oMD:ListItem("Item 1",1)
    oMD:ListItem("Subitem 1.1",2)
    oMD:ListItem("Subitem 1.1.1",3)
    oMD:ListItem("Item 2",1)

    oMD:Rule()

    oMD:Header("Lista Ordenada Aninhada",2)
    oMD:ListItem("Top 1",1,.T.)
    oMD:ListItem("Sub 1",2,.T.)
    oMD:ListItem("Sub 2",2,.T.)
    oMD:ListItem("Top 2",1,.T.)

    oMD:Rule()

    oMD:Header("Lista de Tarefas",2)
    oMD:ListItemTask("Tarefa pendente", .F., 1)
    oMD:ListItemTask(__Accentuation(lAsciiToWebAccentuation,"Tarefa conclu#1da","iacute"), .T., 1)

    oMD:Rule()

    oMD:Header(__Accentuation(lAsciiToWebAccentuation,"Texto Avan#1ado","ccedil"),2)
    oMD:Paragraph(oMD:Highlight("Destaque")+" com "+oMD:Subscript("sub")+" e "+oMD:SuperScript("super"))

    oMD:Rule()

    oMD:Header("Links e Imagens",2)
    oMD:Paragraph("Veja o "+oMD:Link("GitHub","https://github.com"))
    oMD:Paragraph(oMD:Image("Logo","https://github.com/DNATechByNaldoDJ/fw.webex/blob/main/src/resource/dna_tech_logo.png?raw=true"))

    oMd:Rule()

    oMD:Header(__Accentuation(lAsciiToWebAccentuation,"C#1digo","oacute"),2)
    oMD:CodeBlock("User Function Hello()"+cCRLF+"   ConOut('Hello Markdown')"+cCRLF+"Return","advpl")

    oMd:Rule()

    oMD:Header(__Accentuation(lAsciiToWebAccentuation,"Cita#1#2o","ccedil","atilde"),2)
    oMD:Quote(__Accentuation(lAsciiToWebAccentuation,"Markdown deixa a leitura mais agrad#1vel."+cCRLF+"E agora com multi-linha.","aacute"),1)
    oMD:Quote(__Accentuation(lAsciiToWebAccentuation,"Cita#1#2o aninhada.","ccedil","atilde"),2)

    oMd:Rule()

    oMD:Header("Tabela",2)
    oMD:Table({"Produto","Qtde","Valor","Tabela"},{{"A","10","10.25","A-1"},{"B","25","15.75","B-2"}},{"left","right","right","left"})

    oMD:Rule()

    oMD:Header(__Accentuation(lAsciiToWebAccentuation,"Defini#1#2o","ccedil","atilde"),2)
    oMD:DefinitionList("Termo",__Accentuation(lAsciiToWebAccentuation,"Defini#1#2o aqui.","ccedil","atilde"))

    oMD:Rule()

    oMD:Header(__Accentuation(lAsciiToWebAccentuation,"Rodap#1","eacute"),2)
    oMD:Paragraph(__Accentuation(lAsciiToWebAccentuation,"Texto com rodap#1","eacute")+oMD:FootnoteRef("1"))
    oMD:FootnoteDef("1",__Accentuation(lAsciiToWebAccentuation,"Nota de rodap#1.","eacute"))

    oMD:Rule()

    oMD:Header(__Accentuation(lAsciiToWebAccentuation,"Relat#1rio com V#2deo","oacute","iacute"),1)
    oMD:Paragraph(__Accentuation(lAsciiToWebAccentuation,"Para ver, desabilite o coment#1rio abaixo:","aacute"))
    if (lSave)
        oComment:VideoEmbed("https://www.youtube.com/watch?v=vZaldeUg6D0",640,360)
        oMD:Comment(oComment:BuildOutPut(),.T.)
        oComment:Clean()
    else
        oMD:VideoEmbed("https://www.youtube.com/watch?v=vZaldeUg6D0",640,360)
    endif

    oMd:Rule()

    if (lSave)
        oMD:Save("C:\GitHub\fw.webex\src\fw.webex\tests\md\relatorio.md")
    else
        cOutPut:=oMD:BuildOutPut()
    endif

    oMD:Clean()
    FreeObj(@oMD)
    FreeObj(@oComment)

return(cOutPut)

static function __Accentuation(lAsciiToWebAccentuation as logical,cString as character,vAccentuation as variadic)

    local aAccentuation as array

    local cNewString:=cString as character

    local nVArg as numeric
    local nAccentuation as numeric

    if ((ValType(vAccentuation)=="J").and.(vAccentuation:HasProperty("VARGS")))
        vAccentuation:GetJSONValue("VARGS",@aAccentuation)
        nAccentuation:=Len(aAccentuation)
        for nVArg:=1 to nAccentuation
            cNewString:=WebExHelper():Accentuation(cNewString,aAccentuation[nVArg])
        next nVArg
    endif
    if (lAsciiToWebAccentuation)
        cNewString:=WebExHelper():AsciiToWebAccentuation(cNewString)
        if (("&cr;"$cNewString).or.("&NewLine;"$cNewString))
            cNewString:=WebExHelper():StrReplaceEx(;
                cNewString;
                ,{"&cr;",""};
                ,{"&NewLine;",CRLF};
            )
        endif
    endif
return(cNewString)
