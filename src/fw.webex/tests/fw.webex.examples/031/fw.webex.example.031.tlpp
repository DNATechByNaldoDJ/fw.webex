#include "fw.webex.th"

using namespace FWWebEx
using namespace FWWebEx.Tools

procedure u_FWWebExExample_031()
    local bExecute as codeblock
    local cHTML as character
    local cHTMLFile as character
    local cProcName:=ProcName() as character
    local oTWebChannel as object
    bExecute:={||FWMsgRun(nil,{||cHTMLFile:=FWWebExExample_031(@cHTML)},"Aguarde",cProcName)}
    FWExampleTools():Execute(bExecute,cProcName,.F.,.F.)
    if (!Empty(cHTMLFile).and.File(cHTMLFile))
        oTWebChannel:=WebApp():GetTWebChannel()
        FWExampleTools():htmlFileShow(cHTML,cProcName,cHTMLFile,oTWebChannel)
        fErase(cHTMLFile)
    endif
    WebFileTools():ObliterateFWWebExTmpFiles(.T.)
return

static function FWWebExExample_031(cHTML as character) as character

    local cHTMLFile:=ProcName() as character
    local cLayoutJSON as character
    local cOptionsJSON as character
    local cRecordsJSON as character
    local oFWWebExPage as object

    cOptionsJSON:=GetOptionsJSON()

    cLayoutJSON:=GetLayoutJSON()
    cRecordsJSON:=GetRecordsJSON()

    WITH WEBEXOBJECT oFWWebExPage CLASS WebExPage ARGS "FWWebEx :: Designer de r&oacute;tulos"
        WITH WEBEXOBJECT CLASS WebExBody
            WITH WEBEXOBJECT CLASS WebExMain
                WITH WEBEXOBJECT CLASS WebExContainer ARGS .T.
                    .:AddClass("py-3")
                    WITH WEBEXOBJECT CLASS WebExH2
                        .:SetContent("Designer de r&oacute;tulos")
                    END WEBEXOBJECT
                    WITH WEBEXOBJECT CLASS WebExParagraph
                        .:SetContent("Componente autocontido com contrato v2, dados din&acirc;micos, valida&ccedil;&atilde;o e preview.")
                    END WEBEXOBJECT
                    WITH WEBEXOBJECT CLASS WebExLabelDesigner ARGS 100,60
                        .:SetFixedID("label-designer-example-031")
                        .:SetLayout(cLayoutJSON)
                        cLayoutJSON:=""
                        .:SetRecords(cRecordsJSON)
                        cRecordsJSON:=""
                        .:SetOptions(cOptionsJSON)
                    END WEBEXOBJECT
                END WEBEXOBJECT
            END WEBEXOBJECT
        END WEBEXOBJECT
    END WEBEXOBJECT NOADDCHILD

    WebFileTools():HTMLFromControl(oFWWebExPage,oFWWebExPage:GetFWWebExTmpPath(),@cHTMLFile,@cHTML,.T.)
    WEBEXOBJECT CLEAN

return(cHTMLFile)

static function GetOptionsJSON() as character
    local cOptionsJSON as character
    beginContent var cOptionsJSON
{
  "fileName": "rotulos-demonstracao.pdf",
  "showToolbar": true,
  "showLayers": true,
  "showInspector": true,
  "showDrawers": true,
  "autoValidate": true,
  "tabs": {"sidebar": "add"}
}
    endContent
return(cOptionsJSON)

static function GetLayoutJSON() as character

    local cTmpPath as character
    local cLayoutJSON as character
    local cTmpFullPath as character
    local cTmpFullPathFile as character

    local oFileReader as object

    cTmpPath:={"Path":StrTran("\\tmp\\fwwebex\\","\\",BACK_SLASH)}["Path"]
    FWMakeDir(cTmpPath,.F.)
    cTmpFullPath:=cTmpPath+{"Path":StrTran("fw.webex.rotulos.json\\","\\",BACK_SLASH)}["Path"]

    cTmpFullPathFile:=cTmpFullPath+"fwwebex_rotulos_design_contrato_1.json"
    if (!File(cTmpFullPathFile))
        //Se compilou src\fw.webex\tests\resources\rotulos\json\fw.webex.rotulos.json.zip como resource
        if (Resource2File("fw.webex.rotulos.json.zip",cTmpPath+"fw.webex.rotulos.json.zip"))
            if (File(cTmpPath+"fw.webex.rotulos.json.zip"))
                if (FUnzip(cTmpPath+"fw.webex.rotulos.json.zip",cTmpPath)==0)
                    if (File(cTmpFullPathFile))
                        if (FindClass("dna.tech.FileTools"))
                            cLayoutJSON:=dna.tech.FileTools():FullContentTextFile(cTmpFullPathFile)
                        else
                            oFileReader:=FWFileReader():New(cTmpFullPathFile)
                            oFileReader:Open()
                            cLayoutJSON:=oFileReader():FullRead()
                            oFileReader:Close()
                            FreeObj(@oFileReader)
                        endif
                    endif
                endif
            endif
        endif
    else
        if (FindClass("dna.tech.FileTools"))
            cLayoutJSON:=dna.tech.FileTools():FullContentTextFile(cTmpFullPathFile)
        else
            oFileReader:=FWFileReader():New(cTmpFullPathFile)
            oFileReader:Open()
            cLayoutJSON:=oFileReader():FullRead()
            oFileReader:Close()
            FreeObj(@oFileReader)
        endif
    endif

    //Fallback
    if (Empty(cLayoutJSON))
        //Sinto falta disso em AdvPL/TLPP
        //#pragma __streaminclude "../src/tests/hb/ASCII.art/Swimming.ASCII.art"|return(%s)
        beginContent var cLayoutJSON
