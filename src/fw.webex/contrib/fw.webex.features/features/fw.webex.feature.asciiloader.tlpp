#include "fw.webex.th"

namespace FWWebEx

class WebExFeatureASCIILoader from WebExControl
    protected data oFeature as object
    public method Enable() as object
    public method Load(oControl as object) as object
end class

method Enable() class WebExFeatureASCIILoader
    local oFeature as object
    _Super:New()
    ::oFeature:=self
    oFeature:=::oFeature
    ::AddFeature(oFeature,{|oControl|oFeature:Load(oControl)},25)
return(self)

method Load(oControl) class WebExFeatureASCIILoader

    local cASCIILoaderScript as character

    paramtype 1 var oControl as object

    //ASCII Loader
    WITH WEBEXOBJECT oControl
        ***************************************************************************************************************************
        //Scripts Tools
            beginContent var cASCIILoaderScript

                // ===============================
                // FWWebExAsciiEngine GLOBAL
                // ===============================
                if(!window.FWWebExAsciiEngine){

                    window.FWWebExAsciiEngine = (function(){

                        const instances = {};

                        function sleep(ms){
                            return new Promise(r => setTimeout(r, ms));
                        }

                        function createContext(inst){
                            return {
                                inst,
                                currentArea: "full",
                                delay: inst.delay || 120,
                                color: null,
                                progress: 0,
                                stopped: false,
                                typeNextLine: false
                            };
                        }

                        function parseCommand(line){
                            if(line === ";") return { type: "command", name: "clearArea" };
                            if(line === ";c") return { type: "command", name: "clearAll" };
                            if(line === ";type") return { type: "command", name: "typeNext" };

                            if(line.startsWith(";d=")){
                                return { type: "command", name: "delay", value: parseInt(line.split("=")[1]) || 120 };
                            }

                            if(line.startsWith(";area=")){
                                return { type: "command", name: "area", value: line.split("=")[1] || "full" };
                            }

                            if(line.startsWith(";color=")){
                                return { type: "command", name: "color", value: line.split("=")[1] || "" };
                            }

                            if(line.startsWith(";progress=")){
                                return { type: "command", name: "progress", value: parseInt(line.split("=")[1]) || 0 };
                            }

                            throw new Error("Comando invalido: " + line);
                        }

                        function parseTimes(line){
                            const value = (line.split("=")[1] || "").trim();
                            if(value === "inf") return "inf";

                            const n = parseInt(value, 10);
                            if(isNaN(n) || n < 1){
                                throw new Error("Valor invalido para repeticao: " + value);
                            }

                            return n;
                        }

                        function parseScript(script){
                            const lines = script.split("\n");
                            const root = [];
                            const stack = [root];

                            for(let i = 0; i < lines.length; i++){
                                const raw = lines[i];
                                const line = raw.trim();

                                if(line === ""){
                                stack[stack.length - 1].push({ type: "text", value: "" });
                                continue;
                                }

                                if(line === ";end"){
                                if(stack.length === 1){
                                    throw new Error("';end' sem bloco aberto");
                                }
                                stack.pop();
                                continue;
                                }

                                if(line.startsWith(";repeat=")){
                                const node = {
                                    type: "block",
                                    kind: "repeat",
                                    times: parseTimes(line),
                                    children: []
                                };
                                stack[stack.length - 1].push(node);
                                stack.push(node.children);
                                continue;
                                }

                                if(line.startsWith(";loop=")){
                                const node = {
                                    type: "block",
                                    kind: "loop",
                                    times: parseTimes(line),
                                    children: []
                                };
                                stack[stack.length - 1].push(node);
                                stack.push(node.children);
                                continue;
                                }

                                if(line.startsWith(";#") || line.startsWith(";//")){
                                continue;
                                }

                                if(line.startsWith(";")){
                                stack[stack.length - 1].push(parseCommand(line));
                                continue;
                                }

                                stack[stack.length - 1].push({ type: "text", value: raw });
                            }

                            if(stack.length !== 1){
                                throw new Error("Ha bloco sem ';end'");
                            }

                            return root;
                        }

                        function getMode(inst){
                            if(typeof inst.maxLines === "object"){
                                return inst.maxLines.mode || "fixed";
                            }
                            return "fixed";
                        }

                        function getLimit(inst, area){
                            if(typeof inst.maxLines === "number"){
                                return inst.maxLines;
                            }

                            if(typeof inst.maxLines === "object"){
                                return inst.maxLines[area] || 10;
                            }

                            return 10;
                        }

                        function trim(arr, limit){
                            return arr.length > limit ? arr.slice(arr.length - limit) : arr;
                        }

                        function render(inst){
                            const mode = getMode(inst);

                            if(mode === "fixed"){
                                inst.areas.top    = trim(inst.areas.top,    getLimit(inst, "top"));
                                inst.areas.full   = trim(inst.areas.full,   getLimit(inst, "full"));
                                inst.areas.bottom = trim(inst.areas.bottom, getLimit(inst, "bottom"));
                            }

                            let txt = "";

                            if(inst.areas.top.length){
                                txt += inst.areas.top.join("\n") + "\n";
                            }

                            if(inst.areas.full.length){
                                txt += inst.areas.full.join("\n") + "\n";
                            }

                            if(inst.areas.bottom.length){
                                txt += inst.areas.bottom.join("\n");
                            }

                            if(inst.text){
                                txt += (txt ? "\n" : "") + inst.text;
                            }

                            inst.el.textContent = txt;

                            if(mode === "scroll"){
                                inst.el.scrollTop = inst.el.scrollHeight;
                            }
                        }

                        function clearArea(inst, area){
                            inst.areas[area] = [];
                            render(inst);
                        }

                        function clearAll(inst){
                            inst.areas = { top: [], full: [], bottom: [] };
                            render(inst);
                        }

                        async function typeLine(inst, area, text, delay){
                            let buffer = "";

                            for(let i = 0; i < text.length; i++){
                                if(inst.context.stopped) break;
                                buffer += text[i];

                                const clone = [...inst.areas[area]];
                                if(clone.length === 0 || clone[clone.length - 1] !== buffer){
                                if(clone.length && clone[clone.length - 1].startsWith(buffer.slice(0, -1))){
                                    inst.areas[area][inst.areas[area].length - 1] = buffer;
                                } else {
                                    inst.areas[area].push(buffer);
                                }
                                }

                                render(inst);
                                await sleep(Math.max(10, delay / Math.max(text.length, 1)));
                            }
                        }

                        async function appendLine(inst, area, text, delay, typeMode){
                            if(typeMode){
                                inst.areas[area].push("");
                                await typeLine(inst, area, text, delay);
                            } else {
                                inst.areas[area].push(text);
                                render(inst);
                                await sleep(delay);
                            }
                        }

                        async function executeCommand(node, ctx){
                            const inst = ctx.inst;

                            switch(node.name){
                                case "clearArea":
                                clearArea(inst, ctx.currentArea);
                                break;

                                case "clearAll":
                                clearAll(inst);
                                break;

                                case "delay":
                                ctx.delay = node.value;
                                break;

                                case "area":
                                ctx.currentArea = node.value;
                                break;

                                case "color":
                                ctx.color = node.value;
                                inst.el.style.color = node.value;
                                break;

                                case "progress":
                                ctx.progress = node.value;
                                if(typeof inst.onProgress === "function"){
                                    inst.onProgress(node.value, inst);
                                }
                                break;

                                case "typeNext":
                                ctx.typeNextLine = true;
                                break;
                            }
                        }

                        async function executeNode(node, ctx){
                        if(ctx.stopped) return;

                        if(node.type === "text"){
                            const typeMode = ctx.typeNextLine;
                            ctx.typeNextLine = false;
                            await appendLine(ctx.inst, ctx.currentArea, node.value, ctx.delay, typeMode);
                            return;
                        }

                        if(node.type === "command"){
                            await executeCommand(node, ctx);
                            return;
                        }

                        if(node.type === "block"){
                                if(node.times === "inf"){
                                while(!ctx.stopped){
                                    for(const child of node.children){
                                    await executeNode(child, ctx);
                                    if(ctx.stopped) break;
                                    }
                                }
                                return;
                                }

                                for(let i = 0; i < node.times; i++){
                                if(ctx.stopped) break;
                                for(const child of node.children){
                                    await executeNode(child, ctx);
                                    if(ctx.stopped) break;
                                }
                                }
                            }
                        }

                        async function executeAst(inst, ast){
                            const ctx = createContext(inst);
                            inst.context = ctx;

                            for(const node of ast){
                                    await executeNode(node, ctx);
                                    if(ctx.stopped) break;
                                }
                        }


                        function renderFrame(inst, frame){

                            inst.areas = { top: [], full: [], bottom: [] };

                            let currentArea = "full";

                            const lines = frame.split("\n");

                            for(const raw of lines){

                                const line = raw.trim();

                                // ===============================
                                // ?? COMANDOS (DSL)
                                // ===============================

                                if(line === ";"){
                                    inst.areas[currentArea] = [];
                                    continue;
                                }

                                if(line === ";c"){
                                    inst.areas = { top: [], full: [], bottom: [] };
                                    continue;
                                }

                                if(line.startsWith(";area=")){
                                    currentArea = line.split("=")[1] || "full";
                                    continue;
                                }

                                if(line.startsWith(";color=")){
                                    inst.el.style.color = line.split("=")[1] || "";
                                    continue;
                                }

                                if(line.startsWith(";d=")){
                                    // ?? delay por frame (override temporario)
                                    inst._frameDelayOverride = parseInt(line.split("=")[1]) || inst.delay;
                                    continue;
                                }

                                if(line.startsWith(";progress=")){
                                    const val = parseInt(line.split("=")[1]) || 0;
                                    if(typeof inst.onProgress === "function"){
                                        inst.onProgress(val, inst);
                                    }
                                    continue;
                                }

                                // ? ignorados no frame mode (faz sentido)
                                if(line.startsWith(";type")) continue;
                                if(line.startsWith(";repeat")) continue;
                                if(line.startsWith(";loop")) continue;

                                if(line.startsWith(";")) continue;

                                // ===============================
                                // ?? TEXTO
                                // ===============================
                                inst.areas[currentArea].push(raw);
                            }

                            render(inst);
                        }

                        function getFrameComplexity(frame){

                            const lines = frame.split("\n");

                            let weight = 0;

                            for(const raw of lines){

                                const line = raw.trim();

                                if(line.startsWith(";")) continue;
                                if(line === "") continue;

                                weight += 1;
                                weight += Math.min(line.length / 20, 2);
                            }

                            return Math.max(weight, 1);
                        }

                        async function run(id){

                            const inst = instances[id];
                            if(!inst || inst.running) return;

                            inst.running = true;

                            try{

                                // ===============================
                                // SCRIPT MODE
                                // ===============================
                                if(inst.script && inst.script.trim() !== ""){

                                    const ast = parseScript(inst.script);
                                    await executeAst(inst, ast);
                                    return;
                                }

                                // ===============================
                                // FRAME MODE
                                // ===============================
                                if(inst.frames && inst.frames.length){

                                    while(inst.running){

                                        for(const frame of inst.frames){

                                            if(!inst.running) break;

                                            // renderiza TUDO de uma vez
                                            renderFrame(inst, frame);

                                            //calcula complexidade do frame
                                            const complexity = getFrameComplexity(frame);

                                            //calcula tempo adaptativo
                                            const frameTime = Math.min(
                                                inst.delay * complexity * inst.frameTimeFactor,
                                                inst.maxFrameTime || 1000
                                            );

                                            //espera baseado no conteudo
                                            await sleep(frameTime);

                                        }
                                    }
                                }

                            } finally {
                                inst.running = false;
                            }
                        }

                        function stop(id){
                            const inst = instances[id];
                            if(!inst) return;

                            inst.running = false;

                            if(inst.context){
                                inst.context.stopped = true;
                            }
                        }

                        function loadScript(id, script){
                            const inst = instances[id];
                            if(!inst) return;
                            inst.script = script || "";
                        }

                        function applyModeStyle(inst){
                            const mode = getMode(inst);

                            inst.el.style.backgroundColor = "var(--bs-body-bg)";
                            inst.el.style.color           = "var(--bs-body-color)";
                            inst.el.style.display         = "block";
                            inst.el.style.padding         = "0.75rem";
                            inst.el.style.margin          = "0";
                            inst.el.style.whiteSpace      = "pre";
                            inst.el.style.fontFamily      = "monospace";
                            inst.el.style.lineHeight      = "1.2em";
                            inst.el.style.border          = "1px solid var(--bs-border-color)";
                            inst.el.style.borderRadius    = "0.375rem";
                            inst.el.style.boxSizing       = "border-box";

                            if(mode === "fixed"){
                                inst.el.style.overflow = "hidden";

                                const totalLines =
                                getLimit(inst,"top") +
                                getLimit(inst,"full") +
                                getLimit(inst,"bottom");

                                inst.el.style.height = (totalLines * 1.2) + "em";
                            }

                            if(mode === "scroll"){
                                inst.el.style.overflowY = "auto";
                                inst.el.style.overflowX = "hidden";
                                inst.el.style.height = "200px";
                            }
                        }

                        function register(id, config){
                            instances[id] = {
                                el: config.el,
                                frames: config.frames || [],
                                script: (config.script && config.script.trim() !== "") ? config.script : null,
                                text: config.text || "",
                                delay: config.interval || 120,
                                autoStart: config.autoStart || false,
                                maxLines: config.maxLines || 10,
                                frameTimeFactor: config.frameTimeFactor || 0.5,
                                maxFrameTime: config.maxFrameTime || 1000,
                                onProgress: config.onProgress || null,
                                running: false,
                                context: null,
                                areas: { top: [], full: [], bottom: [] },
                            };

                            applyModeStyle(instances[id]);

                            if(instances[id].autoStart){
                                run(id);
                            }
                        }

                        return {
                            register,
                            loadScript,
                            run,
                            stop,
                            parseScript
                        };

                    })();
                    FWWebEx.Events.emit('FWWebEx:ascii:ready');
                }

            endContent
            WITH WEBEXOBJECT CLASS WebExScript
                .:SetContent(cASCIILoaderScript)
            END WEBEXOBJECT NOADDCHILD
        //Scripts Tools
        ***************************************************************************************************************************
    END WEBEXOBJECT NOADDCHILD
    //ASCII Loader

return(self)
