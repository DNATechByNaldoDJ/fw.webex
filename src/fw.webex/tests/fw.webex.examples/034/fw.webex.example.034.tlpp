    local cSVG:="" as character
    BeginContent var cSVG
<svg xmlns="http://www.w3.org/2000/svg" width="130mm" height="115mm" viewBox="0 0 130 115" preserveAspectRatio="xMidYMid meet" data-hide-empty-fields="true">
<rect x="1" y="1" width="128" height="113" rx="2" fill="#fff" stroke="#17232d" stroke-width=".7"/><rect x="5" y="5" width="120" height="18" rx="1.5" fill="#edf4f7" stroke="#40606f" stroke-width=".35"/>
<text x="8" y="12" font-family="Arial" font-size="5.5" font-weight="700">RÓTULO DE PRODUTO</text><text id="product" x="8" y="19" font-family="Arial" font-size="3.8" data-fit-width="112" data-fit-height="5" data-min-font-size="2" data-max-font-size="5">PRODUTO</text>
<svg id="barcode" x="6" y="29" width="48" height="42" viewBox="0 0 100 60" preserveAspectRatio="xMidYMid meet"/>
<g id="data-container" font-family="Arial" font-size="3.4"><rect x="58" y="29" width="66" height="42" fill="none" stroke="#b4c2c9" stroke-width=".25" stroke-dasharray="1 1"/><text x="61" y="37" font-weight="700" data-label-for="batch">Lote:</text><text id="batch" x="121" y="37" text-anchor="end" data-fit-width="32" data-fit-height="5" data-min-font-size="1.5" data-max-font-size="3.4"/><text x="61" y="45" font-weight="700" data-label-for="manufacture">Fabricação:</text><text id="manufacture" x="121" y="45" text-anchor="end" data-fit-width="32" data-fit-height="5" data-min-font-size="1.5" data-max-font-size="3.4"/><text x="61" y="53" font-weight="700" data-label-for="expiration">Validade:</text><text id="expiration" x="121" y="53" text-anchor="end" data-fit-width="32" data-fit-height="5" data-min-font-size="1.5" data-max-font-size="3.4"/><text x="61" y="61" font-weight="700" data-label-for="weight">Peso:</text><text id="weight" x="121" y="61" text-anchor="end" data-fit-width="32" data-fit-height="5" data-min-font-size="1.5" data-max-font-size="3.4"/></g>
<!-- Perfil demonstrativo 1: limites da tabela raster; gap em mm. -->
<g id="volume-species" data-volume-gap="0.57" data-volume-align="center" data-species-use-volume-font="true"><rect x="6" y="77" width="118" height="27" rx="1.5" fill="#f8fafb" stroke="#b4c2c9" stroke-width=".3"/><text id="volume" x="65" y="90" text-anchor="middle" font-family="Arial" font-size="10" font-weight="900" font-style="italic" data-fit-width="112" data-fit-height="16.227778" data-min-font-size="14" data-max-font-size="23" data-font-unit="raster" data-font-scale-x="0.945"/><text id="species" x="65" y="99" text-anchor="middle" font-family="Arial" font-size="5" font-weight="900" data-fit-width="112" data-fit-height="10.583333" data-min-font-size="5" data-max-font-size="15" data-font-unit="raster" data-font-scale-x="0.945"/></g><text x="4" y="112" fill="#aeb7bc" font-family="Arial" font-size="1.7">FWWebEx · SVG label example 034</text></svg>
    EndContent
return(cSVG)
