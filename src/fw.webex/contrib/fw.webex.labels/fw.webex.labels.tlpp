  <input data-role="layout-file" type="file" accept=".json,application/json" hidden>
</div>
<div class="fwwebex-label-workspace" data-role="workspace"
  data-show-layers="true" data-show-inspector="true" data-elements-collapsed="false"
  data-elements-minimized="false">
  <aside class="fwwebex-label-pane fwwebex-label-layers" data-minimized="false">
    <div class="fwwebex-label-panel-head"><span data-role="elements-title">Elementos</span>
      <button type="button" class="fwwebex-label-panel-toggle"
        data-action="toggle-elements-size" aria-expanded="true"
        aria-label="Recolher painel Elementos"
        title="Recolher painel Elementos">Recolher</button></div>
    <div class="fwwebex-label-panel-body">
      <div class="fwwebex-label-tablist" role="tablist" aria-label="Elementos do r&oacute;tulo">
