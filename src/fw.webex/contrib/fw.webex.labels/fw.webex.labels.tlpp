              <label>Margem base<input data-role="page-margin-bottom" type="number" min="0" step=".1"></label>
              <label>Margem esquerda<input data-role="page-margin-left" type="number" min="0" step=".1"></label>
              <label>&Aacute;rea segura<input data-role="page-safe-area" type="number" min="0" step=".1"></label>
              <label>Sangria<input data-role="page-bleed" type="number" min="0" step=".1"></label>
