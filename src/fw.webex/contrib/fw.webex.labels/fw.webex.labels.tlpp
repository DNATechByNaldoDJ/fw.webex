            const hasOverflow=used>mainSize+0.001||crossOverflow;
            container.hasOverflow=hasOverflow;
            if(hasOverflow&&config.overflow==="error")
                throw engineError(issue("CONTAINER_OVERFLOW","error",
                    pointer("elements",indexes.get(container),"layout","overflow"),
                    "Os componentes nao cabem na area "+(container.name||container.id)+".",
                    "Aumente o container, reduza filhos/gap/margens ou use sizing shrink.",
                    container.id,null,"layout",{availableMainSize:mainSize,usedMainSize:used,
