    beginContent var cRecordsJSON
[
  {
    "produto": "DETERGENTE ALCALINO CONCENTRADO",
    "codigoProduto": "PRD-00042",
    "lote": "L260728-A",
    "validade": "28/07/2028",
    "volume": "5 L",
    "especie": "BOMBONA",
    "pesoLiquido": "5,120 kg",
    "barcode": "7891234567895"
  },
  {
    "produto": "DESINFETANTE MULTIUSO",
    "codigoProduto": "PRD-00151",
    "lote": "L260728-B",
    "validade": "28/07/2028",
    "volume": "2 L",
    "especie": "FRASCO",
    "pesoLiquido": "2,080 kg",
    "barcode": "7894900011517"
  }
]
    endContent

    beginContent var cOptionsJSON
{
  "fileName": "rotulos-demonstracao.pdf",
  "showToolbar": true,
  "showLayers": true,
  "showInspector": true,
  "showDrawers": true
}
    endContent

    WITH WEBEXOBJECT oFWWebExPage CLASS WebExPage ARGS "FWWebEx :: Designer de r&oacute;tulos"
        WITH WEBEXOBJECT CLASS WebExBody
            WITH WEBEXOBJECT CLASS WebExMain
                WITH WEBEXOBJECT CLASS WebExContainer ARGS .T.
                    .:AddClass("py-3")
                    WITH WEBEXOBJECT CLASS WebExH2
                        .:SetContent("Designer de r&oacute;tulos")
                    END WEBEXOBJECT
                    WITH WEBEXOBJECT CLASS WebExParagraph
                        .:SetContent("Componente autocontido com contrato v2, dados din&acirc;micos, valida&ccedil;&atilde;o e preview.")
                    END WEBEXOBJECT
                    WITH WEBEXOBJECT CLASS WebExLabelDesigner ARGS 100,60
                        .:SetFixedID("label-designer-example-031")
                        .:SetLayout(cLayoutJSON)
                        .:SetRecords(cRecordsJSON)
                        .:SetOptions(cOptionsJSON)
                    END WEBEXOBJECT
                END WEBEXOBJECT
            END WEBEXOBJECT
        END WEBEXOBJECT
    END WEBEXOBJECT NOADDCHILD

    WebFileTools():HTMLFromControl(oFWWebExPage,oFWWebExPage:GetFWWebExTmpPath(),@cHTMLFile,@cHTML,.T.)
    WEBEXOBJECT CLEAN

return(cHTMLFile)
